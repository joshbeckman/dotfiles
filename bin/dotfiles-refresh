#!/usr/bin/env bash
# dotfiles-refresh: run ./setup unattended and report only when it breaks.
#
# Scheduled every two hours by Library/LaunchAgents/org.joshbeckman.dotfiles-refresh.plist.
# Kept as a script rather than a long ProgramArguments so the failure path can be
# tested on demand, without waiting for launchd or sending a real notification.

set -euo pipefail

DOTFILES="${DOTFILES_DIR:-$HOME/dotfiles}"
# The log lives where the platform keeps such things. Linux has no Library
# directory, and the old default made a Linux run create one just to hold this
# file. DOTFILES_REFRESH_LOG overrides either choice.
host="$(uname -s)"
case "$host" in
  Darwin) default_log="$HOME/Library/Logs/dotfiles-refresh.log" ;;
  *)      default_log="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-refresh/refresh.log" ;;
esac
LOG="${DOTFILES_REFRESH_LOG:-$default_log}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-refresh"
LOCK="$STATE/refresh.lock"
NOTIFIER="${DOTFILES_REFRESH_NOTIFIER:-notify-josh}"

# launchd hands jobs a minimal PATH, and this repo's own tools (dfm, s,
# notify-josh) live in ~/bin, which only interactive shells add. Without this the
# job fails at its first step and cannot report that failure either. The
# interactive login shell's PATH adds machine-specific toolchains (pi and the
# credential helper it needs, a managed brew) without naming them in this public
# repo; a non-interactive shell misses some, which would silently skip updates.
# The marker keeps any shell greeting out of the captured value.
login_path="$("${SHELL:-/bin/zsh}" -lic 'printf "\n__PATH__=%s\n" "$PATH"' </dev/null 2>/dev/null | sed -n 's/^__PATH__=//p' | tail -1 || true)"
PATH="$HOME/bin:${login_path:+$login_path:}/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

mkdir -p "$STATE" "$(dirname "$LOG")"

# A twice-daily job that never rotates its log is a slow disk leak; keep one
# previous file so a failure can still be compared against the run before it.
if [ -f "$LOG" ] && [ "$(wc -c < "$LOG" | tr -d ' ')" -gt 524288 ]; then
  mv -f "$LOG" "$LOG.old"
fi

# The lock records a pid, so a run killed at the wrong moment cannot leave a lock
# that silently blocks every future run. It used to be shlock, which is an INN tool:
# absent here, not an apt package, and not in the Brewfile. With the binary missing
# the old code read "command not found" as "a refresh is already running", logged
# that, and exited 0, so a scheduled refresh reported success for ever without
# running anything at all.
#
# set -C makes the redirect refuse to replace an existing file, which is an atomic
# create, and the pid inside is what separates a live holder from a dead one.
take_lock() {
  if ( set -C; printf '%s\n' "$$" > "$LOCK" ) 2>/dev/null; then
    return 0
  fi
  holder="$(cat "$LOCK" 2>/dev/null || true)"
  if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then
    return 1
  fi
  # The holder is gone: take the lock over rather than leaving it for a human.
  rm -f "$LOCK"
  ( set -C; printf '%s\n' "$$" > "$LOCK" ) 2>/dev/null
}

if ! take_lock; then
  printf '%s  skipped: a refresh is already running\n' "$(date -u +%FT%TZ)" >> "$LOG"
  exit 0
fi
trap 'rm -f "$LOCK"' EXIT INT TERM

# Everything this run writes lands after this line, so the failure message can be
# read back from the offset instead of from the tail of a shared, append-only log
# (which would quote a previous run's "ok" or a concurrent run's skip).
printf '\n=== %s dotfiles-refresh starting\n' "$(date -u +%FT%TZ)" >> "$LOG"

# Self-updaters unpack an app bundle into the user temp directory and sometimes
# never stop: a Raycast updater retry loop left 786 copies and took the disk from
# 80 GB free to 284 MB in a day. free-space owns the detection and the safety
# rules, so this job only has to run it often enough that a fan-out cannot outrun
# the cleanup. Non-fatal and before run_start so a failure here cannot be reported
# as a failed setup step.
if [ "$host" = "Darwin" ] && [ -x "$DOTFILES/bin/free-space" ]; then
  "$DOTFILES/bin/free-space" --apply --yes tmpapps >> "$LOG" 2>&1 || true
fi

run_start=$(($(wc -l < "$LOG" | tr -d ' ') + 1))

set +e
( cd "$DOTFILES" && ./setup ) >> "$LOG" 2>&1
status=$?
set -e

if [ "$status" -eq 0 ]; then
  printf '%s  ok\n' "$(date -u +%FT%TZ)" >> "$LOG"
  exit 0
fi

# Name the step, not just the exit code: setup prints "  ======  <step>" markers,
# so the last marker before the failure is the useful half of the message.
this_run="$(tail -n +"$run_start" "$LOG" 2>/dev/null || true)"
step="$(printf '%s\n' "$this_run" | grep '======' | tail -1 | sed 's/^[[:space:]]*=*[[:space:]]*//; s/[[:space:]]*=*[[:space:]]*$//' || true)"
last="$(printf '%s\n' "$this_run" | grep -v '^[[:space:]]*$' | tail -1 || true)"
printf '%s  FAILED (exit %s) during "%s"\n' "$(date -u +%FT%TZ)" "$status" "${step:-unknown step}" >> "$LOG"

"$NOTIFIER" --from dotfiles-refresh --execute "open '$LOG'" \
  "dotfiles refresh failed" \
  "setup exited ${status} during \"${step:-unknown step}\". Last line: ${last:-none}" || true

exit "$status"
