#!/bin/bash
# gh-nvim-username-keywords: Add new GitHub users to nvim keywords.txt from teams and activity
#
# Only adds usernames not already present. Never removes entries.
#
# Sources:
# 1. GitHub teams you're a member of
# 2. Recent PR reviewers and authors you've interacted with
#
# Usage:
#   gh-nvim-username-keywords                          # Use defaults
#   gh-nvim-username-keywords --team Shopify/other     # Add a team (repeatable)
#   gh-nvim-username-keywords --repo Shopify/other     # Add a repo (repeatable)
#   gh-nvim-username-keywords --limit 50               # Override PR limit
#   gh-nvim-username-keywords --dry-run --verbose      # Preview with progress

set -euo pipefail

KEYWORDS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/nvim/keywords.txt"
VERBOSE=${VERBOSE:-false}
DRY_RUN=false

DEFAULT_PR_LIMIT=30
DEFAULT_REPO_COUNT=3

# Defaults are discovered, not hardcoded: this file is synced across machines
# whose GitHub hosts and orgs differ, so any literal repo or team is wrong
# somewhere. PR/issue authorship is the signal rather than PushEvents because
# server-side merge tools (gitstream) push without generating PushEvents under
# the user, which silently dropped the repos with the most collaborators.
discover_repos() {
    {
        gh search prs --author=@me --sort=updated --limit 25 \
            --json repository,updatedAt \
            --jq '.[] | "\(.updatedAt)\t\(.repository.nameWithOwner)"' 2>/dev/null
        gh search issues --author=@me --sort=updated --limit 25 \
            --json repository,updatedAt \
            --jq '.[] | "\(.updatedAt)\t\(.repository.nameWithOwner)"' 2>/dev/null
    } | sort -r | cut -f2 | awk '!seen[$0]++' | head -n "$DEFAULT_REPO_COUNT" || true
    # PushEvents as a second source: direct-push repos (dotfiles, notes) never
    # appear in PR/issue search. Duplicates against the search results are
    # removed by the caller's union.
    local login
    login=$(gh api user --jq .login 2>/dev/null) || return 0
    gh api "users/$login/events?per_page=100" \
        --jq '.[] | select(.type=="PushEvent") | .repo.name' 2>/dev/null |
        awk '!seen[$0]++' | head -n "$DEFAULT_REPO_COUNT" || true
}

# All memberships, minus org-wide mega-teams: a several-thousand-member team
# (shopifolk, crafters) is an org roster, not a collaborator list, and would
# flood the dictionary. One paginated call returns members_count, so the
# filter costs nothing extra.
TEAM_MEMBER_CAP=100
discover_teams() {
    gh api user/teams --paginate \
        --jq ".[] | select(.members_count <= $TEAM_MEMBER_CAP) | \"\\(.organization.login)/\\(.slug)\"" 2>/dev/null || true
}

TEAMS=()
REPOS=()
PR_LIMIT=""

# Bot accounts to exclude
BOTS=(
    admin-web-ci-bot
    caution-tape-bot
    copilot-pull-request-reviewer
    dependabot
    github-actions
    github-advanced-security
    graphite-app
    pr-reviewer-agent
    shopify-build-cli-shop
    shopify-code-magic-production
    shopify-github-archiver
    shopify-review-assigner
    shopify-shipitnext
    slack-github-archiver
    spy-v2
    test-oversight-service
    translation-platform
    translation-platform-shop
)
BOTS_PATTERN=$(IFS='|'; echo "${BOTS[*]}")

log() {
    if [[ "$VERBOSE" == "true" ]]; then
        echo "[info] $*" >&2
    fi
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --dry-run) DRY_RUN=true; shift ;;
        --verbose|-v) VERBOSE=true; shift ;;
        --team) TEAMS+=("$2"); shift 2 ;;
        --repo) REPOS+=("$2"); shift 2 ;;
        --limit) PR_LIMIT="$2"; shift 2 ;;
        -h|--help)
            cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Add new GitHub users to nvim keywords.txt from teams and PR activity.

Options:
    --team ORG/SLUG   Add a team to query (repeatable, adds to defaults)
    --repo OWNER/NAME Add a repo to query (repeatable, adds to defaults)
    --limit N         Override PR limit (default: $DEFAULT_PR_LIMIT)
    --dry-run         Show what would be added without writing
    --verbose, -v     Show progress
    -h, --help        Show this help

Defaults (discovered at runtime):
    Teams: all memberships with <= $TEAM_MEMBER_CAP members
    Repos: your recent PR/issue repos plus recent direct-push repos
EOF
            exit 0
            ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

# Discovered defaults merge with any provided arguments
while IFS= read -r team; do
    [[ -n "$team" ]] && TEAMS+=("$team")
done < <(discover_teams)
while IFS= read -r repo; do
    [[ -n "$repo" ]] && REPOS+=("$repo")
done < <(discover_repos | awk '!seen[$0]++')
if [[ ${#TEAMS[@]} -eq 0 && ${#REPOS[@]} -eq 0 ]]; then
    echo "Nothing discovered from GitHub and no --team/--repo passed." >&2
    exit 1
fi
PR_LIMIT="${PR_LIMIT:-$DEFAULT_PR_LIMIT}"
log "Teams: ${TEAMS[*]+"${TEAMS[*]}"}  Repos: ${REPOS[*]+"${REPOS[*]}"}"

collect_usernames() {
    {
        # Team members. The [@]+ guard matters: /bin/bash on macOS is 3.2,
        # where expanding an empty array under set -u is a fatal error, and
        # discovery (unlike the old hardcoded defaults) can leave this empty.
        for team in "${TEAMS[@]+"${TEAMS[@]}"}"; do
            log "Fetching members from team: $team"
            local org="${team%%/*}"
            local slug="${team##*/}"
            gh api "orgs/$org/teams/$slug/members" --jq '.[].login' 2>/dev/null || true
        done

        # PR reviewers, authors, and commenters
        for repo in "${REPOS[@]+"${REPOS[@]}"}"; do
            log "Fetching PR activity from: $repo"
            gh pr list --repo "$repo" --author @me --state all --limit "$PR_LIMIT" \
                --json reviews,comments --jq '.[].reviews[].author.login, .[].comments[].author.login' 2>/dev/null || true
            gh pr list --repo "$repo" --reviewed-by @me --state all --limit "$PR_LIMIT" \
                --json author --jq '.[].author.login' 2>/dev/null || true
        done
    } | grep -vE "^($BOTS_PATTERN)$" | grep -v '^$' | sort -fu
}

main() {
    log "Collecting usernames..."

    # Get current entries (strip @ prefix for comparison)
    local existing=""
    if [[ -f "$KEYWORDS_FILE" ]]; then
        existing=$(grep '^@' "$KEYWORDS_FILE" | sed 's/^@//' | sort -fu)
    fi

    # Collect new usernames
    local discovered
    discovered=$(collect_usernames)

    # Find usernames not already in file
    local new_users
    new_users=$(comm -23 <(echo "$discovered") <(echo "$existing"))

    if [[ -z "$new_users" ]]; then
        echo "No new usernames to add."
        exit 0
    fi

    local count
    count=$(echo "$new_users" | wc -l | tr -d ' ')

    if [[ "$DRY_RUN" == "true" ]]; then
        echo "Would add $count new entries:"
        echo "$new_users" | sed 's/^/@/'
    else
        # Append new usernames with @ prefix
        echo "$new_users" | sed 's/^/@/' >> "$KEYWORDS_FILE"
        echo "Added $count new entries to $KEYWORDS_FILE"
    fi
}

main
