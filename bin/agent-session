#!/usr/bin/env python3
"""Change agent session lifecycle state; `agent-find @+handle` is the read-only view.

park/resume/retire keep durable records outside scratchpads. A per-session lease,
held by the running Pi process, stops manual and automatic resumes from running
one transcript twice. Resume refuses unless memory pressure is normal.

repair-inbox validates retained identity evidence, then previews or explicitly
reconstructs an empty inbox. No liveness inference, transcript hydration, or execution.
A killed --apply can leave a hidden .agent-session-* staging directory in the
scratchpad root; it is never published and can be removed by hand.
Roots must already exist, be absolute, and contain no symlink components.
"""
import argparse
from contextlib import contextmanager
import ctypes
from datetime import datetime
import errno
import json
import os
from pathlib import Path
import re
import shutil
import stat
import sys
import uuid


UUID = re.compile(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}")
HANDLE = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")
LIMIT = 65536
DIRECTORY = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW


def absolute(value, expand=True):
    # Header-derived paths are stored verbatim, so a `~` there must not be reinterpreted.
    value = os.path.expanduser(value) if expand else value
    if (not value.startswith('/') or any(ord(c) < 32 or ord(c) == 127 for c in value)
            or value.splitlines() != [value]
            or any(part in ('.', '..') for part in value.split('/'))):
        raise ValueError(f'unsafe absolute path: {value!r}')
    return Path(value)


@contextmanager
def directory(path):
    # Component-wise opens pin directories, rather than check then follow a link.
    fd = os.open('/', DIRECTORY)
    try:
        for part in path.parts[1:]:
            child = os.open(part, DIRECTORY, dir_fd=fd)
            os.close(fd)
            fd = child
        yield fd
    finally:
        os.close(fd)


@contextmanager
def child_directory(fd, name):
    child = os.open(name, DIRECTORY, dir_fd=fd)
    try:
        yield child
    finally:
        os.close(child)


def read_bounded(fd, name, first_line=False, limit=LIMIT):
    file = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
    with os.fdopen(file, 'rb') as stream:
        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
            raise ValueError(f'not a regular file: {name}')
        data = stream.readline(limit + 1) if first_line else stream.read(limit + 1)
    if len(data) > limit:
        raise ValueError(f'metadata exceeds {limit} bytes: {name}')
    return data.decode('utf-8')


def unique_keys(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f'duplicate JSON key: {key}')
        result[key] = value
    return result


def identity(fd, handle):
    sid = read_bounded(fd, handle, limit=128).rstrip('\n')
    if not UUID.fullmatch(sid):
        raise ValueError('identity claim must contain one complete UUID')
    for name in os.listdir(fd):
        if name.startswith('.') or name == handle:
            continue
        other = read_bounded(fd, name, limit=128).rstrip('\n')
        if other.lower() == sid.lower():
            raise ValueError(f'ambiguous identity: {handle} and {name}')
    return sid


def transcripts(fd, prefix=Path()):
    for name in sorted(os.listdir(fd)):
        mode = os.stat(name, dir_fd=fd, follow_symlinks=False).st_mode
        if stat.S_ISLNK(mode):
            raise ValueError(f'linked session evidence: {prefix / name}')
        if stat.S_ISDIR(mode):
            with child_directory(fd, name) as child:
                yield from transcripts(child, prefix / name)
        elif name.endswith('.jsonl'):
            header = json.loads(read_bounded(fd, name, first_line=True), object_pairs_hook=unique_keys)
            if not isinstance(header, dict) or header.get('type') != 'session':
                raise ValueError(f'invalid session header: {prefix / name}')
            yield prefix / name, header


def retained_session(fd, sid):
    matches = []
    for path, header in transcripts(fd):
        file_id = path.stem.rpartition('_')[2]
        header_id = header.get('id')
        if sid.lower() not in (file_id.lower(), header_id.lower() if isinstance(header_id, str) else ''):
            continue
        if not isinstance(header_id, str) or not UUID.fullmatch(header_id):
            raise ValueError(f'invalid header UUID: {path}')
        if file_id != sid or header_id != sid:
            raise ValueError(f'header/filename/registry UUID mismatch: {path}')
        version = header.get('version', 1)
        if type(version) is not int or version not in (1, 2, 3):
            raise ValueError(f'unsupported session version: {path}')
        timestamp = header.get('timestamp')
        if not isinstance(timestamp, str):
            raise ValueError(f'missing session timestamp: {path}')
        parsed = datetime.fromisoformat(timestamp.replace('Z', '+00:00'))
        if parsed.tzinfo is None or path.name != f"{timestamp.replace(':', '-').replace('.', '-')}_{sid}.jsonl":
            raise ValueError(f'header/filename timestamp mismatch: {path}')
        cwd = header.get('cwd')
        if not isinstance(cwd, str):
            raise ValueError(f'missing session cwd: {path}')
        absolute(cwd, expand=False)
        matches.append((path, header))
    if len(matches) != 1:
        raise ValueError(f'expected exactly one retained transcript; found {len(matches)}')
    return matches[0]


def pad_state(fd, handle, sid, session_file, cwd):
    canonical = f'{handle}-{sid[:8]}'
    bases = {handle, handle.rpartition('-of-')[0] or handle}
    candidates = []
    for name in os.listdir(fd):
        if (any(name == base or name.startswith(base + '-') for base in bases)
                or name.endswith('-' + sid)):
            candidates.append(name)
    if not candidates:
        return 'missing'
    if candidates != [canonical]:
        raise ValueError(f'conflicting scratchpads/aliases: {sorted(candidates)}')
    with child_directory(fd, canonical) as pad:
        text = read_bounded(pad, 'session.md')
        for key, value in [('session', sid), ('session file', str(session_file)), ('cwd', cwd)]:
            values = [line[len(key) + 4:] for line in text.splitlines() if line.startswith(f'- {key}: ')]
            if values != [value]:
                raise ValueError(f'existing session.md has conflicting {key} metadata')
        with child_directory(pad, 'inbox') as inbox:
            for name in ('new', 'cur'):
                with child_directory(inbox, name):
                    pass
    return 'existing'


def roots():
    scratch = absolute(os.environ.get('AGENT_SCRATCH_ROOT', '~/.local/state/agent/scratchpads'))
    mail = absolute(os.environ.get('AGENT_MAIL_ROOT', str(scratch)))
    if mail != scratch:
        raise ValueError('AGENT_MAIL_ROOT and AGENT_SCRATCH_ROOT must agree for this command')
    return (absolute(os.environ.get('AGENT_IDENTITIES_DIR', '~/.pi/agent/identities/by-name')),
            absolute(os.environ.get('PI_SESSIONS_DIR', '~/.pi/agent/sessions')), scratch)


def collect_evidence(handle, registry, sessions, scratch):
    with directory(registry) as claims:
        sid = identity(claims, handle)
    with directory(sessions) as retained:
        path, header = retained_session(retained, sid)
    session_file = absolute(str(sessions / path), expand=False)
    cwd = header['cwd']
    try:
        with directory(absolute(cwd, expand=False)):
            cwd_exists = True
    except (FileNotFoundError, NotADirectoryError, PermissionError):
        # macOS reports O_NOFOLLOW|O_DIRECTORY on a link as ENOTDIR; links remain refused.
        if any(os.path.islink(p) for p in (cwd, *map(str, Path(cwd).parents))):
            raise ValueError(f'linked session cwd: {cwd}')
        cwd_exists = False
    with directory(scratch) as pads:
        status = pad_state(pads, handle, sid, session_file, cwd)
    pad = scratch / f'{handle}-{sid[:8]}'
    return dict(handle='@+' + handle, sessionId=sid, sessionFile=str(session_file),
                version=header.get('version', 1), timestamp=header['timestamp'], cwd=cwd,
                cwdExists=cwd_exists, scratchpad=str(pad), inbox=str(pad / 'inbox'),
                status=status)


def publisher():
    libc = ctypes.CDLL(None, use_errno=True)
    if sys.platform == 'darwin':
        # macOS SDK sys/stdio.h: RENAME_EXCL = 0x00000004 (including directories).
        function, flag = getattr(libc, 'renameatx_np', None), 4
    elif sys.platform.startswith('linux'):
        # Linux renameat2(2): RENAME_NOREPLACE = (1 << 0).
        function, flag = getattr(libc, 'renameat2', None), 1
    else:
        function = None
    if function is None or not shutil.rmtree.avoids_symlink_attacks:
        raise ValueError('safe no-clobber directory publication is unsupported on this platform')
    function.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    function.restype = ctypes.c_int

    def publish(source_fd, source, target_fd, target):
        if function(source_fd, os.fsencode(source), target_fd, os.fsencode(target), flag):
            error = ctypes.get_errno()
            raise OSError(error, os.strerror(error), target)
    return publish


def repair(handle, locations, evidence):
    publish = publisher()

    def recheck():
        current = collect_evidence(handle, *locations)
        if dict(current, status=evidence['status']) != evidence:
            raise ValueError('session evidence changed during repair; retry inspection')
        return current

    scratch = locations[2]
    canonical = Path(evidence['scratchpad']).name
    with directory(scratch) as root:
        info = os.fstat(root)
        if info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError('repair requires an owned, private scratchpad root (mode 0700)')
        # Existing prune discovery looks for session.md directly below the root.
        stage = '.agent-session-' + uuid.uuid4().hex
        os.mkdir(stage, 0o700, dir_fd=root)
        try:
            with child_directory(root, stage) as holder:
                os.mkdir('ready', 0o700, dir_fd=holder)
                with child_directory(holder, 'ready') as pad:
                    os.mkdir('inbox', 0o700, dir_fd=pad)
                    with child_directory(pad, 'inbox') as inbox:
                        os.mkdir('new', 0o700, dir_fd=inbox)
                        os.mkdir('cur', 0o700, dir_fd=inbox)
                    # No invented display name: recoverName treats a '# ' heading as an assignment.
                    text = ('Empty reconstruction by agent-session. No messages or notes were recovered.\n'
                            'No heartbeat, live process, or authorization to execute is implied.\n\n'
                            f"- handle: {evidence['handle']}\n- session: {evidence['sessionId']}\n"
                            f"- session file: {evidence['sessionFile']}\n- cwd: {evidence['cwd']}\n")
                    file = os.open('session.md', os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600, dir_fd=pad)
                    with os.fdopen(file, 'w', encoding='utf-8') as stream:
                        stream.write(text)
                        stream.flush()
                        os.fsync(stream.fileno())
                    # A crash must not publish a pad whose metadata was never written.
                    with child_directory(pad, 'inbox') as inbox:
                        for name in ('new', 'cur'):
                            with child_directory(inbox, name) as synced:
                                os.fsync(synced)
                        os.fsync(inbox)
                    os.fsync(pad)
                current = recheck()
                if current['status'] == 'existing':
                    return current
                with directory(scratch) as current_root:
                    if not os.path.samestat(info, os.fstat(current_root)):
                        raise ValueError('scratchpad root changed during repair')
                # Startup/pruning do not share a lock. EXCL prevents replacing even an
                # empty destination; it cannot serialize concurrent alias creation or prune.
                try:
                    publish(holder, 'ready', root, canonical)
                    os.fsync(root)
                except OSError as error:
                    if error.errno not in (errno.EEXIST, errno.ENOTEMPTY):
                        raise
                    current = recheck()
                    if current['status'] != 'existing':
                        raise ValueError('competing destination disappeared during repair')
                    return current
        finally:
            shutil.rmtree(stage, dir_fd=root)
    try:
        result = recheck()
    except ValueError as error:
        raise ValueError(f"published {evidence['scratchpad']}, but {error}; rerun to verify") from error
    if result['status'] != 'existing':
        raise ValueError('published pad disappeared; concurrent pruning may be active')
    result['status'] = 'reconstructed'
    return result



WAKE_GRACE = 600
JOB_KEYS = {'command', 'cwd', 'reason', 'restart'}


def state_root():
    root = absolute(os.environ.get('AGENT_SESSION_STATE', '~/.local/state/agent/sessions'))
    # Parking records must outlive scratchpad pruning, so they live beside, not inside, pads.
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = root.lstat()
    if stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError(f'session state root must be a private owned directory: {root}')
    return root


@contextmanager
def locked(sid):
    import fcntl
    root = state_root()
    fd = os.open(root / f'{sid}.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield root
    finally:
        os.close(fd)


def load(path, default=None):
    try:
        return json.loads(path.read_text(encoding='utf-8'))
    except FileNotFoundError:
        return default


def save(path, value):
    temporary = path.with_name(f'.{path.name}.{uuid.uuid4().hex}')
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w', encoding='utf-8') as stream:
        stream.write(value if isinstance(value, str) else json.dumps(value, indent=2, sort_keys=True) + '\n')
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, path)


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


def lease_holder(root, sid):
    try:
        pid = int((root / f'{sid}.lease').read_text().strip())
    except (FileNotFoundError, ValueError):
        return None
    return pid if alive(pid) else None


def now():
    return datetime.now().astimezone().isoformat(timespec='seconds')


def handle_for(sid, registry):
    if not UUID.fullmatch(sid):
        raise ValueError('expected a complete session UUID')
    with directory(registry) as claims:
        names = [name for name in os.listdir(claims) if not name.startswith('.')
                 and read_bounded(claims, name, limit=128).rstrip('\n').lower() == sid.lower()]
        if len(names) != 1:
            raise ValueError(f'expected one registered handle for {sid}; found {len(names)}')
        identity(claims, names[0])
    return names[0]


def started(sid, pid):
    with locked(sid) as root:
        holder = lease_holder(root, sid)
        if holder not in (None, pid):
            return dict(sessionId=sid, status='conflict', leaseHolder=holder)
        save(root / f'{sid}.lease', f'{pid}\n')
        record = load(root / f'{sid}.json')
        if record and record['state'] in ('parked', 'waking'):
            record.update(state='awake', awakeAt=now())
            save(root / f'{sid}.json', record)
        return dict(sessionId=sid, status='leased', state=record['state'] if record else None)


def exited(sid, pid):
    with locked(sid) as root:
        if lease_holder(root, sid) == pid or not lease_holder(root, sid):
            (root / f'{sid}.lease').unlink(missing_ok=True)
        return dict(sessionId=sid, status='released')


def validate_jobs(jobs):
    if not isinstance(jobs, list):
        raise ValueError('jobs must be a list; use [] when no background jobs were running')
    for job in jobs:
        if not isinstance(job, dict) or set(job) != JOB_KEYS or not isinstance(job['restart'], bool) \
                or not all(isinstance(job[key], str) and job[key].strip() for key in JOB_KEYS - {'restart'}):
            raise ValueError('each job needs command, cwd, reason, and boolean restart')
    return jobs


def park(sid, pid, request):
    registry, sessions, scratch = roots()
    handle = handle_for(sid, registry)
    evidence = collect_evidence(handle, registry, sessions, scratch)
    if evidence['status'] != 'existing':
        raise ValueError('parking needs an existing scratchpad; run repair-inbox first')
    jobs = validate_jobs(request.get('jobs'))
    notes = request.get('notes')
    if not isinstance(notes, str) or not notes.strip():
        raise ValueError('notes must describe what to do after waking')
    with locked(sid) as root:
        if lease_holder(root, sid) != pid:
            raise ValueError('only the running session that holds the lease can park itself')
        record = load(root / f'{sid}.json', {})
        if record.get('state') == 'retired':
            raise ValueError('session is retired')
        lines = [f'# Parked {now()}', '', 'Written by park_session. Jobs are listed for judgment, never replayed automatically.', '', '## Jobs stopped before parking', '']
        lines += [f"- restart={'yes' if j['restart'] else 'no'} · `{j['command']}` in `{j['cwd']}` — {j['reason']}" for j in jobs] or ['- none']
        lines += ['', '## Notes for waking', '', notes.strip(), '']
        notes_path = Path(evidence['scratchpad']) / 'parked.md'
        save(notes_path, '\n'.join(lines))
        record = dict(record, handle='@+' + handle, sessionId=sid, sessionFile=evidence['sessionFile'],
                      cwd=evidence['cwd'], state='parked', wake=True, parkedAt=now(),
                      notes=str(notes_path), jobs=len(jobs))
        save(root / f'{sid}.json', record)
        return record


def retire(handle):
    registry = roots()[0]
    with directory(registry) as claims:
        sid = identity(claims, handle)
    with locked(sid) as root:
        record = load(root / f'{sid}.json', {})
        record.update(handle='@+' + handle, sessionId=sid, state='retired', wake=False, retiredAt=now())
        save(root / f'{sid}.json', record)
        return record


def memory_pressure():
    if sys.platform != 'darwin':
        return 1
    import subprocess
    return int(subprocess.run(['sysctl', '-n', 'kern.memorystatus_vm_pressure_level'],
                              capture_output=True, text=True, check=True).stdout)


def resume(handle, tmux_session, dry_run):
    import shlex
    import subprocess
    locations = roots()
    evidence = collect_evidence(handle, *locations)
    sid = evidence['sessionId']
    with locked(sid) as root:
        record = load(root / f'{sid}.json')
        if not record or record['state'] not in ('parked', 'waking') or not record.get('wake'):
            raise ValueError(f"not parked for waking (state: {record['state'] if record else 'none'})")
        if record['state'] == 'waking':
            age = datetime.now().astimezone() - datetime.fromisoformat(record['wakingAt'])
            if age.total_seconds() < WAKE_GRACE:
                raise ValueError('a wake is already in progress')
        if record['sessionFile'] != evidence['sessionFile'] or record['cwd'] != evidence['cwd']:
            raise ValueError('parking record no longer matches session evidence')
        holder = lease_holder(root, sid)
        if holder:
            raise ValueError(f'session is already running (pid {holder})')
        if not evidence['cwdExists']:
            raise ValueError('stored cwd is missing; recover it explicitly before waking')
        if evidence['status'] != 'existing':
            raise ValueError('scratchpad is missing; run repair-inbox first')
        pressure = memory_pressure()
        if pressure != 1:
            raise ValueError(f'memory pressure is {pressure}; defer this wake')
        mailbox = Path(evidence['scratchpad']).name
        prompt = (f"You were parked and have been woken by agent-session. Read {record['notes']} for the jobs "
                  f"you stopped and your notes. Then read your mail with `agent-mail read --to {mailbox}`. "
                  'Restart a job only if it is still needed.')
        command = ['tmux', 'new-window', '-d', '-t', tmux_session + ':', '-n', handle, '-c', evidence['cwd'],
                   shlex.join(['pi', '--session', evidence['sessionFile'], prompt])]
        if dry_run:
            return dict(record, status='would-wake', command=command)
        if subprocess.run(['tmux', 'has-session', '-t', tmux_session], capture_output=True).returncode:
            raise ValueError(f'tmux session does not exist: {tmux_session}')
        record.update(state='waking', wakingAt=now())
        save(root / f'{sid}.json', record)
        try:
            subprocess.run(command, check=True, capture_output=True, text=True)
        except subprocess.CalledProcessError as error:
            record.update(state='parked')
            save(root / f'{sid}.json', record)
            raise ValueError(f'tmux launch failed: {error.stderr.strip()}') from error
        return dict(record, status='waking')


def exact_handle(value):
    if not value.startswith('@+') or not HANDLE.fullmatch(value[2:]):
        raise ValueError('expected an exact @+handle')
    return value[2:]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    command = commands.add_parser('repair-inbox', help='preview or reconstruct a missing empty inbox')
    command.add_argument('handle', help='exact registered @+handle; aliases are not resolved')
    command.add_argument('--apply', action='store_true', help='publish an empty private pad without replacing anything')
    command = commands.add_parser('resume', help='reopen a parked session in a detached tmux window')
    command.add_argument('handle')
    command.add_argument('--tmux-session', required=True)
    command.add_argument('--dry-run', action='store_true')
    commands.add_parser('retire', help='never wake this session again').add_argument('handle')
    for name in ('started', 'exited', 'park'):
        # Called by the Pi extension for its own process, not by hand.
        command = commands.add_parser(name)
        command.add_argument('session_id')
        command.add_argument('--pid', type=int, required=True)
    for command in commands.choices.values():
        command.add_argument('--json', action='store_true')
    args = parser.parse_args()
    try:
        if args.command == 'repair-inbox':
            handle = exact_handle(args.handle)
            locations = roots()
            result = collect_evidence(handle, *locations)
            if result['status'] == 'missing':
                result = repair(handle, locations, result) if args.apply else dict(result, status='would-reconstruct')
            result = {key: result[key] for key in ('handle', 'sessionId', 'status', 'scratchpad', 'cwd', 'cwdExists')}
        elif args.command == 'resume':
            result = resume(exact_handle(args.handle), args.tmux_session, args.dry_run)
        elif args.command == 'retire':
            result = retire(exact_handle(args.handle))
        elif args.command == 'started':
            result = started(args.session_id, args.pid)
        elif args.command == 'exited':
            result = exited(args.session_id, args.pid)
        else:
            result = park(args.session_id, args.pid, json.load(sys.stdin))
        if args.json:
            print(json.dumps(result, sort_keys=True))
        else:
            for key, value in result.items():
                print(f'{key}: {value}')
        return 3 if result.get('status') == 'conflict' else 0
    except (OSError, ValueError, RecursionError) as error:
        print(f'agent-session: {error}', file=sys.stderr)
        return 2

if __name__ == '__main__':
    sys.exit(main())
