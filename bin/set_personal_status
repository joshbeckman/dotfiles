#!/bin/sh
# Token comes from the encrypted `s` store, not a plaintext file. The wrapper
# supplies the Keychain password source itself so callers that never sourced
# .zshrc (launchd, cron, detached agents) still work.

if [ -z "$1" ]; then
  echo "Usage: $0 <status>"
  exit 1
fi

: "${S_KEY:=!security find-generic-password -s s-secrets -w}"
export S_KEY

exec s PERSONAL_MCP_WRITE_TOKEN -- sh -c '
  status="$1"
  curl https://joshbeckman--5ffab9e262b911f09d000224a6c84d84.web.val.run/update \
    -X POST -F "status=\"$status\"" -F "write_password=$PERSONAL_MCP_WRITE_TOKEN" --silent
' sh "$*"
