#!/usr/bin/env bash
set -euo pipefail

mode="${0##*/git-pr-}"
case "$mode" in
  url|view|checks|merged) ;;
  *) printf 'git-pr-lookup: invoke as git pr-url, git pr-view, git pr-checks, or git pr-merged\n' >&2; exit 2 ;;
esac

usage() {
  case "$mode" in
    url) printf 'Usage: git pr-url [PR_URL|PR_NUMBER|BRANCH]\n' ;;
    view) printf 'Usage: git pr-view [PR_URL|PR_NUMBER|BRANCH]\n' ;;
    checks) printf 'Usage: git pr-checks [PR_URL|PR_NUMBER|BRANCH] [--required]\n' ;;
    merged) printf 'Usage: git pr-merged [PR_URL|PR_NUMBER|BRANCH]\n' ;;
  esac
}

die() {
  printf 'git pr-%s: %s\n' "$mode" "$*" >&2
  exit 1
}

for arg in "$@"; do
  case "$arg" in -h|--help) usage; exit 0 ;; esac
done

selector=""
required=false
for arg in "$@"; do
  case "$arg" in
    --required) required=true ;;
    -*) die "unknown option: $arg" ;;
    *) [[ -z "$selector" ]] || die 'accepts at most one PR selector'; selector="$arg" ;;
  esac
done
[[ "$mode" == checks || "$required" == false ]] || die '--required is only valid for pr-checks'

helper="$(cd "$(dirname "$0")" && pwd)/lib/pr_lookup.rb"
routing="$(ruby "$helper" route "$selector")" || exit 1
IFS=$'\t' read -r provider host repo <<<"$routing"
if [[ "$provider" == native ]]; then
  exec ruby "$helper" lookup "$host" "$repo" "$mode" "$selector" "$required"
fi

if [[ "$provider" == github ]]; then
  export GH_HOST="${host#https://}"
  unset GH_REPO
  export GW_REPO="$GH_HOST/$repo"
  case "$mode" in
    url) exec gw pr-url ${selector:+"$selector"} ;;
    view)
      url="$(gw pr-url ${selector:+"$selector"})" || die 'could not resolve the GitHub pull request'
      # Full markdown for an agent to read, when the `gh view-md` extension is installed.
      # Otherwise `gh pr view`, which needs no extension. No `--comments` either way: on gh
      # 2.103.3 it prints nothing and exits 0.
      #
      # `--max-diff 0` leaves the patch out and lists changed file names instead. The patch is
      # the bulk of the render and the caller's own checkout has it; reading it costs tokens on
      # every later turn of a session. Extensions before the flag get the plain render.
      if gh extension list 2>/dev/null | grep -q '^gh view-md'; then
        if gh view-md --help 2>/dev/null | grep -q -- '--max-diff'; then
          exec gh view-md --max-diff 0 "$url"
        fi
        exec gh view-md "$url"
      fi
      exec gh pr view "$url"
      ;;
    checks)
      args=()
      [[ -n "$selector" ]] && args+=("$selector")
      $required && args+=(--required)
      exec gw pr-checks "${args[@]}"
      ;;
    merged) exec gw pr-merged ${selector:+"$selector"} ;;
  esac
fi

die "unsupported provider: $provider"
