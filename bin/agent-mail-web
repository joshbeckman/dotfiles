#!/usr/bin/env python3
"""Loopback UI for Agent Mail. No database; the CLI owns delivery and archive."""
import argparse
import base64
import fcntl
import hashlib
import hmac
import json
import mimetypes
import math
import os
from pathlib import Path
import re
import secrets
import stat
import subprocess
import sys
import tempfile
import time
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import parse_qs, urlsplit
import urllib.request
import webbrowser
import xml.etree.ElementTree as ET

ROOT = Path(__file__).resolve().parent.parent
ASSETS = ROOT / 'apps/agent-mail-web'
CLI = ROOT / 'bin/agent-mail'
MAX_MESSAGE = 2 * 1024 * 1024
MAX_IMAGE = 5 * 1024 * 1024
MAX_AVATAR = 100 * 1024
FOLDERS = {'inbox': 'inbox/new', 'archive': 'inbox/cur', 'sent': 'sent', 'drafts': 'drafts'}


class MailError(Exception):
    def __init__(self, message, status=400):
        super().__init__(message)
        self.status = status


def cli(*args):
    result = subprocess.run([str(CLI), *map(str, args)], capture_output=True, text=True, timeout=30)
    if result.returncode:
        raise MailError(result.stderr.strip() or 'Agent Mail command failed')
    return result.stdout.strip()


def local_keywords():
    path = Path(os.environ.get('XDG_CONFIG_HOME', '~/.config')).expanduser() / 'nvim/keywords.txt'
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except FileNotFoundError:
        return {'available': False, 'words': []}
    with os.fdopen(fd, 'rb') as source:
        if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
            raise MailError('Keyword dictionary must be a regular file')
        raw = source.read(1024 * 1024 + 1)
    if len(raw) > 1024 * 1024:
        raise MailError('Keyword dictionary exceeds 1 MiB')
    words = list(dict.fromkeys(raw.decode('utf-8').split()))
    if len(words) > 10000 or any(len(word) > 256 for word in words):
        raise MailError('Keyword dictionary exceeds 10,000 words or 256 characters per word')
    return {'available': True, 'words': words}


def atomic_write(path, data):
    fd, tmp = tempfile.mkstemp(prefix='.web-', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def parse_mail(path):
    raw = path.read_bytes()
    if len(raw) > MAX_MESSAGE:
        raise MailError('Message exceeds the 2 MiB reader limit')
    text = raw.decode('utf-8', errors='replace')
    header, _, body = text.partition('\n\n')
    fields = {}
    for line in header.splitlines():
        key, sep, value = line.partition(':')
        if sep:
            fields.setdefault(key.lower(), value.strip())
    return {'id': fields.get('message-id', path.stem),
            'thread': fields.get('thread-id') or fields.get('in-reply-to') or fields.get('message-id', path.stem),
            'parent': fields.get('in-reply-to', ''), 'from': fields.get('from', ''),
            'to': fields.get('to', ''), 'subject': fields.get('subject', ''),
            'date': fields.get('date', ''), 'body': body,
            'revision': hashlib.sha256(raw).hexdigest()}


def address_key(address):
    value = address.strip().casefold()
    if value == 'josh':
        return ('human', 'josh')
    if value.startswith('humans/'):
        return ('human', value[7:])
    if value.startswith('@') and not value.startswith('@+'):
        return ('human', value[1:])
    if not value.startswith('@+') and '@' in value:
        return ('human', value.split('@')[0])
    return ('agent', re.sub(r'-[0-9a-f]{8}$', '', re.sub(r'^@\+|^\+', '', value)))


def avatar_svg(raw):
    # Re-serialize an allowlisted drawing, rather than trusting SVG as a document:
    # direct navigation must be as inert as rendering it through an <img>.
    text = raw.decode('utf-8')
    if re.search(r'<!DOCTYPE|<!ENTITY', text, re.I):
        raise ValueError('SVG declarations are not supported')
    svg = ET.fromstring(text)
    namespace = '{http://www.w3.org/2000/svg}'
    if svg.tag != namespace + 'svg':
        raise ValueError('Expected SVG')
    box = [float(n) for n in re.split(r'[\s,]+', svg.get('viewBox', '').strip())]
    if len(box) != 4 or not all(math.isfinite(n) and abs(n) <= 1e6 for n in box) or min(box[2:]) <= 0:
        raise ValueError('Expected a finite viewBox')
    tags = {'svg', 'g', 'path', 'rect', 'circle', 'ellipse', 'line', 'polyline', 'polygon',
            'defs', 'linearGradient', 'radialGradient', 'stop', 'clipPath', 'title', 'desc'}
    attrs = {'viewBox', 'width', 'height', 'x', 'y', 'x1', 'y1', 'x2', 'y2', 'cx', 'cy',
             'r', 'rx', 'ry', 'd', 'points', 'fill', 'stroke', 'stroke-width', 'stroke-linecap',
             'stroke-linejoin', 'stroke-miterlimit', 'stroke-dasharray', 'stroke-dashoffset',
             'fill-rule', 'clip-rule', 'clip-path', 'opacity', 'fill-opacity', 'stroke-opacity',
             'transform', 'id', 'offset', 'stop-color', 'stop-opacity', 'gradientUnits',
             'gradientTransform', 'spreadMethod', 'fx', 'fy', 'fr', 'preserveAspectRatio',
             'role', 'aria-label'}
    paints = {'fill', 'stroke', 'stop-color', 'clip-path'}
    color = r'(?:#[0-9a-fA-F]{3,8}|[A-Za-z]+|(?:rgb|hsl)a?\([0-9.,%+\-\s]+\)|url\(#[A-Za-z_][A-Za-z0-9_.-]*\))'
    allowed_tags = {namespace + tag for tag in tags}
    nodes = list(svg.iter())
    if len(nodes) > 256:
        raise ValueError('Too many SVG elements')
    for node in nodes:
        if node.tag not in allowed_tags or (node is not svg and node.tag == namespace + 'svg'):
            raise ValueError('Unsupported SVG element')
        for key, value in node.attrib.items():
            if len(value.encode('utf-8')) > 8192 or key not in attrs or (key in paints and not re.fullmatch(color, value)):
                raise ValueError('Unsupported SVG attribute')
            if key not in paints and ('url' in value.lower() or '\\' in value):
                raise ValueError('SVG resources are not supported')
    svg.set('width', '256')
    svg.set('height', '256')
    return ET.tostring(svg, encoding='utf-8')


class Mailbox:
    def __init__(self):
        human_root = Path(os.environ.get('AGENT_HUMAN_MAIL_ROOT', '~/.local/state/agent-mail/humans')).expanduser()
        (human_root / 'josh').mkdir(parents=True, mode=0o700, exist_ok=True)
        self.home = Path(cli('addr', '@josh')).parent.resolve()
        self.cache = {}
        for folder in FOLDERS:
            self.directory(folder)
        self.attachments = self.home / 'attachments'
        self.attachments.mkdir(mode=0o700, exist_ok=True)
        if self.attachments.is_symlink():
            raise MailError('Attachment directory must not be a symlink')

    def directory(self, folder):
        if folder not in FOLDERS:
            raise MailError('Unknown folder')
        path = self.home / FOLDERS[folder]
        path.mkdir(parents=True, mode=0o700, exist_ok=True)
        if path.is_symlink() or not path.resolve().is_relative_to(self.home):
            raise MailError('Folder escapes the mailbox')
        return path

    def path(self, key, folder=None):
        parts = key.split(':') if isinstance(key, str) else []
        if len(parts) != 2 or (folder and parts[0] != folder):
            raise MailError('Invalid message key')
        group, name = parts
        if not re.fullmatch(r'[A-Za-z0-9_.@+\-]+\.md', name) or name.startswith('.'):
            raise MailError('Invalid message name')
        path = self.directory(group) / name
        if path.is_symlink() or not path.is_file():
            raise MailError('Message no longer exists; refresh the inbox or check Sent', 404)
        return path

    def message(self, key):
        path = self.path(key)
        stat = path.stat()
        stamp = (stat.st_mtime_ns, stat.st_size, stat.st_ino)
        cached = self.cache.get(key)
        if not cached or cached[0] != stamp:
            self.cache[key] = (stamp, dict(parse_mail(path), key=key, folder=key.split(':')[0]))
        return dict(self.cache[key][1])

    def messages(self, thread=None):
        messages, warnings, present = [], [], set()
        for folder in FOLDERS:
            for path in self.directory(folder).glob('*.md'):
                key = folder + ':' + path.name
                present.add(key)
                try:
                    if thread is not None:
                        # Keep checking external edits/new files without revalidating
                        # every cached, unrelated message's parent directory.
                        info = path.lstat()
                        cached = self.cache.get(key)
                        stamp = (info.st_mtime_ns, info.st_size, info.st_ino)
                        if (stat.S_ISREG(info.st_mode) and cached and cached[0] == stamp
                                and cached[1]['thread'] != thread):
                            continue
                    if path.stat().st_size > MAX_MESSAGE:
                        raise MailError('Message exceeds the 2 MiB reader limit')
                    message = self.message(key)
                    if thread is None or message['thread'] == thread:
                        messages.append(message)
                except (MailError, OSError) as e:
                    warnings.append(f'{path.name}: {e}')
        self.cache = {k: v for k, v in self.cache.items() if k in present}
        return sorted(messages, key=lambda m: (m['date'], m['key']), reverse=True), warnings

    def listing(self, folder, query):
        messages, warnings = self.messages()
        if folder not in (*FOLDERS, 'all'):
            raise MailError('Unknown folder')
        counts = {f: sum(m['folder'] == f for m in messages) for f in FOLDERS}
        words, people = [], []
        for word in query.casefold().split():
            if word.startswith('with:'):
                address = word[5:]
                if not re.fullmatch(r'@?\+?[A-Za-z0-9._-]+', address):
                    raise MailError('Use with:@+agent-handle or with:@human for contact searches')
                people.append(address_key(address))
            else:
                words.append(word)
        matches = []
        for m in messages:
            if folder != 'all' and m['folder'] != folder:
                continue
            text = '\n'.join(m[k] for k in ('from', 'to', 'subject', 'body')).casefold()
            participants = {address_key(a) for a in (m['from'] + ',' + m['to']).split(',') if a.strip()}
            if all(w in text for w in words) and all(p in participants for p in people):
                matches.append(m)
        return {'messages': [dict((k, v) for k, v in m.items() if k != 'body') |
                             {'excerpt': re.sub(r'\s+', ' ', m['body'])[:180]} for m in matches],
                'counts': counts, 'warnings': warnings}

    def thread(self, key):
        selected = self.message(key)
        messages, _ = self.messages(thread=selected['thread'])
        unique = {}
        for m in messages:
            if m['folder'] != 'drafts' and m['thread'] == selected['thread']:
                old = unique.get(m['id'])
                if not old or m['folder'] == 'inbox':
                    unique[m['id']] = m
        return sorted(unique.values(), key=lambda m: (m['date'], m['id']))

    def draft(self, mode, key=None):
        if mode not in ('compose', 'reply', 'reply-all'):
            raise MailError('Unknown draft mode')
        if mode == 'compose':
            path = Path(cli('compose'))
        else:
            source = self.message(key)
            # A reply to our Sent message goes to its recipients, not back to Josh.
            if mode == 'reply' and source['folder'] == 'sent':
                mode = 'reply-all'
            path = Path(cli(mode, self.path(key)))
        return self.message('drafts:' + path.name)

    def save(self, data):
        path = self.path(data.get('key'), 'drafts')
        current = self.message(data['key'])
        if data.get('revision') != current['revision']:
            raise MailError('Draft changed in another window or editor. Reopen it before saving.', 409)
        for field in ('to', 'subject', 'body'):
            if not isinstance(data.get(field), str):
                raise MailError('Draft fields must be text')
        if any(c in data['to'] + data['subject'] for c in '\r\n\x00'):
            raise MailError('Recipient and subject fields must be single lines')
        if len(data['to']) > 4000 or len(data['subject']) > 1000 or len(data['body']) > MAX_MESSAGE // 2:
            raise MailError('Draft is too large')
        header = path.read_text().partition('\n\n')[0]
        lines = [line for line in header.splitlines() if not line.startswith(('To:', 'Subject:', 'From:'))]
        text = '\n'.join(['From: josh', 'To: ' + data['to'], 'Subject: ' + data['subject'], *lines]) + '\n\n' + data['body']
        atomic_write(path, text.encode())
        return self.message(data['key'])

    def find_sessions(self, query=None, handle=None):
        if query is not None and (not isinstance(query, str) or len(query) > 512):
            raise MailError('Search patterns must be at most 512 characters')
        if handle is not None and not re.fullmatch(r'@?\+?[A-Za-z0-9._-]+', handle):
            raise MailError('Invalid contact handle')
        env = dict(os.environ)
        env.pop('AGENT_SCRATCHPAD', None)
        command = [str(ROOT / 'bin/agent-find'), '--json', '--limit', '30']
        command += ['--agent', handle] if handle is not None else ['--', query]
        result = subprocess.run(command, capture_output=True, text=True, timeout=30, env=env)
        if result.returncode:
            raise MailError(result.stderr.strip() or 'Agent search failed')
        return json.loads(result.stdout)

    def avatar(self, address):
        unavailable = MailError('Avatar unavailable', 404)
        raw_address = str(address).strip().lower()
        transport = re.search(r'-([0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}|[0-9a-f]{8})$', raw_address)
        kind, handle = address_key(raw_address[:transport.start()] if transport else raw_address)
        if kind != 'agent' or not re.fullmatch(r'[a-z0-9][a-z0-9._-]{0,127}', handle):
            raise unavailable
        registry = Path(os.environ.get('AGENT_IDENTITIES_DIR', '~/.pi/agent/identities/by-name')).expanduser()
        root = Path(os.environ.get('AGENT_MAIL_ROOT', os.environ.get('AGENT_SCRATCH_ROOT', '~/.local/state/agent/scratchpads'))).expanduser()
        exact = registry / handle
        if exact.exists() or exact.is_symlink():
            names = [handle]
        elif '-of-' in handle:
            names = [handle.rsplit('-of-', 1)[0]]
        else:
            names = [p.name for p in registry.glob(handle + '-of-*')]
        claims = [registry / name for name in names if (registry / name).exists() or (registry / name).is_symlink()]
        if len(claims) != 1:
            raise unavailable
        try:
            fd = os.open(claims[0], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(fd, 'rb') as source:
                if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
                    raise unavailable
                sid = source.read(129).decode('ascii').strip()
            if not re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', sid):
                raise unavailable
            if transport and transport[1] not in {sid, sid[:8]}:
                raise unavailable
            name = claims[0].name
            candidates = {root / (base + '-' + suffix)
                          for base in (name, name.rsplit('-of-', 1)[0])
                          for suffix in (sid[:8], sid)}
            pads = [p for p in candidates if p.exists() or p.is_symlink()]
            if len(pads) != 1:
                raise unavailable
            # Directory-relative opens prevent a swapped pad/file from escaping to
            # another agent's room; FIFOs and other non-files must never block us.
            directory = os.open(pads[0], os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            try:
                fd = os.open('avatar.svg', os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
            finally:
                os.close(directory)
            with os.fdopen(fd, 'rb') as source:
                if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
                    raise unavailable
                raw = source.read(MAX_AVATAR + 1)
            if len(raw) > MAX_AVATAR:
                raise unavailable
            return avatar_svg(raw)
        except (OSError, ValueError, ET.ParseError):
            raise unavailable from None

    def teams(self, query=''):
        if not isinstance(query, str) or len(query) > 512:
            raise MailError('Team searches must be at most 512 characters')
        command = [str(ROOT / 'bin/agent-team')]
        command += ['search', '--json', '--', query] if query else ['list', '--json']
        result = subprocess.run(command, capture_output=True, text=True, timeout=10)
        if result.returncode:
            raise MailError(result.stderr.strip() or 'Team lookup failed', 503)
        return json.loads(result.stdout)

    def contacts(self, query=''):
        root = Path(os.environ.get('AGENT_MAIL_ROOT', os.environ.get('AGENT_SCRATCH_ROOT', '~/.local/state/agent/scratchpads'))).expanduser()
        registry = Path(os.environ.get('AGENT_IDENTITIES_DIR', '~/.pi/agent/identities/by-name')).expanduser()
        contacts = {}
        for p in registry.glob('*'):
            if p.is_file() and not p.name.startswith('.'):
                contacts[p.name] = {'handle': '@+' + p.name, 'lastSeen': None, 'status': 'historical', 'addressable': False, 'transcriptAvailable': True}
        for pad in root.glob('*'):
            if not pad.is_dir() or pad.is_symlink():
                continue
            handle = re.sub(r'-[0-9a-f]{8}$', '', pad.name)
            entry = contacts.setdefault(handle, {'handle': '@+' + handle})
            entry.update(addressable=True, status='parked', lastSeen=None)
            heartbeat = pad / '.heartbeat'
            try:
                pid = int(heartbeat.read_text().split()[0])
                stamp = heartbeat.stat().st_mtime
                entry['lastSeen'] = stamp
                if pid > 1:
                    os.kill(pid, 0)
                    if time.time() - stamp < 600:
                        entry['status'] = 'active (heartbeat)'
            except (OSError, ValueError, IndexError):
                pass
        messages, _ = self.messages()
        for m in messages:
            for who in (m['from'] + ',' + m['to']).split(','):
                handle = re.sub(r'-[0-9a-f]{8}$', '', who.strip().lstrip('@+'))
                if not handle or handle == 'josh':
                    continue
                contacts.setdefault(handle, {'handle': who.strip(), 'status': 'historical', 'addressable': False, 'lastSeen': None})
        if query:
            results = []
            for session in self.find_sessions(query=query):
                handle = session['handle']
                contact = contacts.get(handle.lstrip('@+') if handle else '', {})
                results.append(dict(contact, handle=handle or '(unnamed session)',
                                    addressable=contact.get('addressable', False),
                                    status=session['liveness'], lastSeen=contact.get('lastSeen'), session=session))
            return results
        return sorted(contacts.values(), key=lambda c: (not c['status'].startswith('active'), not c['addressable'], c['handle']))

    def transcript(self, handle, version=None, before=None, after=None):
        match = re.fullmatch(r'(?:@\+|\+)?([a-z0-9][a-z0-9._-]{0,127})', handle or '')
        if not match:
            raise MailError('Use a registered agent handle, not a human address or file path')
        name = match[1]
        if version is not None and len(version) > 200:
            raise MailError('Invalid transcript version')
        registry = Path(os.environ.get('AGENT_IDENTITIES_DIR', '~/.pi/agent/identities/by-name')).expanduser()
        sessions = Path(os.environ.get('PI_SESSIONS_DIR', '~/.pi/agent/sessions')).expanduser()
        directory_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        file_flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
        source_fd = None
        try:
            registry_fd = os.open(registry, directory_flags)
            try:
                claim_fd = os.open(name, file_flags, dir_fd=registry_fd)
                with os.fdopen(claim_fd, 'rb') as claim:
                    if not stat.S_ISREG(os.fstat(claim.fileno()).st_mode):
                        raise MailError('Identity claim is not a regular file', 404)
                    sid = claim.read(129).decode('ascii').strip()
            finally:
                os.close(registry_fd)
            if not re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', sid):
                raise MailError('Invalid registered session ID', 404)
            root_fd = os.open(sessions, directory_flags)
            try:
                def inspect(directory):
                    nonlocal source_fd
                    for filename in os.listdir(directory):
                        if not filename.endswith('_' + sid + '.jsonl'):
                            continue
                        fd = os.open(filename, file_flags, dir_fd=directory)
                        if not stat.S_ISREG(os.fstat(fd).st_mode):
                            os.close(fd)
                            raise MailError('Transcript is not a regular file', 404)
                        if source_fd is not None:
                            os.close(fd)
                            raise MailError('Multiple transcripts match this session', 409)
                        source_fd = fd

                inspect(root_fd)
                for child in os.listdir(root_fd):
                    try:
                        child_info = os.stat(child, dir_fd=root_fd, follow_symlinks=False)
                    except FileNotFoundError:
                        continue
                    if not stat.S_ISDIR(child_info.st_mode):
                        continue
                    directory = os.open(child, directory_flags, dir_fd=root_fd)
                    try:
                        inspect(directory)
                    finally:
                        os.close(directory)
            finally:
                os.close(root_fd)
            if source_fd is None:
                raise MailError('No retained Pi transcript for this registered agent', 404)
            with os.fdopen(source_fd, 'rb') as source:
                source_fd = None
                info = os.fstat(source.fileno())
                header_line = source.readline(65536)
                if not header_line.endswith(b'\n'):
                    raise MailError('Invalid or incomplete Pi session header', 422)
                header = json.loads(header_line)
                if not isinstance(header, dict) or header.get('type') != 'session' or header.get('id') != sid:
                    raise MailError('Transcript header does not match the registered session', 422)
                header = {key: header[key] for key in ('version', 'id', 'timestamp', 'cwd') if key in header}
                stamp = ':'.join(map(str, (info.st_dev, info.st_ino, info.st_mtime_ns, info.st_size)))
                if before is None and version == stamp:
                    return {'unchanged': True, 'version': stamp, 'sessionId': sid}

                page_limit = 512 * 1024
                tail_limit = 8 * 1024 * 1024
                position, scanned, last_newline = info.st_size, 0, -1
                while position > 0 and scanned < tail_limit:
                    size = min(64 * 1024, position, tail_limit - scanned)
                    source.seek(position - size)
                    tail = source.read(size)
                    found = tail.rfind(b'\n')
                    if found >= 0:
                        last_newline = position - size + found
                        break
                    position -= size
                    scanned += size
                if last_newline < 0:
                    raise MailError('Incomplete transcript tail exceeds the read limit', 413)
                complete_end = last_newline + 1
                if complete_end < len(header_line):
                    raise MailError('Invalid or incomplete Pi session header', 422)
                end = complete_end if before is None else int(before)
                if end < 0 or end > info.st_size:
                    raise MailError('Invalid transcript page offset')
                after_offset = None if after is None else int(after)
                if after_offset is not None and after_offset < 0:
                    raise MailError('Invalid transcript live offset')

                window_start = max(len(header_line), end - page_limit)
                source.seek(window_start)
                raw = source.read(end - window_start)
                records = []
                if raw:
                    source.seek(end - 1)
                    end_is_boundary = source.read(1) == b'\n'
                    if not end_is_boundary:
                        last = raw.rfind(b'\n')
                        line_start = window_start + last + 1 if last >= 0 else window_start
                        records.append((line_start, None, end - line_start, True))
                    else:
                        source.seek(window_start - 1)
                        starts_at_boundary = window_start == len(header_line) or source.read(1) == b'\n'
                        pieces, offset = [], window_start
                        for line in raw.splitlines(keepends=True):
                            pieces.append((offset, line))
                            offset += len(line)
                        used = 0
                        for offset, line in reversed(pieces):
                            charge = max(len(line), 256)
                            if records and (used + charge > page_limit or len(records) >= 2000):
                                break
                            partial = offset == window_start and not starts_at_boundary
                            records.append((offset, None if partial or len(line) > 128 * 1024 else line,
                                            len(line), partial))
                            used += charge
                records.reverse()
                page_start = records[0][0] if records else 0
                old_file = version and version.split(':', 2)[:2] != stamp.split(':', 2)[:2]
                reset = bool(after_offset is not None and
                             (old_file or after_offset < len(header_line) or
                              after_offset > complete_end or page_start > after_offset))
                entries, skipped = [], 0
                for offset, line, size, continued in records:
                    if after_offset is not None and not reset and offset < after_offset:
                        continue
                    if line is None:
                        entry = {'type': 'transcript_oversize', 'bytes': size, 'continued': continued}
                    else:
                        try:
                            entry = json.loads(line)
                            if not isinstance(entry, dict) or not isinstance(entry.get('type'), str):
                                raise ValueError('Invalid entry')
                        except (ValueError, UnicodeDecodeError, RecursionError):
                            skipped += 1
                            continue
                    entries.append({'key': str(offset), 'entry': entry})
                return {'handle': '@+' + name, 'sessionId': sid, 'version': stamp,
                        'header': header, 'entries': entries, 'before': page_start,
                        'end': complete_end, 'reset': reset, 'skipped': skipped,
                        'partial': complete_end < info.st_size}
        except (OSError, UnicodeDecodeError):
            raise MailError('Registered transcript is unavailable or unsafe to read', 404) from None
        except (ValueError, TypeError, RecursionError):
            raise MailError('Invalid transcript header or page offset', 422) from None
        finally:
            if source_fd is not None:
                os.close(source_fd)

    def attachment(self, data):
        try:
            raw = base64.b64decode(data.get('data', ''), validate=True)
        except (ValueError, TypeError):
            raise MailError('Invalid image')
        if not raw or len(raw) > MAX_IMAGE:
            raise MailError('Images must be at most 5 MiB')
        ext = image_type(raw)
        if not ext:
            raise MailError('Only PNG, JPEG, GIF and WebP images are supported')
        name = secrets.token_hex(16) + '.' + ext
        atomic_write(self.attachments / name, raw)
        # Relative to the human mailbox, so sent and received copies can share it.
        return {'url': (self.attachments / name).as_uri()}


def image_type(raw):
    if raw.startswith(b'\x89PNG\r\n\x1a\n'):
        return 'png'
    if raw.startswith(b'\xff\xd8\xff'):
        return 'jpg'
    if raw.startswith((b'GIF87a', b'GIF89a')):
        return 'gif'
    if raw.startswith(b'RIFF') and raw[8:12] == b'WEBP':
        return 'webp'
    return None


class Handler(BaseHTTPRequestHandler):
    def setup(self):
        super().setup()
        self.connection.settimeout(10)

    def log_message(self, *_):
        pass  # Request paths can contain private search terms.

    def reply(self, status, body, mime='application/json', extra_headers=None):
        if mime == 'application/json':
            body = json.dumps(body).encode()
        self.send_response(status)
        self.send_header('Content-Type', mime)
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Cache-Control', 'no-store')
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('Referrer-Policy', 'no-referrer')
        if urlsplit(self.path).path == '/reader.html':
            images = 'data: https:' if parse_qs(urlsplit(self.path).query).get('remote') == ['1'] else 'data:'
            # The reader is sandboxed without allow-same-origin, so it has an opaque
            # origin. WebKit does not match 'self' from an opaque origin, which
            # blocked reader.js and reader.css and left Safari's message body blank
            # while Chromium, the only engine the browser test drives, passed. An
            # explicit origin matches in every engine and grants nothing 'self' did not.
            # Both schemes for the host this request arrived on: behind Tailscale Serve the
            # bridge cannot see the scheme the browser used, and naming one would break the
            # reader frame on whichever it was not. The host is already validated above.
            own = ' '.join(f'{scheme}://{self.headers.get("Host", "")}' for scheme in ('http', 'https'))
            # font-src is required here: without it fonts fall back to default-src
            # 'none', so message bodies rendered in this frame would use system
            # fonts while the surrounding app used the self-hosted ones.
            policy = f"default-src 'none'; script-src {own}; style-src {own} 'unsafe-inline'; img-src {images}; font-src {own}; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
        elif mime == 'image/svg+xml':
            policy = "sandbox; default-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        else:
            policy = "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        self.send_header('Content-Security-Policy', policy)
        for header, value in (extra_headers or {}).items():
            self.send_header(header, value)
        self.end_headers()
        self.wfile.write(body)

    def handle_request(self):
        try:
            # Loopback plus any tailnet name this machine answers to, so Tailscale Serve
            # can proxy to it without the bridge binding anywhere but 127.0.0.1.
            if self.headers.get('Host') not in self.server.authorities:
                raise MailError('Invalid Host', 403)
            url = urlsplit(self.path)
            origin = self.headers.get('Origin')
            # Opaque-origin reader frames load these public, data-free assets. The
            # frame's origin is "null", which makes its font request cross-origin
            # and its fonts.css request carry that null Origin; without the font
            # paths here both were rejected as an invalid Origin, so every message
            # body fell back to system fonts while the surrounding app used Plex.
            reader_asset = self.command == 'GET' and (
                url.path in ('/reader.js', '/reader.css', '/fonts.css')
                or re.fullmatch(r'/fonts/[a-z0-9-]+\.woff2', url.path) is not None
            )
            if not reader_asset:
                if origin and origin not in self.server.origins:
                    raise MailError('Invalid Origin', 403)
                if self.headers.get('Sec-Fetch-Site') == 'cross-site':
                    raise MailError('Cross-site requests are not allowed', 403)
            if url.path.startswith('/api/'):
                token = self.headers.get('X-Agent-Mail-Token', '')
                if not hmac.compare_digest(token, self.server.token):
                    raise MailError('Open the launch URL from agent-mail web to authorize this tab.', 403)
                if self.command == 'POST':
                    if origin not in self.server.origins or self.headers.get('Content-Type') != 'application/json':
                        raise MailError('A same-origin JSON request is required', 403)
                    length = int(self.headers.get('Content-Length', '0'))
                    if length < 1 or length > 8 * 1024 * 1024:
                        raise MailError('Request too large or empty', 413)
                    data = json.loads(self.rfile.read(length))
                    if not isinstance(data, dict):
                        raise MailError('Expected a JSON object')
                    # Separate web launches still share one mailbox and draft revisions.
                    fd = os.open(self.server.box.home / '.web-write.lock', os.O_CREAT | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
                    with os.fdopen(fd, 'w') as lock:
                        fcntl.flock(lock, fcntl.LOCK_EX)
                        return self.post(url.path, data)
                return self.get(url.path, parse_qs(url.query))
            if self.command != 'GET':
                raise MailError('Unknown endpoint', 404)
            static = {'/': 'index.html', **{'/' + name: name for name in ('app.js', 'style.css', 'fonts.css', 'vendor.js', 'composer-vendor.js', 'reader.html', 'reader.css', 'reader.js', 'transcript.html', 'transcript.css', 'transcript.js', 'favicon.svg', 'josh-avatar.png', 'manifest.webmanifest', 'sw.js', 'icon-192.png', 'icon-512.png')}}
            if url.path.startswith('/fonts/'):
                # Self-hosted so the app does not depend on fonts installed on the
                # machine; the name is whitelisted rather than joined, because a
                # path segment from the client must never reach the filesystem.
                name = url.path[len('/fonts/'):]
                if not re.fullmatch(r'[a-z0-9-]+\.woff2', name):
                    raise MailError('Not found', 404)
                p = ASSETS / 'fonts' / name
                # An absent font is a 404, not the 503 that a failed read would
                # produce; and never follow a symlink out of the asset tree.
                if p.is_symlink() or not p.is_file():
                    raise MailError('Not found', 404)
            elif url.path in static:
                p = ASSETS / static[url.path]
            else:
                raise MailError('Not found', 404)
            mime = 'application/manifest+json' if p.suffix == '.webmanifest' else mimetypes.guess_type(p)[0]
            # Fonts are always fetched in CORS mode, and from the reader frame that
            # origin is opaque, so the allowance has to be explicit. These are
            # public OFL files, so a wildcard gives nothing away.
            extra = {'Access-Control-Allow-Origin': '*'} if p.suffix == '.woff2' else None
            self.reply(200, p.read_bytes(), mime or 'application/octet-stream', extra)
        except MailError as e:
            self.reply(e.status, {'error': str(e)})
        except (ValueError, KeyError, TypeError):
            self.reply(400, {'error': 'Invalid request'})
        except (OSError, subprocess.TimeoutExpired) as e:
            self.reply(503, {'error': 'Local mail operation failed. Refresh before retrying: ' + str(e)})

    def get(self, route, args):
        box = self.server.box
        key = args.get('key', [''])[0]
        if route == '/api/messages':
            if self.headers.get('X-Agent-Mail-Notifier') == '1':
                # agent-mail reads this mtime to skip its duplicate desktop banner.
                fd = os.open(box.home / '.web-notifier', os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
                os.utime(fd)
                os.close(fd)
            result = box.listing(args.get('folder', ['inbox'])[0], args.get('q', [''])[0])
        elif route == '/api/thread':
            result = box.thread(key)
        elif route == '/api/draft':
            box.path(key, 'drafts')
            result = box.message(key)
        elif route == '/api/keywords':
            if args:
                raise MailError('Keyword dictionary paths are configured locally, not through the API')
            result = local_keywords()
        elif route == '/api/teams':
            result = box.teams(args.get('q', [''])[0])
        elif route == '/api/contacts':
            result = box.contacts(args.get('q', [''])[0])
        elif route == '/api/contact':
            result = box.find_sessions(handle=args.get('handle', [''])[0])
        elif route == '/api/transcript':
            handle = args.get('handle', [''])[0]
            version = args.get('version', [None])[0]
            before = args.get('before', [None])[0]
            after = args.get('after', [None])[0]
            result = box.transcript(handle, version, before, after)
        elif route == '/api/avatar':
            return self.reply(200, box.avatar(args.get('handle', [''])[0]), 'image/svg+xml')
        elif route == '/api/attachment':
            name = args.get('name', [''])[0]
            if not re.fullmatch(r'[0-9a-f]{32}\.(png|jpg|gif|webp)', name):
                raise MailError('Invalid attachment')
            p = box.attachments / name
            if p.is_symlink() or not p.is_file():
                raise MailError('Image unavailable', 404)
            raw = p.read_bytes()
            if len(raw) > MAX_IMAGE or not image_type(raw):
                raise MailError('Invalid image')
            return self.reply(200, raw, mimetypes.guess_type(p)[0])
        else:
            raise MailError('Unknown endpoint', 404)
        self.reply(200, result)

    def post(self, route, data):
        box = self.server.box
        if route == '/api/archive':
            path = box.path(data.get('key'), 'inbox')
            cli('archive', path)
            result = {'ok': True}
        elif route == '/api/draft':
            result = box.draft(data.get('mode'), data.get('key'))
        elif route == '/api/save':
            result = box.save(data)
        elif route == '/api/delete-draft':
            path = box.path(data.get('key'), 'drafts')
            if box.message(data['key'])['revision'] != data.get('revision'):
                raise MailError('Draft changed; reopen it before deleting.', 409)
            path.unlink()
            result = {'ok': True}
        elif route == '/api/send':
            path = box.path(data.get('key'), 'drafts')
            if box.message(data['key'])['revision'] != data.get('revision'):
                raise MailError('Draft changed; reopen it before sending.', 409)
            delivered = Path(cli('deliver', path))
            result = {'ok': True, 'key': 'sent:' + delivered.name}
        elif route == '/api/attachment':
            result = box.attachment(data)
        else:
            raise MailError('Unknown endpoint', 404)
        self.reply(200, result)

    do_GET = handle_request
    do_POST = handle_request


def tailnet_authorities():
    """Host names besides loopback this bridge should answer to.

    Tailscale Serve proxies this machine's HTTPS name to this port, so requests arrive with
    that name in the Host header. Detected rather than configured because the tailnet DNS
    name can change -- it did, once, while this was being written -- and a stale name in the
    LaunchAgent would be a 403 nobody sees. A missing or unreadable tailscale is not an
    error: the bridge is loopback-only, which stays the default on a machine without it.
    """
    try:
        result = subprocess.run(['tailscale', 'status', '--json'], capture_output=True,
                                text=True, timeout=5, check=True)
        status = json.loads(result.stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    name = ((status.get('Self') or {}).get('DNSName') or '').rstrip('.')
    return [name] if name else []


def load_token(home):
    # Persistent so an installed app, which launches without the URL fragment,
    # stays authorized across bridge restarts. Delete the file to rotate it.
    path = home / '.web-token'
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd) as f:
            info = os.fstat(f.fileno())
            if info.st_uid != os.getuid() or info.st_mode & 0o077:
                raise SystemExit(f'agent-mail-web: {path} must be private (mode 0600)')
            token = f.read().strip()
        if len(token) < 32:
            raise SystemExit(f'agent-mail-web: {path} is malformed; delete it to create a new token')
        return token
    token = secrets.token_urlsafe(32)
    with os.fdopen(fd, 'w') as f:
        f.write(token + '\n')
    return token


def existing_bridge(authority):
    try:
        with urllib.request.urlopen(f'http://{authority}/manifest.webmanifest', timeout=2) as response:
            return json.load(response).get('id') == '/agent-mail'
    except (OSError, ValueError):
        return False


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--port', type=int, default=8765, help='loopback port (default: 8765; 0 chooses a free port)')
    parser.add_argument('--no-open', action='store_true', help='print the private launch URL without opening a browser')
    args = parser.parse_args()
    if not 0 <= args.port <= 65535:
        parser.error('--port must be between 0 and 65535')
    box = Mailbox()
    token = load_token(box.home)
    try:
        server = HTTPServer(('127.0.0.1', args.port), Handler)
    except OSError as error:
        # A background bridge (see its LaunchAgent) shares the same token file.
        if args.port and existing_bridge(f'127.0.0.1:{args.port}'):
            url = f'http://127.0.0.1:{args.port}/#{token}'
            print('Agent Mail web inbox is already running (keep this launch URL private):\n' + url, flush=True)
            if not args.no_open:
                webbrowser.open(url)
            return
        parser.error(f'Cannot listen on 127.0.0.1:{args.port}: {error}. Stop the existing listener or choose another --port.')
    server.box = box
    server.token = token
    server.authority = '127.0.0.1:' + str(server.server_port)
    server.authorities = [server.authority, *tailnet_authorities()]
    server.origins = {f'{scheme}://{authority}'
                      for authority in server.authorities for scheme in ('http', 'https')}
    url = 'http://' + server.authority + '/#' + server.token
    print('Agent Mail web inbox (keep this launch URL private):\n' + url, flush=True)
    for authority in server.authorities[1:]:
        # Printed because the phone cannot use the loopback URL, and the token has to be
        # opened once per origin before the app there is authorized.
        print(f'Also reachable on your tailnet (same token):\nhttps://{authority}/#{server.token}', flush=True)
    print('Ctrl-C stops the bridge. Neovim and CLI mail remain available.', flush=True)
    if not args.no_open:
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == '__main__':
    main()
