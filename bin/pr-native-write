#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: pr-native-write <native-cli-args...>

Run the configured review CLI with agent attribution on explicit pull-request prose writes.
Supports --body/-b and --body-file/-F (including stdin as '-'); body files
are converted to the CLI's --body argument. Human prose is not attributed; read-only calls pass through.
Agent submit is refused because the CLI generates descriptions without an explicit
body: push normally, then use pr-native-write pr create/edit with an explicit body instead.
USAGE
}
[[ $# -gt 0 ]] || { usage >&2; exit 2; }
case "$1" in -h|--help|help) usage; exit 0 ;; esac
native_cli="${PR_NATIVE_CLI:-dt}"
command -v "$native_cli" >/dev/null 2>&1 || { echo 'pr-native-write: native review CLI not found; install through the repository-supported tooling' >&2; exit 127; }
args=("$@")
is_agent=0
if command -v agent-trailer >/dev/null 2>&1 && [[ "$(agent-trailer --raw)" != unknown/unknown/unknown ]]; then
  is_agent=1
fi
help=0
for arg in "$@"; do case "$arg" in -h|--help) help=1 ;; esac; done
if [[ $help -eq 1 ]]; then exec "$native_cli" "${args[@]}"; fi

skip_global_options() {
  while [[ $option_index -lt ${#args[@]} ]]; do
    case "${args[option_index]}" in
      --host|--repo|-R|--remote)
        [[ $((option_index+1)) -lt ${#args[@]} ]] || { echo 'pr-native-write: missing global option value' >&2; exit 2; }
        option_index=$((option_index+2)) ;;
      --host=*|--repo=*|--remote=*|--json|-R?*) option_index=$((option_index+1)) ;;
      *) break ;;
    esac
  done
}
option_index=0
skip_global_options
command_index=$option_index
cmd="${args[command_index]:-}"
option_index=$((command_index+1))
skip_global_options
subcommand_index=$option_index
subcmd="${args[subcommand_index]:-}"
if [[ "$cmd" == submit && $is_agent -eq 1 ]]; then
  for arg in "$@"; do [[ "$arg" != --dry-run ]] || exec "$native_cli" "${args[@]}"; done
  echo 'pr-native-write: agent submit can generate unattributed descriptions; push then use pr-native-write pr create/edit with an explicit body' >&2
  exit 2
fi
case "$cmd $subcmd" in
  'pr create'|'pr edit'|'pr comment'|'pr review') ;;
  api\ *)
    [[ $is_agent -eq 1 ]] || exec "$native_cli" "${args[@]}"
    # Low-level mutations can carry prose outside the PR commands we inspect.
    for arg in "$@"; do
      case "$arg" in -X|--method|-X*|--method=*|--input|--input=*|-f*|-F*|--field|--raw-field|--field=*|--raw-field=*)
        echo 'pr-native-write: use attributed pr commands for agent writes, not low-level API mutations' >&2; exit 2 ;;
      esac
    done
    exec "$native_cli" "${args[@]}" ;;
  *) exec "$native_cli" "${args[@]}" ;;
esac
trailer=""
[[ $is_agent -eq 0 ]] || trailer=$(agent-trailer)
attribute() {
  local text="$1"
  if [[ $is_agent -eq 0 ]]; then printf '%s' "$text"; return; fi
  if printf '%s\n' "$text" | grep -Fqx -- "$trailer"; then printf '%s' "$text"; return; fi
  case "$subcmd" in
    comment|review)
      printf '%s\n\n' "$trailer"
      printf '%s\n' "$text" | sed 's/^/> /; s/^> $/>/' ;;
    *) printf '%s\n\n%s' "$text" "$trailer" ;;
  esac
}
body_count=0
has_attachment=0
for ((i=subcommand_index+1; i<${#args[@]}; i++)); do
  kind='' value=''
  case "${args[i]}" in
    --body|-b|--body-file|-F)
      [[ $((i+1)) -lt ${#args[@]} ]] || { echo 'pr-native-write: missing body value' >&2; exit 2; }
      kind="${args[i]}"; value="${args[i+1]}"; joined=0 ;;
    -b=*) kind='--body'; value="${args[i]#-b=}"; joined=1 ;;
    -F=*) kind='--body-file'; value="${args[i]#-F=}"; joined=1 ;;
    --attach|--attach=*) has_attachment=1; continue ;;
    -b?*) kind='--body'; value="${args[i]#-b}"; joined=1 ;;
    -F?*) kind='--body-file'; value="${args[i]#-F}"; joined=1 ;;
    --body=*|--body-file=*) kind="${args[i]%%=*}"; value="${args[i]#*=}"; joined=1 ;;
    --file-comment)
      [[ $((i+1)) -lt ${#args[@]} ]] || { echo 'pr-native-write: missing file comment' >&2; exit 2; }
      [[ $is_agent -eq 1 ]] || { ((i+=1)); continue; }
      value="${args[i+1]}"; [[ "$value" == *=* ]] || { echo 'pr-native-write: file comment must be PATH=BODY' >&2; exit 2; }
      args[i+1]="${value%%=*}=$(attribute "${value#*=}")"; ((i+=1)); continue ;;
    --file-comment=*)
      [[ $is_agent -eq 1 ]] || continue
      value="${args[i]#*=}"; [[ "$value" == *=* ]] || { echo 'pr-native-write: file comment must be PATH=BODY' >&2; exit 2; }
      args[i]="--file-comment=${value%%=*}=$(attribute "${value#*=}")"; continue ;;
    *) continue ;;
  esac
  case "$kind" in
    --body-file|-F)
      if [[ "$value" == '-' ]]; then value=$(cat && printf '.'); else value=$(cat -- "$value" && printf '.'); fi
      value="${value%.}" ;;
    *)
      if [[ $is_agent -eq 0 ]]; then
        [[ $joined -eq 1 ]] || ((i+=1))
        continue
      fi ;;
  esac
  [[ $is_agent -eq 0 ]] || value=$(attribute "$value")
  if [[ $joined -eq 1 ]]; then args[i]="--body=$value"; else args[i]='--body'; args[i+1]="$value"; ((i+=1)); fi
  body_count=$((body_count+1))
done
if [[ $is_agent -eq 1 && $has_attachment -eq 1 && $body_count -eq 0 ]]; then
  echo 'pr-native-write: agent attachments require an explicit --body or --body-file for attribution' >&2
  exit 2
fi
if [[ $is_agent -eq 1 ]] && [[ "$cmd $subcmd" == 'pr create' || "$cmd $subcmd" == 'pr comment' ]]; then
  [[ $body_count -gt 0 ]] || { echo 'pr-native-write: agent prose creation requires an explicit --body or --body-file' >&2; exit 2; }
fi
exec "$native_cli" "${args[@]}"
