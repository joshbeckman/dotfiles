#!/usr/bin/env python3
"""Render an instruction file as a review page: section sizes, authorship, suggestions.

The file every agent loads on every session is the one nobody measures, so it grows one
real trap at a time. This sizes it, says who added each part, and offers a judgement per
section. Byte counts are exact; authorship and the notes are not, and the page says so.
"""
import argparse
import datetime
import html
import os
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
DEFAULT_SOURCE = ROOT / '.agents/AGENTS.md'
DEFAULT_OUTPUT = pathlib.Path(os.environ.get('XDG_STATE_HOME', pathlib.Path.home() / '.local/state')
                              ) / 'agent/instructions-report.html'

# What to do about each section, keyed by its heading. Sizes come from the file; only the
# judgement is written down here, because a heuristic cannot tell a rule from a mechanism.
SUGGESTIONS = {
    '### Conversation ownership and Agent Mail':
        ('split', 'The handles, group-mail and inbox-browser paragraphs are reference material. '
                  'Keep the rules an agent must not get wrong; move the reference to a linked doc.'),
    '### Avatars':
        ('helper', 'The render-and-check recipe took five defects to get right. Move it to a bin/ '
                   'helper that runs the checks and exits non-zero, leaving the rule and a pointer.'),
    '### Pull request ownership':
        ('pointer', 'Duplicates the own-pr skill. Keep the ownership rule and point at the skill.'),
    '### Agent teams':
        ('pointer', 'docs/agent-teams.md already covers this in more detail. Keep the one-line rule.'),
    '### Your Name':
        ('keep', 'Needed before an agent can act: it is how identity and attribution work.'),
    '### Artifact ownership between agents':
        ('compress', 'Four bullets that restate one rule: ask the owner before editing their artifact.'),
    '### Memory-pressure backpressure':
        ('move', 'Platform-specific mechanism rather than agent guidance; belongs with the tooling.'),
    '### Notifications':
        ('compress', 'Two paragraphs say: use Agent Mail, or notify-josh for a one-shot.'),
    '### Scratchpad':
        ('keep', 'Short, and an agent cannot work without knowing where to write.'),
    '### Secrets':
        ('keep', 'A boundary an agent must not cross.'),
    '### Debugging & Diagnosis':
        ('add', 'Short, and the natural home for the rule that a signal is not the thing it '
                'stands for: read the artifact, not the summary of it.'),
    '## General Guidelines for Coding Agents':
        ('keep', 'Container heading; carries no text of its own.'),
}
MOVABLE = ('pointer', 'helper', 'split', 'compress', 'move')
COLORS = ['#ff7a59', '#ffa184', '#f4b183', '#8fb9a8', '#6f9ba8', '#7a7fb0', '#b07a9a', '#9aa36f']


def sections(text):
    parts = re.split(r'^(#{2,3} .+)$', text, flags=re.M)
    out = []
    for i in range(1, len(parts), 2):
        head, body = parts[i], parts[i + 1]
        out.append({'head': head, 'body': body, 'bytes': len((head + body).encode()),
                    'lines': (head + body).count('\n')})
    return out


def introduced_by(source, head):
    """The commit that last touched this section's heading, and whether an agent wrote it.

    Blame the heading rather than the body: a section's first line is the one that moves when
    it is introduced, and following the body would attribute every later edit to the editor.
    """
    try:
        line = int(subprocess.run(['grep', '-n', '-F', '-m1', head, str(source)],
                                  capture_output=True, text=True).stdout.split(':')[0])
        blame = subprocess.run(['git', '-C', str(source.parent), 'blame', '-L', f'{line},{line}',
                                '--porcelain', '--', str(source)],
                               capture_output=True, text=True, check=True).stdout
        sha = blame.split()[0]
        show = subprocess.run(['git', '-C', str(source.parent), 'show', '-s', '--format=%b', sha],
                              capture_output=True, text=True).stdout
        date = subprocess.run(['git', '-C', str(source.parent), 'show', '-s', '--format=%ad',
                               '--date=short', sha], capture_output=True, text=True).stdout.strip()
        return sha[:7], date, ('Co-authored-by' in show and 'AI' in show)
    except (subprocess.SubprocessError, ValueError, IndexError):
        return '', '', False


def render(source, rows, total_bytes):
    agent_bytes = sum(r['bytes'] for r in rows if r['agent'])
    movable = sum(r['bytes'] for r in rows if r['suggestion'][0] in MOVABLE)

    def bar(row, index, width=520):
        share = row['bytes'] / total_bytes
        return (f'<div class="bar" style="width:{max(share * width, 2):.1f}px;'
                f'background:{COLORS[index % len(COLORS)]}"></div>')

    def card(index, row):
        kind, note = row['suggestion']
        tag = 'agent-added' if row['agent'] else 'josh'
        return f'''<div class="row">
  <div class="meta">
    <span class="pct">{row['bytes']/total_bytes*100:.1f}%</span>
    <span class="bytes">{row['bytes']:,} B</span>
    <span class="lines">{row['lines']} lines</span>
    <span class="tag {tag}">{tag}</span>
    <span class="kind">{kind}</span>
    <span class="src">{row['sha']} {row['date']}</span>
  </div>
  <div class="head">{html.escape(row['head'].lstrip('# '))}</div>
  <div class="barbox" style="background:{COLORS[index % len(COLORS)]}22">{bar(row, index)}</div>
  {f'<div class="note">{html.escape(note)}</div>' if note else ''}
  <details><summary>section text</summary><pre>{html.escape(row['body'].strip())}</pre></details>
</div>'''

    stacked = ''.join(
        f'<span style="flex:{r["bytes"]};background:{COLORS[i % len(COLORS)]}" '
        f'title="{html.escape(r["head"])} {r["bytes"]/total_bytes*100:.1f}%"></span>'
        for i, r in enumerate(rows))

    return f'''<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<title>{html.escape(source.name)} review — {total_bytes:,} bytes, {len(rows)} sections</title>
<style>
 :root {{ color-scheme: light dark; }}
 body {{ font: 15px/1.5 ui-sans-serif, -apple-system, system-ui, sans-serif; max-width: 900px;
        margin: 2rem auto; padding: 0 1.25rem; }}
 h1 {{ font-size: 1.4rem; margin-bottom: .25rem; }}
 .sub {{ color: #6b7280; margin-bottom: 1.5rem; }}
 .stack {{ display: flex; height: 34px; border-radius: 6px; overflow: hidden; margin-bottom: .5rem; }}
 .stack span {{ display: block; }}
 .legend {{ color: #6b7280; font-size: 13px; margin-bottom: 2rem; }}
 .row {{ border-top: 1px solid #8883; padding: .9rem 0; }}
 .meta {{ display: flex; gap: .75rem; font-size: 12px; color: #6b7280; align-items: baseline;
         flex-wrap: wrap; }}
 .pct {{ font-size: 15px; font-weight: 600; color: inherit; }}
 .tag {{ border-radius: 4px; padding: 1px 6px; font-size: 11px; }}
 .tag.agent-added {{ background: #ff7a5922; color: #b04a2e; }}
 .tag.josh {{ background: #6f9ba822; color: #3f6a76; }}
 .kind {{ font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: .04em; }}
 .head {{ font-weight: 600; margin: .15rem 0 .4rem; }}
 .barbox {{ border-radius: 3px; }}
 .bar {{ height: 8px; border-radius: 3px; }}
 .note {{ color: #4b5563; font-size: 13.5px; margin-top: .35rem; }}
 details {{ margin-top: .4rem; }} summary {{ cursor: pointer; color: #6b7280; font-size: 13px; }}
 pre {{ white-space: pre-wrap; font-size: 12.5px; background: #8881; padding: .75rem;
       border-radius: 6px; }}
 .caveat {{ color: #6b7280; font-size: 12.5px; }}
 .callout {{ background: #ff7a5911; border-left: 3px solid #ff7a59; padding: .75rem 1rem;
            border-radius: 4px; margin-bottom: 2rem; }}
</style></head><body>
<h1>{html.escape(source.name)} review</h1>
<div class="sub">{total_bytes:,} bytes, {len(rows)} sections, loaded by every agent in every
session. Generated {datetime.datetime.now().strftime('%Y-%m-%d %H:%M')}.</div>
<div class="stack">{stacked}</div>
<div class="legend">each segment is one section, sized by bytes</div>
<div class="callout"><b>{agent_bytes/total_bytes*100:.0f}% of this file was added by agents</b>,
not by you. Most of it is operational detail that already lives in a linked doc, a skill, or a
tool's own <code>--help</code>. The pointer, helper, split and compress suggestions together
account for about {movable/total_bytes*100:.0f}% of the file's bytes, assuming the linked docs
already carry the detail.<br><br><span class="caveat">Authorship comes from the commit that last
touched each section's heading, so a section you wrote whose heading an agent later edited reads
as agent-added. The byte counts are exact; the judgement in the notes is not.</span></div>
{''.join(card(i, r) for i, r in enumerate(rows))}
</body></html>'''


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--file', default=str(DEFAULT_SOURCE),
                        help='instruction file to review (default: %(default)s)')
    parser.add_argument('--output', default=str(DEFAULT_OUTPUT),
                        help='where to write the page (default: %(default)s)')
    parser.add_argument('--open', action='store_true', help='open the page when it is written')
    args = parser.parse_args()

    # Resolve before git sees it: blame runs with -C inside the repository, so a relative
    # --file would be resolved against the wrong directory.
    source = pathlib.Path(args.file).expanduser().resolve()
    if not source.is_file():
        print(f'agent-instructions-report: no such file: {source}', file=sys.stderr)
        return 2

    text = source.read_text()
    rows = sections(text)
    if not rows:
        print('agent-instructions-report: no level-2 or level-3 headings found', file=sys.stderr)
        return 2
    for row in rows:
        row['sha'], row['date'], row['agent'] = introduced_by(source, row['head'])
        row['suggestion'] = SUGGESTIONS.get(row['head'], ('', ''))
    rows.sort(key=lambda r: -r['bytes'])

    out = pathlib.Path(args.output).expanduser()
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(render(source, rows, len(text.encode())))
    print(out)

    if args.open:
        opener = 'open' if sys.platform == 'darwin' else 'xdg-open'
        subprocess.run([opener, str(out)], check=False)
    return 0


if __name__ == '__main__':
    sys.exit(main())
