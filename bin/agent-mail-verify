#!/bin/sh
# Hourly drift alarm for the mirrored store. The Maildir is authoritative under `both`, so the
# failure this catches is the mirror falling behind rather than the mail going missing, and the
# only signal that matters is a verify that fails or a mirror failure that has not been repaired.
set -eu
# The state directory holds the store marker and the failure log, and it is the parent of the human
# mail root. AGENT_MAIL_ROOT names the scratchpads root, so using it here would send the alarm
# looking in a directory that never holds a failure log, and it would report clean while the mirror
# had drifted.
state="$(dirname -- "${AGENT_HUMAN_MAIL_ROOT:-$HOME/.local/state/agent-mail/humans}")"
err=$(mktemp)
trap 'rm -f "$err"' EXIT
if ! agent-mail-migrate --verify >/dev/null 2>"$err" || [ -s "$state/mirror-failures" ]; then
  cat "$state/mirror-failures" >>"$err" 2>/dev/null || true
  # After a repair the log stays non-empty until --finish retires it, so the alarm keeps firing
  # hourly. Saying which of the two it is keeps a reminder from reading as fresh drift, because an
  # alarm people learn to ignore is worse than none.
  [ -f "$state/mirror-failures.repaired" ] && printf '\nThese ids are already present in SQLite. This is a reminder to run --finish, not new drift.\n' >>"$err"
  agent-mail send --from agent-mail-verify --to josh --subject "Agent mail mirror drifted" --body-file "$err"
fi
