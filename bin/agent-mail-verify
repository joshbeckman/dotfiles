#!/bin/sh
# Alarm when the mail store needs attention. What a failure means depends on the store mode, so the
# alarm reads the marker rather than assuming: under `both` the Maildir is authoritative and a failure
# means the mirror is behind, while under `sqlite` there is no second copy and a failure means mail.
#
# Failures are one file per failure in mirror-failures.d/, retired by moving into repaired/. A file
# being written starts with a dot and is ignored until it is renamed into place. A legacy
# mirror-failures is left to --verify: its retired length lives in mirror-failures.retired-bytes, so
# only the tail past that offset is pending.
set -eu
state="$(dirname -- "${AGENT_HUMAN_MAIL_ROOT:-$HOME/.local/state/agent-mail/humans}")"
failures="$state/mirror-failures.d"
repaired="$failures/repaired"
err=$(mktemp)
trap 'rm -f "$err"' EXIT

# -print -quit stops at the first match, so this stays cheap on a directory with many entries.
first_file() { find "$1" -maxdepth 1 -type f -name '[!.]*' -print -quit 2>/dev/null; }

mode=maildir
if command -v agent-mail >/dev/null 2>&1; then
  mode="$(agent-mail store 2>/dev/null | cut -f1)" || mode=maildir
fi
[ -n "$mode" ] || mode=maildir

# Two different faults, and the repair differs, so they are reported apart.
missing=0
if [ -n "$(first_file "$failures")" ]; then
  missing=1
  for file in "$failures"/*; do
    [ -f "$file" ] || continue
    printf 'Not yet in SQLite: ' >>"$err"
    cat "$file" >>"$err" 2>/dev/null || true
  done
fi
store=0
if ! agent-mail-migrate --verify >/dev/null 2>>"$err"; then
  store=1
  printf '\nSQLite did not verify. Its integrity check failed or the v4 backfill is still owed.\n' >>"$err"
fi

# Repaired records with no finish stamp mean the migration is waiting to be retired. That is a
# reminder, not new drift.
remind=0
if [ "$missing" = 0 ] && [ "$store" = 0 ] && [ ! -e "$state/migration-finished" ] \
   && [ -n "$(first_file "$repaired")" ]; then
  remind=1
  printf 'These ids are already present in SQLite. This is a reminder to run --finish, not new drift.\n' >>"$err"
fi

if [ "$missing" = 0 ] && [ "$store" = 0 ] && [ "$remind" = 0 ]; then
  exit 0
fi

if [ "$missing" = 1 ] && [ "$store" = 1 ]; then
  subject="Agent mail store needs attention: mail missing from SQLite, and it did not verify"
elif [ "$missing" = 1 ]; then
  subject="Agent mail store needs attention: mail missing from SQLite"
elif [ "$store" = 1 ]; then
  subject="Agent mail store needs attention: SQLite does not verify"
else
  subject="Agent mail store needs attention: migration waiting to be finished"
fi
[ "$mode" = both ] && [ "$missing" = 1 ] && subject="$subject (mirror drifted)"

if [ "$missing" = 1 ]; then
  printf '\nRepair: agent-mail-migrate --replay-failures, then agent-mail-migrate --verify.\n' >>"$err"
fi
if [ "$store" = 1 ]; then
  printf 'If replaying does not repair it, restore from %s/archives/.\n' "$state" >>"$err"
fi
if [ "$remind" = 1 ]; then
  printf 'Run agent-mail-migrate --finish when you are ready to retire the archive.\n' >>"$err"
fi

agent-mail send --from agent-mail-verify --to josh --subject "$subject" --body-file "$err"
