#!/bin/sh
# Alarm when the mail store needs attention. What a failure means depends on the store mode, so the
# alarm reads the marker rather than assuming: under `both` the Maildir is authoritative and a failure
# means the mirror is behind, while under `sqlite` there is no second copy and a failure means mail.
#
# Failures are one file per failure in mirror-failures.d/, retired by moving into repaired/. A file
# being written starts with a dot and is ignored until it is renamed into place. The legacy
# mirror-failures file is left to --verify, which knows the retired length.
set -eu
state="$(dirname -- "${AGENT_HUMAN_MAIL_ROOT:-$HOME/.local/state/agent-mail/humans}")"
failures="$state/mirror-failures.d"
repaired="$failures/repaired"
err=$(mktemp)
trap 'rm -f "$err"' EXIT

# -print -quit stops at the first match, so this stays cheap on a directory with many entries.
first_file() { find "$1" -maxdepth 1 -type f -name '[!.]*' -print -quit 2>/dev/null; }

mode=maildir
if command -v agent-mail >/dev/null 2>&1; then
  mode="$(agent-mail store 2>/dev/null | cut -f1)" || mode=maildir
fi
[ -n "$mode" ] || mode=maildir

# Two faults with different repairs, so they are counted apart and reported apart.
missing=0
if [ -n "$(first_file "$failures")" ]; then
  missing=1
  for file in "$failures"/*; do
    [ -f "$file" ] || continue
    printf 'Not yet in SQLite: ' >>"$err"
    cat "$file" >>"$err" 2>/dev/null || true
  done
fi
store=0
status=0
agent-mail-migrate --verify >/dev/null 2>>"$err" || status=$?
# 3 and 4 are verified with completeness unchecked, which is a standing condition rather than drift:
# logged, and not mailed, because an alarm that fires every hour is one nobody reads.
case "$status" in
  0) ;;
  3) printf 'agent-mail-migrate: completeness unchecked, the realm cut over with an empty archive\n' >&2 ;;
  4) printf 'agent-mail-migrate: completeness unchecked, the archive was removed after a cutover that had mail\n' >&2 ;;
  *) store=1 ;;
esac

# Repaired records with no finish stamp mean the migration is waiting to be retired, which is a
# reminder rather than new drift.
remind=0
if [ "$missing" = 0 ] && [ "$store" = 0 ] && [ ! -e "$state/migration-finished" ] \
   && [ -n "$(first_file "$repaired")" ]; then
  remind=1
  printf 'These ids are already present in SQLite. This is a reminder to run --finish, not new drift.\n' >>"$err"
fi

if [ "$missing" = 0 ] && [ "$store" = 0 ] && [ "$remind" = 0 ]; then
  exit 0
fi

# --verify reports unrepaired records too, so one pending record fails both this scan and verify.
# That is one fault, not two, and a subject claiming both would be untrue. The pending record is the
# actionable one, and verify's own message is in the body above.
if [ "$missing" = 1 ]; then
  subject="Agent mail store needs attention: mail missing from SQLite"
elif [ "$store" = 1 ]; then
  subject="Agent mail store needs attention: SQLite does not verify"
else
  subject="Agent mail store needs attention: migration waiting to be finished"
fi
[ "$mode" = both ] && [ "$missing" = 1 ] && subject="$subject (mirror drifted)"

if [ "$missing" = 1 ]; then
  printf '\nRepair: agent-mail-migrate --replay-failures, then agent-mail-migrate --verify.\n' >>"$err"
fi
# Only a store fault with no pending record gets the store advice. When a record is pending, verify
# fails for that reason, and telling the reader to hunt corruption or restore the Maildir would send
# them after a fault that is not there. verify's own message stays above, so a second fault is still
# visible.
if [ "$store" = 1 ] && [ "$missing" = 0 ]; then
  # The archives were a pre-flip snapshot and --finish deletes them, so they are not a repair here.
  # The Maildir is the only other record, and it stopped receiving writes at the flip.
  printf '\nSQLite did not verify. Its integrity check failed or the v4 backfill is still owed.\n' >>"$err"
  printf 'If replaying does not repair it, the Maildir under %s and %s is the pre-flip record; restoring from it loses everything sent since the flip.\n' \
    "${AGENT_MAIL_ROOT:-$HOME/.local/state/agent/scratchpads}" \
    "${AGENT_HUMAN_MAIL_ROOT:-$HOME/.local/state/agent-mail/humans}" >>"$err"
fi
if [ "$remind" = 1 ]; then
  printf 'Run agent-mail-migrate --finish when you are ready to retire the archive.\n' >>"$err"
fi

agent-mail send --from agent-mail-verify --to josh --subject "$subject" --body-file "$err"
