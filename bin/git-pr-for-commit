#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: pr-for-commit <commit>

Print the canonical pull-request URL associated with a commit in the current repository.
EOF
}

die() {
  printf 'pr-for-commit: %s\n' "$*" >&2
  exit 1
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
[[ $# -eq 1 ]] || { usage >&2; exit 2; }
commit="$(git rev-parse --verify "$1^{commit}" 2>/dev/null)" || die "not a commit: $1"

helper="$(cd "$(dirname "$0")" && pwd)/lib/pr_lookup.rb"
routing="$(ruby "$helper" route '')" || exit 1
IFS=$'\t' read -r provider host repo <<<"$routing"
if [[ "$provider" == native ]]; then
  exec ruby "$helper" commit "$host" "$repo" "$commit"
fi

[[ "$provider" == github ]] || die 'the classified legacy adapter cannot safely bind commit association; use the owning repository workflow'
export GH_HOST="${host#https://}"
unset GH_REPO
export GW_REPO="$GH_HOST/$repo"
command -v gw >/dev/null 2>&1 || die 'gw is required for GitHub lookup'

urls="$(gw api -H 'Accept: application/vnd.github+json' "repos/$repo/commits/$commit/pulls" --jq '.[].html_url')" ||
  die 'GitHub associated-pulls lookup failed'
unique_urls="$(printf '%s\n' "$urls" | ruby -e 'pattern = %r{\Ahttps://github\.com/#{Regexp.escape(ARGV.fetch(0))}/pull/[0-9]+\z}; puts STDIN.each_line.map(&:strip).select { |url| url.match?(pattern) }.uniq.sort' "$repo")"
url_count="$(printf '%s\n' "$unique_urls" | grep -c . || true)"
case "$url_count" in
  1) printf '%s\n' "$unique_urls" ;;
  0) die "no pull request found for $commit" ;;
  *) die "multiple pull requests found for $commit: $(printf '%s' "$unique_urls" | tr '\n' ' ')" ;;
esac
