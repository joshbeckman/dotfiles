#!/usr/bin/env python3
"""Find agent sessions by transcript topic, or inspect one exact contact.

A search result carries the matching line count and a few excerpts, because a count
alone does not say what matched and a count is easy to inflate: a session that dumped a
file mentioning the term fifty times outranks one that discussed it twice.
"""
import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys


def identities(root):
    by_id = {}
    if root.is_dir():
        for path in sorted(root.iterdir()):
            if path.is_file() and not path.name.startswith('.'):
                sid = path.read_text().strip()
                by_id.setdefault(sid, path.name)
    return by_id


def ranked_sessions(root, pattern):
    # NUL separates paths from counts, so spaces and colons in paths stay intact.
    result = subprocess.run(['rg', '-c', '-i', '--null', '--glob', '*.jsonl', '--', pattern, str(root)], capture_output=True)
    if result.returncode not in (0, 1):
        raise ValueError(result.stderr.decode(errors='replace').strip() or 'ripgrep search failed')
    data = result.stdout
    ranked = []
    while data:
        path, sep, rest = data.partition(b'\0')
        count, newline, data = rest.partition(b'\n')
        if not sep or not newline:
            raise ValueError('Unexpected ripgrep count output')
        ranked.append((int(count), Path(os.fsdecode(path))))
    return sorted(ranked, key=lambda item: (item[0], str(item[1])), reverse=True)


def recorded_model(record):
    kind = record.get('type')
    message = record.get('message')
    if kind == 'model_change':
        provider, model, source = record.get('provider'), record.get('modelId'), 'model_change'
    elif kind == 'message' and isinstance(message, dict) and message.get('role') == 'assistant':
        provider, model, source = message.get('provider'), message.get('model'), 'assistant'
    else:
        return None
    if not all(isinstance(value, str) and value for value in (provider, model)):
        return None
    timestamp = record.get('timestamp')
    if not isinstance(timestamp, str):
        timestamp = None
        if isinstance(message, dict) and type(message.get('timestamp')) in (int, float):
            try:
                timestamp = datetime.fromtimestamp(message['timestamp'] / 1000, timezone.utc).isoformat()
            except (ValueError, OverflowError, OSError):
                pass
    return {'provider': provider, 'model': model, 'observedAt': timestamp, 'source': source}


def text_candidates(record):
    """(kind, text) for every place a match is worth showing, in reading order.

    A transcript is JSONL, one record per line, and a single record can hold an entire
    tool result or a thinking block of hundreds of thousands of characters. So the
    matching line is never printable as it stands: the match has to be found again
    inside the parsed record and windowed, or one hit prints a quarter of a megabyte.
    """
    kind = record.get('type')
    if kind == 'custom_message':
        content = record.get('content')
        return [('notice', content)] if isinstance(content, str) else []
    if kind == 'compaction':
        summary = record.get('summary')
        return [('summary', summary)] if isinstance(summary, str) else []
    if kind == 'session_info':
        name = record.get('name')
        return [('title', name)] if isinstance(name, str) else []
    message = record.get('message')
    if kind != 'message' or not isinstance(message, dict):
        return []
    role = message.get('role')
    role = role if isinstance(role, str) and role else 'message'
    content = message.get('content')
    if isinstance(content, str):
        return [(role, content)]
    if not isinstance(content, list):
        return []
    candidates = []
    for part in content:
        if not isinstance(part, dict):
            continue
        if part.get('type') == 'thinking' and isinstance(part.get('thinking'), str):
            candidates.append((role + ' thinking', part['thinking']))
        elif isinstance(part.get('text'), str):
            candidates.append((role, part['text']))
        elif part.get('type') == 'toolCall' and isinstance(part.get('arguments'), dict):
            # Not prose, but a tool call's arguments carry the command or the path
            # that was searched for, which is often exactly what matched.
            flat = ' '.join(value for value in part['arguments'].values() if isinstance(value, str))
            if flat:
                name = part.get('name')
                candidates.append((f'{role} tool {name}' if isinstance(name, str) else role + ' tool', flat))
    return candidates


def excerpt(text, match, width=60):
    start = max(0, match.start() - width)
    end = min(len(text), match.end() + width)
    body = ' '.join(text[start:end].split())
    return ('\u2026' if start else '') + body + ('\u2026' if end < len(text) else '')


def sample_from(record, line, pattern):
    """One excerpt for an already-parsed matching record, or None."""
    for kind, text in text_candidates(record):
        found = pattern.search(text)
        if found is not None:
            return {'at': record.get('timestamp'), 'kind': kind, 'text': excerpt(text, found)}
    # The match is in metadata rather than in any text field. Show where it is instead
    # of dropping an excerpt the count says exists.
    found = pattern.search(line)
    if found is None:
        return None
    return {'at': record.get('timestamp'), 'kind': 'metadata', 'text': excerpt(line, found)}


def hydrate(file, hits, claims, mail_root, pane_titles, pattern=None, samples=0):
    sid = file.stem.rpartition('_')[2]
    handle = claims.get(sid, '')
    cwd, title, harness = '', '', None
    entries, used, leaf = {}, {}, None
    collected = []
    with file.open(errors='replace') as transcript:
        for index, line in enumerate(transcript):
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if not isinstance(record, dict):
                continue
            if pattern is not None and samples:
                sample = sample_from(record, line, pattern)
                if sample is not None:
                    collected.append(sample)
                    if len(collected) > samples:
                        collected.pop(0)
            if index == 0:
                if isinstance(record.get('cwd'), str):
                    cwd = record['cwd']
                if record.get('type') == 'session':
                    harness = 'pi'
            if record.get('type') == 'session':
                continue
            if record.get('type') == 'session_info' and isinstance(record.get('name'), str):
                title = record['name']
            model = recorded_model(record)
            if model and model['source'] == 'assistant':
                key = (model['provider'], model['model'])
                item = used.setdefault(key, {'provider': key[0], 'model': key[1],
                                            'firstObservedAt': model['observedAt'], 'lastObservedAt': None})
                item['lastObservedAt'] = model['observedAt']
            # Parent links from every entry prevent reporting an abandoned branch's model.
            entry_id = record.get('id')
            if not isinstance(entry_id, str):
                entry_id = index
            parent = record.get('parentId', leaf)
            entries[entry_id] = (parent if type(parent) in (str, int) else None, model)
            leaf = entry_id
    current, seen = None, set()
    while leaf in entries and leaf not in seen:
        seen.add(leaf)
        leaf, current = entries[leaf]
        if current:
            break
    display = handle.replace('-', ' ').casefold()
    live = 'RUNNING (tmux)' if display and display in pane_titles.casefold() else 'parked'
    pad = mail_root / (handle + '-' + sid[:8]) if handle else None
    pad = str(pad) if pad and pad.is_dir() else None
    resume = f'cd {shlex.quote(cwd or "?")} && pi --session {shlex.quote(str(file))}'
    return {'handle': '@+' + handle if handle else None, 'title': title or '(untitled)',
            'sessionId': sid, 'sessionShort': sid[:8], 'started': file.name[:10],
            'matches': hits, 'samples': collected, 'cwd': cwd or '?', 'liveness': live, 'scratchpad': pad,
            'sessionFile': str(file), 'resume': resume, 'harness': harness,
            'provider': current['provider'] if current else None,
            'model': current['model'] if current else None,
            'modelObservedAt': current['observedAt'] if current else None,
            'modelSource': current['source'] if current else None,
            'modelsUsed': list(used.values())}


def team_memberships():
    try:
        result = subprocess.run([str(Path(__file__).resolve().with_name('agent-team')), 'list', '--json'],
                                capture_output=True, text=True, timeout=10)
        if result.returncode:
            raise ValueError(result.stderr.strip() or 'team lookup failed')
        teams = json.loads(result.stdout)
        by_session = {}
        for team in teams:
            if team['status'] != 'active':
                continue
            for member in team['members']:
                if member['leftAt'] is None:
                    by_session.setdefault(member['sessionId'], []).append({
                        'handle': team['handle'], 'name': team['name'], 'coordinator': team['coordinator'],
                        'scope': member['scope'], 'joinedAt': member['joinedAt'], 'scratchpad': team['scratchpad'],
                        'role': 'coordinator' if member['handle'] == team['coordinator'] else 'member'})
        return by_session, None
    except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as error:
        warning = str(error)
        print('agent-find: team membership unavailable: ' + warning, file=sys.stderr)
        return None, warning


def positive_int(value):
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError('limit must be positive')
    return number


def non_negative_int(value):
    number = int(value)
    if number < 0:
        raise argparse.ArgumentTypeError('samples must not be negative')
    return number


def main():
    parser = argparse.ArgumentParser(description='Find agent sessions by case-insensitive transcript regex, or inspect an exact @+handle.')
    parser.add_argument('pattern', nargs='*', help='transcript search pattern, or a single @+handle for exact lookup')
    parser.add_argument('--limit', type=positive_int, default=5, help='maximum results (default: 5)')
    parser.add_argument('--samples', type=non_negative_int, default=3, help='matching excerpts to show per session (default: 3; 0 disables)')
    parser.add_argument('--json', action='store_true', help='emit session metadata, latest recorded model, observed-model history, and matching excerpts as JSON')
    parser.add_argument('--agent', help='inspect an exact registry handle instead of searching transcripts')
    args = parser.parse_intermixed_args()
    pattern = ' '.join(args.pattern)
    if bool(pattern) == bool(args.agent):
        parser.error('provide either a search pattern or --agent HANDLE')
    if not args.agent and re.fullmatch(r'@\+[a-z0-9][a-z0-9._-]*', pattern):
        args.agent = pattern
    search_pattern = None
    if pattern and args.samples:
        try:
            search_pattern = re.compile(pattern, re.IGNORECASE)
        except re.error:
            # ripgrep's dialect is not Python's. Excerpts are optional, so a pattern
            # only ripgrep can compile costs the excerpts and nothing else.
            search_pattern = None
    root = Path(os.environ.get('PI_SESSIONS_DIR', '~/.pi/agent/sessions')).expanduser()
    registry = Path(os.environ.get('AGENT_IDENTITIES_DIR', '~/.pi/agent/identities/by-name')).expanduser()
    mail_root = Path(os.environ.get('AGENT_MAIL_ROOT', os.environ.get('AGENT_SCRATCH_ROOT', '~/.local/state/agent/scratchpads'))).expanduser()
    try:
        if not root.is_dir():
            raise ValueError(f'no sessions at {root}')
        claims = identities(registry)
        if args.agent:
            handle = args.agent.removeprefix('@').removeprefix('+')
            sid = next((sid for sid, name in claims.items() if name == handle), None)
            if sid and not re.fullmatch(r'[a-fA-F0-9-]+', sid):
                raise ValueError('Invalid session ID in identity registry')
            ranked = [(None, file) for file in sorted(root.rglob('*_' + sid + '.jsonl'))] if sid else []
        else:
            ranked = ranked_sessions(root, pattern)
            # Human web searches unset AGENT_SCRATCHPAD so the launching agent is included.
            pad = os.environ.get('AGENT_SCRATCHPAD', '')
            if pad:
                own_handle = Path(pad).name.rpartition('-')[0]
                own_sid = next((sid for sid, name in claims.items() if name == own_handle), None)
                if own_sid:
                    ranked = [(hits, file) for hits, file in ranked if file.stem.rpartition('_')[2] != own_sid]
        try:
            pane_titles = subprocess.run(['tmux', 'list-panes', '-a', '-F', '#{pane_title}'], capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.TimeoutExpired):
            pane_titles = ''
        results = [hydrate(file, hits, claims, mail_root, pane_titles, search_pattern, args.samples)
                   for hits, file in ranked[:args.limit]]
        memberships, team_warning = team_memberships() if results else ({}, None)
        for result in results:
            result['teams'] = memberships.get(result['sessionId'], []) if memberships is not None else None
            result['teamsWarning'] = team_warning
        if args.json:
            print(json.dumps(results))
        elif not results:
            print('No sessions match: ' + (pattern or args.agent))
            return 1
        else:
            for result in results:
                print('─────')
                identity = f'{result["handle"]}  [{result["liveness"]}]' if result['handle'] else '(pre-registry, unnamed)'
                print(f'{"agent:":9} {identity}')
                print(f'{"title:":9} {result["title"]}')
                for team in result['teams'] or []:
                    print(f'{"team:":9} {team["handle"]}  [{team["role"]}; coordinator {team["coordinator"]}]')
                if result['teams'] is None:
                    print(f'{"team:":9} unknown (team registry unavailable)')
                print(f'{"harness:":9} {result["harness"] or "unknown"}')
                model = f'{result["provider"]}/{result["model"]}' if result['model'] else 'unknown'
                print(f'{"model:":9} {model}  (latest recorded)')
                if result['modelObservedAt']:
                    print(f'{"observed:":9} {result["modelObservedAt"]}  [{result["modelSource"]}]')
                for model in result['modelsUsed']:
                    print(f'{"used:":9} {model["provider"]}/{model["model"]}  '
                          f'(first: {model["firstObservedAt"] or "unknown time"}; last: {model["lastObservedAt"] or "unknown time"})')
                matches = 'metadata only' if result['matches'] is None else f'{result["matches"]} matches'
                print(f'{"session:":9} {result["sessionShort"]}  ({matches}, started {result["started"]})')
                for sample in result['samples']:
                    print(f'{"match:":9} {sample["at"] or "unknown time"}  {sample["kind"]}  {sample["text"]}')
                print(f'{"cwd:":9} {result["cwd"]}')
                print(f'{"pad:":9} {result["scratchpad"] or "-"}')
                print(f'{"resume:":9} {result["resume"]}')
        return 0
    except (OSError, ValueError) as error:
        print('agent-find: ' + str(error), file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
