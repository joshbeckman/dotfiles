#!/usr/bin/env python3
"""Route explicit PR writes through the classified repository's attribution adapter."""
import json
import os
from pathlib import Path
import subprocess
import sys
from urllib.parse import urlsplit


def main():
    arguments = sys.argv[1:]
    if not arguments or arguments[0] in ('--help', '-h', 'help'):
        print('Usage: git pr-write <create|edit|comment|review|ready|close|reopen> [PR_URL|NUMBER|BRANCH] [OPTIONS]')
        print('Classify the repository first; explicit prose bodies use the selected attribution adapter.')
        return 0 if arguments else 2
    verb = arguments[0]
    if verb not in ('create', 'edit', 'comment', 'review', 'ready', 'close', 'reopen'):
        raise ValueError('unsupported write verb; use the owning repository workflow')
    selector = arguments[1] if len(arguments) > 1 and not arguments[1].startswith('-') else ''
    value_options = {
        '--body', '--body-file', '--title', '--base', '--head', '--reviewer',
        '--team-reviewer', '--assignee', '--label', '--project', '--milestone',
        '--add-label', '--remove-label', '--add-assignee', '--remove-assignee',
        '--add-reviewer', '--remove-reviewer', '--add-team-reviewer',
        '--remove-team-reviewer', '--file-comment', '--attach', '--reply-to',
        '--path', '--line', '--side', '--start-line', '--recover',
        '-b', '-F', '-t', '-B', '-H', '-r', '-a', '-l', '-m', '-p',
    }
    if verb in ('close', 'reopen'):
        value_options.update(('--comment', '-c'))
    switches = {'--approve', '--request-changes', '--comment', '--draft', '--publish',
                '--json', '--help', '-h', '--yes', '--no-maintainer-edit', '--delete-branch'}
    index = 2 if selector else 1
    while index < len(arguments):
        arg = arguments[index]
        key = arg.split('=', 1)[0]
        if key in ('--host', '--repo', '-R', '--remote') or (arg.startswith('-R') and len(arg) > 2):
            raise ValueError('scope overrides are not accepted; configure and classify the intended repository first')
        if arg in value_options:
            if index + 1 >= len(arguments):
                raise ValueError('missing option value')
            index += 2
        elif key in value_options and '=' in arg:
            index += 1
        elif any(arg.startswith(flag) and len(arg) > 2 for flag in value_options if len(flag) == 2):
            index += 1
        elif arg in switches:
            index += 1
        elif arg.startswith('-'):
            raise ValueError('unsupported option; use the owning repository workflow')
        else:
            raise ValueError('selectors must immediately follow the write verb; additional positional arguments are not accepted')
    classifier = Path(__file__).resolve().with_name('git-pr-host')
    result = subprocess.run([str(classifier), *([selector] if selector else [])], text=True, stdout=subprocess.PIPE, check=True)
    record = json.loads(result.stdout)
    if not isinstance(record, dict) or not isinstance(record.get('capabilities'), dict):
        raise ValueError('invalid hosting discovery record')
    if record['capabilities'].get('write') is not True:
        raise ValueError('the classified adapter cannot safely bind PR writes; use the owning repository workflow')
    provider, host, repo = (record.get(key) for key in ('provider', 'host', 'repo'))
    if not isinstance(repo, str) or not repo or repo == '-':
        raise ValueError('repository identity is required before PR writes')
    environment = os.environ.copy()
    if provider == 'github':
        parsed_host = urlsplit(host) if isinstance(host, str) else None
        if not parsed_host or parsed_host.scheme != 'https' or not parsed_host.hostname or parsed_host.username or parsed_host.password:
            raise ValueError('GitHub writes require a classified HTTPS host')
        environment['GH_HOST'] = parsed_host.netloc
        environment.pop('GH_REPO', None)
        environment.pop('GW_REPO', None)
        command = ['gw', 'pr', *arguments, '--repo', f'{parsed_host.netloc}/{repo}']
    elif provider == 'native':
        client = record.get('read_cli')
        if not isinstance(host, str) or not host or not isinstance(client, str) or not client:
            raise ValueError('native writes require a classified host and client')
        environment['PR_NATIVE_CLI'] = client
        wrapper = classifier.with_name('pr-native-write')
        command = [str(wrapper), 'pr', *arguments, '--host', host, '-R', repo]
    else:
        raise ValueError('unsupported write adapter; no fallback will be attempted')
    os.execvpe(command[0], command, environment)


try:
    sys.exit(main())
except subprocess.CalledProcessError as error:
    sys.exit(error.returncode)
except (OSError, ValueError, KeyError, TypeError) as error:
    print(f'git pr-write: {error}', file=sys.stderr)
    sys.exit(1)
