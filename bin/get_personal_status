#!/bin/sh
# Token comes from the encrypted `s` store, not a plaintext file. The wrapper
# supplies the Keychain password source itself so callers that never sourced
# .zshrc (launchd, cron, detached agents) still work.

VERBOSE=false
while [ $# -gt 0 ]; do
  case "$1" in
    -v|--verbose)
      VERBOSE=true
      shift
      ;;
    *)
      echo "Usage: $0 [-v|--verbose]"
      exit 1
      ;;
  esac
done

if ! command -v jq >/dev/null 2>&1; then
  echo "Error: jq is required but not installed."
  exit 1
fi

: "${S_KEY:=!security find-generic-password -s s-secrets -w}"
export S_KEY

if [ "$VERBOSE" = true ]; then
  filter='"\(.status)\nUpdated: \(.updated_at)"'
else
  filter='.status'
fi

exec s PERSONAL_MCP_READ_TOKEN -- sh -c '
  curl https://joshbeckman--5ffab9e262b911f09d000224a6c84d84.web.val.run/api \
    -H "Authorization: Bearer $PERSONAL_MCP_READ_TOKEN" --silent | jq -r "$1"
' sh "$filter"
