#!/usr/bin/env python3
"""Copy the Maildir Agent Mail store into the SQLite store.

Read-only on the Maildir: nothing is moved, renamed, or deleted, so the old store
stays usable and this can be re-run until the cutover is deliberate. Idempotent: a
message already in the database is not written again, and its delivery state is brought
into line with the Maildir: a file in new/ is unread, one in cur/ is read, and one that has
gone from a mailbox that still exists was discarded, which is what v1's discard does.

The audience comes from where a message actually sits, not from its To header. The
Maildir delivers by writing a file into a mailbox, and the To header mixes canonical
handles with transport addresses, so the directory is the delivery record: a message
that reached three inboxes becomes one message with three recipients.

Read state comes from the Maildir too: a file in new/ is unread, one in cur/ has been
read. The old store never recorded when, so read_at is the file's mtime, which is the
arrival time rather than the moment anyone looked. A message new to an existing thread is
appended after that thread's last message, so a re-run never reuses a sequence.

Usage:
  agent-mail-migrate                 migrate into the default database
  agent-mail-migrate --dry-run       print the plan and write nothing
  agent-mail-migrate --verify        compare the Maildir against the database
  agent-mail-migrate --message ID    bring one message and its deliveries into line
                                     (what agent-mail runs after each change while the
                                     store marker says both)
  agent-mail-migrate --set-store both     migrate, verify, then start dual-writing
  agent-mail-migrate --set-store maildir  stop dual-writing (the Maildir never stopped
                                          being authoritative, so nothing is lost)
  agent-mail-migrate --set-store sqlite   from both: sync, verify, archive, then make the
                                          SQLite store the record (there is no way back)
  agent-mail-migrate --message ID --import-only [--apply read|discard --mailbox M]
                                     add one message the database lacks, changing nothing
                                     else, and apply a read or discard agent-mail made to it
                                     (what agent-mail runs for a writer that straddled the flip)
  agent-mail-migrate --replay-failures
                                     repair every logged mirror failure, then retire the log
  agent-mail-migrate --finish        stamp the migration done and delete its archives

Before --set-store both changes anything, it archives the inboxes, the human mailboxes,
the identity registry and the database to archives/ beside the marker, then restores that
archive into a temporary directory and checks it holds the same mail. --finish refuses
unless --verify is clean.

  --db PATH          target database (default: AGENT_MAIL2_DB, then mail2.sqlite3 beside
                     the human root, where agent-mail2 keeps it)
  --agent-root DIR   agent scratchpad root (default: AGENT_MAIL_ROOT, then AGENT_SCRATCH_ROOT,
                     as agent-mail resolves it)
  --human-root DIR   human mailbox root (default: AGENT_HUMAN_MAIL_ROOT, then
                     ~/.local/state/agent-mail/humans)
  --visibility NAME  visibility for migrated threads (public or private; public default)
  --quiet            print nothing on success

Exit status for --verify: 0 verified, 1 problems, 3 verified with completeness unchecked
(the realm cut over with an empty archive), 4 the same, with the archive removed after a
cutover that had mail. 3 and 4 are standing conditions, so agent-mail-verify logs them and
mails only on 1.

The store marker is <human-root>/../store, which bin/agent-mail reads: maildir (or absent,
or anything unreadable) uses the Maildir alone; both writes the Maildir and mirrors each
change here; sqlite uses this store alone. Once it says sqlite this tool refuses to write,
because the Maildir is no longer the record and syncing from it would discard newer mail.
"""

from __future__ import annotations

import argparse
import os
import re
import sqlite3
import subprocess
import sys
import tarfile
import tempfile
from datetime import datetime, timezone
from pathlib import Path

HEADER = re.compile(r"^([A-Za-z][A-Za-z0-9-]*):[ \t]?(.*)$")
ADDRESS = re.compile(r"^[A-Za-z0-9._+@-]+$")
FOLDERS = (("new", None), ("cur", "read"))


class MigrationError(Exception):
    pass


def parse(path: Path) -> tuple[dict[str, str], str]:
    # Not read_text: universal newlines would rewrite a CR in the body, and a replacement
    # character would hide undecodable bytes behind a verify that compares the same lossy text.
    try:
        text = path.read_bytes().decode("utf-8")
    except UnicodeDecodeError as error:
        raise MigrationError(f"{path} is not UTF-8 ({error.reason} at byte {error.start})") from None
    head, _, body = text.partition("\n\n")
    headers: dict[str, str] = {}
    for line in head.splitlines():
        match = HEADER.match(line)
        if match:
            headers.setdefault(match.group(1).lower(), match.group(2).strip())
    return headers, body


def normalize(value: str) -> str:
    """A From header as the mailbox agent-mail would deliver to: sigils dropped, humans/<h> and
    an email address reduced to the human handle. Case is kept, as agent-mail keeps it."""
    address = value.strip()
    if address.startswith("@"):
        address = address[1:]
    if address.startswith("+"):
        address = address[1:]
    if address.startswith("humans/"):
        address = address[len("humans/"):]
    elif "@" in address:
        address = address.split("@", 1)[0]
    if not address or not ADDRESS.fullmatch(address):
        raise MigrationError(f"unusable address: {value!r}")
    return address


# A transport address: a handle plus the first eight hex characters of a session ID (the
# form a pad and a delivery both use), or that name with the full UUID.
SESSION_ADDRESS = re.compile(
    r"^(?P<base>.+)-(?P<sid>[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?)$"
)
SESSION_ID = re.compile(
    r"^[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$"
)

_claims: dict[str, str] | None = None


def claims() -> dict[str, str]:
    """The identity registry's name claims: handle slug to session ID, as bin/agent-mail reads
    them. Empty when the registry is absent, which is the case in the test suites."""
    global _claims
    if _claims is None:
        _claims = {}
        root = Path(os.environ.get("AGENT_IDENTITIES_DIR")
                    or Path.home() / ".pi" / "agent" / "identities" / "by-name").expanduser()
        try:
            for claim in root.iterdir():
                if claim.is_symlink() or not claim.is_file():
                    continue
                session_id = claim.read_text(encoding="utf-8", errors="replace").strip()
                if SESSION_ID.fullmatch(session_id):
                    _claims[claim.name] = session_id
        except OSError:
            pass
    return _claims


def canonical_sender(address: str) -> str:
    """The mailbox the resolver would reach for this From header.

    A session renamed to the realm-suffixed convention keeps the From header it was sent
    with, so its transport address names a handle no pad has. bin/agent-mail resolves that
    name through the identity registry and lands on the canonical pad; recording the header
    verbatim instead forks one seat into two mailboxes, one holding only its sent mail.
    """
    match = SESSION_ADDRESS.match(address)
    if not match or "-of-" in match["base"]:
        return address
    suffix = match["sid"].lower()[:8]
    found = sorted(name for name, session_id in claims().items()
                   if name.startswith(match["base"] + "-of-") and session_id.lower().startswith(suffix))
    return f"{found[0]}-{suffix}" if len(found) == 1 else address


def parse_time(value: str | None, fallback: int) -> int:
    if not value:
        return fallback
    try:
        parsed = datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
    except ValueError:
        return fallback
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return int(parsed.timestamp() * 1_000_000)


def mtime_us(path: Path) -> int:
    return int(path.stat().st_mtime * 1_000_000)


class Message:
    def __init__(self, message_id: str):
        self.message_id = message_id
        self.thread_id: str | None = None
        self.sender: str | None = None
        self.reply_to: str | None = None
        self.sent_at = 0
        self.subject: str | None = None
        self.body = ""
        self.recipients: dict[str, int | None] = {}
        self.reply_address: str | None = None
        self.team_to: str | None = None
        self.escalated: dict[str, int] = {}
        # The To header: the only record of a recipient whose copy is gone. Used for the
        # audience only, never for deliveries.
        self.addressed: list[str] = []

    def absorb(self, path: Path, headers: dict[str, str], body: str) -> None:
        if not self.body and body:
            self.body = body
        if self.thread_id is None:
            self.thread_id = headers.get("thread-id") or self.message_id
        if self.reply_to is None:
            self.reply_to = headers.get("in-reply-to")
        if self.subject is None and headers.get("subject"):
            self.subject = headers["subject"]
        if headers.get("from"):
            self.sender = self.sender or canonical_sender(normalize(headers["from"]))
        if headers.get("reply-to") and self.reply_address is None:
            self.reply_address = normalize(headers["reply-to"])
        if headers.get("team-to") and self.team_to is None:
            self.team_to = headers["team-to"]
        if not self.addressed:
            self.addressed = [normalize(a) for a in headers.get("to", "").split(",") if a.strip()]
        self.sent_at = self.sent_at or parse_time(headers.get("date"), mtime_us(path))

    def offer_sender(self, mailbox: str) -> None:
        self.sender = self.sender or canonical_sender(mailbox)


def mailboxes(agent_root: Path, human_root: Path) -> dict[str, dict[str, Path]]:
    """Mailbox id to its Maildir folders. Agents keep an inbox in their scratchpad;
    humans keep a full mailbox, sent folder included. A sent copy is redundant wherever
    the message reached an inbox, since the From header names the sender, so it is only
    read as a fallback for a message with no inbox copy at all."""
    found: dict[str, dict[str, Path]] = {}
    pads = {pad.name for pad in agent_root.glob("*") if pad.is_dir()}
    for inbox in sorted(agent_root.glob("*/inbox")):
        # agent-mail2 refuses a symlinked pad too: through a link one inbox has two names.
        if inbox.is_symlink() or inbox.parent.is_symlink():
            raise MigrationError(f"{inbox.parent} is a symlink; a mailbox must be a real scratchpad")
        found[inbox.parent.name] = {"inbox": inbox}
    for box in sorted(human_root.glob("*")):
        if box.is_dir():
            # One namespace in the database, so silently letting one shadow the other would
            # drop an inbox from the migration and from verify.
            if box.name in pads:
                raise MigrationError(f"{box.name} is both an agent scratchpad and a human mailbox")
            found[box.name] = {"inbox": box / "inbox", "sent": box / "sent"}
    return found


def files(directory: Path, only: str | None) -> list[Path]:
    if only is None:
        return sorted(directory.glob("*.md"))
    # A literal name, not a glob pattern: --message '*' must not reach every message.
    path = directory / f"{only}.md"
    return [path] if path.is_file() else []


def collect(boxes: dict[str, dict[str, Path]], only: str | None = None) -> dict[str, Message]:
    messages: dict[str, Message] = {}
    for mailbox, folders in boxes.items():
        inbox = folders.get("inbox")
        if inbox is not None:
            for folder, state in FOLDERS:
                directory = inbox / folder
                if not directory.is_dir():
                    continue
                for path in files(directory, only):
                    headers, body = parse(path)
                    message_id = headers.get("message-id") or path.stem
                    if only is not None and message_id != only:
                        raise MigrationError(f"{path} carries Message-ID {message_id}, not {only}")
                    message = messages.setdefault(message_id, Message(message_id))
                    message.absorb(path, headers, body)
                    message.recipients[mailbox] = mtime_us(path) if state else None
                    # v1 marks an escalated delivery with a directory; carried over so the
                    # SQLite sweep does not notify Josh about it a second time.
                    marker = inbox / f".escalated-{message_id}"
                    if marker.is_dir():
                        message.escalated[mailbox] = mtime_us(marker)
        sent = folders.get("sent")
        if sent is not None and sent.is_dir():
            for path in files(sent, only):
                headers, body = parse(path)
                message_id = headers.get("message-id") or path.stem
                if only is not None and message_id != only:
                    raise MigrationError(f"{path} carries Message-ID {message_id}, not {only}")
                message = messages.setdefault(message_id, Message(message_id))
                message.absorb(path, headers, body)
                message.offer_sender(mailbox)
    return messages


def causal(group: list[Message]) -> list[Message]:
    """Date order, except that a parent always precedes its replies. Dates have one-second
    resolution and come from the sender's clock, and the parent key is checked on insert."""
    pending = {message.message_id: message for message in group}
    ordered: list[Message] = []
    while pending:
        ready = [m for m in pending.values() if m.reply_to not in pending]
        # A cycle cannot come from agent-mail; break it in date order rather than loop.
        earliest = min(ready or pending.values(), key=lambda m: (m.sent_at, m.message_id))
        ordered.append(pending.pop(earliest.message_id))
    return ordered


def threads(messages: dict[str, Message]) -> dict[str, list[Message]]:
    grouped: dict[str, list[Message]] = {}
    for message in messages.values():
        grouped.setdefault(message.thread_id or message.message_id, []).append(message)
    for thread in grouped.values():
        thread.sort(key=lambda item: (item.sent_at, item.message_id))
    return grouped


def ensure(db: sqlite3.Connection, address: str, timestamp: int, humans: set[str]) -> None:
    db.execute(
        "INSERT OR IGNORE INTO mailboxes(mailbox_id, kind, created_at) VALUES (?, ?, ?)",
        (address, "human" if address == "josh" or address in humans else "agent", timestamp),
    )


def migrate(db: sqlite3.Connection, messages: dict[str, Message], visibility: str,
            boxes: dict[str, dict[str, Path]], only: str | None = None,
            import_only: bool = False) -> dict[str, int]:
    counts = {"messages": 0, "deliveries": 0, "threads": 0, "dangling_replies": 0,
              "state_changes": 0, "discarded": 0}
    now = int(datetime.now(timezone.utc).timestamp() * 1_000_000)
    humans = {name for name, folders in boxes.items() if "sent" in folders}
    for thread_id, group in sorted(threads(messages).items()):
        group = causal(group)
        db.execute(
            "INSERT OR IGNORE INTO threads(thread_id, created_at, visibility) VALUES (?, ?, ?)",
            (thread_id, group[0].sent_at, visibility),
        )
        counts["threads"] += db.execute("SELECT changes()").fetchone()[0]
        # The next free sequence, not the message's position in the Maildir group: v1's
        # discard deletes files, so that position shifts between runs and would collide.
        sequence = db.execute(
            "SELECT COALESCE(MAX(sequence), 0) + 1 FROM messages WHERE thread_id = ?", (thread_id,)
        ).fetchone()[0]
        for message in group:
            sender = message.sender
            if sender is None:
                raise MigrationError(f"message {message.message_id} has no sender")
            exists = db.execute(
                "SELECT 1 FROM messages WHERE message_id = ?", (message.message_id,)
            ).fetchone()
            if not exists:
                # A reply can name a parent that was never delivered to any mailbox we can
                # see. Keep the message and its thread, drop the link, and say so.
                reply_to = message.reply_to
                if reply_to is not None and reply_to not in messages and not db.execute(
                    "SELECT 1 FROM messages WHERE message_id = ?", (reply_to,)
                ).fetchone():
                    reply_to = None
                    counts["dangling_replies"] += 1
                ensure(db, sender, message.sent_at, humans)
                db.execute(
                    """INSERT INTO messages(
                         message_id, thread_id, sequence, sender_mailbox_id,
                         reply_to_message_id, sent_at, subject, body, reply_to_address, team_to
                       ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                    (
                        message.message_id,
                        thread_id,
                        sequence,
                        sender,
                        reply_to,
                        message.sent_at,
                        message.subject,
                        message.body,
                        message.reply_address,
                        message.team_to,
                    ),
                )
                sequence += 1
                counts["messages"] += 1
            elif (message.reply_address or message.team_to) and not import_only:
                # Mail migrated before v4 lost these headers; the schema lets them be filled
                # once, from NULL.
                db.execute(
                    """UPDATE messages SET reply_to_address = COALESCE(reply_to_address, ?),
                                          team_to = COALESCE(team_to, ?)
                       WHERE message_id = ? AND ((reply_to_address IS NULL AND ? IS NOT NULL)
                                                 OR (team_to IS NULL AND ? IS NOT NULL))""",
                    (message.reply_address, message.team_to, message.message_id,
                     message.reply_address, message.team_to),
                )
            # A recipient whose copy was discarded or pruned before migration stays in the
            # audience, so reply-all still reaches it; no delivery is invented for it. A To
            # entry that is only another spelling of a surviving copy's mailbox (the handle
            # of <handle>-<session>) is that recipient already.
            for address in message.addressed:
                if any(r == address or r.startswith(address + "-") for r in message.recipients):
                    continue
                ensure(db, address, message.sent_at, humans)
                db.execute("INSERT OR IGNORE INTO message_recipients VALUES (?, ?)",
                           (message.message_id, address))
            for recipient, read_at in sorted(message.recipients.items()):
                ensure(db, recipient, message.sent_at, humans)
                db.execute(
                    "INSERT OR IGNORE INTO message_recipients(message_id, recipient_mailbox_id) VALUES (?, ?)",
                    (message.message_id, recipient),
                )
                db.execute(
                    """INSERT OR IGNORE INTO deliveries(
                         message_id, recipient_mailbox_id, read_at, escalated_at, delivery_seq)
                       VALUES (?, ?, ?, ?, (SELECT COALESCE(MAX(delivery_seq), 0) + 1 FROM deliveries))""",
                    (message.message_id, recipient, read_at, message.escalated.get(recipient)),
                )
                if db.execute("SELECT changes()").fetchone()[0]:
                    counts["deliveries"] += 1
                    continue
                if import_only:
                    continue
                if recipient in message.escalated:
                    db.execute("UPDATE deliveries SET escalated_at = ? WHERE message_id = ? "
                               "AND recipient_mailbox_id = ? AND escalated_at IS NULL",
                               (message.escalated[recipient], message.message_id, recipient))
                # The Maildir is authoritative: a file in new/ is unread and one in cur/ is
                # read, whatever the database said, and a file that is present is not discarded.
                db.execute(
                    """UPDATE deliveries
                       SET read_at = CASE WHEN ? IS NULL THEN NULL ELSE COALESCE(read_at, ?) END,
                           discarded_at = NULL
                       WHERE message_id = ? AND recipient_mailbox_id = ?
                         AND ((? IS NULL) != (read_at IS NULL) OR discarded_at IS NOT NULL)""",
                    (read_at, read_at, message.message_id, recipient, read_at),
                )
                counts["state_changes"] += db.execute("SELECT changes()").fetchone()[0]
    # v1's discard deletes the file. A delivery whose file has gone from an inbox that still
    # exists was discarded; a mailbox whose inbox is gone entirely is left alone, since a
    # pruned scratchpad or a wrong --agent-root says nothing about what its owner discarded.
    for mailbox, folders in ({} if import_only else boxes).items():
        inbox = folders.get("inbox")
        if inbox is None or not inbox.is_dir():
            continue
        present = {m.message_id for m in messages.values() if mailbox in m.recipients}
        sql = "SELECT message_id FROM deliveries WHERE recipient_mailbox_id = ? AND discarded_at IS NULL"
        params: tuple = (mailbox,)
        if only is not None:
            sql += " AND message_id = ?"
            params = (mailbox, only)
        for (message_id,) in db.execute(sql, params).fetchall():
            if message_id not in present:
                db.execute(
                    "UPDATE deliveries SET discarded_at = ? WHERE message_id = ? AND recipient_mailbox_id = ?",
                    (now, message_id, mailbox),
                )
                counts["discarded"] += 1
    return counts


def plan(messages: dict[str, Message]) -> str:
    grouped = threads(messages)
    lines = [
        f"maildir messages: {len(messages)}",
        f"threads: {len(grouped)}",
        f"deliveries: {sum(len(m.recipients) for m in messages.values())}",
    ]
    per_box: dict[str, int] = {}
    for message in messages.values():
        for mailbox in message.recipients:
            per_box[mailbox] = per_box.get(mailbox, 0) + 1
    for mailbox, count in sorted(per_box.items()):
        lines.append(f"  {mailbox}: {count}")
    return "\n".join(lines)


def verify(db: sqlite3.Connection, messages: dict[str, Message],
           boxes: dict[str, dict[str, Path]]) -> list[str]:
    """Every Maildir message is stored with the same sender, thread and body, and every
    delivery in a mailbox that still has an inbox is in the state its file says."""
    problems: list[str] = []
    stored = {
        row[0]: tuple(row[1:])
        for row in db.execute("SELECT message_id, sender_mailbox_id, thread_id, body, "
                              "reply_to_address, team_to FROM messages")
    }
    missing = sorted(set(messages) - set(stored))
    if missing:
        problems.append(f"{len(missing)} maildir messages are not in the database")
    parents = dict(db.execute("SELECT message_id, reply_to_message_id FROM messages"))
    for message in messages.values():
        row = stored.get(message.message_id)
        if row is not None and row != (message.sender, message.thread_id or message.message_id, message.body,
                                       message.reply_address, message.team_to):
            problems.append(f"{message.message_id} differs from its Maildir copy")
        if (row is not None and message.reply_to in messages
                and parents.get(message.message_id) != message.reply_to):
            problems.append(f"{message.message_id} lost its parent {message.reply_to}")
    for mailbox, folders in boxes.items():
        inbox = folders.get("inbox")
        if inbox is None or not inbox.is_dir():
            continue
        expected = {
            m.message_id: "unread" if m.recipients[mailbox] is None else "read"
            for m in messages.values() if mailbox in m.recipients
        }
        rows = db.execute(
            "SELECT message_id, read_at, discarded_at, escalated_at FROM deliveries WHERE recipient_mailbox_id = ?",
            (mailbox,),
        ).fetchall()
        actual = {row[0]: "discarded" if row[2] is not None else "unread" if row[1] is None else "read"
                  for row in rows}
        # Escalation only matters while unread, and v1 clears its marker on read.
        for message_id, _, _, escalated_at in rows:
            message = messages.get(message_id)
            if message is not None and expected.get(message_id) == "unread" and actual[message_id] == "unread":
                if (mailbox in message.escalated) != bool(escalated_at and escalated_at > 0):
                    problems.append(f"{message_id} is {'' if mailbox in message.escalated else 'not '}escalated "
                                    f"for {mailbox} in the Maildir, but the database disagrees")
        for message_id, state in sorted(expected.items()):
            if actual.get(message_id) != state:
                problems.append(f"{message_id} is {state} for {mailbox} in the Maildir, "
                                f"{actual.get(message_id, 'not delivered')} in the database")
        for message_id, state in sorted(actual.items()):
            if message_id not in expected and state != "discarded":
                problems.append(f"{message_id} is {state} for {mailbox} in the database "
                                "but gone from its Maildir")
    return problems


def runtime_agent_root() -> Path:
    # agent-mail's precedence, or the two would read different trees.
    return Path(
        os.environ.get("AGENT_MAIL_ROOT")
        or os.environ.get("AGENT_SCRATCH_ROOT")
        or Path.home() / ".local" / "state" / "agent" / "scratchpads"
    ).expanduser()


def runtime_database(human_root: Path) -> Path:
    """The database agent-mail mirrors into and agent-mail2 reads."""
    raw = os.environ.get("AGENT_MAIL2_DB")
    if raw:
        return Path(raw).expanduser().absolute()
    # Not a fixed home path: relocating the mail state must never write the real store.
    return human_root.parent / "mail2.sqlite3"


def database_path(explicit: str | None, human_root: Path) -> Path:
    return Path(explicit).expanduser().absolute() if explicit else runtime_database(human_root)


STORES = ("maildir", "both", "sqlite")


def store_mode(marker: Path) -> str:
    """Must read the marker exactly as bin/agent-mail does."""
    # A store name and trailing newlines, nothing else, byte for byte as bin/agent-mail checks:
    # a NUL that $(cat) would drop must not read as a store here or there.
    try:
        raw = marker.read_bytes()
    except OSError:
        return "maildir"
    match = re.fullmatch(rb"(maildir|both|sqlite)\n*", raw)
    return match.group(1).decode() if match else "maildir"


def write_store(marker: Path, mode: str) -> None:
    """By rename, so a reader never sees half a marker."""
    marker.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = marker.with_name(f".{marker.name}.{os.getpid()}")
    temporary.write_text(mode + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    os.replace(temporary, marker)


def schema_version(db_path: Path) -> int:
    db = sqlite3.connect(db_path, timeout=5)
    try:
        return db.execute("PRAGMA user_version").fetchone()[0]
    finally:
        db.close()


def backfill_pending(db: sqlite3.Connection) -> bool:
    return bool(db.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'backfill_pending'").fetchone()
                and db.execute("SELECT 1 FROM backfill_pending").fetchone())


def open_db(db_path: Path) -> sqlite3.Connection:
    # agent-mail2 owns the schema, so it creates the database and upgrades an older one.
    if not db_path.exists() or schema_version(db_path) < 4:
        # --db wins over the ambient default, so init must be told the same path. The
        # sibling, not PATH, so a launchd or systemd caller gets the same tool.
        environment = dict(os.environ, AGENT_MAIL2_DB=str(db_path))
        subprocess.run(
            [str(Path(__file__).resolve().with_name("agent-mail2")), "init"],
            check=True, capture_output=True, env=environment,
        )
    db = sqlite3.connect(db_path, timeout=5, isolation_level=None)
    db.execute("PRAGMA foreign_keys = ON")
    db.execute("PRAGMA busy_timeout = 5000")
    return db


def with_ancestors(boxes: dict[str, dict[str, Path]], db: sqlite3.Connection,
                   messages: dict[str, Message]) -> dict[str, Message]:
    """A reply mirrored before its parent would lose the link for good and land ahead of it,
    so a parent still only in the Maildir is brought in with it."""
    for _ in range(1000):
        missing = {m.reply_to for m in messages.values()
                   if m.reply_to and m.reply_to not in messages
                   and not db.execute("SELECT 1 FROM messages WHERE message_id = ?", (m.reply_to,)).fetchone()}
        found = {}
        for parent in missing:
            if parent and "/" not in parent and not parent.startswith("."):
                found.update(collect(boxes, parent))
        if not found:
            return messages
        messages = {**messages, **found}
    return messages


def apply_acknowledgement(db: sqlite3.Connection, message_id: str, operation: str, mailbox: str) -> None:
    """A read or discard that agent-mail made on the Maildir after the flip. Only ever sets a
    timestamp that is still NULL, so it cannot unread, undiscard or overwrite anything."""
    column = {"read": "read_at", "discard": "discarded_at"}[operation]
    db.execute(
        f"UPDATE deliveries SET {column} = COALESCE({column}, ?) WHERE message_id = ? AND recipient_mailbox_id = ?",
        (int(datetime.now(timezone.utc).timestamp() * 1_000_000), message_id, mailbox),
    )


def failure_text(failures: Path) -> str:
    """A record's text. For the legacy log, only what follows the prefix already retired: an
    old agent-mail still running may append to it at any time, so it is never renamed or
    truncated, and retiring it records how many bytes were checked."""
    raw = failures.read_bytes()
    if failures.name == "mirror-failures":
        raw = raw[legacy_retired(failures):]
    return raw.decode("utf-8", "replace")


def legacy_retired(failures: Path) -> int:
    try:
        return int((failures.parent / "mirror-failures.retired-bytes").read_text().strip() or 0)
    except (OSError, ValueError):
        return 0


def failure_entries(failures: Path) -> list[tuple[str, str, str]]:
    """(message id, operation, mailbox) for each logged mirror failure. Lines from before the
    operation was recorded carry only the id, and were sends."""
    entries = []
    for line in failure_text(failures).splitlines():
        fields = line.split("\t")
        if len(fields) < 3:
            continue
        operation = fields[2] if len(fields) >= 5 and fields[2] in ("send", "read", "discard") else "send"
        entries.append((fields[1], operation, fields[3] if operation != "send" else ""))
    return entries


def unrepaired(db: sqlite3.Connection, entries: list[tuple[str, str, str]]) -> list[str]:
    missing = []
    for message_id, operation, mailbox in entries:
        if not db.execute("SELECT 1 FROM messages WHERE message_id = ?", (message_id,)).fetchone():
            missing.append(message_id)
        elif operation != "send":
            column = {"read": "read_at", "discard": "discarded_at"}[operation]
            if not db.execute(f"SELECT 1 FROM deliveries WHERE message_id = ? AND recipient_mailbox_id = ? "
                              f"AND {column} IS NOT NULL", (message_id, mailbox)).fetchone():
                missing.append(f"{message_id} ({operation} by {mailbox})")
    return missing


def failure_records(state: Path) -> list[Path]:
    """Every unretired failure record: one file each in mirror-failures.d/, plus the single
    mirror-failures log that agent-mail wrote before records existed."""
    directory = state / "mirror-failures.d"
    records = sorted(p for p in directory.iterdir() if p.is_file() and not p.name.startswith(".")) \
        if directory.is_dir() else []
    legacy = state / "mirror-failures"
    pending = legacy.is_file() and legacy.stat().st_size > legacy_retired(legacy)
    return records + ([legacy] if pending else [])


def retire(record: Path) -> None:
    # A record is immutable once renamed into place, so retiring the one that was checked
    # cannot take a failure added since with it.
    if record.name == "mirror-failures":
        raise AssertionError("retire the legacy log with retire_legacy and the size it checked")
    done = record.parent / "repaired"
    done.mkdir(mode=0o700, exist_ok=True)
    record.rename(done / record.name)


def retire_legacy(failures: Path, checked: int) -> None:
    marker = failures.parent / "mirror-failures.retired-bytes"
    temporary = marker.with_name(f".{marker.name}.{os.getpid()}")
    temporary.write_text(f"{checked}\n")
    os.replace(temporary, marker)


def retire_checked(record: Path, size: int) -> None:
    if record.name == "mirror-failures":
        retire_legacy(record, size)
    else:
        retire(record)


def replay_failures(marker: Path, db_path: Path, roots: tuple[Path, Path], visibility: str) -> int:
    """Repair every recorded mirror failure: each message is synced (both) or imported (sqlite),
    and a read or discard is applied to its delivery. Each record is retired once it is in."""
    records = failure_records(marker.parent)
    if not records:
        print("no mirror failures")
        return 0
    sqlite_mode = store_mode(marker) == "sqlite"
    still: list[str] = []
    for record in records:
        # The legacy log's size before reading: only that prefix is retired if it is repaired.
        size = record.stat().st_size
        entries = failure_entries(record)
        for message_id, operation, mailbox in entries:
            run_migration(db_path, roots, visibility, message_id, import_only=sqlite_mode,
                          apply=(operation, mailbox) if operation != "send" and sqlite_mode else None)
        db = open_db(db_path)
        try:
            missing = unrepaired(db, entries)
        finally:
            db.close()
        if missing:
            still += missing
        else:
            retire_checked(record, size)
    if still:
        raise MigrationError(f"{len(still)} failures are still not repaired: {', '.join(still[:5])}")
    print(f"repaired {len(records)} mirror failure record{'s' if len(records) != 1 else ''}")
    return 0


def run_migration(db_path: Path, roots: tuple[Path, Path], visibility: str,
                  only: str | None, import_only: bool = False,
                  apply: tuple[str, str] | None = None) -> dict[str, int]:
    """With import_only, mail the database lacks is added and nothing it has is changed:
    after the flip the Maildir may still add mail, from a writer that straddled it, but it is
    no longer the record of state, so it can never discard, unread or rewrite anything."""
    # Checked here, not only in main: every path that syncs from the Maildir, the automatic
    # backfill included, must refuse once SQLite is the record, or it would discard mail
    # the Maildir never had and revert reads.
    if store_mode(roots[1].resolve().parent / "store") == "sqlite" and not import_only:
        raise MigrationError("the store is sqlite, so the Maildir is no longer the record; refusing to sync from it")
    db = open_db(db_path)
    if backfill_pending(db) and not import_only:
        # The v4 upgrade owes the headers v3 dropped a full pass from the Maildir.
        only = None
    try:
        # The snapshot is taken under the write lock. Collected before it, a migration could
        # apply a view older than a mirror that committed meanwhile: discarding mail that
        # arrived, or undoing a read.
        db.execute("BEGIN IMMEDIATE")
        # Checked at commit, so a parent filed under another thread can follow its reply.
        db.execute("PRAGMA defer_foreign_keys = ON")
        try:
            # Again under the lock: the check above can pass just before a flip, and the flip
            # writes the marker holding this lock, so only this one is authoritative.
            if store_mode(roots[1].resolve().parent / "store") == "sqlite" and not import_only:
                raise MigrationError("the store became sqlite; refusing to sync from the Maildir")
            # Discovered under the lock too: an inbox created since an earlier pass is mail.
            boxes = mailboxes(*roots)
            messages = collect(boxes, only)
            if only is not None:
                # Not the file's mtime: that is the arrival time, and this runs right after the read.
                now = int(datetime.now(timezone.utc).timestamp() * 1_000_000)
                for message in messages.values():
                    message.recipients = {box: None if state is None else now
                                          for box, state in message.recipients.items()}
                messages = with_ancestors(boxes, db, messages)
            counts = migrate(db, messages, visibility, boxes, only, import_only)
            if apply is not None and only is not None:
                apply_acknowledgement(db, only, *apply)
            if only is None and not import_only and backfill_pending(db):
                db.execute("DELETE FROM backfill_pending")
            db.execute("COMMIT")
        except BaseException:
            db.execute("ROLLBACK")
            raise
    finally:
        db.close()
    return counts


def run_verify(db_path: Path, roots: tuple[Path, Path],
               notes: list[tuple[int, str]] | None = None) -> list[str]:
    db = open_db(db_path)
    if backfill_pending(db) and store_mode(roots[1].resolve().parent / "store") != "sqlite":
        db.close()
        run_migration(db_path, roots, "public", None)
        db = open_db(db_path)
    try:
        # Under the write lock, so a mirror committing mid-check cannot read as drift.
        db.execute("BEGIN IMMEDIATE")
        try:
            # A recorded mirror failure is drift until it is replayed, whichever store holds
            # the record, so the alarm needs only this command and not the record layout.
            pending = [m for record in failure_records(roots[1].resolve().parent)
                       for m in unrepaired(db, failure_entries(record))]
            problems = [f"{len(pending)} recorded mirror failures are unrepaired ({', '.join(pending[:5])}); "
                        "run agent-mail-migrate --replay-failures"] if pending else []
            if store_mode(roots[1].resolve().parent / "store") == "sqlite":
                # The Maildir is no longer the record, so read state cannot be compared with it:
                # a post-flip read is in the database alone, and the frozen file would report
                # every one as drift. It is still frozen evidence, so completeness can be. The
                # archive only ever loses files to a pruned pad, which weakens this check and
                # can never fail it, and an empty archive would make it a tautology that passes
                # on every store, so that case says so instead of reporting success.
                archived = collect(mailboxes(*roots))
                if archived:
                    stored = {row[0]: (row[1] or row[0], row[2]) for row in db.execute(
                        "SELECT message_id, thread_id, body FROM messages")}
                    missing = sorted(set(archived) - set(stored))
                    if missing:
                        problems.append(
                            f"{len(missing)} archived messages are missing from the database "
                            f"({', '.join(missing[:3])})")
                    # Thread and body are frozen properties of the archive, so they keep the
                    # comparison the old full verify made, less the two that legitimately move:
                    # the sender canonicalization, and read state, which is the store's alone
                    # after the flip. The routing headers wait on the backfill check below.
                    drift = [m.message_id for m in archived.values()
                             if m.message_id in stored
                             and stored[m.message_id] != (m.thread_id or m.message_id, m.body)]
                    if drift:
                        problems.append(
                            f"{len(drift)} messages differ from their archived copy "
                            f"({', '.join(sorted(drift)[:3])})")
                else:
                    # An empty archive is normal for a realm that cut over empty, and then the
                    # note is all there is to say. It is not normal for a realm that had mail at
                    # the cutover, because the archive lives inside the pads and pruning them
                    # erodes it: there the reference was removed, and the check that would have
                    # caught a missing message is gone. The marker's mtime is the cutover, so
                    # the two cases are distinguishable without storing a count.
                    oldest = db.execute("SELECT MIN(sent_at) FROM messages").fetchone()[0]
                    marker = roots[1].resolve().parent / "store"
                    try:
                        cutover = int(marker.stat().st_mtime * 1_000_000)
                    except OSError:
                        cutover = None
                    # Standing conditions, not drift: neither clears up on its own, because a
                    # frozen archive is not repopulated and the migrated mail keeps its date.
                    # Reporting them as drift would make the alarm fire hourly for ever and stop
                    # it meaning "wrong now", so each gets a code the alarm can log quietly.
                    if oldest is not None and cutover is not None and oldest < cutover:
                        note = (4, "the Maildir archive holds no messages, and the store holds mail from "
                                   "before the cutover, so the reference was removed and completeness "
                                   "cannot be checked")
                    else:
                        note = (3, "the Maildir archive holds no messages, so completeness is unchecked")
                    if notes is not None:
                        notes.append(note)
                    else:
                        print(f"agent-mail-migrate: {note[1]}", file=sys.stderr)
                if db.execute("PRAGMA integrity_check").fetchone()[0] != "ok":
                    problems.append("integrity check failed")
                if backfill_pending(db):
                    problems.append("the v4 routing-header backfill never ran, and the store is already sqlite")
                return problems
            boxes = mailboxes(*roots)
            return problems + verify(db, collect(boxes), boxes)
        finally:
            db.execute("ROLLBACK")
    finally:
        db.close()


def report(counts: dict[str, int], db_path: Path) -> None:
    print(
        f"migrated {counts['messages']} messages, {counts['threads']} new threads, "
        f"{counts['deliveries']} deliveries into {db_path}"
    )
    if counts["state_changes"] or counts["discarded"]:
        print(f"  {counts['state_changes']} deliveries changed read state, "
              f"{counts['discarded']} were discarded in the Maildir")
    if counts["dangling_replies"]:
        print(
            f"  {counts['dangling_replies']} replies named a parent that is not in the Maildir; "
            "the message and its thread were kept and the link dropped",
            file=sys.stderr,
        )


def mail_digest(boxes: dict[str, dict[str, Path]]) -> dict[str, tuple]:
    """Each message's sender, thread, body and per-mailbox state, for comparing two trees."""
    return {
        m.message_id: (m.sender, m.thread_id, m.body,
                       tuple(sorted((box, state is None) for box, state in m.recipients.items())))
        for m in collect(boxes).values()
    }


def archive(marker: Path, db_path: Path, agent_root: Path, human_root: Path,
            registry: Path, label: str) -> Path:
    directory = marker.parent / "archives"
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    path = directory / f"pre-{label}-{stamp}.tar.gz"
    boxes = mailboxes(agent_root, human_root)
    for attempt in range(3):
        before = mail_digest(boxes)
        with tempfile.TemporaryDirectory(prefix="agent-mail-archive-") as scratch:
            snapshot = Path(scratch) / "mail2.sqlite3"
            if db_path.exists():
                # The backup API, not a file copy: a copy can catch the WAL mid-checkpoint.
                source = sqlite3.connect(db_path)
                target = sqlite3.connect(snapshot)
                source.backup(target)
                target.close()
                source.close()
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(descriptor, "wb") as raw, tarfile.open(fileobj=raw, mode="w:gz") as tar:
                for inbox in sorted(agent_root.glob("*/inbox")):
                    tar.add(inbox, arcname=f"agents/{inbox.parent.name}/inbox")
                if human_root.is_dir():
                    tar.add(human_root, arcname="humans")
                if registry.is_dir():
                    tar.add(registry, arcname="identities")
                if snapshot.exists():
                    tar.add(snapshot, arcname="mail2.sqlite3")
            restored = Path(scratch) / "restored"
            with tarfile.open(path) as tar:
                # Python before 3.12 has no filter argument; the archive is the one just written.
                tar.extractall(restored, **({"filter": "data"} if hasattr(tarfile, "data_filter") else {}))
            after = mail_digest(mailboxes(restored / "agents", restored / "humans"))
        # Mail that arrives while the archive is written makes the comparison differ, so retry
        # rather than accept an archive that was never shown to restore.
        if after == before == mail_digest(boxes):
            return path
    path.unlink()
    raise MigrationError("the archive did not restore to the same mail after three attempts; nothing was changed")


def finish(marker: Path, db_path: Path, agent_root: Path, human_root: Path) -> int:
    if store_mode(marker) == "maildir":
        raise MigrationError("the store is maildir, so there is no migration to finish")
    if store_mode(marker) == "both":
        problems = run_verify(db_path, (agent_root, human_root))
        if problems:
            for problem in problems:
                print(f"agent-mail-migrate: {problem}", file=sys.stderr)
            raise MigrationError(f"{len(problems)} problems; the archives were kept")
    # An import that failed is only in the Maildir until someone repairs it, and the archive
    # and the failure log are how anyone would know: both stay until every one is in SQLite.
    records = failure_records(marker.parent)
    if records:
        sizes = {record: record.stat().st_size for record in records}
        db = open_db(db_path)
        try:
            missing = [m for record in records for m in unrepaired(db, failure_entries(record))]
        finally:
            db.close()
        if missing:
            raise MigrationError(f"{len(missing)} failed mirrors are not repaired ({', '.join(missing[:5])}); "
                                 "run agent-mail-migrate --replay-failures first")
        for record in records:
            retire_checked(record, sizes[record])
    directory = marker.parent / "archives"
    removed = sorted(directory.glob("*.tar.gz")) if directory.is_dir() else []
    for path in removed:
        path.unlink()
    (marker.parent / "migration-finished").write_text(
        datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") + "\n", encoding="utf-8")
    print(f"migration finished; removed {len(removed)} archive{'s' if len(removed) != 1 else ''}")
    return 0


def flip_to_sqlite(marker: Path, db_path: Path, roots: tuple[Path, Path], visibility: str) -> int:
    # One last full sync while the Maildir is still the record, so the backfill and every
    # read and discard are in, then a clean verify before anything is written.
    run_migration(db_path, roots, visibility, None)
    problems = run_verify(db_path, roots)
    if problems:
        for problem in problems:
            print(f"agent-mail-migrate: {problem}", file=sys.stderr)
        raise MigrationError(f"{len(problems)} problems; the store marker was not changed")
    # The marker is written holding the database's write lock, so a migration either finished
    # before it or sees sqlite when it takes the lock.
    db = open_db(db_path)
    try:
        db.execute("BEGIN IMMEDIATE")
        write_store(marker, "sqlite")
        db.execute("COMMIT")
    finally:
        db.close()
    # Anything delivered between that verify and the marker, by a writer whose mirror then
    # failed or that read the marker before the write, is added now. From here on the same
    # import runs as each straddling writer's mirror.
    counts = run_migration(db_path, roots, visibility, None, import_only=True)
    print(f"store is sqlite: agent-mail2 holds the mail in {db_path}"
          + (f"; {counts['messages']} messages delivered during the switch were added" if counts["messages"] else ""))
    return 0


def set_store(target: str, marker: Path, db_path: Path, agent_root: Path, human_root: Path,
              visibility: str, registry: Path) -> int:
    import fcntl

    # One transition at a time, and the current store read only once the lock is held: a
    # switch that read both, paused, and wrote maildir after a flip would hide SQLite-only mail.
    marker.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(marker.parent / ".store.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return switch_store(target, marker, db_path, agent_root, human_root, visibility, registry)


def switch_store(target: str, marker: Path, db_path: Path, agent_root: Path, human_root: Path,
                 visibility: str, registry: Path) -> int:
    current = store_mode(marker)
    if target == current:
        print(f"store is already {current}")
        return 0
    if current == "sqlite":
        raise MigrationError(
            "the store is sqlite, so mail since the flip exists only in the database; "
            "leaving it would strand that mail"
        )
    if target == "sqlite" and current != "both":
        raise MigrationError("switch to both first: the flip to sqlite is from a verified mirror, not from the Maildir")
    if target == "maildir":
        write_store(marker, "maildir")
        print("store is maildir; the database is no longer written")
        return 0
    # Only the default database can be the runtime store: agent-mail2 recognises it as the one
    # whose mail notifies Josh, and a custom one would deliver silently.
    runtime = human_root.parent / "mail2.sqlite3"
    if db_path.resolve() != runtime.resolve():
        raise MigrationError(f"the runtime store is {runtime}, so the store cannot be switched over {db_path}; "
                             "unset AGENT_MAIL2_DB and --db")
    if agent_root.resolve() != runtime_agent_root().resolve():
        raise MigrationError(f"agent-mail delivers under {runtime_agent_root()}, so the store cannot be switched from {agent_root}")
    saved = archive(marker, db_path, agent_root, human_root, registry, target)
    print(f"archived and restored the mail to {saved}")
    if target == "sqlite":
        return flip_to_sqlite(marker, db_path, (agent_root, human_root), visibility)
    run_migration(db_path, (agent_root, human_root), visibility, None)
    problems = run_verify(db_path, (agent_root, human_root))
    if problems:
        for problem in problems:
            print(f"agent-mail-migrate: {problem}", file=sys.stderr)
        raise MigrationError(f"{len(problems)} problems; the store marker was not changed")
    write_store(marker, "both")
    # A send between the verify and the marker write was mirrored by nobody.
    run_migration(db_path, (agent_root, human_root), visibility, None)
    problems = run_verify(db_path, (agent_root, human_root))
    for problem in problems:
        print(f"agent-mail-migrate: {problem}", file=sys.stderr)
    print(f"store is both: the Maildir stays authoritative and every change is mirrored into {db_path}")
    return 1 if problems else 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--db")
    parser.add_argument("--agent-root")
    parser.add_argument("--human-root")
    parser.add_argument("--visibility", choices=("public", "private"), default="public")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true")
    mode.add_argument("--verify", action="store_true")
    mode.add_argument("--message", metavar="ID")
    mode.add_argument("--set-store", choices=STORES)
    mode.add_argument("--finish", action="store_true")
    mode.add_argument("--replay-failures", action="store_true")
    parser.add_argument("--import-only", action="store_true",
                        help="add mail the database lacks and change nothing it has (the mirror after the flip)")
    parser.add_argument("--apply", choices=("read", "discard"),
                        help="with --message: apply this acknowledgement to --mailbox's delivery")
    parser.add_argument("--mailbox")
    parser.add_argument("--quiet", action="store_true")
    args = parser.parse_args()

    agent_root = Path(args.agent_root).expanduser() if args.agent_root else runtime_agent_root()
    # Resolved as agent-mail resolves it (pwd -P), or a symlinked root would put the marker
    # and the database somewhere agent-mail never looks.
    human_root = Path(
        args.human_root
        or os.environ.get("AGENT_HUMAN_MAIL_ROOT")
        or Path.home() / ".local" / "state" / "agent-mail" / "humans"
    ).expanduser().resolve()
    db_path = database_path(args.db, human_root)
    marker = human_root.parent / "store"
    if args.message is not None and (not args.message or "/" in args.message or args.message.startswith(".")):
        parser.error("--message takes a message id")
    if args.apply and not (args.message and args.mailbox):
        parser.error("--apply needs --message and --mailbox")

    try:
        if args.set_store:
            registry = Path(os.environ.get("AGENT_IDENTITIES_DIR") or "~/.pi/agent/identities/by-name").expanduser()
            return set_store(args.set_store, marker, db_path, agent_root, human_root, args.visibility, registry)
        if args.finish:
            return finish(marker, db_path, agent_root, human_root)
        if args.replay_failures:
            return replay_failures(marker, db_path, (agent_root, human_root), args.visibility)
        if args.dry_run:
            print(plan(collect(mailboxes(agent_root, human_root))))
            return 0
        if args.verify:
            notes: list[tuple[int, str]] = []
            problems = run_verify(db_path, (agent_root, human_root), notes)
            for problem in problems:
                print(f"agent-mail-migrate: {problem}", file=sys.stderr)
            for _, text in notes:
                print(f"agent-mail-migrate: {text}", file=sys.stderr)
            if problems:
                print(f"{len(problems)} problems")
                return 1
            if not notes:
                print("verified")
                return 0
            # Neither a pass nor a failure, and not drift: nothing is wrong now, but a check did
            # not run and will not start working again. 3 means it never could, 4 means the
            # reference was removed. Both are logged rather than mailed, because a standing
            # condition mailed hourly is an alarm nobody reads, and drift has to stay the one
            # thing that mails.
            print("verified (completeness unchecked: no archived mail)")
            return max(code for code, _ in notes)
        counts = run_migration(db_path, (agent_root, human_root), args.visibility, args.message, args.import_only,
                               (args.apply, args.mailbox) if args.apply else None)
    except (MigrationError, OSError, sqlite3.Error, subprocess.CalledProcessError, tarfile.TarError) as error:
        print(f"agent-mail-migrate: {error}", file=sys.stderr)
        return 1

    if not args.quiet:
        report(counts, db_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
