#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: agent-trailer [--raw] [--email] [--name NAME]

Print the trailer identifying the agent behind a commit, comment, or document:

  Co-authored-by: AI <session name> (<harness>/<provider>/<model>)

One key everywhere, so `grep "Co-authored-by: AI"` finds agent work whatever
surface it landed on. The session name is omitted when unknown. Values come
from the running harness's environment, not from the model's self-report
(models routinely guess their own name wrong).

Options:
  --raw         Print "<harness>/<provider>/<model>" without the trailer prefix.
  --email       Append "<git user.email +pi>". Only GitHub's commit parser
                needs it; in comments and prose it is an address on display
                for nothing.
  --name NAME   Session name to use instead of $AGENT_NAME.
  -h, --help    Show this help.
USAGE
}

raw=0
with_email=0
name="${AGENT_NAME:-}"

while [ $# -gt 0 ]; do
  case "$1" in
    --raw) raw=1 ;;
    --email) with_email=1 ;;
    --name)
      name="${2:-}"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    "") ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
  shift
done

harness=unknown
provider=unknown
model=unknown

if [ -n "${PI_MODEL:-}" ] || [ -n "${PI_CODING_AGENT:-}" ]; then
  harness=pi
  provider="${PI_PROVIDER:-unknown}"
  model="${PI_MODEL:-unknown}"
  if [ -n "${PI_PACKAGE_DIR:-}" ]; then
    harness="pi-$(basename "$PI_PACKAGE_DIR" | sed 's/^pi-//')"
  fi
elif [ -n "${CLAUDECODE:-}" ] || [ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ]; then
  harness=claude-code
  provider=anthropic
  model="${ANTHROPIC_MODEL:-${CLAUDE_MODEL:-unknown}}"
elif [ -n "${CURSOR_AGENT:-}" ]; then
  harness=cursor
  provider="${CURSOR_PROVIDER:-unknown}"
  model="${CURSOR_MODEL:-unknown}"
elif [ -n "${CODEX_HOME:-}" ] || [ -n "${CODEX_SANDBOX:-}" ]; then
  harness=codex
  provider=openai
  model="${CODEX_MODEL:-unknown}"
elif [ -n "${AIDER_MODEL:-}" ]; then
  harness=aider
  provider=unknown
  model="$AIDER_MODEL"
fi

# The proxy provider ids carry routing hints ("-250k-prefer-using-this-one")
# that mean nothing to a PR reader; keep only the vendor prefix.
provider="${provider%%-*}"

id="$harness/$provider/$model"

if [ "$raw" -eq 1 ]; then
  printf '%s\n' "$id"
  exit 0
fi

who="AI"
[ -n "$name" ] && who="AI $name"

suffix=""
if [ "$with_email" -eq 1 ]; then
  # +pi tags the address so agent commits are filterable and never collide with
  # Josh's own authorship, while still resolving to a real mailbox.
  email="$(git config user.email 2>/dev/null || true)"
  case "$email" in
    *@*) email="${email%@*}+pi@${email##*@}" ;;
    *) email="josh+pi@joshbeckman.org" ;;
  esac
  suffix=" <$email>"
fi

printf 'Co-authored-by: %s (%s)%s\n' "$who" "$id" "$suffix"
