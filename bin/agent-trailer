#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: agent-trailer [--raw] [--email] [--name NAME]

Print the trailer identifying the agent behind a commit, comment, or document:

  Co-authored-by: AI <session name> (<harness>/<provider>/<model>)

One key everywhere, so `grep "Co-authored-by: AI"` finds agent work whatever
surface it landed on. The session name is omitted when unknown. Values come
from the running harness's environment, not from the model's self-report
(models routinely guess their own name wrong).

Options:
  --raw         Print "<harness>/<provider>/<model>" without the trailer prefix.
  --email       Append "<git user.email +pi>". Only GitHub's commit parser
                needs it; in comments and prose it is an address on display
                for nothing.
  --name NAME   Session name to use instead of $AGENT_NAME.
  -h, --help    Show this help.
USAGE
}

raw=0
with_email=0
name="${AGENT_NAME:-}"

while [ $# -gt 0 ]; do
  case "$1" in
    --raw) raw=1 ;;
    --email) with_email=1 ;;
    --name)
      name="${2:-}"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    "") ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
  shift
done

harness=unknown
provider=unknown
model=unknown

# PI_MODEL/PI_PROVIDER are injected per bash-tool invocation rather than exported
# into pi's process environment, so shell escapes, tmux panes, commit hooks and
# extension subprocesses see only PI_CODING_AGENT. Recover the pair from the
# session transcript there instead of reporting unknown/unknown.
pi_session_model() {
  _sid="${PI_SESSION_ID:-}"
  if [ -z "$_sid" ] && [ -n "${AGENT_NAME:-}" ]; then
    _slug="$(printf '%s' "$AGENT_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//')"
    _sid="$(cat "$HOME/.pi/agent/identities/by-name/$_slug" 2>/dev/null || true)"
    # Sessions allocated before the realm existed carry a bare two-word
    # AGENT_NAME, but their registry claims were normalized to the realm-suffixed
    # form; retry with the suffix so live pre-realm agents still resolve.
    if [ -z "$_sid" ] && [ -f "$HOME/.config/agent-realm" ]; then
      _realm="$(tr '[:upper:]' '[:lower:]' < "$HOME/.config/agent-realm" | tr -d '[:space:]')"
      [ -n "$_realm" ] && _sid="$(cat "$HOME/.pi/agent/identities/by-name/$_slug-of-$_realm" 2>/dev/null || true)"
    fi
  fi
  [ -n "$_sid" ] || return 1
  _file="${PI_SESSION_FILE:-}"
  if [ ! -f "$_file" ]; then
    _file="$(find "$HOME/.pi/agent/sessions" -name "*_$_sid.jsonl" -print -quit 2>/dev/null)"
  fi
  [ -f "$_file" ] || return 1
  # Last model_change wins: the trailer should name the model that is running now,
  # not whichever one the session happened to start with.
  _line="$(grep '"type":"model_change"' "$_file" 2>/dev/null | tail -1)"
  [ -n "$_line" ] || return 1
  # Extracted independently because the two keys are not emitted in a fixed order.
  _p="$(printf '%s' "$_line" | sed -n 's/.*"provider":"\([^"]*\)".*/\1/p')"
  _m="$(printf '%s' "$_line" | sed -n 's/.*"modelId":"\([^"]*\)".*/\1/p')"
  [ -n "$_p" ] && [ -n "$_m" ] || return 1
  printf '%s %s\n' "$_p" "$_m"
}

# getPackageDir() reads PI_PACKAGE_DIR as a Nix/Guix *input* override; pi never
# exports it, so the version has to come from the installed package itself.
pi_version() {
  _bin="$(command -v pi 2>/dev/null)" || return 1
  _dir="$(dirname "$(readlink "$_bin" 2>/dev/null || printf '%s' "$_bin")")"
  case "$_dir" in /*) ;; *) _dir="$(cd "$(dirname "$_bin")" && cd "$_dir" && pwd)" ;; esac
  while [ "$_dir" != "/" ]; do
    # Keep walking past a package.json that is not pi's own: a project-local
    # install puts the app's manifest on this path, and reporting its version as
    # the harness version would be wrong in a way nobody would notice.
    # piConfig covers rebuilds that rename the binary away from "pi".
    if [ -f "$_dir/package.json" ] && grep -q '"pi-coding-agent\|"piConfig"' "$_dir/package.json"; then
      sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$_dir/package.json" | head -1
      return 0
    fi
    _dir="$(dirname "$_dir")"
  done
  return 1
}

if [ -n "${PI_MODEL:-}" ] || [ -n "${PI_CODING_AGENT:-}" ]; then
  harness=pi
  provider="${PI_PROVIDER:-unknown}"
  model="${PI_MODEL:-unknown}"
  if [ "$model" = unknown ] || [ "$provider" = unknown ]; then
    recovered="$(pi_session_model || true)"
    if [ -n "$recovered" ]; then
      provider="${recovered%% *}"
      model="${recovered##* }"
    fi
  fi
  if [ -n "${PI_PACKAGE_DIR:-}" ]; then
    harness="pi-$(basename "$PI_PACKAGE_DIR" | sed 's/^pi-//')"
  else
    version="$(pi_version || true)"
    [ -n "$version" ] && harness="pi-$version"
  fi
elif [ -n "${CLAUDECODE:-}" ] || [ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ]; then
  harness=claude-code
  provider=anthropic
  model="${ANTHROPIC_MODEL:-${CLAUDE_MODEL:-unknown}}"
elif [ -n "${CURSOR_AGENT:-}" ]; then
  harness=cursor
  provider="${CURSOR_PROVIDER:-unknown}"
  model="${CURSOR_MODEL:-unknown}"
elif [ -n "${CODEX_HOME:-}" ] || [ -n "${CODEX_SANDBOX:-}" ]; then
  harness=codex
  provider=openai
  model="${CODEX_MODEL:-unknown}"
elif [ -n "${AIDER_MODEL:-}" ]; then
  harness=aider
  provider=unknown
  model="$AIDER_MODEL"
fi

# The proxy provider ids carry routing hints ("-250k-prefer-using-this-one")
# that mean nothing to a PR reader; keep only the vendor prefix.
provider="${provider%%-*}"

id="$harness/$provider/$model"

if [ "$raw" -eq 1 ]; then
  printf '%s\n' "$id"
  exit 0
fi

who="AI"
[ -n "$name" ] && who="AI $name"

suffix=""
if [ "$with_email" -eq 1 ]; then
  # +pi tags the address so agent commits are filterable and never collide with
  # Josh's own authorship, while still resolving to a real mailbox.
  email="$(git config user.email 2>/dev/null || true)"
  case "$email" in
    *@*) email="${email%@*}+pi@${email##*@}" ;;
    *) email="josh+pi@joshbeckman.org" ;;
  esac
  suffix=" <$email>"
fi

printf 'Co-authored-by: %s (%s)%s\n' "$who" "$id" "$suffix"
