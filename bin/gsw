#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: gsw <gs-args...>

Run gs with automatic agent attribution on prose-bearing PR writes. Human and
read-only calls pass through unchanged.

Examples:
  gsw submit --body-file /tmp/pr.md
  gsw pr comment 123 --body "Found the failing boundary."
  gsw pr review 123 --approve --body-file /tmp/review.md
USAGE
}

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 2
fi

case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
esac

command -v gs >/dev/null 2>&1 || { echo "gsw: gs not found" >&2; exit 127; }

under_agent() {
  command -v agent-trailer >/dev/null 2>&1 || return 1
  [[ "$(agent-trailer --raw 2>/dev/null || echo unknown/unknown/unknown)" != "unknown/unknown/unknown" ]]
}

has_help_flag() {
  local arg
  for arg in "$@"; do
    case "$arg" in -h|--help) return 0 ;; esac
  done
  return 1
}

has_flag() {
  local wanted="$1" arg
  shift
  for arg in "$@"; do
    [[ "$arg" == "$wanted" ]] && return 0
  done
  return 1
}

writes_prose() {
  [[ "$1" == submit ]] && return 0
  case "$1 ${2:-}" in
    "pr create" | "pr comment" | "pr review" | "pr edit") return 0 ;;
  esac
  return 1
}

trailer_tmp=""
inject_trailer() {
  local i idx=-1 kind="" value="" joined=0 content already=0 trailer
  for ((i = 0; i < ${#args[@]}; i++)); do
    case "${args[i]}" in
      --body|-b)
        kind=inline; idx=$i; value="${args[i + 1]-}"; joined=0
        ;;
      --body-file|-F)
        kind=file; idx=$i; value="${args[i + 1]-}"; joined=0
        ;;
      --body=*)
        kind=inline; idx=$i; value="${args[i]#--body=}"; joined=1
        ;;
      --body-file=*)
        kind=file; idx=$i; value="${args[i]#--body-file=}"; joined=1
        ;;
    esac
  done

  # Some verbs legitimately write no prose (an approval or label edit), while
  # submit may only be updating an existing PR. Do not invent a body that could
  # change gs semantics merely to force attribution.
  [[ $idx -ge 0 ]] || return 0

  if [[ $kind == file ]]; then
    if [[ $value == "-" ]]; then content="$(cat)"; else content="$(cat "$value")"; fi
  else
    content="$value"
  fi

  # Preserve other agents' attribution and append this editor. Suppress only
  # the exact current trailer so a rewrite cannot remain credited solely to its
  # original owner.
  trailer="$(agent-trailer)"
  if printf '%s\n' "$content" | grep -Fqx -- "$trailer"; then already=1; fi
  # stdin was consumed while checking it, so even an already-attributed body has
  # to be materialized before gs can read it. Files and inline args can pass
  # through untouched when they already carry the trailer.
  if [[ $already -eq 1 && ! ( $kind == file && $value == "-" ) ]]; then return 0; fi

  trailer_tmp="$(mktemp "${TMPDIR:-/tmp}/gsw-body.XXXXXX")"
  trap 'rm -f "$trailer_tmp"' EXIT HUP INT TERM
  if [[ $already -eq 1 ]]; then
    printf '%s\n' "$content" > "$trailer_tmp"
  else
    printf '%s\n\n%s\n' "$content" "$trailer" > "$trailer_tmp"
  fi
  if [[ $joined -eq 1 ]]; then
    args[idx]="--body-file=$trailer_tmp"
  else
    args[idx]="--body-file"
    args[idx + 1]="$trailer_tmp"
  fi
}

cmd="$1"
subcmd="${2:-}"
args=("$@")
is_agent=0
under_agent && is_agent=1

if [[ $is_agent -eq 1 ]] && ! has_help_flag "$@"; then
  if [[ $cmd == submit ]] && has_flag --stack "$@" && ! has_flag --dry-run "$@" && ! has_flag --push-only "$@"; then
    echo "gsw: agent stack submission can create multiple PR bodies; verify attribution on each new PR" >&2
  fi
  if writes_prose "$cmd" "$subcmd"; then inject_trailer; fi
fi

submitted_stack_urls() {
  local branch common state numbers number
  branch="$(git branch --show-current 2>/dev/null || true)"
  common="$(git rev-parse --git-common-dir 2>/dev/null || true)"
  [[ -n "$branch" && -n "$common" ]] || return 0
  state="$common/.gs/state.json"
  [[ -f "$state" ]] || return 0
  numbers="$(ruby -rjson -e '
    state = JSON.parse(File.read(ARGV.fetch(0)))
    current = ARGV.fetch(1)
    branches = state.fetch("branches", {})
    selected = []
    node = current
    while branches.key?(node)
      selected << node
      node = branches.fetch(node)["parent"]
    end
    if ARGV.fetch(2) == "true"
      queue = [current]
      until queue.empty?
        parent = queue.shift
        children = branches.select { |_name, data| data["parent"] == parent }.keys
        selected.concat(children)
        queue.concat(children)
      end
    end
    selected.uniq.map { |name| branches.dig(name, "prNumber") }.compact.each { |number| puts number }
  ' "$state" "$branch" "$(has_flag --stack "${args[@]}" && echo true || echo false)" 2>/dev/null || true)"
  while IFS= read -r number; do
    [[ -n "$number" ]] || continue
    gs pr view "$number" --json 2>/dev/null |
      ruby -rjson -e 'pr = JSON.parse(STDIN.read); puts(pr["htmlUrl"] || pr["url"]) unless pr["xGitstreamStateExtended"] == "merged"' 2>/dev/null || true
  done <<<"$numbers"
}

# Capture newly-created PR URLs at the attributed write boundary. This handles
# multi-PR stack submissions without asking the model to remember registration.
gs_run_and_register() {
  local output rc=0 branch urls url
  output="$(mktemp "${TMPDIR:-/tmp}/gsw-create.XXXXXX")"
  gs "${args[@]}" >"$output" || rc=$?
  cat "$output"
  if [[ $rc -eq 0 ]]; then
    urls="$(grep -Eo 'https://[^[:space:][:cntrl:]]+/(repos/)?[^/[:space:]]+/[^/[:space:]]+/(pull|pulls)/[0-9]+' "$output" | sort -u || true)"
    if [[ $cmd == submit ]] && has_flag --stack "${args[@]}"; then
      urls="$(printf '%s\n%s\n' "$urls" "$(submitted_stack_urls)" | sed '/^$/d' | sort -u)"
    fi
    if [[ -z "$urls" ]]; then
      branch="$(git branch --show-current 2>/dev/null || true)"
      if [[ -n "$branch" ]]; then
        urls="$(gs pr list --head "$branch" --state all --json 2>/dev/null |
          ruby -rjson -e 'JSON.parse(STDIN.read).each { |pr| puts(pr["htmlUrl"] || pr["url"]) }' 2>/dev/null || true)"
      fi
    fi
    if [[ -z "$urls" ]]; then
      echo "gsw: PR write succeeded but no URL was available for ownership monitoring" >&2
    elif ! command -v agent-pr-monitor >/dev/null 2>&1; then
      echo "gsw: PR write succeeded but agent-pr-monitor is unavailable" >&2
    else
      while IFS= read -r url; do
        [[ -n "$url" ]] || continue
        agent-pr-monitor own "$url" --provider gitstream --cwd "$PWD" >&2 ||
          echo "gsw: PR written but ownership monitoring failed; run: agent-pr-monitor own $url --provider gitstream --cwd $PWD" >&2
      done <<<"$urls"
    fi
  fi
  rm -f "$output"
  [[ -z "$trailer_tmp" ]] || rm -f "$trailer_tmp"
  exit "$rc"
}

if [[ $is_agent -eq 1 ]] && ! has_help_flag "${args[@]}"; then
  if [[ $cmd == pr && $subcmd == create ]] || {
    [[ $cmd == submit ]] && ! has_flag --dry-run "${args[@]}" && ! has_flag --push-only "${args[@]}"
  }; then
    gs_run_and_register
  fi
fi

if [[ -n "$trailer_tmp" ]]; then
  rc=0
  gs "${args[@]}" || rc=$?
  rm -f "$trailer_tmp"
  exit "$rc"
fi

exec gs "${args[@]}"
