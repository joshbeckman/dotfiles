#!/usr/bin/env bash
set -euo pipefail

# Let gh interpret remotes; parsing URLs here breaks on renamed repositories and enterprise hosts.
repo_args=()
if [[ -n "${GW_REPO:-}" ]]; then
  repo_args=(--repo "$GW_REPO")
fi

# Attribution is a property of the write path, not something a model has to
# remember: an agent that never read AGENTS.md still cannot post prose here
# without a trailer. Detection is by harness environment, so a human running
# gw gets byte-identical behaviour to plain gh.
under_agent() {
  command -v agent-trailer >/dev/null 2>&1 || return 1
  [ "$(agent-trailer --raw 2>/dev/null || echo unknown/unknown/unknown)" != "unknown/unknown/unknown" ]
}

writes_prose() {
  case "$1 ${2:-}" in
    "issue comment" | "pr comment" | "pr create" | "issue create" | "pr review" | "pr edit" | "issue edit") return 0 ;;
    "issue close" | "pr close" | "issue reopen" | "pr reopen") return 0 ;;
  esac
  return 1
}

# Rewrites args[] so the body always arrives as a file we control. Handling
# --body and --body-file through one path avoids quoting a trailer back into an
# inline argument.
trailer_tmp=""
metadata_value_option() {
  case "$1" in
    --title|-t|--base|-B|--head|-H|--repo|-R) return 0 ;;
    --assignee|-a|--reviewer|-r|--label|-l|--project|-p) return 0 ;;
    --milestone|-m|--template|-T|--recover|--attach|--reason) return 0 ;;
    --add-assignee|--remove-assignee|--add-reviewer|--remove-reviewer) return 0 ;;
    --add-label|--remove-label|--add-project|--remove-project|--type|--parent) return 0 ;;
    --blocked-by|--blocking|--add-blocked-by|--remove-blocked-by) return 0 ;;
    --add-blocking|--remove-blocking|--add-sub-issue|--remove-sub-issue) return 0 ;;
  esac
  return 1
}

inject_trailer() {
  local mode="${1:-body}"
  local presentation="${2:-artifact}"
  local i idx=-1 kind="" value="" joined=0 content
  for ((i = 0; i < ${#args[@]}; i++)); do
    if metadata_value_option "${args[i]}"; then
      [[ $((i + 1)) -lt ${#args[@]} ]] || { echo 'gw: metadata option requires a value' >&2; return 2; }
      ((i+=1))
      continue
    fi
    if [[ $mode == comment ]]; then
      case "${args[i]}" in
        --comment | -c)
          [[ $((i + 1)) -lt ${#args[@]} ]] || { echo 'gw: comment option requires a value' >&2; return 2; }
          kind=inline; idx=$i; value="${args[i + 1]}"; joined=0; ((i+=1)) ;;
        -c=*) kind=inline; idx=$i; value="${args[i]#-c=}"; joined=1 ;;
        -c?*) kind=inline; idx=$i; value="${args[i]#-c}"; joined=1 ;;
        --comment=*) kind=inline; idx=$i; value="${args[i]#--comment=}"; joined=1 ;;
      esac
    else
      case "${args[i]}" in
        --body | -b)
          [[ $((i + 1)) -lt ${#args[@]} ]] || { echo 'gw: body option requires a value' >&2; return 2; }
          kind=inline; idx=$i; value="${args[i + 1]}"; joined=0; ((i+=1)) ;;
        -b=*) kind=inline; idx=$i; value="${args[i]#-b=}"; joined=1 ;;
        -b?*) kind=inline; idx=$i; value="${args[i]#-b}"; joined=1 ;;
        -F=*) kind=file; idx=$i; value="${args[i]#-F=}"; joined=1 ;;
        -F?*) kind=file; idx=$i; value="${args[i]#-F}"; joined=1 ;;
        --body=*) kind=inline; idx=$i; value="${args[i]#--body=}"; joined=1 ;;
        --body-file | -F)
          [[ $((i + 1)) -lt ${#args[@]} ]] || { echo 'gw: body-file option requires a value' >&2; return 2; }
          kind=file; idx=$i; value="${args[i + 1]}"; joined=0; ((i+=1)) ;;
        --body-file=*) kind=file; idx=$i; value="${args[i]#--body-file=}"; joined=1 ;;
      esac
    fi
  done

  # No prose flag: close/reopen without --comment posts no prose at all, and a
  # bodyless create/edit means gh builds one itself (--fill) or opens an
  # editor. Neither should have a flag invented for it.
  if [[ $idx -lt 0 ]]; then
    [[ $mode == comment ]] || echo "gw: no --body/--body-file; add the agent-trailer output yourself" >&2
    return 0
  fi

  if [[ $kind == file ]]; then
    if [[ $value == "-" ]]; then
      content="$(cat)"
    else
      content="$(cat -- "$value")"
    fi
  else
    content="$value"
  fi

  # Suppress only this editor's exact trailer. A different agent's line is
  # provenance, so keep it and add the current editor rather than crediting the
  # original owner for a rewrite they did not make.
  local trailer
  trailer="$(agent-trailer)"
  local already=0
  if printf '%s\n' "$content" | grep -Fqx -- "$trailer"; then
    already=1
    # Reading stdin consumed it; preserve an already-attributed body in a file.
    if [[ ! ( $kind == file && $value == "-" ) ]]; then return 0; fi
  fi

  if [[ $already -eq 0 ]]; then
    if [[ $presentation == conversation ]]; then
      content="$trailer"$'\n\n'"$(printf '%s\n' "$content" | sed 's/^/> /; s/^> $/>/')"
    else
      content="$content"$'\n\n'"$trailer"
    fi
  fi

  # --comment has no file variant, so the attributed body rides inline; args
  # are passed as an array straight to exec, so embedded newlines survive.
  if [[ $mode == comment ]]; then
    if [[ $joined -eq 1 ]]; then
      args[idx]="--comment=$content"
    else
      args[idx + 1]="$content"
    fi
    return 0
  fi

  trailer_tmp="$(mktemp "${TMPDIR:-/tmp}/gw-body.XXXXXX")"
  printf '%s\n' "$content" > "$trailer_tmp"
  if [[ $joined -eq 1 ]]; then
    args[idx]="--body-file=$trailer_tmp"
  else
    args[idx]="--body-file"
    args[idx + 1]="$trailer_tmp"
  fi
}

usage() {
  cat <<EOF
Usage: gw <gh-args...>

Uses gh's current repository, with current-branch selection for PR commands.
Set GW_REPO=owner/repo to override repository discovery.

Examples:
  gw pr status
  gw pr view
  gw pr checks
  gw issue list
  gw issue view 123
EOF
}

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 2
fi

case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
esac

cmd="$1"
shift

has_help_flag() {
  local i
  local fields=("$@")
  for ((i = 0; i < ${#fields[@]}; i++)); do
    if metadata_value_option "${fields[i]}"; then ((i+=1)); continue; fi
    case "${fields[i]}" in --body|-b|--body-file|-F) ((i+=1)); continue ;; esac
    if [[ "${cmd:-} ${fields[0]:-}" == 'pr close' || "${cmd:-} ${fields[0]:-}" == 'pr reopen' || "${cmd:-} ${fields[0]:-}" == 'issue close' || "${cmd:-} ${fields[0]:-}" == 'issue reopen' ]]; then
      case "${fields[i]}" in --comment|-c) ((i+=1)); continue ;; esac
    fi
    case "${fields[i]}" in -h|--help) return 0 ;; esac
  done
  return 1
}

current_branch() {
  git branch --show-current 2>/dev/null || true
}

# Not exec: the temp body has to outlive gh and be cleaned up afterwards.
gh_run() {
  if [[ -n "$trailer_tmp" ]]; then
    local rc=0
    gh "$@" || rc=$?
    rm -f "$trailer_tmp"
    exit "$rc"
  fi
  exec gh "$@"
}

pr_selector_defaults_to_branch() {
  case "${1:-}" in
    view|checks|diff|comment|edit|review|merge|close|reopen|ready|lock|unlock)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

args=("$@")
if [[ ${#args[@]} -gt 0 ]] && under_agent && writes_prose "$cmd" "${args[0]}" && ! has_help_flag "${args[@]}"; then
  case "$cmd ${args[0]}" in
    "issue comment" | "pr comment" | "pr review") inject_trailer body conversation ;;
    "issue close" | "pr close" | "issue reopen" | "pr reopen") inject_trailer comment conversation ;;
    *) inject_trailer body artifact ;;
  esac
fi
set -- "${args[@]}"

case "$cmd" in
  pr)
    if [[ $# -gt 0 ]] && pr_selector_defaults_to_branch "$1" && ! has_help_flag "$@"; then
      subcmd="$1"
      shift
      case "${1:-}" in
        ""|-*)
          branch="$(current_branch)"
          if [[ -n "$branch" ]]; then
            gh_run pr ${repo_args[@]+"${repo_args[@]}"} "$subcmd" "$branch" "$@"
          fi
          ;;
      esac
      gh_run pr ${repo_args[@]+"${repo_args[@]}"} "$subcmd" "$@"
    fi
    gh_run pr ${repo_args[@]+"${repo_args[@]}"} "$@"
    ;;
  issue|release|run|workflow|label|milestone|browse|project|ruleset|secret|variable|cache)
    gh_run "$cmd" ${repo_args[@]+"${repo_args[@]}"} "$@"
    ;;
  *)
    gh_run "$cmd" "$@"
    ;;
esac
