#!/usr/bin/env bash
set -euo pipefail

# Let gh interpret remotes; parsing URLs here breaks on renamed repositories and enterprise hosts.
repo_args=()
if [[ -n "${GW_REPO:-}" ]]; then
  repo_args=(--repo "$GW_REPO")
fi

# Attribution is a property of the write path, not something a model has to
# remember: an agent that never read AGENTS.md still cannot post prose here
# without a trailer. Detection is by harness environment, so a human running
# gw gets byte-identical behaviour to plain gh.
under_agent() {
  command -v agent-trailer >/dev/null 2>&1 || return 1
  [ "$(agent-trailer --raw 2>/dev/null || echo unknown/unknown/unknown)" != "unknown/unknown/unknown" ]
}

writes_prose() {
  case "$1 ${2:-}" in
    "issue comment" | "pr comment" | "pr create" | "issue create" | "pr review" | "pr edit" | "issue edit") return 0 ;;
    "issue close" | "pr close" | "issue reopen" | "pr reopen") return 0 ;;
  esac
  return 1
}

# close/reopen carry prose in --comment, which has no file variant. --comment
# must not be rewritten on other verbs: it is a boolean review type on
# `pr review`.
takes_comment_flag() {
  case "$1 ${2:-}" in
    "issue close" | "pr close" | "issue reopen" | "pr reopen") return 0 ;;
  esac
  return 1
}

# Rewrites args[] so the body always arrives as a file we control. Handling
# --body and --body-file through one path avoids quoting a trailer back into an
# inline argument.
trailer_tmp=""
inject_trailer() {
  local mode="${1:-body}"
  local i idx=-1 kind="" value="" joined=0 content
  for ((i = 0; i < ${#args[@]}; i++)); do
    if [[ $mode == comment ]]; then
      case "${args[i]}" in
        --comment | -c) kind=inline; idx=$i; value="${args[i + 1]-}"; joined=0 ;;
        --comment=*) kind=inline; idx=$i; value="${args[i]#--comment=}"; joined=1 ;;
      esac
    else
      case "${args[i]}" in
        --body | -b) kind=inline; idx=$i; value="${args[i + 1]-}"; joined=0 ;;
        --body=*) kind=inline; idx=$i; value="${args[i]#--body=}"; joined=1 ;;
        --body-file | -F) kind=file; idx=$i; value="${args[i + 1]-}"; joined=0 ;;
        --body-file=*) kind=file; idx=$i; value="${args[i]#--body-file=}"; joined=1 ;;
      esac
    fi
  done

  # No prose flag: close/reopen without --comment posts no prose at all, and a
  # bodyless create/edit means gh builds one itself (--fill) or opens an
  # editor. Neither should have a flag invented for it.
  if [[ $idx -lt 0 ]]; then
    [[ $mode == comment ]] || echo "gw: no --body/--body-file; add the agent-trailer output yourself" >&2
    return 0
  fi

  if [[ $kind == file ]]; then
    if [[ $value == "-" ]]; then
      content="$(cat)"
    else
      content="$(cat "$value")"
    fi
  else
    content="$value"
  fi

  # Suppress only this editor's exact trailer. A different agent's line is
  # provenance, so keep it and add the current editor rather than crediting the
  # original owner for a rewrite they did not make.
  local trailer
  trailer="$(agent-trailer)"
  if printf '%s\n' "$content" | grep -Fqx -- "$trailer"; then
    return 0
  fi

  # --comment has no file variant, so the trailer rides inline; args are passed
  # as an array straight to exec, so embedded newlines survive without
  # re-quoting.
  if [[ $mode == comment ]]; then
    content="$content"$'\n\n'"$trailer"
    if [[ $joined -eq 1 ]]; then
      args[idx]="--comment=$content"
    else
      args[idx + 1]="$content"
    fi
    return 0
  fi

  trailer_tmp="$(mktemp "${TMPDIR:-/tmp}/gw-body.XXXXXX")"
  printf '%s\n\n%s\n' "$content" "$trailer" > "$trailer_tmp"
  if [[ $joined -eq 1 ]]; then
    args[idx]="--body-file=$trailer_tmp"
  else
    args[idx]="--body-file"
    args[idx + 1]="$trailer_tmp"
  fi
}

usage() {
  cat <<EOF
Usage: gw <gh-args...>

Uses gh's current repository, with current-branch selection for PR commands.
Set GW_REPO=owner/repo to override repository discovery.

Examples:
  gw pr status
  gw pr view
  gw pr checks
  gw issue list
  gw issue view 123
EOF
}

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 2
fi

case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
esac

cmd="$1"
shift

has_help_flag() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      -h|--help)
        return 0
        ;;
    esac
  done
  return 1
}

current_branch() {
  git branch --show-current 2>/dev/null || true
}

# Not exec: the temp body has to outlive gh and be cleaned up afterwards.
gh_run() {
  if [[ -n "$trailer_tmp" ]]; then
    local rc=0
    gh "$@" || rc=$?
    rm -f "$trailer_tmp"
    exit "$rc"
  fi
  exec gh "$@"
}

pr_selector_defaults_to_branch() {
  case "${1:-}" in
    view|checks|diff|comment|edit|review|merge|close|reopen|ready|lock|unlock)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

args=("$@")
if [[ ${#args[@]} -gt 0 ]] && under_agent && writes_prose "$cmd" "${args[0]}" && ! has_help_flag "${args[@]}"; then
  if takes_comment_flag "$cmd" "${args[0]}"; then
    inject_trailer comment
  else
    inject_trailer body
  fi
fi
set -- "${args[@]}"

case "$cmd" in
  pr)
    if [[ $# -gt 0 ]] && pr_selector_defaults_to_branch "$1" && ! has_help_flag "$@"; then
      subcmd="$1"
      shift
      case "${1:-}" in
        ""|-*)
          branch="$(current_branch)"
          if [[ -n "$branch" ]]; then
            gh_run pr ${repo_args[@]+"${repo_args[@]}"} "$subcmd" "$branch" "$@"
          fi
          ;;
      esac
      gh_run pr ${repo_args[@]+"${repo_args[@]}"} "$subcmd" "$@"
    fi
    gh_run pr ${repo_args[@]+"${repo_args[@]}"} "$@"
    ;;
  issue|release|run|workflow|label|milestone|browse|project|ruleset|secret|variable|cache)
    gh_run "$cmd" ${repo_args[@]+"${repo_args[@]}"} "$@"
    ;;
  *)
    gh_run "$cmd" "$@"
    ;;
esac
