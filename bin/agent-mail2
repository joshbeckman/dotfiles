#!/usr/bin/env python3
"""SQLite-backed Agent Mail with compare-and-swap thread appends.

Addresses resolve exactly as `agent-mail` resolves them: @+handle, bare name, transport
<name>-<sessionID>, @josh, humans/<handle>, an email address, or @team/<slug>. A mailbox is
the scratchpad an agent address resolves to, or the human handle, so every spelling of one
recipient reaches one mailbox, and a recipient with no scratchpad is refused.

Exit status: 0 on success, 1 on any error, 2 on a usage error, 3 when --if-head names a
head that is no longer current (re-read the thread and resend), 4 when a message exceeds
--max-bytes, 5 when the runtime store is not SQLite yet (use agent-mail).
"""

from __future__ import annotations

import argparse
import glob
import json
import os
import re
import sqlite3
import sys
import time

# subprocess, pathlib and datetime are left out on purpose: interpreter startup is most of
# this tool's latency.

STALE_THREAD = 3
OVERSIZED = 4
WRONG_STORE = 5
SCHEMA_VERSION = 4
STORE_MARKER = re.compile(rb"(maildir|both|sqlite)\n*")
ADDRESS = re.compile(r"^[A-Za-z0-9._+@-]+$")
AGENT_ID = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)+$")
TEAM_MEMBER = re.compile(r"^@\+[a-z0-9]+(?:-[a-z0-9]+)+$")
SESSION_SUFFIX = re.compile(
    r"-[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$"
)
UUID = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
HEADER_CONTROL = re.compile(r"[\x00-\x1f\x7f\u0085\u2028\u2029]")
HERE = os.path.dirname(os.path.realpath(__file__))
PROG = os.environ.get("AGENT_MAIL_PROG") or "agent-mail2"

SCHEMA = """
CREATE TABLE IF NOT EXISTS mailboxes (
  mailbox_id TEXT PRIMARY KEY,
  kind TEXT NOT NULL CHECK (kind IN ('agent', 'human')),
  created_at INTEGER NOT NULL
);
CREATE TABLE IF NOT EXISTS threads (
  thread_id TEXT PRIMARY KEY,
  created_at INTEGER NOT NULL,
  visibility TEXT NOT NULL DEFAULT 'public' CHECK (visibility IN ('public', 'private'))
);
CREATE TABLE IF NOT EXISTS messages (
  message_id TEXT PRIMARY KEY,
  thread_id TEXT NOT NULL REFERENCES threads(thread_id),
  sequence INTEGER NOT NULL CHECK (sequence > 0),
  sender_mailbox_id TEXT NOT NULL REFERENCES mailboxes(mailbox_id),
  reply_to_message_id TEXT REFERENCES messages(message_id),
  sent_at INTEGER NOT NULL,
  subject TEXT,
  body TEXT NOT NULL,
  reply_to_address TEXT,
  team_to TEXT,
  UNIQUE (thread_id, sequence)
);
CREATE TABLE IF NOT EXISTS message_recipients (
  message_id TEXT NOT NULL REFERENCES messages(message_id),
  recipient_mailbox_id TEXT NOT NULL REFERENCES mailboxes(mailbox_id),
  PRIMARY KEY (message_id, recipient_mailbox_id)
);
CREATE TABLE IF NOT EXISTS deliveries (
  message_id TEXT NOT NULL REFERENCES messages(message_id),
  recipient_mailbox_id TEXT NOT NULL REFERENCES mailboxes(mailbox_id),
  read_at INTEGER,
  discarded_at INTEGER,
  delivery_seq INTEGER,
  escalated_at INTEGER,
  PRIMARY KEY (message_id, recipient_mailbox_id),
  FOREIGN KEY (message_id, recipient_mailbox_id)
    REFERENCES message_recipients(message_id, recipient_mailbox_id)
);
CREATE UNIQUE INDEX IF NOT EXISTS deliveries_by_seq ON deliveries(delivery_seq);
CREATE TABLE IF NOT EXISTS send_keys (
  idempotency_key TEXT PRIMARY KEY,
  message_id TEXT NOT NULL REFERENCES messages(message_id)
);
CREATE INDEX IF NOT EXISTS messages_thread_sequence
  ON messages(thread_id, sequence DESC);
CREATE INDEX IF NOT EXISTS message_recipients_by_recipient
  ON message_recipients(recipient_mailbox_id, message_id);
CREATE INDEX IF NOT EXISTS deliveries_recipient_state
  ON deliveries(recipient_mailbox_id, discarded_at, read_at, message_id);
CREATE TRIGGER IF NOT EXISTS messages_no_update
  BEFORE UPDATE ON messages WHEN NOT (APPEND_ONLY)
  BEGIN SELECT RAISE(ABORT, 'messages are append-only'); END;
CREATE TRIGGER IF NOT EXISTS messages_no_delete
  BEFORE DELETE ON messages BEGIN SELECT RAISE(ABORT, 'messages are append-only'); END;
CREATE TRIGGER IF NOT EXISTS message_recipients_no_update
  BEFORE UPDATE ON message_recipients BEGIN SELECT RAISE(ABORT, 'the recipient list is append-only'); END;
CREATE TRIGGER IF NOT EXISTS message_recipients_no_delete
  BEFORE DELETE ON message_recipients BEGIN SELECT RAISE(ABORT, 'the recipient list is append-only'); END;
"""


# Everything about a message is fixed, except that a routing header the v3 schema could not
# store may be filled in once, from the Maildir copy, and never changed after.
APPEND_ONLY = """NEW.message_id IS OLD.message_id AND NEW.thread_id IS OLD.thread_id
  AND NEW.sequence IS OLD.sequence AND NEW.sender_mailbox_id IS OLD.sender_mailbox_id
  AND NEW.reply_to_message_id IS OLD.reply_to_message_id AND NEW.sent_at IS OLD.sent_at
  AND NEW.subject IS OLD.subject AND NEW.body IS OLD.body
  AND (OLD.reply_to_address IS NULL OR NEW.reply_to_address IS OLD.reply_to_address)
  AND (OLD.team_to IS NULL OR NEW.team_to IS OLD.team_to)"""
SCHEMA = SCHEMA.replace("APPEND_ONLY", APPEND_ONLY)


class MailError(Exception):
    pass


class WrongStore(MailError):
    def __init__(self, mode: str):
        self.mode = mode
        super().__init__(f"the store marker says {mode}, so the Maildir holds the mail; use agent-mail")


class Oversized(MailError):
    def __init__(self, message_id: str, size: int, limit: int):
        self.message_id, self.size, self.limit = message_id, size, limit
        super().__init__(f"oversized: {size} bytes")


class StaleThread(MailError):
    def __init__(self, thread_id: str, expected: str, current: str):
        self.thread_id = thread_id
        self.expected = expected
        self.current = current
        super().__init__(
            f"stale-thread: expected head {expected}, current head {current} "
            f"for thread {thread_id}"
        )


def now_us() -> int:
    return time.time_ns() // 1000


def format_time(value: int | None) -> str | None:
    if value is None:
        return None
    seconds, micros = divmod(value, 1_000_000)
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(seconds))
    return f"{stamp}.{micros:06d}Z" if micros else f"{stamp}Z"


_ids = None


def message_id(subject: str | None) -> str:
    """Mint an id through the shared helper, so both stores mint one shape.

    The helper is loaded as a module rather than run as a process: a second interpreter
    start was a third of a send's latency, and loading the same file keeps one generator.
    """
    global _ids
    if _ids is None:
        helper = os.path.join(HERE, "agent-mail-id")
        if not os.path.isfile(helper):
            raise MailError(f"sibling agent-mail-id not found at {helper}")
        from importlib.machinery import SourceFileLoader
        from importlib.util import module_from_spec, spec_from_loader

        # The helper has no .py suffix, so a cached compile would land in bin/__pycache__.
        sys.dont_write_bytecode = True
        loader = SourceFileLoader("agent_mail_id", helper)
        module = module_from_spec(spec_from_loader("agent_mail_id", loader))
        loader.exec_module(module)
        _ids = module
    return _ids.message_id(subject or "")


def database_path() -> str:
    raw = os.environ.get("AGENT_MAIL2_DB")
    if raw:
        return os.path.abspath(os.path.expanduser(raw))
    # Beside the resolved human root, as bin/agent-mail derives it with pwd -P, never a fixed
    # home path: relocating the mail state must never write the real store.
    return os.path.join(os.path.dirname(os.path.realpath(human_root())), "mail2.sqlite3")


def state_root() -> str:
    return os.path.dirname(os.path.realpath(human_root()))


def store_mode() -> str:
    # Byte for byte as bin/agent-mail and agent-mail-migrate read it.
    try:
        with open(os.path.join(state_root(), "store"), "rb") as source:
            marker = STORE_MARKER.fullmatch(source.read())
    except OSError:
        marker = None
    return marker.group(1).decode() if marker else "maildir"


def is_runtime_database() -> bool:
    return os.path.realpath(database_path()) == os.path.realpath(os.path.join(state_root(), "mail2.sqlite3"))


def require_authoritative() -> None:
    """Refuse the runtime database as a source of record unless the marker says sqlite.

    Under maildir or both the Maildir is the record. A SQLite-only delivery would be marked
    discarded and a SQLite-only read reverted by the next reconciliation, and a receiver
    reading the mirror could miss mail whose mirror failed. A database named by
    AGENT_MAIL2_DB elsewhere is not the runtime store and is unaffected.
    """
    if is_runtime_database() and store_mode() != "sqlite":
        raise WrongStore(store_mode())


def require_writable() -> None:
    require_authoritative()


def connect() -> sqlite3.Connection:
    path = database_path()
    parent = os.path.dirname(path)
    parent_existed = os.path.exists(parent)
    os.makedirs(parent, mode=0o700, exist_ok=True)
    if not parent_existed or "AGENT_MAIL2_DB" not in os.environ:
        os.chmod(parent, 0o700)
    if os.path.islink(path):
        raise MailError(f"database path must not be a symlink: {path}")
    db = sqlite3.connect(path, timeout=5, isolation_level=None)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA foreign_keys = ON")
    db.execute("PRAGMA busy_timeout = 5000")
    db.execute("PRAGMA synchronous = FULL")
    version = db.execute("PRAGMA user_version").fetchone()[0]
    if version == SCHEMA_VERSION:
        return db
    if version == 3:
        upgrade_v3(db)
        return db
    if version != 0:
        db.close()
        raise MailError(f"unsupported schema version {version}; expected {SCHEMA_VERSION}")
    # The v1 and v2 upgrade paths are gone: no database of either version was ever created,
    # and they ran outside a transaction, so a crash mid-upgrade could strand deliveries.
    # Creating a fresh schema is idempotent, so a crash here is repaired by the next connect.
    db.execute("PRAGMA journal_mode = WAL")
    db.executescript(SCHEMA)
    db.execute(f"PRAGMA user_version = {SCHEMA_VERSION}")
    os.chmod(path, 0o600)
    return db


def upgrade_v3(db: sqlite3.Connection) -> None:
    """v4 adds delivery order, escalation state and the routing headers the Maildir carried.

    One transaction, statement by statement: executescript would commit midway, and a crash
    between ALTERs would leave a v3 database that the next upgrade could not finish. The
    version is read again under the lock, so two processes upgrading at once do it once.
    """
    db.execute("BEGIN IMMEDIATE")
    try:
        if db.execute("PRAGMA user_version").fetchone()[0] == 3:
            for statement in (
                "ALTER TABLE messages ADD COLUMN reply_to_address TEXT",
                "ALTER TABLE messages ADD COLUMN team_to TEXT",
                "ALTER TABLE deliveries ADD COLUMN delivery_seq INTEGER",
                "ALTER TABLE deliveries ADD COLUMN escalated_at INTEGER",
                """CREATE TEMP TABLE delivery_order AS
                     SELECT d.rowid AS row, ROW_NUMBER() OVER (
                       ORDER BY m.sent_at, d.message_id, d.recipient_mailbox_id) AS seq
                     FROM deliveries d JOIN messages m USING(message_id)""",
                "UPDATE deliveries SET delivery_seq = (SELECT seq FROM delivery_order WHERE row = deliveries.rowid)",
                "DROP TABLE delivery_order",
                "CREATE UNIQUE INDEX deliveries_by_seq ON deliveries(delivery_seq)",
                """CREATE TABLE send_keys (idempotency_key TEXT PRIMARY KEY,
                     message_id TEXT NOT NULL REFERENCES messages(message_id))""",
                # Whoever upgrades, the headers v3 dropped are owed a full pass from the Maildir.
                # A row, not a flag in this process: the next migrator run sees it whichever
                # command upgraded, and it survives a crash before the pass.
                "CREATE TABLE backfill_pending (since INTEGER NOT NULL)",
                f"INSERT INTO backfill_pending VALUES ({now_us()})",
                "DROP TRIGGER messages_no_update",
                f"""CREATE TRIGGER messages_no_update BEFORE UPDATE ON messages WHEN NOT ({APPEND_ONLY})
                    BEGIN SELECT RAISE(ABORT, 'messages are append-only'); END""",
                f"PRAGMA user_version = {SCHEMA_VERSION}",
            ):
                db.execute(statement)
        db.execute("COMMIT")
    except BaseException:
        db.execute("ROLLBACK")
        raise


def next_delivery_seq(db: sqlite3.Connection) -> int:
    return db.execute("SELECT COALESCE(MAX(delivery_seq), 0) + 1 FROM deliveries").fetchone()[0]


# A rule-for-rule port of resolve_inbox in bin/agent-mail; test/agent-mail2 compares the two.
# Storing the normalized text instead made @+name and name-<session> two mailboxes, and mail
# to the documented handle form sat where its recipient never looked.


class Mailbox:
    __slots__ = ("id", "kind", "pad")

    def __init__(self, mailbox_id: str, kind: str, pad: str | None = None):
        self.id = mailbox_id
        self.kind = kind
        self.pad = pad


def agent_root() -> str:
    raw = os.environ.get("AGENT_MAIL_ROOT") or os.environ.get("AGENT_SCRATCH_ROOT") or "~/.local/state/agent/scratchpads"
    return os.path.realpath(os.path.expanduser(raw))


def human_root() -> str:
    return os.path.expanduser(os.environ.get("AGENT_HUMAN_MAIL_ROOT") or "~/.local/state/agent-mail/humans")


def registry_root() -> str:
    return os.path.expanduser(os.environ.get("AGENT_IDENTITIES_DIR") or "~/.pi/agent/identities/by-name")


def strip_sigils(value: str) -> str:
    value = value.strip()
    if value.startswith("@"):
        value = value[1:]
    if value.startswith("+"):
        value = value[1:]
    return value


def normalize_address(value: str) -> str:
    address = strip_sigils(value)
    if not address or not ADDRESS.fullmatch(address):
        raise MailError(f"invalid mailbox address: {address!r}")
    return address


def human_handle(identifier: str) -> str | None:
    if identifier == "josh":
        return "josh"
    if identifier.startswith("humans/"):
        handle = identifier[len("humans/"):]
    elif "@" in identifier:
        handle = identifier.split("@", 1)[0]
    elif os.path.isdir(os.path.join(human_root(), identifier)):
        handle = identifier
    else:
        return None
    return handle or None


def without_realm(identifier: str) -> str:
    return identifier.rsplit("-of-", 1)[0]


def matching_pads(root: str, prefix: str) -> list[str]:
    return sorted(p for p in glob.glob(glob.escape(os.path.join(root, prefix)) + "-*") if os.path.isdir(p))


def agent_box(pad: str) -> Mailbox:
    # A symlinked pad gives one inbox two names, and a human mailbox of the same name would
    # share its row: refuse both rather than deliver to whichever spelling resolved first.
    name = os.path.basename(pad)
    if os.path.islink(pad):
        raise MailError(f"scratchpad {pad} is a symlink; a mailbox must be a real directory")
    if os.path.isdir(os.path.join(human_root(), name)):
        raise MailError(f"{name} is both an agent scratchpad and a human mailbox")
    return Mailbox(name, "agent", pad)


def resolve(raw: str) -> Mailbox:
    """An agent address with no scratchpad still resolves, to the pad it would have, so
    send can name the missing pad."""
    identifier = strip_sigils(raw)
    address = identifier
    if identifier.startswith("humans/"):
        address = identifier[len("humans/"):]
        if "/" in address:
            raise MailError(f"invalid mailbox address: {identifier!r}")
    elif "/" in identifier:
        raise MailError(f"invalid mailbox address: {identifier!r}")
    if not address or not ADDRESS.fullmatch(address):
        raise MailError(f"invalid mailbox address: {identifier!r}")
    handle = human_handle(identifier)
    if handle:
        if os.path.isdir(os.path.join(agent_root(), handle)):
            raise MailError(f"{handle} is both an agent scratchpad and a human mailbox")
        return Mailbox(handle, "human")

    registry = registry_root()
    if os.path.lexists(registry) and not (os.path.isdir(registry) and os.access(registry, os.R_OK | os.X_OK)):
        raise MailError(f"identity registry is unavailable: {registry}")
    claims: list[str] = []
    exact = os.path.join(registry, identifier)
    if os.path.lexists(exact):
        claims = [exact]
    elif SESSION_SUFFIX.search(identifier):
        pass  # An explicit transport address must not be retargeted by a name alias.
    elif "-of-" in identifier:
        base = os.path.join(registry, without_realm(identifier))
        if os.path.lexists(base):
            claims = [base]
    else:
        claims = sorted(p for p in glob.glob(glob.escape(exact) + "-of-*") if os.path.lexists(p))
    if len(claims) > 1:
        raise MailError(f"ambiguous registered recipient '{identifier}'")
    root = agent_root()
    if claims:
        claim = claims[0]
        if os.path.islink(claim) or not os.path.isfile(claim):
            raise MailError(f"invalid identity claim for '{identifier}'")
        with open(claim, "rb") as source:
            sid = source.read(129).decode("ascii", "replace").rstrip("\n")
        if not UUID.fullmatch(sid):
            raise MailError(f"invalid session ID in identity claim for '{identifier}'")
        name = os.path.basename(claim)
        pads: list[str] = []
        for base in dict.fromkeys((name, without_realm(name))):
            for suffix in dict.fromkeys((sid[:8], sid)):
                candidate = os.path.join(root, f"{base}-{suffix}")
                if os.path.isdir(candidate) and candidate not in pads:
                    pads.append(candidate)
        if len(pads) == 1:
            return agent_box(pads[0])
        if not pads:
            raise MailError(f"registered recipient '{identifier}' has no session-qualified scratchpad")
        raise MailError(f"ambiguous scratchpads for registered recipient '{identifier}': {' '.join(pads)}")

    pad = os.path.join(root, identifier)
    if os.path.isdir(pad):
        return agent_box(pad)
    if SESSION_SUFFIX.search(identifier):
        return agent_box(pad)
    hits = matching_pads(root, identifier)
    # Pads made before the realm-suffix convention are <base>-<session>, so retry the
    # canonical <base>-of-<realm> handle without its realm.
    if not hits and "-of-" in identifier:
        bare = without_realm(identifier)
        if os.path.isdir(os.path.join(root, bare)):
            return agent_box(os.path.join(root, bare))
        hits = matching_pads(root, bare)
    if len(hits) == 1:
        return agent_box(hits[0])
    if not hits:
        return agent_box(pad)
    raise MailError(f"ambiguous recipient '{identifier}'; matches: {' '.join(hits)}")


def mailbox_id(raw: str) -> str:
    return resolve(raw).id


def is_team(value: str) -> bool:
    return value.startswith("@team/") or value.startswith("team/")


def team_members(team: str) -> list[str]:
    import subprocess

    helper = os.path.join(HERE, "agent-team")
    try:
        result = subprocess.run(
            [helper, "members", team if team.startswith("@") else f"@{team}"],
            check=False, text=True, capture_output=True, timeout=10,
        )
    except subprocess.TimeoutExpired as error:
        raise MailError(f"team expansion timed out: {team}") from error
    except OSError as error:
        raise MailError(f"sibling agent-team not found (required for team recipients): {error}") from error
    if result.returncode:
        raise MailError(result.stderr.strip() or f"could not expand {team}")
    members = result.stdout.splitlines()
    if not members:
        raise MailError(f"team '{team}' has no members")
    for member in members:
        if not TEAM_MEMBER.fullmatch(member):
            raise MailError(f"invalid member from team '{team}': {member}")
    return members


def idle_hours(pad: str) -> int:
    mtime = os.stat(pad).st_mtime
    try:
        mtime = max(mtime, os.stat(os.path.join(pad, ".heartbeat")).st_mtime)
    except OSError:
        pass
    return int((time.time() - mtime) // 3600)


def expand_recipients(raw_values: list[str], teams: list[str] | None = None,
                      reply_all: bool = False) -> list[Mailbox]:
    addresses: list[str] = []
    for raw in raw_values:
        for value in raw.split(","):
            value = value.strip()
            if not value:
                raise MailError("empty recipient")
            if is_team(value):
                if teams is not None:
                    teams.append(value if value.startswith("@") else f"@{value}")
                for member in team_members(value):
                    if resolve(member).kind != "agent":
                        raise MailError(f"team member conflicts with a human address: {member}")
                    addresses.append(member)
                if len(addresses) > 1000:
                    raise MailError("recipient expansion exceeds 1000 mailboxes")
            else:
                addresses.append(value)
    recipients: dict[str, Mailbox] = {}
    for address in addresses:
        mailbox = resolve(address)
        if mailbox.kind == "agent" and not os.path.isdir(mailbox.pad or ""):
            # Reply-all takes its audience from stored rows, so a seat that has been pruned
            # blocks the send without the sender ever naming it. The failure is per target
            # message, which makes it impossible to predict from outside: say which address
            # is dead and which command still works, or the sender reads this as "reply-all
            # is broken" and stops.
            hint = ""
            if reply_all:
                hint = "; it is in this message's stored audience, so retry with --to for the recipients that resolve"
            raise MailError(
                f"recipient '{strip_sigils(address)}' has no scratchpad at {mailbox.pad} (not created or pruned?){hint}"
            )
        recipients.setdefault(mailbox.id, mailbox)
    if not recipients:
        raise MailError("at least one recipient is required")
    return list(recipients.values())


def ring(recipients: list[Mailbox]) -> None:
    # Replaced by rename, not touched: a directory watch fires on entries changing, not on
    # a file's mtime. Best effort, because a ring is only a hint.
    doorbells = os.path.join(os.path.dirname(database_path()), "doorbells")
    try:
        os.makedirs(doorbells, mode=0o700, exist_ok=True)
        for mailbox in recipients:
            temporary = os.path.join(doorbells, f".{mailbox.id}.{os.getpid()}")
            with open(temporary, "w"):
                pass
            os.replace(temporary, os.path.join(doorbells, mailbox.id))
    except OSError:
        pass


def notify_josh(title: str, message: str, away_only: bool) -> bool:
    import shlex
    import shutil
    import subprocess

    command = shutil.which("notify-josh")
    if not command:
        return False
    # agent-mail web, not agent-mail inbox (Neovim, which Josh no longer uses) and not a bare
    # URL: the launcher starts or reuses the bridge and opens it with the tab's token.
    click = f"{shlex.quote(os.path.join(HERE, 'agent-mail'))} web"
    argv = [command, *(["--away-only"] if away_only else []), "--from", "agent-mail",
            "--execute", click, title, message]
    try:
        return subprocess.run(argv, capture_output=True, timeout=30).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def web_inbox_open() -> bool:
    # An open web app polls and shows its own notification, so the banner would be a duplicate.
    try:
        return time.time() - os.stat(os.path.join(human_root(), "josh", ".web-notifier")).st_mtime < 150
    except OSError:
        return False


def notify_delivery(db: sqlite3.Connection, mid: str, author: str, subject: str | None,
                    recipients: list[Mailbox]) -> None:
    """Tell Josh at once when mail reaches him, as agent-mail does. Only for the runtime store:
    a private database is a test or an experiment, and must not reach Josh."""
    if not is_runtime_database() or not any(r.id == "josh" for r in recipients):
        return
    # After the commit, so nothing here may fail the send: a non-zero exit for delivered mail
    # invites a duplicate. A notification that did not happen is left for the sweep.
    try:
        if notify_josh(f"Agent mail: {subject or '(no subject)'}",
                       f"From {author}. Read with: agent-mail read --to @josh", web_inbox_open()):
            db.execute("UPDATE deliveries SET escalated_at = ? WHERE message_id = ? "
                       "AND recipient_mailbox_id = 'josh' AND escalated_at IS NULL", (now_us(), mid))
            return
    except (sqlite3.Error, OSError):
        pass
    print(f"{PROG}: immediate Josh notification failed; unread sweep will retry", file=sys.stderr)


def warn_idle(recipients: list[Mailbox]) -> None:
    try:
        limit = int(os.environ.get("AGENT_MAIL_STALE_HOURS") or 12)
    except ValueError:
        limit = 12
    for mailbox in recipients:
        if mailbox.kind == "agent" and mailbox.pad:
            try:
                idle = idle_hours(mailbox.pad)
            except OSError:
                continue
            if idle >= limit:
                print(f"{PROG}: '{mailbox.id}' last active {idle}h ago", file=sys.stderr)


def claimed_sender(raw: str) -> Mailbox:
    # A service such as pr-monitor has no scratchpad, so it keeps its literal name.
    if is_team(raw):
        raise MailError("a team cannot be a message sender")
    mailbox = resolve(raw)
    if mailbox.kind == "human" or os.path.isdir(mailbox.pad or ""):
        return mailbox
    return Mailbox(normalize_address(raw), "agent")


def sender() -> Mailbox:
    explicit = os.environ.get("AGENT_MAIL_FROM")
    if explicit:
        return claimed_sender(explicit)
    scratchpad = os.environ.get("AGENT_SCRATCHPAD")
    candidate = os.path.basename(scratchpad.rstrip("/")) if scratchpad else os.environ.get("AGENT_HANDLE")
    if candidate and candidate not in (".", "/"):
        address = normalize_address(candidate)
        if address == "josh" or "@" in address or not AGENT_ID.fullmatch(address):
            raise MailError(f"invalid derived agent identity: {address}")
        if scratchpad:
            return Mailbox(address, "agent", scratchpad)
        # AGENT_HANDLE carries no session, so find the pad it names.
        mailbox = resolve(address)
        return mailbox if os.path.isdir(mailbox.pad or "") else Mailbox(address, "agent")
    if os.environ.get("AGENT_MAIL2_HUMAN") == "josh":
        return Mailbox("josh", "human")
    raise MailError("cannot determine sender; set AGENT_SCRATCHPAD or AGENT_HANDLE")


def sender_id() -> str:
    return sender().id


def ensure_mailbox(db: sqlite3.Connection, mailbox: Mailbox, timestamp: int) -> None:
    db.execute(
        "INSERT OR IGNORE INTO mailboxes(mailbox_id, kind, created_at) VALUES (?, ?, ?)",
        (mailbox.id, mailbox.kind, timestamp),
    )



def message_query(identifier: str) -> str:
    value = os.path.basename(identifier.strip())
    if value.endswith(".md"):
        value = value[:-3]
    if not value:
        raise MailError(f"invalid message id: {identifier!r}")
    return value


def find_message(db: sqlite3.Connection, identifier: str, mailbox: str | None = None,
                 required: bool = True) -> sqlite3.Row | None:
    # Prefix then suffix, as agent-mail does: a ULID shortens from the front and a legacy
    # <pid>-<rand> tail from the back. An ambiguous match is refused rather than guessed.
    value = message_query(identifier)
    if mailbox is None:
        base, params = "SELECT m.* FROM messages m WHERE ", {}
    else:
        base = """SELECT m.* FROM deliveries d JOIN messages m USING(message_id)
                  WHERE d.recipient_mailbox_id = :mailbox AND d.discarded_at IS NULL AND """
        params = {"mailbox": mailbox}
    params["value"] = value
    row = db.execute(base + "m.message_id = :value", params).fetchone()
    if row is not None:
        return row
    # A v1 file path names one message exactly; agent-run stores them in its receipts, and
    # a path that matched a different message by prefix would reply in the wrong thread.
    exact_only = "/" in identifier or identifier.strip().endswith(".md")
    for direction, clause in () if exact_only else (
        ("start", "substr(m.message_id, 1, length(:value)) = :value"),
        ("end", "substr(m.message_id, -length(:value)) = :value"),
    ):
        rows = db.execute(base + clause + " ORDER BY m.message_id LIMIT 2", params).fetchall()
        if len(rows) == 1:
            return rows[0]
        if rows:
            raise MailError(f"ambiguous message id '{value}'; several messages {direction} with it")
    if required:
        raise MailError(f"unknown message: {value}" + (f" in {mailbox}'s inbox" if mailbox else ""))
    return None


def head(db: sqlite3.Connection, thread_id: str) -> sqlite3.Row | None:
    return db.execute(
        "SELECT message_id, sequence FROM messages WHERE thread_id = ? ORDER BY sequence DESC LIMIT 1",
        (thread_id,),
    ).fetchone()


def resolve_thread(db: sqlite3.Connection, identifier: str) -> str:
    if db.execute("SELECT 1 FROM threads WHERE thread_id = ?", (identifier,)).fetchone():
        return identifier
    row = find_message(db, identifier, required=False)
    return row["thread_id"] if row is not None else identifier


def thread_members(db: sqlite3.Connection, thread_id: str) -> set[str]:
    """Everyone who has sent or received a message in the thread."""
    return {
        row[0]
        for row in db.execute(
            """SELECT sender_mailbox_id AS mailbox FROM messages WHERE thread_id = ?
               UNION
               SELECT r.recipient_mailbox_id FROM message_recipients r
                 JOIN messages m USING(message_id) WHERE m.thread_id = ?""",
            (thread_id, thread_id),
        )
    }


def thread_visibility(db: sqlite3.Connection, thread_id: str) -> str:
    row = db.execute("SELECT visibility FROM threads WHERE thread_id = ?", (thread_id,)).fetchone()
    if row is None:
        raise MailError(f"unknown thread: {thread_id}")
    return row["visibility"]


def require_visible(db: sqlite3.Connection, thread_id: str, mailbox: str) -> str:
    """A private thread is visible only to its members; a public one to anyone."""
    visibility = thread_visibility(db, thread_id)
    if visibility == "private" and mailbox not in thread_members(db, thread_id):
        raise MailError(f"thread {thread_id} is private")
    return visibility


def recipients_for(db: sqlite3.Connection, message: str) -> list[str]:
    return [
        row[0]
        for row in db.execute(
            "SELECT recipient_mailbox_id FROM message_recipients WHERE message_id = ? ORDER BY recipient_mailbox_id",
            (message,),
        )
    ]


def read_body(args: argparse.Namespace) -> str:
    if args.body is not None and args.body_file is not None:
        raise MailError("--body and --body-file are mutually exclusive")
    if args.body is not None:
        body = args.body
    elif args.body_file is not None:
        with open(args.body_file, encoding="utf-8") as source:
            body = source.read()
    else:
        body = sys.stdin.read()
    if "\x00" in body:
        raise MailError("body must not contain NUL")
    return body


def subject_value(value: str | None) -> str | None:
    if value is None:
        return None
    if HEADER_CONTROL.search(value):
        raise MailError("subject must be one line without control characters")
    return value


def append_message(args: argparse.Namespace) -> str:
    require_writable()
    db = connect()
    try:
        author = claimed_sender(args.sender) if args.sender else sender()
        body = read_body(args)
        subject = subject_value(args.subject)
        reply_to: str | None = None
        thread_id: str | None = args.thread
        expected = args.if_head
        direct = list(args.to or [])
        private = bool(args.private)

        reply_address = None
        if args.reply_to:
            if is_team(args.reply_to):
                raise MailError("a team cannot be Reply-To")
            reply_address = claimed_sender(args.reply_to).id
        if args.reply_all:
            if direct:
                raise MailError("--reply-all and --to are mutually exclusive")
            source = find_message(db, args.reply_all)
            reply_to = source["message_id"]
            if thread_id is not None and thread_id != source["thread_id"]:
                raise MailError("--reply-all message belongs to another --thread")
            thread_id = source["thread_id"]
            # Reply-To stands in for the sender, as it does in agent-mail.
            answer = source["reply_to_address"] or source["sender_mailbox_id"]
            direct = [answer, *recipients_for(db, reply_to)]
            if subject is None:
                source_subject = source["subject"] or "(no subject)"
                subject = source_subject if source_subject.startswith("Re: ") else f"Re: {source_subject}"
        elif args.in_reply_to:
            source = find_message(db, args.in_reply_to)
            reply_to = source["message_id"]
            if thread_id is None:
                thread_id = source["thread_id"]
            elif thread_id != source["thread_id"]:
                raise MailError("--in-reply-to message belongs to another thread")
        elif thread_id is not None:
            thread_id = resolve_thread(db, thread_id)

        teams: list[str] = []
        recipients = expand_recipients(direct, teams, reply_all=bool(args.reply_all))
        if args.reply_all:
            # After resolution: a Reply-To alias of the author must not deliver to the author.
            recipients = [r for r in recipients if r.id != author.id]
            if not recipients:
                raise MailError("--reply-all source has no other recipients")
        new_thread = thread_id is None
        if new_thread:
            if expected not in (None, "none"):
                raise MailError("a new thread has no head; omit --if-head or use --if-head none")
        elif private:
            raise MailError("--private applies only when creating a thread; visibility is fixed at creation")

        db.execute("BEGIN IMMEDIATE")
        try:
            # A retry of a send whose outcome was lost (a killed caller, a timeout) returns the
            # message already delivered rather than delivering it twice.
            if args.idempotency_key:
                done = db.execute("SELECT message_id FROM send_keys WHERE idempotency_key = ?",
                                  (args.idempotency_key,)).fetchone()
                if done:
                    db.execute("ROLLBACK")
                    return done[0]
            mid = message_id(subject)
            timestamp = now_us()
            if new_thread:
                thread_id = mid
            current = head(db, thread_id)
            passed = 0
            if new_thread:
                if current is not None:
                    raise MailError(f"thread already exists: {thread_id}")
                db.execute(
                    "INSERT INTO threads(thread_id, created_at, visibility) VALUES (?, ?, ?)",
                    (thread_id, timestamp, "private" if private else "public"),
                )
                sequence = 1
            else:
                if current is None:
                    raise MailError(f"unknown thread: {thread_id}")
                # --if-head is the strict compare-and-swap. Without it a reply still lands,
                # because one command name serves every caller that learned v1's
                # `send --reply-all MID`, and the sender is told what it had not seen.
                if expected is not None and current["message_id"] != expected:
                    raise StaleThread(thread_id, expected, current["message_id"])
                sequence = current["sequence"] + 1
                if expected is None and reply_to is not None and current["message_id"] != reply_to:
                    passed = db.execute(
                        """SELECT count(*) FROM messages WHERE thread_id = ? AND sequence >
                             (SELECT sequence FROM messages WHERE message_id = ?)""",
                        (thread_id, reply_to),
                    ).fetchone()[0]
            ensure_mailbox(db, author, timestamp)
            for recipient in recipients:
                ensure_mailbox(db, recipient, timestamp)
            db.execute(
                """INSERT INTO messages(
                     message_id, thread_id, sequence, sender_mailbox_id,
                     reply_to_message_id, sent_at, subject, body, reply_to_address, team_to
                   ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                (mid, thread_id, sequence, author.id, reply_to, timestamp, subject, body,
                 reply_address, ", ".join(teams) or None),
            )
            pairs = [(mid, recipient.id) for recipient in recipients]
            db.executemany("INSERT INTO message_recipients(message_id, recipient_mailbox_id) VALUES (?, ?)", pairs)
            if args.idempotency_key:
                db.execute("INSERT INTO send_keys VALUES (?, ?)", (args.idempotency_key, mid))
            first = next_delivery_seq(db)
            db.executemany(
                "INSERT INTO deliveries(message_id, recipient_mailbox_id, delivery_seq) VALUES (?, ?, ?)",
                [(mid, recipient, first + offset) for offset, (_, recipient) in enumerate(pairs)],
            )
            db.execute("COMMIT")
        except Exception:
            db.execute("ROLLBACK")
            raise
        if passed:
            print(
                f"{PROG}: {passed} message{'s' if passed != 1 else ''} arrived in this thread after "
                f"{reply_to}; your reply follows them. Read with: {PROG} thread {thread_id}",
                file=sys.stderr,
            )
        ring(recipients)
        notify_delivery(db, mid, author.id, subject, recipients)
        warn_idle(recipients)
        return mid
    finally:
        db.close()


def message_record(db: sqlite3.Connection, row: sqlite3.Row, body: bool = False) -> dict:
    record = {
        "message_id": row["message_id"],
        "thread_id": row["thread_id"],
        "sequence": row["sequence"],
        "from": row["sender_mailbox_id"],
        "to": recipients_for(db, row["message_id"]),
        "date": format_time(row["sent_at"]),
        "in_reply_to": row["reply_to_message_id"],
        "reply_to": row["reply_to_address"],
        "team_to": row["team_to"],
        "subject": row["subject"],
    }
    if body:
        record["body"] = row["body"]
    return record


def print_json(value: object) -> None:
    json.dump(value, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


def render_message(db: sqlite3.Connection, row: sqlite3.Row) -> str:
    recipients = ", ".join(recipients_for(db, row["message_id"]))
    lines = [f"From: {row['sender_mailbox_id']}", f"To: {recipients}"]
    if row["team_to"]:
        lines.append(f"Team-To: {row['team_to']}")
    if row["reply_to_address"]:
        lines.append(f"Reply-To: {row['reply_to_address']}")
    lines += [
        f"Date: {format_time(row['sent_at'])}",
        f"Message-ID: {row['message_id']}",
        f"Thread-ID: {row['thread_id']}",
        f"Thread-Sequence: {row['sequence']}",
    ]
    if row["reply_to_message_id"]:
        lines.append(f"In-Reply-To: {row['reply_to_message_id']}")
    lines.append(f"Subject: {row['subject'] or '(no subject)'}")
    return "\n".join(lines) + "\n\n" + row["body"]


def cmd_init(_args: argparse.Namespace) -> None:
    db = connect()
    db.close()
    print(database_path())


def cmd_send(args: argparse.Namespace) -> None:
    print(append_message(args))


def service_mailbox(raw: str) -> Mailbox:
    """A service such as agent-run owns exactly the pad of its own name. Anything that could
    retarget it, an alias, a registered agent's claim, a symlink or a human, is refused."""
    name = strip_sigils(raw)
    if os.path.lexists(os.path.join(registry_root(), name)):
        raise MailError(f"{name} is a registered agent, not a service mailbox")
    mailbox = resolve(name)
    pad = os.path.join(agent_root(), name)
    if mailbox.kind != "agent" or mailbox.id != name or not os.path.isdir(pad) or os.path.islink(pad):
        raise MailError(f"{name} is not exactly an existing service scratchpad")
    if os.path.dirname(os.path.realpath(pad)) != agent_root():
        raise MailError(f"{name} resolves outside the scratch root")
    return mailbox


def cmd_resolve(args: argparse.Namespace) -> None:
    if args.json or args.service:
        records = []
        for raw in args.address:
            mailbox = service_mailbox(raw) if args.service else resolve(raw)
            pad = mailbox.pad if mailbox.kind == "agent" and os.path.isdir(mailbox.pad or "") else None
            records.append({"version": 1, "mailbox": mailbox.id, "kind": mailbox.kind,
                            "pad": os.path.realpath(pad) if pad else None,
                            "doorbell": os.path.join(state_root(), "doorbells", mailbox.id),
                            "store": store_mode()})
        print_json(records[0] if len(records) == 1 else records)
        return
    missing = False
    for raw in args.address:
        mailbox = resolve(raw)
        line = f"{mailbox.kind}\t{mailbox.id}"
        if mailbox.kind == "agent" and not os.path.isdir(mailbox.pad or ""):
            line += "\tno-scratchpad"
            missing = True
        print(line)
    if missing:
        raise SystemExit(1)


def cmd_head(args: argparse.Namespace) -> None:
    db = connect()
    try:
        thread_id = resolve_thread(db, args.thread)
        current = head(db, thread_id)
        if current is None:
            raise MailError(f"unknown thread: {thread_id}")
        print(current["message_id"])
    finally:
        db.close()


def cursor_value(cursor: str) -> int:
    if not re.fullmatch(r"d[0-9]{1,18}", cursor or ""):
        raise MailError(f"invalid cursor: {cursor!r}")
    return int(cursor[1:])


def cmd_scan(args: argparse.Namespace) -> None:
    require_authoritative()
    db = connect()
    try:
        if args.limit < 1:
            raise MailError("--limit must be positive")
        mailbox = None if args.all else mailbox_id(args.to) if args.to else sender_id()
        sql = """SELECT d.recipient_mailbox_id, d.read_at, d.delivery_seq, m.*
                 FROM deliveries d JOIN messages m USING(message_id)
                 WHERE d.discarded_at IS NULL"""
        params: list[object] = []
        if args.after:
            sql += " AND d.delivery_seq > ?"
            params.append(cursor_value(args.after))
        if args.state == "unread":
            sql += " AND d.read_at IS NULL"
        elif args.state == "read":
            sql += " AND d.read_at IS NOT NULL"
        if mailbox is not None:
            sql += " AND d.recipient_mailbox_id = ?"
            params.append(mailbox)
        if args.thread:
            sql += " AND m.thread_id = ?"
            params.append(resolve_thread(db, args.thread))
        if args.sender:
            sql += " AND m.sender_mailbox_id = ?"
            params.append(mailbox_id(args.sender))
        if args.contains:
            sql += " AND (instr(COALESCE(m.subject, ''), ?) > 0 OR instr(m.body, ?) > 0)"
            params.extend([args.contains, args.contains])
        # Delivery order, not sent_at: a sender's clock can run backwards, and a page boundary
        # drawn on dates could skip mail delivered later with an earlier date.
        sql += " ORDER BY d.delivery_seq LIMIT ?"
        params.append(args.limit + 1)
        rows = db.execute(sql, params).fetchall()
        more = len(rows) > args.limit
        rows = rows[:args.limit]
        if args.json:
            print_json({
                "version": 1,
                "store": store_mode(),
                "messages": [
                    dict(message_record(db, row), mailbox=row["recipient_mailbox_id"],
                         state="read" if row["read_at"] is not None else "unread",
                         read_at=format_time(row["read_at"]), delivery_seq=row["delivery_seq"],
                         bytes=len(render_message(db, row).encode("utf-8")))
                    for row in rows
                ],
                "next": f"d{rows[-1]['delivery_seq']}" if more else None,
            })
            return
        if not rows:
            print("(no matching messages)")
            return
        for row in rows:
            state = "read" if row["read_at"] is not None else "unread"
            print(
                f"{row['recipient_mailbox_id']}\t{row['message_id']}\tstate:{state}\t"
                f"thread:{row['thread_id']}\tseq:{row['sequence']}\t"
                f"from:{row['sender_mailbox_id']}\t{row['subject'] or '(no subject)'}"
            )
    finally:
        db.close()


def viewer_id(args: argparse.Namespace) -> str:
    """The mailbox asking, or "" when the caller has no identity: only public threads
    are visible then, so a private one is refused rather than shown."""
    value = getattr(args, "viewer", None)
    if value:
        return mailbox_id(value)
    try:
        return sender_id()
    except MailError:
        return ""


def cmd_search(args: argparse.Namespace) -> None:
    """Find messages the caller can see: its own deliveries, plus every public thread."""
    db = connect()
    try:
        if args.limit < 1:
            raise MailError("--limit must be positive")
        mailbox = viewer_id(args)
        sql = """SELECT m.*, t.visibility,
                        CASE WHEN d.recipient_mailbox_id IS NULL THEN 0 ELSE 1 END AS delivered
                 FROM messages m
                 JOIN threads t ON t.thread_id = m.thread_id
                 LEFT JOIN deliveries d
                   ON d.message_id = m.message_id AND d.recipient_mailbox_id = ?
                 WHERE (t.visibility = 'public' OR d.recipient_mailbox_id IS NOT NULL)"""
        params: list[object] = [mailbox]
        if args.thread:
            sql += " AND m.thread_id = ?"
            params.append(resolve_thread(db, args.thread))
        if args.sender:
            sql += " AND m.sender_mailbox_id = ?"
            params.append(mailbox_id(args.sender))
        if args.query:
            sql += " AND (instr(COALESCE(m.subject, ''), ?) > 0 OR instr(m.body, ?) > 0)"
            params.extend([args.query, args.query])
        sql += " ORDER BY m.sent_at, m.thread_id, m.sequence LIMIT ?"
        params.append(args.limit)
        rows = db.execute(sql, params).fetchall()
        if args.json:
            print_json([
                dict(message_record(db, row), visibility=row["visibility"],
                     scope="mine" if row["delivered"] else "public")
                for row in rows
            ])
            return
        if not rows:
            print("(no matching messages)")
            return
        for row in rows:
            scope = "mine" if row["delivered"] else "public"
            print(
                f"{row['visibility']}\t{scope}\t{row['message_id']}\t"
                f"thread:{row['thread_id']}\tseq:{row['sequence']}\t"
                f"from:{row['sender_mailbox_id']}\t{row['subject'] or '(no subject)'}"
            )
    finally:
        db.close()


def cmd_read(args: argparse.Namespace) -> None:
    require_authoritative()
    db = connect()
    try:
        mailbox = mailbox_id(args.to) if args.to else sender_id()

        def pick() -> sqlite3.Row | None:
            if args.id:
                return find_message(db, args.id, mailbox)
            return db.execute(
                """SELECT m.* FROM deliveries d JOIN messages m USING(message_id)
                   WHERE d.recipient_mailbox_id = ? AND d.read_at IS NULL AND d.discarded_at IS NULL
                   ORDER BY d.delivery_seq LIMIT 1""",
                (mailbox,),
            ).fetchone()

        def bounded(row: sqlite3.Row | None) -> bytes:
            if row is None:
                raise MailError("no matching message")
            raw = render_message(db, row).encode("utf-8")
            # Checked before anything is marked, so an oversized message stays unread.
            if args.max_bytes is not None and len(raw) > args.max_bytes:
                raise Oversized(row["message_id"], len(raw), args.max_bytes)
            return raw

        if args.peek:
            row = pick()
            raw = bounded(row)
        else:
            db.execute("BEGIN IMMEDIATE")
            try:
                row = pick()
                raw = bounded(row)
                db.execute(
                    """UPDATE deliveries SET read_at = COALESCE(read_at, ?)
                       WHERE message_id = ? AND recipient_mailbox_id = ? AND discarded_at IS NULL""",
                    (now_us(), row["message_id"], mailbox),
                )
                db.execute("COMMIT")
            except Exception:
                db.execute("ROLLBACK")
                raise
        current = head(db, row["thread_id"])
        if args.json:
            print_json(dict(version=1, store=store_mode(), **message_record(db, row, body=True),
                            head=current["message_id"], raw=raw.decode("utf-8"), bytes=len(raw)))
        elif args.raw:
            sys.stdout.flush()
            sys.stdout.buffer.write(raw)
            sys.stdout.buffer.flush()
        else:
            print(render_message(db, row), end="")
        print(
            f"Reply with: {PROG} send --reply-all {row['message_id']} "
            f"--if-head {current['message_id']} --body-file FILE",
            file=sys.stderr,
        )
    finally:
        db.close()


def cmd_receipt(args: argparse.Namespace) -> None:
    db = connect()
    try:
        message = find_message(db, args.message)["message_id"]
        rows = db.execute(
            """SELECT d.*, m.sent_at FROM deliveries d JOIN messages m USING(message_id)
               WHERE d.message_id = ? ORDER BY d.recipient_mailbox_id""",
            (message,),
        ).fetchall()
        records = []
        for row in rows:
            state = "discarded" if row["discarded_at"] is not None else "read" if row["read_at"] is not None else "unread"
            records.append({"state": state, "message_id": message, "to": row["recipient_mailbox_id"],
                            "sent": format_time(row["sent_at"]), "read_at": format_time(row["read_at"]),
                            "discarded_at": format_time(row["discarded_at"])})
        if args.json:
            print_json(records)
            return
        for record in records:
            # agent-mail omits read times because the Maildir never knew them; this store does.
            extra = "".join(f"\t{key[:-3]}:{record[key]}" for key in ("read_at", "discarded_at") if record[key])
            print(f"{record['state']}\t{message}\tto:{record['to']}\tsent:{record['sent']}{extra}")
    finally:
        db.close()


def cmd_discard(args: argparse.Namespace) -> None:
    require_writable()
    db = connect()
    try:
        mailbox = mailbox_id(args.to) if args.to else sender_id()
        db.execute("BEGIN IMMEDIATE")
        try:
            row = find_message(db, args.id, mailbox)
            db.execute(
                """UPDATE deliveries SET discarded_at = COALESCE(discarded_at, ?)
                   WHERE message_id = ? AND recipient_mailbox_id = ?""",
                (now_us(), row["message_id"], mailbox),
            )
            db.execute("COMMIT")
        except Exception:
            if db.in_transaction:
                db.execute("ROLLBACK")
            raise
    finally:
        db.close()


def cmd_sweep(args: argparse.Namespace) -> None:
    """Escalate mail nobody has read for --hours, as agent-mail sweep does. Any live session
    can run it, because the recipient of ignored mail is by definition not running."""
    require_authoritative()
    # An experiment's database never notifies Josh; it only reports what it would escalate.
    dry_run = args.dry_run or not is_runtime_database()
    db = connect()
    try:
        now = now_us()
        # escalated_at is positive once Josh was told, negative while a sweep is telling him.
        # A negative claim older than ten minutes belonged to a sweep that died, so it is open.
        open_claim = "(d.escalated_at IS NULL OR (d.escalated_at < 0 AND -d.escalated_at < :stale))"
        rows = db.execute(
            f"""SELECT d.message_id, d.recipient_mailbox_id, d.escalated_at, m.sender_mailbox_id,
                       m.subject, m.sent_at
                FROM deliveries d JOIN messages m USING(message_id)
                WHERE d.read_at IS NULL AND d.discarded_at IS NULL AND {open_claim}
                  AND m.sent_at <= :cutoff ORDER BY d.delivery_seq""",
            {"stale": now - 600_000_000, "cutoff": now - int(args.hours * 3600 * 1_000_000)},
        ).fetchall()
        for row in rows:
            age = (now - row["sent_at"]) // 3_600_000_000
            line = (f"{row['recipient_mailbox_id']}\t{row['message_id']}\tfrom:{row['sender_mailbox_id']}\t"
                    f"{row['subject'] or '(no subject)'}\t{age}h")
            if dry_run:
                print(f"would escalate\t{line}")
                continue
            key = (row["message_id"], row["recipient_mailbox_id"])
            # The claim is the update, re-checking that the mail is still unread: concurrent
            # sweeps race, and only the one that changes the row notifies.
            claimed = db.execute(
                "UPDATE deliveries SET escalated_at = ? WHERE message_id = ? AND recipient_mailbox_id = ? "
                "AND read_at IS NULL AND discarded_at IS NULL AND escalated_at IS ?",
                (-now, *key, row["escalated_at"]),
            ).rowcount
            if not claimed:
                continue
            told = notify_josh(f"Unread agent mail ({age}h)",
                               f"{row['recipient_mailbox_id']} has not read \"{row['subject'] or '(no subject)'}\" "
                               f"from {row['sender_mailbox_id']}", False)
            db.execute("UPDATE deliveries SET escalated_at = ? WHERE message_id = ? AND recipient_mailbox_id = ? "
                       "AND escalated_at = ?", (now if told else None, *key, -now))
            print(f"{'escalated' if told else 'notification failed'}\t{line}")
    finally:
        db.close()


def cmd_thread(args: argparse.Namespace) -> None:
    db = connect()
    try:
        thread_id = resolve_thread(db, args.thread)
        require_visible(db, thread_id, viewer_id(args))
        rows = db.execute(
            "SELECT * FROM messages WHERE thread_id = ? ORDER BY sequence", (thread_id,)
        ).fetchall()
        if not rows:
            raise MailError(f"unknown thread: {thread_id}")
        if args.json:
            print_json([message_record(db, row, body=True) for row in rows])
            return
        for index, message in enumerate(rows):
            if index:
                print("\n---")
            print(render_message(db, message), end="")
    finally:
        db.close()


def cmd_publish(args: argparse.Namespace) -> None:
    """A thread member makes a private thread public; anyone may read it afterwards."""
    db = connect()
    mailbox = viewer_id(args)
    try:
        db.execute("BEGIN IMMEDIATE")
        try:
            thread_id = resolve_thread(db, args.thread)
            visibility = thread_visibility(db, thread_id)
            if mailbox not in thread_members(db, thread_id):
                raise MailError(f"{mailbox or 'no identity'} is not a member of thread {thread_id}")
            if visibility != "public":
                db.execute("UPDATE threads SET visibility = 'public' WHERE thread_id = ?", (thread_id,))
            db.execute("COMMIT")
        except Exception:
            if db.in_transaction:
                db.execute("ROLLBACK")
            raise
        print(f"{thread_id}\tpublic")
    finally:
        db.close()


COMMANDS = ("init", "send", "scan", "read", "receipt", "discard", "head", "thread", "search", "publish", "resolve",
            "sweep")


def parser(only: str | None = None) -> argparse.ArgumentParser:
    # Only the invoked subparser: building all of them cost more than most commands' work.
    result = argparse.ArgumentParser(
        prog=PROG, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = result.add_subparsers(dest="command", required=True)

    def add(name: str, func, help_text: str) -> argparse.ArgumentParser | None:
        if only is not None and only != name:
            return None
        command = sub.add_parser(name, help=help_text)
        command.set_defaults(func=func)
        return command

    add("init", cmd_init, "initialize the database")

    send = add("send", cmd_send, "append a message")
    if send:
        send.add_argument("--to", action="append", default=[])
        send.add_argument("--from", dest="sender", metavar="ID",
                          help="send as this mailbox, e.g. a service such as pr-monitor (default: the caller)")
        send.add_argument("--reply-all", metavar="MESSAGE_ID",
                          help="reply to the sender and other recipients; a shortened id or v1 file path works")
        send.add_argument("--thread", metavar="THREAD_ID")
        send.add_argument("--if-head", metavar="MESSAGE_ID",
                          help="refuse with exit 3 unless this is still the thread's head (strict compare-and-swap)")
        send.add_argument("--in-reply-to", metavar="MESSAGE_ID")
        send.add_argument("--reply-to", metavar="ID", help="where replies to this message go instead of the sender")
        send.add_argument("--idempotency-key", metavar="KEY",
                          help="a retry with the same key returns the first delivery's id instead of sending again")
        send.add_argument("--subject")
        send.add_argument("--body", "-m")
        send.add_argument("--body-file")
        send.add_argument("--private", action="store_true",
                          help="create the thread private (visible only to its members; public is the default)")

    scan = add("scan", cmd_scan, "list and filter inbox messages")
    if scan:
        scan.add_argument("--to")
        scan.add_argument("--all", action="store_true", help="scan every mailbox")
        scan.add_argument("--state", choices=("unread", "read", "all"), default="unread")
        scan.add_argument("--thread")
        scan.add_argument("--from", dest="sender")
        scan.add_argument("--contains", help="match literal text in subject or body")
        scan.add_argument("--limit", type=int, default=100)
        scan.add_argument("--after", metavar="CURSOR", help="continue a drain from the previous page's next")
        scan.add_argument("--json", action="store_true")

    read = add("read", cmd_read, "read one inbox message")
    if read:
        read.add_argument("--to")
        read.add_argument("--id")
        read.add_argument("--peek", action="store_true")
        read.add_argument("--json", action="store_true")
        read.add_argument("--raw", action="store_true", help="the rendered message as UTF-8 bytes, nothing else")
        read.add_argument("--max-bytes", type=int, metavar="N",
                          help="refuse with exit 4 rather than print more than N bytes")

    receipt = add("receipt", cmd_receipt, "show recipient delivery state, with read times")
    if receipt:
        receipt.add_argument("message")
        receipt.add_argument("--json", action="store_true")

    discard = add("discard", cmd_discard, "hide one inbox delivery")
    if discard:
        discard.add_argument("--to")
        discard.add_argument("--id", required=True)

    head_parser = add("head", cmd_head, "print a thread's current head message")
    if head_parser:
        head_parser.add_argument("thread")

    thread = add("thread", cmd_thread, "print a thread in ledger order")
    if thread:
        thread.add_argument("thread")
        thread.add_argument("--as", dest="viewer", help="view as this mailbox (default: the caller)")
        thread.add_argument("--json", action="store_true")

    search = add("search", cmd_search, "find messages you can see, including public threads")
    if search:
        search.add_argument("query", nargs="?", help="match literal text in subject or body")
        search.add_argument("--thread")
        search.add_argument("--from", dest="sender")
        search.add_argument("--limit", type=int, default=100)
        search.add_argument("--as", dest="viewer", help="search as this mailbox (default: the caller)")
        search.add_argument("--json", action="store_true")

    publish = add("publish", cmd_publish, "a thread member makes a private thread public")
    if publish:
        publish.add_argument("thread")
        publish.add_argument("--as", dest="viewer", help="act as this mailbox (default: the caller)")

    resolve_parser = add("resolve", cmd_resolve, "print the mailbox each address reaches")
    if resolve_parser:
        resolve_parser.add_argument("address", nargs="+")
        resolve_parser.add_argument("--json", action="store_true")
        resolve_parser.add_argument("--service", action="store_true",
                                    help="fail unless each address is exactly its own service scratchpad")

    sweep = add("sweep", cmd_sweep, "escalate mail unread for --hours")
    if sweep:
        sweep.add_argument("--hours", type=float, default=4)
        sweep.add_argument("--dry-run", action="store_true")

    return result


def main() -> int:
    os.umask(0o077)
    only = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] in COMMANDS else None
    args = parser(only).parse_args()
    try:
        args.func(args)
        return 0
    except StaleThread as error:
        print(f"{PROG}: {error}", file=sys.stderr)
        return STALE_THREAD
    except WrongStore as error:
        if getattr(args, "json", False):
            print_json({"version": 1, "error": "store", "store": error.mode})
        print(f"{PROG}: {error}", file=sys.stderr)
        return WRONG_STORE
    except Oversized as error:
        if getattr(args, "json", False):
            print_json({"version": 1, "error": "oversized", "message_id": error.message_id,
                        "bytes": error.size, "max_bytes": error.limit})
        print(f"{PROG}: {error}", file=sys.stderr)
        return OVERSIZED
    except (MailError, OSError, sqlite3.Error) as error:
        print(f"{PROG}: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
