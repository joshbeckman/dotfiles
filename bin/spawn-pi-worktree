#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  spawn-pi-worktree [--dry-run] [--approve] [--secret KEY]... --tmux-session SESSION \
    --title TITLE --cwd PATH --prompt TEXT

Starts Pi in an existing git worktree and a new detached tmux window.
Repository-specific worktree creation and setup must already be complete.

Pi's provider key is injected with `s` when that tool is available. The key
name comes from --secret (repeatable), then $SPAWN_PI_SECRETS, then Pi's own
configured defaultProvider as <PROVIDER>_API_KEY.
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

shell_join() {
  local joined="" arg
  for arg in "$@"; do
    printf -v joined '%s%q ' "$joined" "$arg"
  done
  printf '%s\n' "${joined% }"
}

pi_default_provider() {
  # Pi writes a flat settings object; stripping newlines also reads a
  # pretty-printed file. The launcher is Pi-specific, so reading Pi's own
  # provider is a less surprising default than hardcoding one key name.
  local settings="${PI_SETTINGS:-$HOME/.pi/agent/settings.json}"
  [[ -f "$settings" ]] || return 0
  tr -d '\n' <"$settings" | sed -n 's/.*"defaultProvider"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

dry_run=false
approve=false
tmux_session=""
title=""
cwd=""
prompt=""
secrets=()

while (($#)); do
  case "$1" in
    --dry-run) dry_run=true; shift ;;
    --approve) approve=true; shift ;;
    --secret) (($# >= 2)) || die '--secret requires a value'; secrets+=("$2"); shift 2 ;;
    --tmux-session) (($# >= 2)) || die '--tmux-session requires a value'; tmux_session="$2"; shift 2 ;;
    --title) (($# >= 2)) || die '--title requires a value'; title="$2"; shift 2 ;;
    --cwd) (($# >= 2)) || die '--cwd requires a value'; cwd="$2"; shift 2 ;;
    --prompt) (($# >= 2)) || die '--prompt requires a value'; prompt="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ -n "$tmux_session" ]] || die '--tmux-session is required'
[[ -n "$title" ]] || die '--title is required'
[[ -n "$cwd" ]] || die '--cwd is required'
[[ -n "$prompt" ]] || die '--prompt is required'
[[ "$cwd" = /* ]] || die '--cwd must be an absolute path'
[[ -d "$cwd" ]] || die "cwd does not exist: $cwd"
[[ "$title" != *$'\n'* ]] || die '--title must be one line'
git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "cwd is not a git worktree: $cwd"
worktree_root="$(git -C "$cwd" rev-parse --show-toplevel)"
if caller_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)" && [[ "$worktree_root" == "$caller_root" ]]; then
  die "cwd belongs to the coordinator's current worktree: $worktree_root"
fi

command -v tmux >/dev/null 2>&1 || die 'tmux is not installed'
tmux has-session -t "$tmux_session" 2>/dev/null || die "tmux session does not exist: $tmux_session"
if tmux list-windows -t "$tmux_session" -F '#W' | grep -Fxq "$title"; then
  die "tmux window already exists: $tmux_session:$title"
fi

if [[ "$(uname -s)" == Darwin ]] && pressure="$(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null)"; then
  [[ "$pressure" == 1 ]] || die "macOS memory pressure is $pressure; defer this launch"
fi

shell="${SHELL:-/bin/sh}"
[[ -x "$shell" ]] || die "login shell is not executable: $shell"
pi_path=""
if ! pi_path="$($shell -lic 'command -v pi' 2>/dev/null | tail -1)" || [[ -z "$pi_path" ]]; then
  die "pi is not available in the login shell: $shell"
fi

# The tmux server is started by systemd with only PATH, so a new window inherits
# neither the provider key nor the secret store's key source. Both have to be
# supplied here or the child starts with "No models available".
if ((${#secrets[@]} == 0)) && [[ -n "${SPAWN_PI_SECRETS:-}" ]]; then
  read -r -a secrets <<<"$SPAWN_PI_SECRETS"
fi
if ((${#secrets[@]} == 0)) && provider="$(pi_default_provider)" && [[ -n "$provider" ]]; then
  secrets+=("$(printf '%s_API_KEY' "$provider" | tr '[:lower:]' '[:upper:]')")
fi

pi_args=(--name "$title")
$approve && pi_args+=(--approve)
pi_args+=(-- "$prompt")

pi_command=("$pi_path" "${pi_args[@]}")
wrapped=false
if ((${#secrets[@]} > 0)) && command -v s >/dev/null 2>&1; then
  pi_command=(s "${secrets[@]}" -- "$pi_path" "${pi_args[@]}")
  wrapped=true
fi

# Passed to the window, not exported globally: S_KEY_COMMAND is a command, not
# the key itself, and it is what lets `s` decrypt without a TTY.
env_args=()
[[ -n "${S_KEY_COMMAND:-}" ]] && env_args+=(-e "S_KEY_COMMAND=$S_KEY_COMMAND")
[[ -n "${S_FILE:-}" ]] && env_args+=(-e "S_FILE=$S_FILE")

inner='pi_path=$1; shift; printf "Starting Pi: %s\n" "$pi_path"; "$@"; status=$?; printf "Pi exited with %s; leaving an interactive shell open.\n" "$status"; exec "${SHELL:-/bin/sh}" -l'
window_command="$(shell_join /bin/sh -c "$inner" spawn-pi-worktree "$pi_path" "${pi_command[@]}")"
branch="$(git -C "$cwd" branch --show-current)"

if $dry_run; then
  printf 'worktree: %s\nbranch: %s\npi: %s\n' "$worktree_root" "${branch:-detached HEAD}" "$pi_path"
  if $wrapped; then printf 'secrets: %s\n' "${secrets[*]}"; fi
  env_display=""
  for value in "${env_args[@]}"; do env_display+=" $(printf '%q' "$value")"; done
  printf 'tmux new-window -t %q -d -n %q -c %q%s %q\n' "$tmux_session:" "$title" "$cwd" "$env_display" "$window_command"
  exit 0
fi

exec tmux new-window -t "$tmux_session:" -d -n "$title" -c "$cwd" "${env_args[@]}" "$window_command"
