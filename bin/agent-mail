#!/usr/bin/env bash
set -euo pipefail

# agent-mail — dead-drop messaging between agent sessions (and the human)
# over a Maildir-style tree. No daemon, no lockfiles: delivery is a single
# atomic rename, so concurrent senders never corrupt a reader's view.
#
# Why not the `mail`/postfix stack? Unix mail addresses the OS *user*, not a
# session; every agent runs as the same user and would share one mbox spool,
# which needs locking and loses per-session isolation. We keep email's proven
# *format* (RFC-822 headers) and drop its transport.
#
# Creating one native-mail OS account per agent was evaluated and rejected:
# it retains the session registry while adding privileged account, mailbox, and
# alias state. Decision: "Keep Agent Mail independent of OS user accounts"
# https://github.com/joshbeckman/dotfiles/issues/7
#
# Why not delete-on-read for state? State lives in *which directory* a message
# sits in (new/ vs cur/), not in a flag we rewrite — less mutable state, and it
# leaves an audit trail until an agent explicitly discards.

MAIL_ROOT="${AGENT_MAIL_ROOT:-${AGENT_SCRATCH_ROOT:-$HOME/.local/state/agent/scratchpads}}"
HUMAN_MAIL_ROOT="${AGENT_HUMAN_MAIL_ROOT:-$HOME/.local/state/agent-mail/humans}"
mkdir -p -m 700 "$MAIL_ROOT" "$HUMAN_MAIL_ROOT"
chmod 700 "$MAIL_ROOT" "$HUMAN_MAIL_ROOT"
MAIL_ROOT="$(CDPATH= cd -- "$MAIL_ROOT" && pwd -P)"
HUMAN_MAIL_ROOT="$(CDPATH= cd -- "$HUMAN_MAIL_ROOT" && pwd -P)"

usage() {
  cat <<'USAGE'
Usage:
  agent-mail send   (--to ID... | --reply-all FILE) [--from ID] [--reply-to ID] [--subject S] [--in-reply-to MID] [--body TEXT | --body-file F]
  agent-mail scan   [--to ID] [--all]
  agent-mail receipt MSGID
  agent-mail read   --to ID [--id MSG] [--peek]
  agent-mail discard --to ID --id MSG
  agent-mail addr   ID
  agent-mail inbox  ID
  agent-mail web    [--port PORT] [--no-open]
  agent-mail archive FILE
  agent-mail compose
  agent-mail reply  FILE
  agent-mail reply-all FILE
  agent-mail deliver FILE
  agent-mail sweep  [--hours N] [--dry-run]

An ID is an agent as <name>-<sessionID>, or a human as `@josh`,
`humans/<handle>`, or an email address. The @+name agent form and @name human
form are accepted; sigils are stripped. Bare `josh` remains accepted. Agent
inboxes resolve under AGENT_MAIL_ROOT; human inboxes persist under
AGENT_HUMAN_MAIL_ROOT. @team/<slug> recipients expand the current agent-team
roster. To records concrete recipients; Team-To records addressed teams.
Reply-all keeps the original recipients even after roster changes. Teams
cannot be senders or Reply-To targets and have no separate inbox.

Message filenames expose UTC creation time, sender, receiver, and a truncated
subject before a collision-resistant suffix. Thread-ID names the root message;
In-Reply-To names the immediate parent.

send   Deliver a message. Repeat --to or separate recipients with commas.
       --reply-all derives recipients and thread headers from an existing message.
       Body from --body/-m, --body-file, or stdin.
scan   List unread (new/) messages for an inbox, or --all inboxes.
receipt Say whether a message you sent has been read. Takes the MSGID that
       `send` printed. Exits 1 if it is in no inbox.
read   Print the oldest unread message (or --id), moving it new/ -> cur/.
       --peek prints without marking read.
discard Delete a message from cur/ or new/.
addr   Print the resolved inbox path for an ID (empty+exit 1 if none).
inbox Open an ID's inbox directory in Neovim.
web   Open Josh's web inbox through a loopback-only local bridge.
archive Move a message from inbox/new to inbox/cur.
compose Create a blank Josh-authored draft and print its path.
reply  Create a reply draft and print its path.
reply-all Create a draft to the sender and other original recipients.
deliver Atomically copy a draft to recipients and retain a human Sent copy.
sweep  Notify Josh about messages unread for --hours (default 4). Any live
       session can run it; a dead recipient cannot escalate for itself.

Env:
  AGENT_TEAM_ROOT Override team registry root (see agent-team).
  AGENT_MAIL_ROOT  Override agent inbox root (default AGENT_SCRATCH_ROOT or
                   ~/.local/state/agent/scratchpads).
  AGENT_SCRATCH_ROOT Persistent agent scratchpad and inbox root.
  AGENT_HUMAN_MAIL_ROOT Persistent human inboxes (default
                   ~/.local/state/agent-mail/humans).
  AGENT_MAIL_STALE_HOURS  Report the recipient's idle time on send once it
                   reaches this many hours (default 12).
  AGENT_MAIL_EDITOR Editor used by inbox (default nvim).
USAGE
}

die() { echo "agent-mail: $*" >&2; exit 1; }

# Accept the @+name mention form from prose and vim autocomplete. Stripped
# before any address parsing because "@+name" contains "@" and would otherwise
# be misread as a human email address downstream.
normalize_id() {
  local id="$1"
  id="${id#@}"
  id="${id#+}"
  printf '%s' "$id"
}

is_team_handle() {
  local id="$1"
  case "$id" in
    @team/*|team/*) return 0 ;;
    *) return 1 ;;
  esac
}

TEAM_MEMBERS=()
expand_team_members() {
  local team="$1" helper members_output member
  local handle_pattern='^@\+[a-z0-9]+(-[a-z0-9]+)+$'
  TEAM_MEMBERS=()
  helper="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/agent-team"
  [ -x "$helper" ] || die "sibling agent-team not found (required for team recipients)"
  # Keep trailing blank lines visible for validation; substitution strips them.
  members_output="$("$helper" members "$team" && printf '.')" || die "team expansion failed for '$team'"
  members_output="${members_output%.}"
  members_output="${members_output%$'\n'}"
  [ -n "$members_output" ] || die "team '$team' has no members"
  while IFS= read -r member; do
    [[ "$member" =~ $handle_pattern ]] || die "invalid member from team '$team': $member"
    member="$(normalize_id "$member")"
    [ -z "$(human_handle "$member" || true)" ] || die "team member conflicts with a human address: $member"
    TEAM_MEMBERS+=("$member")
  done <<< "$members_output"
}

PARSED_RECIPIENTS=()
PARSED_TEAMS=()
parse_recipient_lists() {
  PARSED_RECIPIENTS=()
  PARSED_TEAMS=()
  local raw recipient existing duplicate
  local -a pre_expanded=()

  for raw in "$@"; do
    while :; do
      case "$raw" in
        *,*) recipient="${raw%%,*}"; raw="${raw#*,}"; [ -n "$raw" ] || die "empty recipient in list" ;;
        *) recipient="$raw"; raw="" ;;
      esac
      recipient="${recipient#"${recipient%%[![:space:]]*}"}"
      recipient="${recipient%"${recipient##*[![:space:]]}"}"
      [ -n "$recipient" ] || die "empty recipient in list"
      recipient="$(normalize_id "$recipient")"
      duplicate=0
      for existing in ${pre_expanded[@]+"${pre_expanded[@]}"}; do
        [ "$existing" = "$recipient" ] && duplicate=1
      done
      [ "$duplicate" -eq 1 ] || pre_expanded+=("$recipient")
      [ -z "$raw" ] && break
    done
  done

  local -a members=() seen_inboxes=()
  local member inbox
  for recipient in "${pre_expanded[@]}"; do
    if is_team_handle "$recipient"; then
      PARSED_TEAMS+=("@$recipient")
      expand_team_members "@$recipient"
      members=("${TEAM_MEMBERS[@]}")
    else
      members=("$recipient")
    fi
    for member in "${members[@]}"; do
      inbox="$(resolve_inbox "$member")"
      duplicate=0
      for existing in ${seen_inboxes[@]+"${seen_inboxes[@]}"}; do
        [ "$existing" = "$inbox" ] && duplicate=1
      done
      if [ "$duplicate" -eq 0 ]; then
        seen_inboxes+=("$inbox")
        PARSED_RECIPIENTS+=("$member")
      fi
    done
  done
}

# The sender's own address, in the order the forms are trustworthy. The
# scratchpad basename comes before AGENT_HANDLE because it is the transport
# form (<name>-<sessionID>, RFC 0001 section 6): it resolves exactly, names one
# session, and gives the recipient something `receipt` and a reply can use.
# AGENT_HANDLE is realm-suffixed with no session id, so it only resolves when
# the pad follows the same convention -- true for new sessions, false for the
# pre-realm pads still running. Guessing wrong is worse than saying unknown,
# so both are consulted before falling back.
sender_id() {
  local id="${AGENT_MAIL_FROM:-}"
  [ -n "$id" ] || id="$(basename "${AGENT_SCRATCHPAD:-}" 2>/dev/null)"
  [ -n "$id" ] || id="${AGENT_HANDLE:-}"
  [ -n "$id" ] && [ "$id" != "." ] && [ "$id" != "/" ] || id="unknown"
  printf '%s' "$id"
}

# Resolve an ID to an inbox base path. Humans: humans/<handle>. Agents:
# match <name>-* exactly, then fall back to a bare name dir. Ambiguity (two
# live sessions of one name) fails loudly rather than guessing a recipient.
human_handle() {
  local id="$1" handle
  case "$id" in
    josh) printf 'josh'; return 0 ;;
    humans/*) handle="${id#humans/}" ;;
    *@*) handle="${id%%@*}" ;;
    *) [ -d "$HUMAN_MAIL_ROOT/$id" ] || return 1; handle="$id" ;;
  esac
  [ -n "$handle" ] || return 1
  printf '%s' "$handle"
}

resolve_inbox() {
  local id match handle address
  id="$(normalize_id "$1")"
  address="$id"
  case "$id" in
    humans/*) address="${id#humans/}"; case "$address" in */*) die "invalid recipient ID: $id" ;; esac ;;
    */*) die "invalid recipient ID: $id" ;;
  esac
  case "$address" in ''|*[!A-Za-z0-9._+@-]*) die "invalid recipient ID: $id" ;; esac
  if handle="$(human_handle "$id")"; then
    echo "$HUMAN_MAIL_ROOT/$handle/inbox"
    return 0
  fi
  # Match on the *scratchpad* existing, not inbox/ — a fresh recipient has a
  # scratchpad but no inbox until their first mail arrives, so keying off
  # inbox/ made bare-name first contact impossible (chicken-and-egg).
  # Exact dir first (full <name>-<sessionID>), then prefix-glob (bare <name>).
  # Names themselves contain hyphens, so we cannot infer "full ID" by counting
  # hyphens — match the filesystem instead.
  if [ -d "$MAIL_ROOT/$id" ]; then
    echo "$MAIL_ROOT/$id/inbox"; return 0
  fi
  local -a hits=()
  local d
  for d in "$MAIL_ROOT/$id"-*/; do
    [ -d "$d" ] && hits+=("${d%/}/inbox")
  done
  # Pads created before the realm-suffix convention are named <base>-<session>,
  # so the canonical handle agent-find prints (<base>-of-<realm>) matches
  # nothing and send reports a missing scratchpad for a pad that exists. Retry
  # without the suffix: RFC 0001 section 5 requires consumers to accept both
  # handle forms. This is the mirror of agent-trailer's bare -> suffixed retry.
  if [ ${#hits[@]} -eq 0 ] && [ "$id" != "${id%-of-*}" ]; then
    local bare="${id%-of-*}"
    if [ -d "$MAIL_ROOT/$bare" ]; then
      echo "$MAIL_ROOT/$bare/inbox"; return 0
    fi
    for d in "$MAIL_ROOT/$bare"-*/; do
      [ -d "$d" ] && hits+=("${d%/}/inbox")
    done
  fi
  case ${#hits[@]} in
    1) echo "${hits[0]}"; return 0 ;;
    0) echo "$MAIL_ROOT/$id/inbox"; return 0 ;;
    *) die "ambiguous recipient '$id'; matches: ${hits[*]}" ;;
  esac
}

ensure_maildir() {
  mkdir -p "$1/tmp" "$1/new" "$1/cur"
}

clear_escalation_marker() {
  rmdir "$1/.escalated-$2" 2>/dev/null || true
}

cleanup_escalation_markers() {
  local inbox="$1" marker id
  for marker in "$inbox"/.escalated-*; do
    [ -d "$marker" ] || continue
    id="${marker##*/.escalated-}"
    [ -e "$inbox/new/$id.md" ] || rmdir "$marker" 2>/dev/null || true
  done
}

inbox_click_command() {
  local handle="$1" self inner command
  self="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)/$(basename -- "$0")"
  printf -v inner '%q ' "$self" inbox "@$handle"
  inner="${inner% }"
  printf -v command '%q ' /usr/bin/open -na Ghostty.app --args -e /bin/zsh -lic "$inner"
  printf '%s' "${command% }"
}

notify_human_delivery() {
  local handle="$1" inbox="$2" msgid="$3" from="$4" subject="$5" click_command
  [ "$handle" = josh ] && command -v notify-josh >/dev/null 2>&1 || return 0
  click_command="$(inbox_click_command "$handle")"
  if notify-josh --from agent-mail --execute "$click_command" "Agent mail: $subject" \
    "From $from. Read with: agent-mail read --to @josh" >/dev/null 2>&1; then
    mkdir "$inbox/.escalated-$msgid" 2>/dev/null || true
  else
    echo "agent-mail: immediate Josh notification failed; unread sweep will retry" >&2
  fi
}

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Hours since a scratchpad's last heartbeat or structural change. The heartbeat
# keeps parked live sessions current without rewriting every artifact timestamp.
# Only for *directories*: for a message file, use message_age_hours instead.
idle_hours() {
  local path="$1" mtime heartbeat now
  mtime=$(stat -f %m "$path" 2>/dev/null) || return 1
  heartbeat="$path/.heartbeat"
  if [ -f "$heartbeat" ]; then
    local heartbeat_mtime
    heartbeat_mtime=$(stat -f %m "$heartbeat" 2>/dev/null || echo 0)
    [ "$heartbeat_mtime" -le "$mtime" ] || mtime="$heartbeat_mtime"
  fi
  now=$(date +%s)
  echo $(( (now - mtime) / 3600 ))
}

# Hours since a message was delivered, read from the timestamp already in its
# msgid rather than from mtime. mtime cannot answer this: the same restamping
# that keeps a live session's scratchpad from being reaped walks the inbox too,
# so an unread message could keep looking newly arrived and never escalate.
# mv preserves mtime, so moving new/ -> cur/ is not what disturbs it.
message_age_hours() {
  local path="$1" id ts sent now
  id=$(basename "$path" .md)
  ts="${id%%-*}"
  case "$ts" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z) ;;
    *) idle_hours "$path"; return ;;  # not msgid-shaped: mtime is all we have
  esac
  sent=$(date -j -u -f '%Y%m%dT%H%M%SZ' "$ts" +%s 2>/dev/null) ||
    sent=$(date -u -d "${ts:0:4}-${ts:4:2}-${ts:6:2} ${ts:9:2}:${ts:11:2}:${ts:13:2}" +%s 2>/dev/null) ||
    { idle_hours "$path"; return; }
  now=$(date +%s)
  echo $(( (now - sent) / 3600 ))
}

filename_component() {
  local value="$1" limit="$2"
  LC_ALL=C printf '%s' "$value" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9._@+-]+/-/g; s/-+/-/g; s/^[-.]+//; s/[-.]+$//' |
    cut -c1-"$limit" |
    sed -E 's/[-.]+$//'
}

# The descriptive fields make Maildir listings useful; pid and random retain
# collision resistance when one sender creates several messages per second.
gen_msgid() {
  local from to subject
  from="$(filename_component "$1" 48)"
  to="$(filename_component "$2" 48)"
  subject="$(filename_component "$3" 48)"
  printf '%s--from-%s--to-%s--%s--%s-%s\n' \
    "$(date -u +%Y%m%dT%H%M%SZ)" "${from:-unknown}" "${to:-unknown}" \
    "${subject:-no-subject}" "$$" "${RANDOM}${RANDOM}"
}

message_header() {
  awk -v key="$2" '/^$/ { exit } index($0, key ": ") == 1 { print substr($0, length(key) + 3); exit }' "$1"
}

thread_id_for_message() {
  local path="$1" thread
  thread="$(message_header "$path" Thread-ID)"
  [ -n "$thread" ] || thread="$(message_header "$path" Message-ID)"
  printf '%s' "$thread"
}

thread_id_for_parent() {
  local id="$(basename "$1" .md)" inbox state path
  for inbox in "$MAIL_ROOT"/*/inbox "$HUMAN_MAIL_ROOT"/*/inbox; do
    [ -d "$inbox" ] || continue
    for state in new cur; do
      path="$inbox/$state/$id.md"
      if [ -f "$path" ]; then
        thread_id_for_message "$path"
        return
      fi
    done
  done
  for path in "$HUMAN_MAIL_ROOT"/*/sent/"$id.md"; do
    if [ -f "$path" ]; then
      thread_id_for_message "$path"
      return
    fi
  done
  # A parent can have aged out with its session inbox. Keeping its ID still
  # links the new branch instead of silently starting an unrelated thread.
  printf '%s' "$id"
}

retain_human_sent() {
  local source="$1" from="$2" msgid="$3" handle sent tmp
  handle="$(human_handle "$(normalize_id "$from")" || true)"
  [ -n "$handle" ] || return 0
  case "$handle" in *[!A-Za-z0-9._-]*|.|..) die "invalid human sender" ;; esac
  sent="$HUMAN_MAIL_ROOT/$handle/sent"
  mkdir -p -m 700 "$sent"
  tmp="$(mktemp "$sent/.sent.XXXXXXXX")"
  cp "$source" "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$sent/$msgid.md"
}

cmd_send() {
  local from="$(sender_id)" reply_to="" reply_all_file="" subject="" in_reply_to="" body_file="" body="" have_body=0
  local -a raw_recipients=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) raw_recipients+=("$2"); shift 2 ;;
      --from) from="$2"; shift 2 ;;
      --reply-to) reply_to="$2"; shift 2 ;;
      --reply-all) reply_all_file="$2"; shift 2 ;;
      --subject) subject="$2"; shift 2 ;;
      --in-reply-to) in_reply_to="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      # Every agent guesses --body first, and the guess costs a turn to correct.
      # Kept as a peer of --body-file rather than the documented form: a one-line
      # reply inline is fine, anything longer wants a file it can revise.
      --body | -m) body="$2"; have_body=1; shift 2 ;;
      *) die "send: unknown arg $1" ;;
    esac
  done
  [ "$have_body" -eq 1 ] && [ -n "$body_file" ] && die "send: --body and --body-file are mutually exclusive"
  [ -z "$reply_all_file" ] || [ "${#raw_recipients[@]}" -eq 0 ] || die "send: --reply-all and --to are mutually exclusive"
  from="$(normalize_id "$from")"
  [ -n "$reply_to" ] && reply_to="$(normalize_id "$reply_to")"

  # Reject team handles as sender or Reply-To
  is_team_handle "$from" && die "send: team cannot be message sender (From)"
  [ -n "$reply_to" ] && is_team_handle "$reply_to" && die "send: team cannot be Reply-To"

  if [ -n "$reply_all_file" ]; then
    local source_path source_sender source_to source_subject source_id self_inbox candidate candidate_inbox
    source_path="$(message_path "$reply_all_file")"
    source_sender="$(message_header "$source_path" Reply-To)"
    [ -n "$source_sender" ] || source_sender="$(message_header "$source_path" From)"
    source_to="$(message_header "$source_path" To)"
    source_id="$(message_header "$source_path" Message-ID)"
    [ -n "$source_sender" ] && [ -n "$source_id" ] || die "send: reply-all source is missing From or Message-ID"
    is_team_handle "$source_sender" && die "send: team cannot be reply target"
    if [ -n "$source_to" ]; then
      parse_recipient_lists "$source_sender" "$source_to"
    else
      parse_recipient_lists "$source_sender"
    fi
    self_inbox="$(resolve_inbox "$from")"
    raw_recipients=()
    for candidate in "${PARSED_RECIPIENTS[@]}"; do
      candidate_inbox="$(resolve_inbox "$candidate")"
      [ "$candidate_inbox" = "$self_inbox" ] || raw_recipients+=("$candidate")
    done
    [ "${#raw_recipients[@]}" -gt 0 ] || die "send: reply-all source has no other recipients"
    if [ -z "$subject" ]; then
      source_subject="$(message_header "$source_path" Subject)"
      case "$source_subject" in Re:\ *) subject="$source_subject" ;; *) subject="Re: ${source_subject:-(no subject)}" ;; esac
    fi
    [ -n "$in_reply_to" ] || in_reply_to="$source_id"
  fi

  [ "${#raw_recipients[@]}" -gt 0 ] || die "send: --to or --reply-all required"
  parse_recipient_lists "${raw_recipients[@]}"
  local -a recipients=("${PARSED_RECIPIENTS[@]}") inboxes=() humans=()

  local recipient inbox human scratchpad idle
  for recipient in "${recipients[@]}"; do
    inbox="$(resolve_inbox "$recipient")"
    human="$(human_handle "$recipient" || true)"
    scratchpad="$(dirname "$inbox")"
    if [ -z "$human" ]; then
      # Validate the complete recipient list before writing any message copy.
      [ -d "$scratchpad" ] || die "recipient '$recipient' has no scratchpad at $scratchpad (not created or pruned?)"
      idle="$(idle_hours "$scratchpad" || echo 0)"
      if [ "$idle" -ge "${AGENT_MAIL_STALE_HOURS:-12}" ]; then
        echo "agent-mail: '$recipient' last active ${idle}h ago" >&2
      fi
    fi
    inboxes+=("$inbox")
    humans+=("$human")
  done
  for inbox in "${inboxes[@]}"; do ensure_maildir "$inbox"; done

  local to_header="${recipients[0]}" to_filename="${recipients[0]}" i
  for ((i = 1; i < ${#recipients[@]}; i++)); do
    to_header+=", ${recipients[$i]}"
    to_filename+="+${recipients[$i]}"
  done

  local effective_subject="${subject:-(no subject)}"
  local msgid; msgid="$(gen_msgid "$from" "$to_filename" "$effective_subject")"
  local thread_id="$msgid"
  [ -z "$in_reply_to" ] || thread_id="$(thread_id_for_parent "$in_reply_to")"
  # A recipient may read/move its copy before we retain the sender's Sent copy.
  local source_tmp="${inboxes[0]}/tmp/$msgid.source"

  # Build Team-To header if teams were addressed
  local team_to_header=""
  if [ ${#PARSED_TEAMS[@]} -gt 0 ]; then
    team_to_header="${PARSED_TEAMS[0]}"
    for ((i = 1; i < ${#PARSED_TEAMS[@]}; i++)); do
      team_to_header+=", ${PARSED_TEAMS[$i]}"
    done
  fi

  {
    echo "From: $from"
    echo "To: $to_header"
    [ -n "$team_to_header" ] && echo "Team-To: $team_to_header"
    [ -n "$reply_to" ] && echo "Reply-To: $reply_to"
    echo "Date: $(now_iso)"
    echo "Message-ID: $msgid"
    echo "Thread-ID: $thread_id"
    [ -n "$in_reply_to" ] && echo "In-Reply-To: $in_reply_to"
    echo "Subject: $effective_subject"
    echo
    if [ "$have_body" -eq 1 ]; then
      printf '%s\n' "$body"
    elif [ -n "$body_file" ]; then
      cat "$body_file"
    else
      cat
    fi
  } > "$source_tmp"

  local tmp dst
  for ((i = 0; i < ${#inboxes[@]}; i++)); do
    dst="${inboxes[$i]}/new/$msgid.md"
    [ ! -e "$dst" ] || die "delivery destination already exists: $dst"
    tmp="${inboxes[$i]}/tmp/$msgid.md"
    cp "$source_tmp" "$tmp"
  done
  for ((i = 0; i < ${#inboxes[@]}; i++)); do
    tmp="${inboxes[$i]}/tmp/$msgid.md"
    dst="${inboxes[$i]}/new/$msgid.md"
    mv "$tmp" "$dst"
  done

  retain_human_sent "$source_tmp" "$from" "$msgid"
  rm "$source_tmp"
  for ((i = 0; i < ${#inboxes[@]}; i++)); do
    notify_human_delivery "${humans[$i]}" "${inboxes[$i]}" "$msgid" "$from" "$effective_subject"
  done

  echo "$msgid"
}

cmd_scan() {
  local to="" all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) to="$2"; shift 2 ;;
      --all) all=1; shift ;;
      *) die "scan: unknown arg $1" ;;
    esac
  done
  local -a inboxes=()
  if [ "$all" -eq 1 ]; then
    local d
    for d in "$MAIL_ROOT"/*/inbox "$HUMAN_MAIL_ROOT"/*/inbox; do
      [ -d "$d/new" ] && inboxes+=("$d")
    done
  else
    [ -n "$to" ] || die "scan: --to or --all required"
    inboxes+=("$(resolve_inbox "$to")")
  fi

  local inbox f found=0
  for inbox in "${inboxes[@]}"; do
    [ -d "$inbox/new" ] || continue
    for f in "$inbox/new"/*.md; do
      [ -e "$f" ] || continue
      found=1
      local from subj
      from=$(sed -n 's/^From: //p' "$f" | head -1)
      subj=$(sed -n 's/^Subject: //p' "$f" | head -1)
      printf '%s\t%s\tfrom:%s\t%s\n' "$inbox" "$(basename "$f" .md)" "$from" "$subj"
    done
  done
  [ "$found" -eq 1 ] || echo "(no unread messages)"
}

# Reports delivery state without adding any: a message in cur/ has been read,
# one in new/ has not. Deliberately prints no read *time* -- mv preserves mtime
# and restamping rewrites it, so any timestamp here would be fiction, and
# recording a real one means the mutable flag file this design does without.
cmd_receipt() {
  local id="${1:-}"
  [ -n "$id" ] || die "receipt: MSGID required"
  id="$(basename "$id" .md)"

  local inbox recipient state="" found=0
  for inbox in "$MAIL_ROOT"/*/inbox "$HUMAN_MAIL_ROOT"/*/inbox; do
    [ -d "$inbox" ] || continue
    if [ -e "$inbox/cur/$id.md" ]; then state=read
    elif [ -e "$inbox/new/$id.md" ]; then state=unread
    else continue
    fi
    found=1
    recipient="$(basename "$(dirname "$inbox")")"
    local age; age="$(message_age_hours "$inbox/$([ "$state" = read ] && echo cur || echo new)/$id.md" || echo 0)"
    printf '%s\t%s\tto:%s\tdelivered:%s\t%sh ago\n' "$state" "$id" "$recipient" "${id%%-*}" "$age"
  done
  [ "$found" -eq 0 ] || return 0

  # Absence is ambiguous on purpose: discard removes from both new/ and cur/,
  # so a read-then-discarded message is indistinguishable from one never sent.
  echo "unknown	$id	not in any inbox (read and discarded, or never delivered)"
  return 1
}

cmd_read() {
  local to="" id="" peek=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) to="$2"; shift 2 ;;
      --id) id="$2"; shift 2 ;;
      --peek) peek=1; shift ;;
      *) die "read: unknown arg $1" ;;
    esac
  done
  [ -n "$to" ] || die "read: --to required"
  local inbox; inbox="$(resolve_inbox "$to")"

  local f=""
  if [ -n "$id" ]; then
    [ -e "$inbox/new/$id.md" ] && f="$inbox/new/$id.md"
    [ -z "$f" ] && [ -e "$inbox/cur/$id.md" ] && f="$inbox/cur/$id.md"
  else
    # Oldest unread first; new/ names sort chronologically by construction.
    for cand in "$inbox/new"/*.md; do
      [ -e "$cand" ] && { f="$cand"; break; }
    done
  fi
  [ -n "$f" ] || { echo "(no message)" >&2; exit 1; }

  cat "$f"

  if [ "$peek" -eq 0 ] && [ "$(dirname "$f")" = "$inbox/new" ]; then
    mkdir -p "$inbox/cur"
    local basename; basename="$(basename "$f")"
    mv "$f" "$inbox/cur/$basename"
    clear_escalation_marker "$inbox" "${basename%.md}"
  fi
}

cmd_discard() {
  local to="" id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) to="$2"; shift 2 ;;
      --id) id="$2"; shift 2 ;;
      *) die "discard: unknown arg $1" ;;
    esac
  done
  [ -n "$to" ] && [ -n "$id" ] || die "discard: --to and --id required"
  local inbox; inbox="$(resolve_inbox "$to")"
  rm -f "$inbox/new/$id.md" "$inbox/cur/$id.md"
  clear_escalation_marker "$inbox" "$id"
}

message_path() {
  local path="$1" dir
  [ -f "$path" ] || die "message file not found: $path"
  dir="$(CDPATH= cd -- "$(dirname -- "$path")" && pwd)"
  case "$dir" in
    "$MAIL_ROOT"/*/inbox/new|"$MAIL_ROOT"/*/inbox/cur|"$HUMAN_MAIL_ROOT"/*/inbox/new|"$HUMAN_MAIL_ROOT"/*/inbox/cur|"$HUMAN_MAIL_ROOT"/*/sent)
      printf '%s/%s' "$dir" "$(basename -- "$path")" ;;
    *) die "not an agent-mail message: $path" ;;
  esac
}

cmd_inbox() {
  local id="${1:-}" handle="" inbox scratchpad
  [ -n "$id" ] || die "inbox: ID required"
  [ $# -eq 1 ] || die "inbox: expected one ID"
  id="$(normalize_id "$id")"
  inbox="$(resolve_inbox "$id")"
  handle="$(human_handle "$id" || true)"
  scratchpad="$(dirname "$inbox")"
  [ -n "$handle" ] || [ -d "$scratchpad" ] || die "recipient '$id' has no scratchpad at $scratchpad (not created or pruned?)"
  ensure_maildir "$inbox"
  cleanup_escalation_markers "$inbox"
  command -v "${AGENT_MAIL_EDITOR:-nvim}" >/dev/null 2>&1 || die "editor not found: ${AGENT_MAIL_EDITOR:-nvim}"
  cd "$inbox"
  exec "${AGENT_MAIL_EDITOR:-nvim}" .
}

cmd_archive() {
  local path; path="$(message_path "${1:-}")"
  [ $# -eq 1 ] || die "archive: expected one message file"
  [ "$(basename "$(dirname "$path")")" = new ] || die "message is already archived: $path"
  local inbox dst
  inbox="$(dirname "$(dirname "$path")")"
  ensure_maildir "$inbox"
  dst="$inbox/cur/$(basename "$path")"
  [ ! -e "$dst" ] || die "archive destination already exists: $dst"
  mv "$path" "$dst"
  clear_escalation_marker "$inbox" "$(basename "$path" .md)"
  printf '%s\n' "$dst"
}

cmd_compose() {
  [ $# -eq 0 ] || die "compose: expected no arguments"
  local drafts draft
  drafts="$HUMAN_MAIL_ROOT/josh/drafts"
  mkdir -p "$drafts"
  draft="$drafts/compose-$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM.md"
  {
    echo "From: josh"
    echo "To: "
    echo "Subject: "
    echo
  } >"$draft"
  printf '%s\n' "$draft"
}

create_reply_draft() {
  local path="$1" to="$2" subject in_reply_to thread_id msgid drafts draft to_filename
  subject="$(message_header "$path" Subject)"
  case "$subject" in Re:\ *) ;; *) subject="Re: ${subject:-(no subject)}" ;; esac
  in_reply_to="$(message_header "$path" Message-ID)"
  thread_id="$(thread_id_for_message "$path")"
  to_filename="${to//, /+}"
  msgid="$(gen_msgid josh "$to_filename" "$subject")"
  thread_id="${thread_id:-$msgid}"
  drafts="$HUMAN_MAIL_ROOT/josh/drafts"
  mkdir -p "$drafts"
  draft="$drafts/$msgid.md"
  {
    echo "From: josh"
    echo "To: $to"
    echo "Date: $(now_iso)"
    echo "Message-ID: $msgid"
    echo "Thread-ID: ${thread_id:-$in_reply_to}"
    [ -n "$in_reply_to" ] && echo "In-Reply-To: $in_reply_to"
    echo "Subject: $subject"
    echo
  } >"$draft"
  printf '%s\n' "$draft"
}

cmd_reply() {
  local path; path="$(message_path "${1:-}")"
  [ $# -eq 1 ] || die "reply: expected one message file"
  local to
  to="$(message_header "$path" Reply-To)"
  [ -n "$to" ] || to="$(message_header "$path" From)"
  [ -n "$to" ] || die "reply: message has no From or Reply-To header"
  is_team_handle "$to" && die "reply: team cannot be reply target"
  create_reply_draft "$path" "$(normalize_id "$to")"
}

cmd_reply_all() {
  local path; path="$(message_path "${1:-}")"
  [ $# -eq 1 ] || die "reply-all: expected one message file"
  local sender original_to recipient human to=""
  sender="$(message_header "$path" Reply-To)"
  [ -n "$sender" ] || sender="$(message_header "$path" From)"
  original_to="$(message_header "$path" To)"
  [ -n "$sender" ] || die "reply-all: message has no From or Reply-To header"
  is_team_handle "$sender" && die "reply-all: team cannot be reply target"
  if [ -n "$original_to" ]; then
    parse_recipient_lists "$sender" "$original_to"
  else
    parse_recipient_lists "$sender"
  fi
  for recipient in "${PARSED_RECIPIENTS[@]}"; do
    human="$(human_handle "$recipient" || true)"
    [ "$human" = josh ] && continue
    [ -z "$to" ] && to="$recipient" || to+=", $recipient"
  done
  [ -n "$to" ] || die "reply-all: message has no recipients other than Josh"
  create_reply_draft "$path" "$to"
}

cmd_deliver() {
  local draft="${1:-}" dir
  [ $# -eq 1 ] || die "deliver: expected one draft file"
  [ -f "$draft" ] || die "draft file not found: $draft"
  dir="$(CDPATH= cd -- "$(dirname -- "$draft")" && pwd)"
  [ "$dir" = "$HUMAN_MAIL_ROOT/josh/drafts" ] || die "not a Josh agent-mail draft: $draft"

  local to from reply_to subject msgid recipient inbox scratchpad human dst to_filename i
  local -a recipients=() inboxes=() humans=()
  to="$(message_header "$draft" To)"
  from="$(message_header "$draft" From)"
  reply_to="$(message_header "$draft" Reply-To)"
  subject="$(message_header "$draft" Subject)"
  msgid="$(message_header "$draft" Message-ID)"
  awk '/^$/ { found=1; exit } END { exit !found }' "$draft" || die "draft has no header/body separator"
  [ -n "$to" ] && [ -n "$from" ] || die "draft is missing To or From"

  # Reject team handles as sender or Reply-To
  from="$(normalize_id "$from")"
  is_team_handle "$from" && die "deliver: team cannot be message sender (From)"
  if [ -n "$reply_to" ]; then
    reply_to="$(normalize_id "$reply_to")"
    is_team_handle "$reply_to" && die "deliver: team cannot be Reply-To"
  fi

  parse_recipient_lists "$to"
  recipients=("${PARSED_RECIPIENTS[@]}")
  to_filename="${recipients[0]}"
  for ((i = 1; i < ${#recipients[@]}; i++)); do
    to_filename+="+${recipients[$i]}"
  done
  for recipient in "${recipients[@]}"; do
    inbox="$(resolve_inbox "$recipient")"
    human="$(human_handle "$recipient" || true)"
    scratchpad="$(dirname "$inbox")"
    [ -n "$human" ] || [ -d "$scratchpad" ] || die "recipient '$recipient' has no scratchpad at $scratchpad (not created or pruned?)"
    inboxes+=("$inbox")
    humans+=("$human")
  done
  # Build Team-To header if teams were addressed
  local team_to_header=""
  if [ ${#PARSED_TEAMS[@]} -gt 0 ]; then
    team_to_header="${PARSED_TEAMS[0]}"
    for ((i = 1; i < ${#PARSED_TEAMS[@]}; i++)); do
      team_to_header+=", ${PARSED_TEAMS[$i]}"
    done
  fi

  # Update draft with expanded recipients and metadata
  local expanded_to="${recipients[0]}"
  for ((i = 1; i < ${#recipients[@]}; i++)); do
    expanded_to+=", ${recipients[$i]}"
  done

  local had_msgid="$msgid"
  [ -n "$msgid" ] || msgid="$(gen_msgid "$from" "$to_filename" "${subject:-(no subject)}")"
  for inbox in "${inboxes[@]}"; do
    dst="$inbox/new/$msgid.md"
    [ ! -e "$dst" ] || die "delivery destination already exists: $dst"
  done
  for inbox in "${inboxes[@]}"; do ensure_maildir "$inbox"; done

  if [ -z "$had_msgid" ] || [ -n "$team_to_header" ] || [ "$to" != "$expanded_to" ]; then
    local tmp line thread_id
    thread_id="$(message_header "$draft" Thread-ID)"
    tmp="$(mktemp "$draft.tmp.XXXXXXXX")"
    # Hand the remaining bytes to cat at the separator: line-oriented rewriting
    # would change a body without a final newline (or its header-like lines).
    {
      while IFS= read -r line; do
        if [ -z "$line" ]; then
          printf '\n'
          cat
          break
        fi
        case "$line" in
          To:\ *)
            printf 'To: %s\n' "$expanded_to"
            [ -z "$team_to_header" ] || printf 'Team-To: %s\n' "$team_to_header"
            if [ -z "$had_msgid" ]; then
              printf 'Date: %s\nMessage-ID: %s\n' "$(now_iso)" "$msgid"
              [ -n "$thread_id" ] || printf 'Thread-ID: %s\n' "$msgid"
            fi
            ;;
          Team-To:\ *) [ -n "$team_to_header" ] || printf '%s\n' "$line" ;;
          Date:\ *|Message-ID:\ *) [ -z "$had_msgid" ] || printf '%s\n' "$line" ;;
          *) printf '%s\n' "$line" ;;
        esac
      done
    } <"$draft" >"$tmp"
    mv "$tmp" "$draft"
  fi
  local first_dst="" tmp_dst
  for ((i = 0; i < ${#inboxes[@]}; i++)); do
    inbox="${inboxes[$i]}"
    dst="$inbox/new/$msgid.md"
    tmp_dst="$inbox/tmp/$msgid.md.$$-$RANDOM"
    cp "$draft" "$tmp_dst"
    mv "$tmp_dst" "$dst"
    [ -n "$first_dst" ] || first_dst="$dst"
  done
  retain_human_sent "$draft" "$from" "$msgid"
  rm "$draft"
  for ((i = 0; i < ${#inboxes[@]}; i++)); do
    notify_human_delivery "${humans[$i]}" "${inboxes[$i]}" "$msgid" "$from" "${subject:-(no subject)}"
  done
  printf '%s\n' "$first_dst"
}

# Escalate to the human when nobody picked a message up. Runs from any live
# session because the recipient, by definition, is not running to notice.
cmd_sweep() {
  local hours=4 dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --hours) hours="$2"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      *) die "sweep: unknown arg $1" ;;
    esac
  done

  local inbox f
  for inbox in "$MAIL_ROOT"/*/inbox "$HUMAN_MAIL_ROOT"/*/inbox; do
    [ "$dry" -eq 1 ] || cleanup_escalation_markers "$inbox"
    [ -d "$inbox/new" ] || continue
    for f in "$inbox/new"/*.md; do
      [ -e "$f" ] || continue
      local age; age="$(message_age_hours "$f" || echo 0)"
      [ "$age" -ge "$hours" ] || continue

      local msgid; msgid="$(basename "$f" .md)"
      local recipient; recipient="$(basename "$(dirname "$inbox")")"
      local from subj
      from=$(sed -n 's/^From: //p' "$f" | head -1)
      subj=$(sed -n 's/^Subject: //p' "$f" | head -1)

      if [ "$dry" -eq 1 ]; then
        printf 'would escalate\t%s\t%s\tfrom:%s\t%s\t%sh\n' "$recipient" "$msgid" "$from" "$subj" "$age"
        continue
      fi

      # mkdir is the atomic test-and-set: several live sessions may sweep the
      # same inbox concurrently, and only the one that creates the marker
      # notifies. A flag file written after checking would race.
      mkdir "$inbox/.escalated-$msgid" 2>/dev/null || continue

      if command -v notify-josh >/dev/null 2>&1; then
        notify-josh --from agent-mail "Unread agent mail (${age}h)" \
          "$recipient has not read \"$subj\" from $from" >/dev/null 2>&1 || true
      fi
      printf 'escalated\t%s\t%s\tfrom:%s\t%s\t%sh\n' "$recipient" "$msgid" "$from" "$subj" "$age"
    done
  done
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
sub="$1"; shift
case "$sub" in
  send)    cmd_send "$@" ;;
  scan)    cmd_scan "$@" ;;
  receipt) cmd_receipt "$@" ;;
  read)    cmd_read "$@" ;;
  discard) cmd_discard "$@" ;;
  inbox)   cmd_inbox "$@" ;;
  web)     exec "$(dirname "$0")/agent-mail-web" "$@" ;;
  archive) cmd_archive "$@" ;;
  compose)   cmd_compose "$@" ;;
  reply)     cmd_reply "$@" ;;
  reply-all) cmd_reply_all "$@" ;;
  deliver)   cmd_deliver "$@" ;;
  sweep)   cmd_sweep "$@" ;;
  # resolve_inbox returns a canonical path with status 0 for an unknown ID so
  # send can report the missing scratchpad with the name in it. addr has no such
  # second act: printing a plausible path for a recipient that does not exist
  # reads as "the inbox is there" and sent one agent chasing a pruned-pad theory
  # for a pad that was only named differently. Honor the documented contract
  # here rather than in resolve_inbox, which send still needs unchanged.
  addr)
    [ $# -ge 1 ] || die "addr: ID required"
    _inbox="$(resolve_inbox "$1")" || exit 1
    [ -d "$(dirname "$_inbox")" ] || exit 1
    printf '%s\n' "$_inbox"
    ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
