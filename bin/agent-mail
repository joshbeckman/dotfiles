#!/usr/bin/env bash
set -euo pipefail

# agent-mail — dead-drop messaging between agent sessions (and the human)
# over a Maildir-style tree. No daemon, no lockfiles: delivery is a single
# atomic rename, so concurrent senders never corrupt a reader's view.
#
# Why not the `mail`/postfix stack? Unix mail addresses the OS *user*, not a
# session; every agent runs as the same user and would share one mbox spool,
# which needs locking and loses per-session isolation. We keep email's proven
# *format* (RFC-822 headers) and drop its transport.
#
# Why not delete-on-read for state? State lives in *which directory* a message
# sits in (new/ vs cur/), not in a flag we rewrite — less mutable state, and it
# leaves an audit trail until an agent explicitly discards.

MAIL_ROOT="${AGENT_MAIL_ROOT:-/tmp/agent}"
mkdir -p "$MAIL_ROOT"
MAIL_ROOT="$(CDPATH= cd -- "$MAIL_ROOT" && pwd -P)"

usage() {
  cat <<'USAGE'
Usage:
  agent-mail send   --to ID [--from ID] [--reply-to ID] [--subject S] [--in-reply-to MID] [--body TEXT | --body-file F]
  agent-mail scan   [--to ID] [--all]
  agent-mail receipt MSGID
  agent-mail read   --to ID [--id MSG] [--peek]
  agent-mail discard --to ID --id MSG
  agent-mail addr   ID
  agent-mail inbox  ID
  agent-mail archive FILE
  agent-mail reply  FILE
  agent-mail deliver FILE
  agent-mail sweep  [--hours N] [--dry-run]

An ID is an agent as <name>-<sessionID>, or a human as `@josh`,
`humans/<handle>`, or an email address. The @+name agent form and @name human
form are accepted; sigils are stripped. Bare `josh` remains accepted. Agent inboxes resolve to
<name>-*/inbox; human inboxes to humans/<handle>/inbox.

send   Deliver a message. Body from --body/-m, --body-file, or stdin.
scan   List unread (new/) messages for an inbox, or --all inboxes.
receipt Say whether a message you sent has been read. Takes the MSGID that
       `send` printed. Exits 1 if it is in no inbox.
read   Print the oldest unread message (or --id), moving it new/ -> cur/.
       --peek prints without marking read.
discard Delete a message from cur/ or new/.
addr   Print the resolved inbox path for an ID (empty+exit 1 if none).
inbox Open an ID's inbox directory in Neovim.
archive Move a message from inbox/new to inbox/cur.
reply  Create a reply draft and print its path.
deliver Atomically move a reply draft into its recipient's inbox/new.
sweep  Notify Josh about messages unread for --hours (default 4). Any live
       session can run it; a dead recipient cannot escalate for itself.

Env:
  AGENT_MAIL_ROOT  Base dir (default /tmp/agent). Ephemeral: dies on reboot /
                   ~3-day idle. Not for anything that must be received.
  AGENT_MAIL_STALE_HOURS  Report the recipient's idle time on send once it
                   reaches this many hours (default 12).
  AGENT_MAIL_EDITOR Editor used by inbox (default nvim).
USAGE
}

die() { echo "agent-mail: $*" >&2; exit 1; }

# Accept the @+name mention form from prose and vim autocomplete. Stripped
# before any address parsing because "@+name" contains "@" and would otherwise
# be misread as a human email address downstream.
normalize_id() {
  local id="$1"
  id="${id#@}"
  id="${id#+}"
  printf '%s' "$id"
}

# The sender's own address, in the order the forms are trustworthy. The
# scratchpad basename comes before AGENT_HANDLE because it is the transport
# form (<name>-<sessionID>, RFC 0001 section 6): it resolves exactly, names one
# session, and gives the recipient something `receipt` and a reply can use.
# AGENT_HANDLE is realm-suffixed with no session id, so it only resolves when
# the pad follows the same convention -- true for new sessions, false for the
# pre-realm pads still running. Guessing wrong is worse than saying unknown,
# so both are consulted before falling back.
sender_id() {
  local id="${AGENT_MAIL_FROM:-}"
  [ -n "$id" ] || id="$(basename "${AGENT_SCRATCHPAD:-}" 2>/dev/null)"
  [ -n "$id" ] || id="${AGENT_HANDLE:-}"
  [ -n "$id" ] && [ "$id" != "." ] && [ "$id" != "/" ] || id="unknown"
  printf '%s' "$id"
}

# Resolve an ID to an inbox base path. Humans: humans/<handle>. Agents:
# match <name>-* exactly, then fall back to a bare name dir. Ambiguity (two
# live sessions of one name) fails loudly rather than guessing a recipient.
human_handle() {
  local id="$1" handle
  case "$id" in
    josh) printf 'josh'; return 0 ;;
    humans/*) handle="${id#humans/}" ;;
    *@*) handle="${id%%@*}" ;;
    *) [ -d "$MAIL_ROOT/humans/$id" ] || return 1; handle="$id" ;;
  esac
  [ -n "$handle" ] || return 1
  printf '%s' "$handle"
}

resolve_inbox() {
  local id match handle address
  id="$(normalize_id "$1")"
  address="$id"
  case "$id" in
    humans/*) address="${id#humans/}"; case "$address" in */*) die "invalid recipient ID: $id" ;; esac ;;
    */*) die "invalid recipient ID: $id" ;;
  esac
  case "$address" in ''|*[!A-Za-z0-9._+@-]*) die "invalid recipient ID: $id" ;; esac
  if handle="$(human_handle "$id")"; then
    echo "$MAIL_ROOT/humans/$handle/inbox"
    return 0
  fi
  # Match on the *scratchpad* existing, not inbox/ — a fresh recipient has a
  # scratchpad but no inbox until their first mail arrives, so keying off
  # inbox/ made bare-name first contact impossible (chicken-and-egg).
  # Exact dir first (full <name>-<sessionID>), then prefix-glob (bare <name>).
  # Names themselves contain hyphens, so we cannot infer "full ID" by counting
  # hyphens — match the filesystem instead.
  if [ -d "$MAIL_ROOT/$id" ]; then
    echo "$MAIL_ROOT/$id/inbox"; return 0
  fi
  local -a hits=()
  local d
  for d in "$MAIL_ROOT/$id"-*/; do
    [ -d "$d" ] && hits+=("${d%/}/inbox")
  done
  # Pads created before the realm-suffix convention are named <base>-<session>,
  # so the canonical handle agent-find prints (<base>-of-<realm>) matches
  # nothing and send reports a missing scratchpad for a pad that exists. Retry
  # without the suffix: RFC 0001 section 5 requires consumers to accept both
  # handle forms. This is the mirror of agent-trailer's bare -> suffixed retry.
  if [ ${#hits[@]} -eq 0 ] && [ "$id" != "${id%-of-*}" ]; then
    local bare="${id%-of-*}"
    if [ -d "$MAIL_ROOT/$bare" ]; then
      echo "$MAIL_ROOT/$bare/inbox"; return 0
    fi
    for d in "$MAIL_ROOT/$bare"-*/; do
      [ -d "$d" ] && hits+=("${d%/}/inbox")
    done
  fi
  case ${#hits[@]} in
    1) echo "${hits[0]}"; return 0 ;;
    0) echo "$MAIL_ROOT/$id/inbox"; return 0 ;;
    *) die "ambiguous recipient '$id'; matches: ${hits[*]}" ;;
  esac
}

ensure_maildir() {
  mkdir -p "$1/tmp" "$1/new" "$1/cur"
}

notify_human_delivery() {
  local handle="$1" inbox="$2" msgid="$3" from="$4" subject="$5"
  [ "$handle" = josh ] && command -v notify-josh >/dev/null 2>&1 || return 0
  if notify-josh --from agent-mail "Agent mail: $subject" \
    "From $from. Read with: agent-mail read --to @josh" >/dev/null 2>&1; then
    mkdir "$inbox/.escalated-$msgid" 2>/dev/null || true
  else
    echo "agent-mail: immediate Josh notification failed; unread sweep will retry" >&2
  fi
}

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Hours since a path was last modified. The naming extension restamps each
# scratchpad on session activity, so the directory's mtime is a liveness
# signal for the session that owns it -- no registry or heartbeat file needed.
# Only for *directories*: for a message file, use message_age_hours instead.
idle_hours() {
  local path="$1" mtime now
  mtime=$(stat -f %m "$path" 2>/dev/null) || return 1
  now=$(date +%s)
  echo $(( (now - mtime) / 3600 ))
}

# Hours since a message was delivered, read from the timestamp already in its
# msgid rather than from mtime. mtime cannot answer this: the same restamping
# that keeps a live session's scratchpad from being reaped walks the inbox too,
# so an unread message could keep looking newly arrived and never escalate.
# mv preserves mtime, so moving new/ -> cur/ is not what disturbs it.
message_age_hours() {
  local path="$1" id ts sent now
  id=$(basename "$path" .md)
  ts="${id%%-*}"
  case "$ts" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z) ;;
    *) idle_hours "$path"; return ;;  # not msgid-shaped: mtime is all we have
  esac
  sent=$(date -j -u -f '%Y%m%dT%H%M%SZ' "$ts" +%s 2>/dev/null) ||
    sent=$(date -u -d "${ts:0:4}-${ts:4:2}-${ts:6:2} ${ts:9:2}:${ts:11:2}:${ts:13:2}" +%s 2>/dev/null) ||
    { idle_hours "$path"; return; }
  now=$(date +%s)
  echo $(( (now - sent) / 3600 ))
}

# Sortable, collision-resistant message id: epoch + pid + random.
gen_msgid() {
  echo "$(date -u +%Y%m%dT%H%M%SZ)-$$-${RANDOM}${RANDOM}"
}

cmd_send() {
  local to="" from="$(sender_id)" reply_to="" subject="" in_reply_to="" body_file="" body="" have_body=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) to="$2"; shift 2 ;;
      --from) from="$2"; shift 2 ;;
      --reply-to) reply_to="$2"; shift 2 ;;
      --subject) subject="$2"; shift 2 ;;
      --in-reply-to) in_reply_to="$2"; shift 2 ;;
      --body-file) body_file="$2"; shift 2 ;;
      # Every agent guesses --body first, and the guess costs a turn to correct.
      # Kept as a peer of --body-file rather than the documented form: a one-line
      # reply inline is fine, anything longer wants a file it can revise.
      --body | -m) body="$2"; have_body=1; shift 2 ;;
      *) die "send: unknown arg $1" ;;
    esac
  done
  [ "$have_body" -eq 1 ] && [ -n "$body_file" ] && die "send: --body and --body-file are mutually exclusive"
  [ -n "$to" ] || die "send: --to required"
  # Headers keep the canonical bare ID so a reply's --to needs no cleanup.
  to="$(normalize_id "$to")"
  from="$(normalize_id "$from")"
  [ -n "$reply_to" ] && reply_to="$(normalize_id "$reply_to")"

  local inbox; inbox="$(resolve_inbox "$to")"
  local human=""; human="$(human_handle "$to" || true)"
  local scratchpad; scratchpad="$(dirname "$inbox")"
  if [ -z "$human" ]; then
    # Fail loudly if the recipient scratchpad is gone (reboot/pruned) rather
    # than silently conjuring a dead inbox nobody will ever read.
    [ -d "$scratchpad" ] || die "recipient '$to' has no scratchpad at $scratchpad (rebooted or pruned?)"

    # Report, don't predict: an overnight-idle session usually resumes, so state
    # the age and let the sender judge. Not fatal either way; there is no wakeup,
    # and the sender's only signal about a quiet recipient is how quiet it is.
    local idle; idle="$(idle_hours "$scratchpad" || echo 0)"
    if [ "$idle" -ge "${AGENT_MAIL_STALE_HOURS:-12}" ]; then
      echo "agent-mail: '$to' last active ${idle}h ago" >&2
    fi
  fi

  ensure_maildir "$inbox"

  local msgid; msgid="$(gen_msgid)"
  local tmp="$inbox/tmp/$msgid.md"
  local dst="$inbox/new/$msgid.md"

  {
    echo "From: $from"
    echo "To: $to"
    [ -n "$reply_to" ] && echo "Reply-To: $reply_to"
    echo "Date: $(now_iso)"
    echo "Message-ID: $msgid"
    [ -n "$in_reply_to" ] && echo "In-Reply-To: $in_reply_to"
    echo "Subject: ${subject:-(no subject)}"
    echo
    if [ "$have_body" -eq 1 ]; then
      printf '%s\n' "$body"
    elif [ -n "$body_file" ]; then
      cat "$body_file"
    else
      cat
    fi
  } > "$tmp"

  # Atomic within one filesystem: reader in new/ never sees a partial write.
  mv "$tmp" "$dst"

  # Josh's inbox is also an attention channel. Successful notification marks
  # this delivery so the unread sweep does not send the same alert four hours
  # later; a failed notification stays eligible for that fallback.
  notify_human_delivery "$human" "$inbox" "$msgid" "$from" "${subject:-(no subject)}"

  echo "$msgid"
}

cmd_scan() {
  local to="" all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) to="$2"; shift 2 ;;
      --all) all=1; shift ;;
      *) die "scan: unknown arg $1" ;;
    esac
  done
  local -a inboxes=()
  if [ "$all" -eq 1 ]; then
    local d
    for d in "$MAIL_ROOT"/*/inbox "$MAIL_ROOT"/humans/*/inbox; do
      [ -d "$d/new" ] && inboxes+=("$d")
    done
  else
    [ -n "$to" ] || die "scan: --to or --all required"
    inboxes+=("$(resolve_inbox "$to")")
  fi

  local inbox f found=0
  for inbox in "${inboxes[@]}"; do
    [ -d "$inbox/new" ] || continue
    for f in "$inbox/new"/*.md; do
      [ -e "$f" ] || continue
      found=1
      local from subj
      from=$(sed -n 's/^From: //p' "$f" | head -1)
      subj=$(sed -n 's/^Subject: //p' "$f" | head -1)
      printf '%s\t%s\tfrom:%s\t%s\n' "$inbox" "$(basename "$f" .md)" "$from" "$subj"
    done
  done
  [ "$found" -eq 1 ] || echo "(no unread messages)"
}

# Reports delivery state without adding any: a message in cur/ has been read,
# one in new/ has not. Deliberately prints no read *time* -- mv preserves mtime
# and restamping rewrites it, so any timestamp here would be fiction, and
# recording a real one means the mutable flag file this design does without.
cmd_receipt() {
  local id="${1:-}"
  [ -n "$id" ] || die "receipt: MSGID required"
  id="$(basename "$id" .md)"

  local inbox recipient state=""
  for inbox in "$MAIL_ROOT"/*/inbox "$MAIL_ROOT"/humans/*/inbox; do
    [ -d "$inbox" ] || continue
    if [ -e "$inbox/cur/$id.md" ]; then state=read
    elif [ -e "$inbox/new/$id.md" ]; then state=unread
    else continue
    fi
    recipient="$(basename "$(dirname "$inbox")")"
    local age; age="$(message_age_hours "$inbox/$([ "$state" = read ] && echo cur || echo new)/$id.md" || echo 0)"
    printf '%s\t%s\tto:%s\tdelivered:%s\t%sh ago\n' "$state" "$id" "$recipient" "${id%%-*}" "$age"
    return 0
  done

  # Absence is ambiguous on purpose: discard removes from both new/ and cur/,
  # so a read-then-discarded message is indistinguishable from one never sent.
  echo "unknown	$id	not in any inbox (read and discarded, or never delivered)"
  return 1
}

cmd_read() {
  local to="" id="" peek=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) to="$2"; shift 2 ;;
      --id) id="$2"; shift 2 ;;
      --peek) peek=1; shift ;;
      *) die "read: unknown arg $1" ;;
    esac
  done
  [ -n "$to" ] || die "read: --to required"
  local inbox; inbox="$(resolve_inbox "$to")"

  local f=""
  if [ -n "$id" ]; then
    [ -e "$inbox/new/$id.md" ] && f="$inbox/new/$id.md"
    [ -z "$f" ] && [ -e "$inbox/cur/$id.md" ] && f="$inbox/cur/$id.md"
  else
    # Oldest unread first; new/ names sort chronologically by construction.
    for cand in "$inbox/new"/*.md; do
      [ -e "$cand" ] && { f="$cand"; break; }
    done
  fi
  [ -n "$f" ] || { echo "(no message)" >&2; exit 1; }

  cat "$f"

  if [ "$peek" -eq 0 ] && [ "$(dirname "$f")" = "$inbox/new" ]; then
    mkdir -p "$inbox/cur"
    mv "$f" "$inbox/cur/$(basename "$f")"
  fi
}

cmd_discard() {
  local to="" id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) to="$2"; shift 2 ;;
      --id) id="$2"; shift 2 ;;
      *) die "discard: unknown arg $1" ;;
    esac
  done
  [ -n "$to" ] && [ -n "$id" ] || die "discard: --to and --id required"
  local inbox; inbox="$(resolve_inbox "$to")"
  rm -f "$inbox/new/$id.md" "$inbox/cur/$id.md"
}

message_path() {
  local path="$1" dir
  [ -f "$path" ] || die "message file not found: $path"
  dir="$(CDPATH= cd -- "$(dirname -- "$path")" && pwd)"
  case "$dir" in
    "$MAIL_ROOT"/*/inbox/new|"$MAIL_ROOT"/humans/*/inbox/new|"$MAIL_ROOT"/*/inbox/cur|"$MAIL_ROOT"/humans/*/inbox/cur)
      printf '%s/%s' "$dir" "$(basename -- "$path")" ;;
    *) die "not an agent-mail message: $path" ;;
  esac
}

cmd_inbox() {
  local id="${1:-}" handle="" inbox scratchpad
  [ -n "$id" ] || die "inbox: ID required"
  [ $# -eq 1 ] || die "inbox: expected one ID"
  id="$(normalize_id "$id")"
  inbox="$(resolve_inbox "$id")"
  handle="$(human_handle "$id" || true)"
  scratchpad="$(dirname "$inbox")"
  [ -n "$handle" ] || [ -d "$scratchpad" ] || die "recipient '$id' has no scratchpad at $scratchpad (rebooted or pruned?)"
  ensure_maildir "$inbox"
  command -v "${AGENT_MAIL_EDITOR:-nvim}" >/dev/null 2>&1 || die "editor not found: ${AGENT_MAIL_EDITOR:-nvim}"
  exec "${AGENT_MAIL_EDITOR:-nvim}" "$inbox"
}

cmd_archive() {
  local path; path="$(message_path "${1:-}")"
  [ $# -eq 1 ] || die "archive: expected one message file"
  [ "$(basename "$(dirname "$path")")" = new ] || die "message is already archived: $path"
  local inbox dst
  inbox="$(dirname "$(dirname "$path")")"
  ensure_maildir "$inbox"
  dst="$inbox/cur/$(basename "$path")"
  [ ! -e "$dst" ] || die "archive destination already exists: $dst"
  mv "$path" "$dst"
  printf '%s\n' "$dst"
}

cmd_reply() {
  local path; path="$(message_path "${1:-}")"
  [ $# -eq 1 ] || die "reply: expected one message file"
  local to subject in_reply_to msgid drafts draft
  to="$(sed -n 's/^Reply-To: //p' "$path" | head -1)"
  [ -n "$to" ] || to="$(sed -n 's/^From: //p' "$path" | head -1)"
  [ -n "$to" ] || die "reply: message has no From or Reply-To header"
  subject="$(sed -n 's/^Subject: //p' "$path" | head -1)"
  case "$subject" in Re:\ *) ;; *) subject="Re: ${subject:-(no subject)}" ;; esac
  in_reply_to="$(sed -n 's/^Message-ID: //p' "$path" | head -1)"
  msgid="$(gen_msgid)"
  drafts="$MAIL_ROOT/humans/josh/drafts"
  mkdir -p "$drafts"
  draft="$drafts/$msgid.md"
  {
    echo "From: josh"
    echo "To: $(normalize_id "$to")"
    echo "Date: $(now_iso)"
    echo "Message-ID: $msgid"
    [ -n "$in_reply_to" ] && echo "In-Reply-To: $in_reply_to"
    echo "Subject: $subject"
    echo
  } >"$draft"
  printf '%s\n' "$draft"
}

cmd_deliver() {
  local draft="${1:-}" dir
  [ $# -eq 1 ] || die "deliver: expected one draft file"
  [ -f "$draft" ] || die "draft file not found: $draft"
  dir="$(CDPATH= cd -- "$(dirname -- "$draft")" && pwd)"
  [ "$dir" = "$MAIL_ROOT/humans/josh/drafts" ] || die "not a Josh agent-mail draft: $draft"

  local to from subject msgid inbox scratchpad human dst
  to="$(sed -n 's/^To: //p' "$draft" | head -1)"
  from="$(sed -n 's/^From: //p' "$draft" | head -1)"
  subject="$(sed -n 's/^Subject: //p' "$draft" | head -1)"
  msgid="$(sed -n 's/^Message-ID: //p' "$draft" | head -1)"
  [ -n "$to" ] && [ -n "$from" ] && [ -n "$msgid" ] || die "draft is missing To, From, or Message-ID"
  to="$(normalize_id "$to")"
  inbox="$(resolve_inbox "$to")"
  human="$(human_handle "$to" || true)"
  scratchpad="$(dirname "$inbox")"
  [ -n "$human" ] || [ -d "$scratchpad" ] || die "recipient '$to' has no scratchpad at $scratchpad (rebooted or pruned?)"
  ensure_maildir "$inbox"
  dst="$inbox/new/$msgid.md"
  [ ! -e "$dst" ] || die "delivery destination already exists: $dst"
  mv "$draft" "$dst"
  notify_human_delivery "$human" "$inbox" "$msgid" "$from" "${subject:-(no subject)}"
  printf '%s\n' "$dst"
}

# Escalate to the human when nobody picked a message up. Runs from any live
# session because the recipient, by definition, is not running to notice.
cmd_sweep() {
  local hours=4 dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --hours) hours="$2"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      *) die "sweep: unknown arg $1" ;;
    esac
  done

  local inbox f
  for inbox in "$MAIL_ROOT"/*/inbox "$MAIL_ROOT"/humans/*/inbox; do
    [ -d "$inbox/new" ] || continue
    for f in "$inbox/new"/*.md; do
      [ -e "$f" ] || continue
      local age; age="$(message_age_hours "$f" || echo 0)"
      [ "$age" -ge "$hours" ] || continue

      local msgid; msgid="$(basename "$f" .md)"
      local recipient; recipient="$(basename "$(dirname "$inbox")")"
      local from subj
      from=$(sed -n 's/^From: //p' "$f" | head -1)
      subj=$(sed -n 's/^Subject: //p' "$f" | head -1)

      if [ "$dry" -eq 1 ]; then
        printf 'would escalate\t%s\t%s\tfrom:%s\t%s\t%sh\n' "$recipient" "$msgid" "$from" "$subj" "$age"
        continue
      fi

      # mkdir is the atomic test-and-set: several live sessions may sweep the
      # same inbox concurrently, and only the one that creates the marker
      # notifies. A flag file written after checking would race.
      mkdir "$inbox/.escalated-$msgid" 2>/dev/null || continue

      if command -v notify-josh >/dev/null 2>&1; then
        notify-josh --from agent-mail "Unread agent mail (${age}h)" \
          "$recipient has not read \"$subj\" from $from" >/dev/null 2>&1 || true
      fi
      printf 'escalated\t%s\t%s\tfrom:%s\t%s\t%sh\n' "$recipient" "$msgid" "$from" "$subj" "$age"
    done
  done
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
sub="$1"; shift
case "$sub" in
  send)    cmd_send "$@" ;;
  scan)    cmd_scan "$@" ;;
  receipt) cmd_receipt "$@" ;;
  read)    cmd_read "$@" ;;
  discard) cmd_discard "$@" ;;
  inbox)   cmd_inbox "$@" ;;
  archive) cmd_archive "$@" ;;
  reply)   cmd_reply "$@" ;;
  deliver) cmd_deliver "$@" ;;
  sweep)   cmd_sweep "$@" ;;
  # resolve_inbox returns a canonical path with status 0 for an unknown ID so
  # send can report the missing scratchpad with the name in it. addr has no such
  # second act: printing a plausible path for a recipient that does not exist
  # reads as "the inbox is there" and sent one agent chasing a pruned-pad theory
  # for a pad that was only named differently. Honor the documented contract
  # here rather than in resolve_inbox, which send still needs unchanged.
  addr)
    [ $# -ge 1 ] || die "addr: ID required"
    _inbox="$(resolve_inbox "$1")" || exit 1
    [ -d "$(dirname "$_inbox")" ] || exit 1
    printf '%s\n' "$_inbox"
    ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
