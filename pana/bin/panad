#!/usr/bin/env node
// Entry stub for the pana daemon. WP1 builds the server loop behind src/server.
// It defers to src/server/main so the real implementation lands without touching this file.
import { pathToFileURL } from "node:url";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const here = dirname(fileURLToPath(import.meta.url));
const entry = pathToFileURL(join(here, "..", "src", "server", "index.ts")).href;

const mod = await import(entry);
const exit = await mod.main(process.argv.slice(2));
process.exit(typeof exit === "number" ? exit : 0);
