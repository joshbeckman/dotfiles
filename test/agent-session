    def test_existing_artifact_links_are_not_traversed_or_changed(self):
        self.restore()
        (self.pad / 'notes-link').symlink_to(self.root / 'outside')
        (self.pad / 'parent-link').symlink_to(self.pad, target_is_directory=True)
