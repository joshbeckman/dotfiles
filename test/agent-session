#!/usr/bin/env python3
"""Isolated tests; never address a real identity, mailbox, or Pi process."""
import errno
import json
import os
from pathlib import Path
import runpy
import stat
import subprocess
import tempfile
import unittest
from unittest.mock import patch


REPO = Path(__file__).resolve().parents[1]
CLI = REPO / 'bin/agent-session'
API = runpy.run_path(str(CLI))
HANDLE = 'fixture-farrier-of-test'
SID = '12345678-1234-4321-8765-123456789abc'
OTHER = '87654321-1234-4321-8765-123456789abc'
TIMESTAMP = '2026-01-02T03:04:05.678Z'


def snapshot(root):
    result = {}
    for path in [root, *sorted(root.rglob('*'))]:
        info = path.lstat()
        content = os.readlink(path) if path.is_symlink() else path.read_bytes() if path.is_file() else None
        result[str(path.relative_to(root))] = (info.st_ino, info.st_mode, info.st_mtime_ns,
                                              info.st_ctime_ns, content)
    return result


class SessionTest(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='agent-session-test-')
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name).resolve()
        self.claims = self.root / 'identities/by-name'
        self.sessions = self.root / 'sessions'
        self.pads = self.root / 'pads'
        self.cwd = self.root / 'project'
        for path in (self.claims, self.sessions / '--project--', self.pads, self.cwd,
                     self.root / 'home', self.root / 'humans', self.root / 'teams'):
            path.mkdir(parents=True, mode=0o700)
        self.claim = self.claims / HANDLE
        self.claim.write_text(SID + '\n')
        self.header = dict(type='session', version=3, id=SID, timestamp=TIMESTAMP, cwd=str(self.cwd))
        filename = TIMESTAMP.replace(':', '-').replace('.', '-') + '_' + SID + '.jsonl'
        self.transcript = self.sessions / '--project--' / filename
        self.save_header()
        self.pad = self.pads / (HANDLE + '-' + SID[:8])
        self.env = {key: value for key, value in os.environ.items()
                    if not key.startswith(('AGENT_', 'PI_', 'XDG_'))}
        self.env.update(HOME=str(self.root / 'home'), AGENT_IDENTITIES_DIR=str(self.claims),
                        PI_SESSIONS_DIR=str(self.sessions), AGENT_SCRATCH_ROOT=str(self.pads),
                        AGENT_MAIL_ROOT=str(self.pads), AGENT_HUMAN_MAIL_ROOT=str(self.root / 'humans'),
                        AGENT_TEAM_ROOT=str(self.root / 'teams'), PYTHONDONTWRITEBYTECODE='1')

    def save_header(self, body=b'{"type":"message","fixture":true}\n'):
        self.transcript.write_bytes(json.dumps(self.header).encode() + b'\n' + body)

    def call(self, command='repair-inbox', *options, handle='@+' + HANDLE, expected=0):
        result = subprocess.run([str(CLI), command, handle, *options, '--json'], env=self.env,
                                capture_output=True, text=True, timeout=15)
        self.assertEqual(result.returncode, expected, result.stderr)
        return json.loads(result.stdout) if expected == 0 else result.stderr

    def refused(self, **kwargs):
        before = snapshot(self.root)
        error = self.call('repair-inbox', '--apply', expected=2, **kwargs)
        self.assertEqual(before, snapshot(self.root))
        return error

    def restore(self):
        return self.call('repair-inbox', '--apply')

    def test_preview_is_read_only_and_reports_only_repair_state(self):
        before = snapshot(self.root)
        info = self.call()
        self.assertEqual(info, {'handle': '@+' + HANDLE, 'sessionId': SID, 'status': 'would-reconstruct',
                                'scratchpad': str(self.pad), 'cwd': str(self.cwd), 'cwdExists': True})
        self.assertEqual(before, snapshot(self.root))

    def test_read_only_inspection_belongs_to_agent_find(self):
        result = subprocess.run([str(CLI), 'inspect', '@+' + HANDLE], env=self.env,
                                capture_output=True, text=True, timeout=15)
        self.assertEqual(result.returncode, 2)
        self.assertIn('invalid choice', result.stderr)

    def test_reconstruction_private_minimal_and_preserves_evidence(self):
        before_claims, before_sessions = snapshot(self.claims), snapshot(self.sessions)
        self.assertEqual(self.restore()['status'], 'reconstructed')
        expected = {'session.md', 'inbox', 'inbox/new', 'inbox/cur'}
        self.assertEqual({str(p.relative_to(self.pad)) for p in self.pad.rglob('*')}, expected)
        for path in [self.pad, *self.pad.rglob('*')]:
            self.assertEqual(stat.S_IMODE(path.stat().st_mode), 0o700 if path.is_dir() else 0o600)
        text = (self.pad / 'session.md').read_text()
        self.assertIn('Empty reconstruction', text)
        self.assertIn('No messages or notes were recovered.', text)
        self.assertNotIn('# ', text)
        self.assertNotIn('- started:', text)
        self.assertNotIn('- git:', text)
        self.assertEqual(before_claims, snapshot(self.claims))
        self.assertEqual(before_sessions, snapshot(self.sessions))

    def test_idempotence_preserves_existing_notes_messages_and_permissions(self):
        self.restore()
        (self.pad / 'notes.md').write_text('Keep my work.\n')
        (self.pad / 'inbox/new/original.md').write_text('Original message.\n')
        (self.pad / 'session.md').chmod(0o640)
        before = snapshot(self.root)
        self.assertEqual(self.restore()['status'], 'existing')
        self.assertEqual(self.call()['status'], 'existing')
        self.assertEqual(before, snapshot(self.root))

    def test_existing_startup_metadata_is_accepted_without_modification(self):
        self.restore()
        (self.pad / 'session.md').write_text(
            '# Fixture Farrier of Test\n\n' + f'- session: {SID}\n'
            f'- session file: {self.transcript}\n- cwd: {self.cwd}\n'
            '- git: main\n- started: 2026-01-02T03:05:00.000Z\n')
        before = snapshot(self.root)
        self.assertEqual(self.restore()['status'], 'existing')
        self.assertEqual(before, snapshot(self.root))

