    def test_startup_winning_publication_race_is_not_overwritten(self):
        real_publisher = API['publisher']()
        captured = []

        def publisher():
            def publish(*args):
                self.pad.mkdir()
                captured.append(self.pad.stat().st_ino)
                real_publisher(*args)
            return publish

        with patch.dict(os.environ, self.env, clear=True), patch.dict(API['repair'].__globals__, publisher=publisher):
            locations = API['roots']()
            evidence = API['collect_evidence'](HANDLE, *locations)
            with self.assertRaises(OSError):
                API['repair'](HANDLE, locations, evidence)
        self.assertEqual(self.pad.stat().st_ino, captured[0])
        self.assertEqual(list(self.pad.iterdir()), [])
        self.assertEqual(list(self.pads.iterdir()), [self.pad])

