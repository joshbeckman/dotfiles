class LifecycleTest(unittest.TestCase):
    # Borrow fixtures without rerunning every SessionTest case.
    save_header, call, restore = SessionTest.save_header, SessionTest.call, SessionTest.restore

    def setUp(self):
        SessionTest.setUp(self)
        self.state = self.root / 'state'
        self.bin = self.root / 'stub-bin'
        self.bin.mkdir()
        self.tmux_log = self.root / 'tmux.log'
        self.stub('tmux', '#!/bin/sh\nprintf "%s\\n" "$*" >> "$TMUX_LOG"\n[ "$1" = has-session ] && exit "${TMUX_HAS:-0}"\nexit "${TMUX_FAIL:-0}"\n')
        self.stub('sysctl', '#!/bin/sh\necho "${PRESSURE:-1}"\n')
        self.env.update(AGENT_SESSION_STATE=str(self.state), TMUX_LOG=str(self.tmux_log),
                        PATH=str(self.bin) + os.pathsep + self.env['PATH'])
        self.live = os.getpid()
        dead = subprocess.Popen(['true'])
        dead.wait()
        self.dead = dead.pid
        self.restore()

    def stub(self, name, text):
        path = self.bin / name
        path.write_text(text)
        path.chmod(0o700)

    def run_cli(self, *args, stdin=None, expected=0):
        result = subprocess.run([str(CLI), *args, '--json'], env=self.env, input=stdin,
                                capture_output=True, text=True, timeout=15)
        self.assertEqual(result.returncode, expected, result.stderr)
        return json.loads(result.stdout) if result.stdout else result.stderr

    def record(self):
        return json.loads((self.state / f'{SID}.json').read_text())

    def park(self, pid=None, jobs=None, expected=0):
        request = json.dumps({'jobs': [] if jobs is None else jobs, 'notes': 'Check PR 42 first.'})
        return self.run_cli('park', SID, '--pid', str(pid or self.live), stdin=request, expected=expected)

    def parked(self):
        self.run_cli('started', SID, '--pid', str(self.live))
        self.park()
        self.run_cli('exited', SID, '--pid', str(self.live))

    def test_lease_conflicts_with_a_live_process_but_replaces_a_dead_one(self):
        self.assertEqual(self.run_cli('started', SID, '--pid', str(self.dead))['status'], 'leased')
        self.assertEqual(self.run_cli('started', SID, '--pid', str(self.live))['status'], 'leased')
        conflict = self.run_cli('started', SID, '--pid', '1', expected=3)
        self.assertEqual(conflict['leaseHolder'], self.live)
        self.run_cli('exited', SID, '--pid', '1')
        self.assertTrue((self.state / f'{SID}.lease').exists())
        self.run_cli('exited', SID, '--pid', str(self.live))
        self.assertFalse((self.state / f'{SID}.lease').exists())
        self.assertEqual(stat.S_IMODE(self.state.stat().st_mode), 0o700)

    def test_a_session_that_never_parked_gets_a_record(self):
        # wake-mail reads records, so a session with none was invisible to it: four of the
        # five running sessions here had no record at all. A record that cannot describe
        # the session well enough to resume later would be worse than none, so this also
        # checks the fields resume needs.
        self.assertFalse((self.state / f'{SID}.json').exists())
        self.assertEqual(self.run_cli('started', SID, '--pid', str(self.live))['state'], 'awake')
        record = self.record()
        self.assertEqual(record['state'], 'awake')
        self.assertTrue(record['wake'])
        self.assertEqual(record['sessionFile'], str(self.transcript))
        self.assertEqual(record['cwd'], str(self.cwd))
        self.assertTrue(Path(record['notes']).is_file())
        before = (self.state / f'{SID}.json').read_bytes()
        self.run_cli('started', SID, '--pid', str(self.live))
        self.assertEqual((self.state / f'{SID}.json').read_bytes(), before)

    def test_an_unclean_exit_leaves_a_session_wakable(self):
        # exited repairs a clean exit, but a killed process or a shutdown never runs the
        # exit handler, so the record stays awake. The lease is then the only signal that
        # the process is gone, and resume uses it. Without this, a reboot strands a
        # session permanently: no automatic route back, and a manual relaunch the only way.
        self.parked()
        self.run_cli('started', SID, '--pid', str(self.live))
        self.assertEqual(self.record()['state'], 'awake')
        self.run_cli('exited', SID, '--pid', str(self.live))
        self.assertEqual(self.record()['state'], 'parked')
        # Unclean exit: the lease vanishes and nothing reports it.
        self.run_cli('started', SID, '--pid', str(self.live))
        (self.state / f'{SID}.lease').unlink()
        self.assertEqual(self.record()['state'], 'awake')
        plan = self.run_cli('resume', '@+' + HANDLE, '--tmux-session', 'agents', '--dry-run')
        self.assertEqual(plan['status'], 'would-wake')
        # A session that really is running still refuses, because it holds the lease.
        self.run_cli('started', SID, '--pid', str(self.live))
        self.run_cli('resume', '@+' + HANDLE, '--tmux-session', 'agents', expected=2)

    def test_only_the_lease_holder_can_park_and_notes_are_written(self):
        self.run_cli('started', SID, '--pid', str(self.live))
        self.assertIn('holds the lease', self.park(pid=1, expected=2))
        jobs = [{'command': 'bin/rails test', 'cwd': str(self.cwd), 'reason': 'full suite', 'restart': True}]
        record = self.park(jobs=jobs)
        self.assertEqual((record['state'], record['wake'], record['jobs']), ('parked', True, 1))
        notes = (self.pad / 'parked.md').read_text()
        self.assertIn('restart=yes · `bin/rails test`', notes)
        self.assertIn('Check PR 42 first.', notes)
        self.assertIn('never replayed automatically', notes)
        self.assertEqual(stat.S_IMODE((self.pad / 'parked.md').stat().st_mode), 0o600)

    def test_park_requires_an_explicit_job_account_and_notes(self):
        self.run_cli('started', SID, '--pid', str(self.live))
        for request in ({'notes': 'x'}, {'jobs': [{'command': 'x'}], 'notes': 'x'},
                        {'jobs': [{'command': 'x', 'cwd': 'y', 'reason': 'z', 'restart': 'yes'}], 'notes': 'x'},
                        {'jobs': [], 'notes': ' '}):
            with self.subTest(request=request):
                self.run_cli('park', SID, '--pid', str(self.live), stdin=json.dumps(request), expected=2)
        # `started` now writes a record for a session that never parked, so the file exists;
        # what a rejected park must not do is change it.
        self.assertEqual(self.record()['state'], 'awake')

