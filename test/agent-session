        self.save_header(b'not JSON\n' + b'x' * 2_000_000)
        self.assertEqual(self.call()['sessionId'], SID)
        self.assertEqual(self.restore()['status'], 'reconstructed')

    def test_legacy_documented_header_versions(self):
        for version in (None, 1, 2, 3):
            with self.subTest(version=version):
                self.header.pop('version', None)
                if version is not None:
                    self.header['version'] = version
                self.save_header()
                self.assertEqual(self.call()['status'], 'would-reconstruct')

    def test_unknown_invalid_and_alias_handles(self):
        for handle in ('@+unknown', HANDLE, '@' + HANDLE, '@+../escape', '@+foo/bar',
                       '@+foo\nbar', '@+fixture-farrier', '@+' + HANDLE + '-' + SID[:8]):
            with self.subTest(handle=handle):
                self.refused(handle=handle)

    def test_malformed_registry_uuid_and_duplicate_claim(self):
        for sid in (SID[:8], '1234-1234', '../escape', SID + '\n' + OTHER, 'subagent:' + SID):
            with self.subTest(sid=sid):
                self.claim.write_text(sid + '\n')
                self.assertIn('complete UUID', self.refused())
        self.claim.write_text(SID + '\n')
