    def test_memory_pressure_probe_failure_refuses_on_macos(self):
        # Exercise the Darwin branch on any host: sitecustomize makes the
        # interpreter report darwin, and the stub sysctl then fails instead of
        # printing a level. A failed probe must not silently disable the gate.
        self.parked()
        self.stub('sysctl', '#!/bin/sh\nexit 1\n')
        seam = self.root / 'seam'
        seam.mkdir()
        (seam / 'sitecustomize.py').write_text('import sys\nsys.platform = "darwin"\n')
        self.env['PYTHONPATH'] = str(seam)
        self.assertIn('could not read memory pressure',
                      self.run_cli('resume', '@+' + HANDLE, '--tmux-session', 'agents', expected=2))
        self.env.pop('PYTHONPATH')
        self.assertEqual(self.record()['state'], 'parked')

