    def test_default_roots_under_isolated_home(self):
        home = Path(self.env['HOME'])
        defaults = ((self.claims, home / '.pi/agent/identities/by-name'),
                    (self.sessions, home / '.pi/agent/sessions'),
                    (self.pads, home / '.local/state/agent/scratchpads'))
        for source, target in defaults:
            target.parent.mkdir(parents=True, exist_ok=True)
            source.rename(target)
        for key in ('AGENT_IDENTITIES_DIR', 'PI_SESSIONS_DIR', 'AGENT_SCRATCH_ROOT', 'AGENT_MAIL_ROOT'):
            self.env.pop(key)
        self.assertEqual(self.call()['status'], 'would-reconstruct')
        self.assertEqual(self.restore()['status'], 'reconstructed')

    def test_concurrent_repairs_publish_once(self):
        command = [str(CLI), 'repair-inbox', '@+' + HANDLE, '--apply', '--json']
        processes = [subprocess.Popen(command, env=self.env, stdout=subprocess.PIPE,
                                      stderr=subprocess.PIPE, text=True) for _ in range(8)]
        states = []
        for process in processes:
            stdout, stderr = process.communicate(timeout=20)
            self.assertEqual(process.returncode, 0, stderr)
            states.append(json.loads(stdout)['status'])
        self.assertEqual(states.count('reconstructed'), 1)
        self.assertEqual(states.count('existing'), 7)
        self.assertEqual(list(self.pads.iterdir()), [self.pad])

    def test_native_publication_never_clobbers_any_destination(self):
        publish = API['publisher']()
        source = self.pads / 'source'
        source.mkdir()
        (source / 'proof').write_text('prepared')
        for kind in ('empty', 'nonempty', 'file', 'link'):
            with self.subTest(kind=kind):
                target = self.pads / kind
                if kind == 'file':
                    target.write_text('keep')
                elif kind == 'link':
                    target.symlink_to(self.root / 'outside')
                else:
                    target.mkdir()
                    if kind == 'nonempty':
                        (target / 'proof').write_text('keep')
                before = snapshot(self.root)
                with API['directory'](self.pads) as fd:
                    with self.assertRaises(OSError) as error:
                        publish(fd, 'source', fd, kind)
                self.assertIn(error.exception.errno, (errno.EEXIST, errno.ENOTEMPTY))
                self.assertEqual(before, snapshot(self.root))

    def test_startup_winning_publication_race_is_not_overwritten(self):
        real_publisher = API['publisher']()
        captured = []

        def publisher():
            def publish(*args):
                self.pad.mkdir()
                captured.append(self.pad.stat().st_ino)
                real_publisher(*args)
            return publish

        with patch.dict(os.environ, self.env, clear=True), patch.dict(API['repair'].__globals__, publisher=publisher):
            locations = API['roots']()
            evidence = API['collect_evidence'](HANDLE, *locations)
            with self.assertRaises(OSError):
                API['repair'](HANDLE, locations, evidence)
        self.assertEqual(self.pad.stat().st_ino, captured[0])
        self.assertEqual(list(self.pad.iterdir()), [])
        self.assertEqual(list(self.pads.iterdir()), [self.pad])

    def test_changed_evidence_aborts_and_removes_only_own_staging(self):
        with patch.dict(os.environ, self.env, clear=True):
            locations = API['roots']()
            evidence = API['collect_evidence'](HANDLE, *locations)
            real_inspect = API['collect_evidence']

            def changed_inspect(*args):
                self.header['cwd'] = str(self.root / 'another-missing-project')
                self.save_header()
                return real_inspect(*args)

            with patch.dict(API['repair'].__globals__, collect_evidence=changed_inspect):
                with self.assertRaisesRegex(ValueError, 'evidence changed'):
                    API['repair'](HANDLE, locations, evidence)
        self.assertEqual(list(self.pads.iterdir()), [])

    def test_root_replacement_aborts_without_publishing_to_either_root(self):
        with patch.dict(os.environ, self.env, clear=True):
            locations = API['roots']()
            evidence = API['collect_evidence'](HANDLE, *locations)
            real_inspect = API['collect_evidence']
            moved = self.root / 'moved-pads'

            def changed_inspect(*args):
                result = real_inspect(*args)
                self.pads.rename(moved)
                self.pads.mkdir(mode=0o700)
                return result

            with patch.dict(API['repair'].__globals__, collect_evidence=changed_inspect):
                with self.assertRaisesRegex(ValueError, 'root changed'):
                    API['repair'](HANDLE, locations, evidence)
        self.assertEqual(list(self.pads.iterdir()), [])
        self.assertEqual(list(moved.iterdir()), [])

    def test_real_mail_delivery_to_synthetic_restored_pad(self):
        stub = self.root / 'bin'
        stub.mkdir()
        notify = stub / 'notify-josh'
        notify.write_text('#!/bin/sh\nexit 93\n')
        notify.chmod(0o700)
        self.env['PATH'] = str(stub) + os.pathsep + self.env['PATH']
        self.restore()
        claims, sessions = snapshot(self.claims), snapshot(self.sessions)
        result = subprocess.run([str(REPO / 'bin/agent-mail'), 'send', '--from', 'fixture-sender',
                                 '--to', '@+' + HANDLE, '--subject', 'Synthetic restoration',
                                 '--body', 'Isolated delivery only.'], env=self.env,
                                capture_output=True, text=True, timeout=15)
        self.assertEqual(result.returncode, 0, result.stderr)
        messages = list((self.pad / 'inbox/new').iterdir())
        self.assertEqual(len(messages), 1)
        self.assertIn('Isolated delivery only.', messages[0].read_text())
        self.assertEqual(claims, snapshot(self.claims))
        self.assertEqual(sessions, snapshot(self.sessions))
        self.assertEqual(self.call()['status'], 'existing')


