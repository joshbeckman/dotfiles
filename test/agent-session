    def test_non_ascii_metadata_round_trips_under_c_locale(self):
        project = self.root / 'caf\u00e9 project'
        project.mkdir()
        self.header['cwd'] = str(project)
        self.save_header()
        self.env.update(LC_ALL='C', LANG='C', PYTHONUTF8='0', PYTHONIOENCODING='ascii:backslashreplace')
        self.assertEqual(self.restore()['status'], 'reconstructed')
        self.assertIn(str(project), (self.pad / 'session.md').read_text(encoding='utf-8'))
        self.assertEqual(self.restore()['status'], 'existing')

