        self.assertEqual(self.call()['status'], 'existing')
        self.assertEqual(self.restore()['status'], 'existing')
        self.assertEqual(snapshot(self.root), before)

    def test_header_registry_filename_mismatches(self):
        for key, value in (('id', OTHER), ('id', SID[:8]), ('type', 'message'), ('version', 4),
                           ('version', True), ('timestamp', 'not-a-date'), ('timestamp', '2026-01-03T03:04:05.678Z'),
                           ('cwd', '../escape'), ('cwd', str(self.cwd) + '/../../escape')):
            with self.subTest(key=key, value=value):
                original = self.header[key]
                self.header[key] = value
                self.save_header()
                self.refused()
                self.header[key] = original
        self.save_header()
        renamed = self.transcript.with_name(self.transcript.name.replace(SID, OTHER))
        self.transcript.rename(renamed)
        self.assertIn('mismatch', self.refused())

    def test_duplicate_and_missing_transcripts(self):
