#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
export AGENT_SCRATCH_ROOT="$tmp/scratchpads"
export PI_SESSIONS_DIR="$tmp/sessions"
# A store of this test's own, so the machine's real one can never decide these cases.
export AGENT_MAIL_ROOT="$AGENT_SCRATCH_ROOT"
export AGENT_HUMAN_MAIL_ROOT="$tmp/humans"
export AGENT_MAIL2_DB="$tmp/mail2.sqlite3"
mkdir -p "$AGENT_HUMAN_MAIL_ROOT/josh"
mkdir -p "$AGENT_SCRATCH_ROOT" "$PI_SESSIONS_DIR"
# agent-scratchpad has to reach the commands beside it, not whichever copies this host
# installed: a machine that never ran setup has none on PATH. Shadow them with stubs that
# fail, so a regression to the PATH lookup shows up here instead of on a fresh host.
mkdir -p "$tmp/path"
for name in agent-mail agent-slug; do
  printf '#!/bin/sh\necho "agent-scratchpad used %s from PATH" >&2\nexit 1\n' "$name" >"$tmp/path/$name"
  chmod +x "$tmp/path/$name"
done
export PATH="$tmp/path:$PATH"

make_pad() {
  local dir="$AGENT_SCRATCH_ROOT/$1" name="$2" session="$3" session_file="${4:-(none)}"
  mkdir -p "$dir"
  printf '# %s\n\n- session: %s\n- session file: %s\n' "$name" "$session" "$session_file" >"$dir/session.md"
  printf 'work\n' >"$dir/notes.md"
}

make_pad old-agent-11111111 'Old Agent' old-session
make_pad recent-agent-22222222 'Recent Agent' recent-session
make_pad live-agent-33333333 'Live Agent' live-session
make_pad unread-agent-55555555 'Unread Agent' unread-session
make_pad malformed-agent-66666666 'Malformed Agent' malformed-session
printf 'not-a-pid\n' >"$AGENT_SCRATCH_ROOT/malformed-agent-66666666/.heartbeat"
mkdir -p "$AGENT_SCRATCH_ROOT/unread-agent-55555555/inbox/new"
printf 'From: sender\nSubject: waiting\n\nbody\n' >"$AGENT_SCRATCH_ROOT/unread-agent-55555555/inbox/new/message.md"
session_log="$PI_SESSIONS_DIR/session.jsonl"
printf '{}\n' >"$session_log"
make_pad logged-agent-44444444 'Logged Agent' logged-session "$session_log"

touch -t 202001010000 "$AGENT_SCRATCH_ROOT/old-agent-11111111/"*.md
touch -t 202001010000 "$AGENT_SCRATCH_ROOT/logged-agent-44444444/"*.md
touch -t 202001010000 "$AGENT_SCRATCH_ROOT/unread-agent-55555555/"*.md "$AGENT_SCRATCH_ROOT/unread-agent-55555555/inbox/new/message.md"
printf '%s\tlive-session\n' "$$" >"$AGENT_SCRATCH_ROOT/live-agent-33333333/.heartbeat"

list="$($root/bin/agent-scratchpad list)"
mode="$(stat -c %a "$AGENT_SCRATCH_ROOT" 2>/dev/null || stat -f %Lp "$AGENT_SCRATCH_ROOT")"
[[ "$mode" == 700 ]]
grep -Fq 'Old Agent (old-agent-11111111)' <<<"$list"
grep -Fq 'live' <<<"$list"

dry="$($root/bin/agent-scratchpad prune --days 30)"
grep -Fq 'Old Agent' <<<"$dry"
! grep -Fq 'Recent Agent' <<<"$dry"
! grep -Fq 'Logged Agent' <<<"$dry"
! grep -Fq 'Unread Agent' <<<"$dry"
[[ -d "$AGENT_SCRATCH_ROOT/old-agent-11111111" ]]

$root/bin/agent-scratchpad prune --days 30 --apply --yes >/dev/null
[[ ! -e "$AGENT_SCRATCH_ROOT/old-agent-11111111" ]]
[[ -d "$AGENT_SCRATCH_ROOT/logged-agent-44444444" ]]
[[ -d "$AGENT_SCRATCH_ROOT/unread-agent-55555555" ]]

unread_dry="$($root/bin/agent-scratchpad prune --days 30 --include-unread)"
grep -Fq 'Unread Agent' <<<"$unread_dry"
grep -Fq 'unread=1' <<<"$unread_dry"
$root/bin/agent-scratchpad prune --days 30 --include-unread --apply --yes >/dev/null
[[ ! -e "$AGENT_SCRATCH_ROOT/unread-agent-55555555" ]]

if $root/bin/agent-scratchpad prune --agent 'Live Agent' --apply --yes >/dev/null 2>&1; then
  echo 'live scratchpad was pruned without --force' >&2
  exit 1
fi
[[ -d "$AGENT_SCRATCH_ROOT/live-agent-33333333" ]]
$root/bin/agent-scratchpad prune --agent @+live-agent --apply --yes --force >/dev/null
[[ ! -e "$AGENT_SCRATCH_ROOT/live-agent-33333333" ]]

if $root/bin/agent-scratchpad prune --agent 'Malformed Agent' --apply --yes >/dev/null 2>&1; then
  echo 'malformed heartbeat did not fail closed' >&2
  exit 1
fi
$root/bin/agent-scratchpad prune --agent 'Malformed Agent' --apply --yes --force >/dev/null
[[ ! -e "$AGENT_SCRATCH_ROOT/malformed-agent-66666666" ]]

$root/bin/agent-scratchpad prune --agent 'Recent Agent' --apply --yes >/dev/null
[[ ! -e "$AGENT_SCRATCH_ROOT/recent-agent-22222222" ]]

# A durable pad is protected by intent, not by a heartbeat that cannot describe a
# poller which exits between runs.
make_pad durable-agent-77777777 'Durable Agent' durable-session
touch -t 202001010000 "$AGENT_SCRATCH_ROOT/durable-agent-77777777/"*.md
"$root/bin/agent-scratchpad" durable 'Durable Agent' >/dev/null
[[ -e "$AGENT_SCRATCH_ROOT/durable-agent-77777777/.durable" ]]
grep -Fq 'durable' <<<"$("$root/bin/agent-scratchpad" list)"
! grep -Fq 'Durable Agent' <<<"$("$root/bin/agent-scratchpad" prune --days 30)"
if "$root/bin/agent-scratchpad" prune --agent 'Durable Agent' --apply --yes >/dev/null 2>&1; then
  echo 'durable scratchpad was pruned without --force' >&2
  exit 1
fi
[[ -d "$AGENT_SCRATCH_ROOT/durable-agent-77777777" ]]
"$root/bin/agent-scratchpad" durable 'Durable Agent' --remove >/dev/null
[[ ! -e "$AGENT_SCRATCH_ROOT/durable-agent-77777777/.durable" ]]
"$root/bin/agent-scratchpad" prune --agent 'Durable Agent' --apply --yes >/dev/null
[[ ! -e "$AGENT_SCRATCH_ROOT/durable-agent-77777777" ]]

# Once the store is sqlite the inbox directory is a frozen archive: nothing moves those
# files, so a pad's age protection has to come from the store. Both directions are pinned
# here, because counting the wrong one either protects a pad for ever or prunes unread mail.
make_pad frozen-agent-88888888 'Frozen Agent' frozen-session
mkdir -p "$AGENT_SCRATCH_ROOT/frozen-agent-88888888/inbox/new"
printf 'From: sender\n\nold mail that will never move\n' >"$AGENT_SCRATCH_ROOT/frozen-agent-88888888/inbox/new/frozen.md"
make_pad waiting-agent-99999999 'Waiting Agent' waiting-session
make_pad sender-agent-aaaa1111 'Sender Agent' sender-session
touch -t 202001010000 "$AGENT_SCRATCH_ROOT/frozen-agent-88888888/"*.md \
  "$AGENT_SCRATCH_ROOT/frozen-agent-88888888/inbox/new/frozen.md" \
  "$AGENT_SCRATCH_ROOT/waiting-agent-99999999/"*.md \
  "$AGENT_SCRATCH_ROOT/sender-agent-aaaa1111/"*.md

# The Maildir still records the frozen file, which is the behaviour being replaced.
grep -Fq 'unread=1' <<<"$("$root/bin/agent-scratchpad" prune --days 30 --include-unread)"

printf 'sqlite\n' >"$tmp/store"
"$root/bin/agent-mail2" init >/dev/null
AGENT_SCRATCHPAD="$AGENT_SCRATCH_ROOT/sender-agent-aaaa1111" "$root/bin/agent-mail2" send \
  --to waiting-agent-99999999 --subject 'unread in the store' --body 'nobody has read this' >/dev/null

# The directory says one, the store says none: the frozen file must not protect the pad.
frozen="$("$root/bin/agent-scratchpad" prune --days 30 --include-unread)"
grep -Fq 'Frozen Agent' <<<"$frozen"
grep -Fq 'unread=0' <<<"$frozen"
grep -Fq 'Frozen Agent' <<<"$("$root/bin/agent-scratchpad" prune --days 30)"

# The directory says none, the store says one: the pad must stay.
waiting="$("$root/bin/agent-scratchpad" prune --days 30 --include-unread)"
grep -Fq 'unread=1' <<<"$waiting"
! grep -Fq 'Waiting Agent' <<<"$("$root/bin/agent-scratchpad" prune --days 30)"
set +e
"$root/bin/agent-scratchpad" prune --days 30 --apply --yes >"$tmp/apply-out" 2>"$tmp/apply-err"
set -e
# The selection step drops it before the apply-time re-check, so it is absent from the
# list and survives the run that prunes its neighbours.
! grep -Fq 'Waiting Agent' "$tmp/apply-out"
[[ -d "$AGENT_SCRATCH_ROOT/waiting-agent-99999999" ]]
[[ ! -e "$AGENT_SCRATCH_ROOT/frozen-agent-88888888" ]]

printf 'agent-scratchpad tests passed\n'
