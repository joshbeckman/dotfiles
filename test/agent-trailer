#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/bin" "$tmp/.local/state/pana"
printf '{"domain":"test.example","user":"tester"}\n' >"$tmp/.local/state/pana/config.json"
cat >"$tmp/bin/git" <<'SH'
#!/bin/sh
[ "$*" = 'config user.email' ] || exit 1
printf '%s\n' "$TEST_GIT_EMAIL"
SH
chmod +x "$tmp/bin/git"

checks=0
check() {
  local expected="$1" actual
  shift
  local -a settings=(TEST_GIT_EMAIL=person@example.org)
  while [ "$1" != -- ]; do
    settings+=("$1")
    shift
  done
  shift
  actual="$(env -i HOME="$tmp" PATH="$tmp/bin:$root/bin:/usr/bin:/bin" \
    "${settings[@]}" /bin/bash "$root/bin/agent-trailer" "$@")"
  if [ "$actual" != "$expected" ]; then
    printf 'Expected: %s\nActual:   %s\n' "$expected" "$actual" >&2
    return 1
  fi
  checks=$((checks + 1))
}

named=(AGENT_NAME='Test Agent' AGENT_HANDLE=test-agent)
runtime=(PI_MODEL=model-one PI_PROVIDER=vendor-routing-hint PI_PACKAGE_DIR=/fixture/pi-test)
check 'Co-authored-by: AI Test Agent @+test-agent' "${named[@]}" "${runtime[@]}" --
check 'Co-authored-by: AI Test Agent <person+test-agent@example.org>' "${named[@]}" "${runtime[@]}" -- --email
check 'pi-test/vendor/model-one' "${named[@]}" "${runtime[@]}" -- --raw
check 'pi-test/vendor/model-one' "${named[@]}" "${runtime[@]}" -- --raw --email
check 'Co-authored-by: AI Test Agent @+test-agent' "${named[@]}" "${runtime[@]}" PI_MODEL=model-two --
check 'pi-test/vendor/model-two' "${runtime[@]}" PI_MODEL=model-two -- --raw
check 'Co-authored-by: AI Test Agent @+test-agent' "${named[@]}" CLAUDECODE=1 ANTHROPIC_MODEL=fixture-model --
check 'claude-code/anthropic/fixture-model' CLAUDECODE=1 ANTHROPIC_MODEL=fixture-model -- --raw
check 'Co-authored-by: AI Test Agent @+test-agent' "${named[@]}" --
check 'unknown/unknown/unknown' -- --raw
check 'Co-authored-by: AI' --
check 'Co-authored-by: AI <person+pi@example.org>' -- --email
check 'Co-authored-by: AI Other Display Name @+test-agent' "${named[@]}" -- --name 'Other Display Name'
check 'Co-authored-by: AI Test Agent of Example @+test-agent-of-example' AGENT_NAME='Test Agent of Example' --
check 'Co-authored-by: AI Test Agent <josh+test-agent@joshbeckman.org>' "${named[@]}" TEST_GIT_EMAIL= -- --email

cat >"$tmp/session.jsonl" <<'JSON'
{"type":"model_change","provider":"first","modelId":"model-one"}
{"type":"model_change","provider":"second-routing","modelId":"model-two"}
JSON
check 'pi-test/second/model-two' PI_CODING_AGENT=1 PI_PACKAGE_DIR=/fixture/pi-test \
  PI_SESSION_ID=fixture-session PI_SESSION_FILE="$tmp/session.jsonl" -- --raw

# pana sessions have no name, so the trailer is the session URL. A bare ULID is the
# form PANA_SESSION takes, which is why the domain comes from pana's config.
pana_session=01JB8ZQ4V0K3W9X2Y7Z5A6B8C9
pana_url="pana://test.example/sessions/$pana_session"
check "Co-authored-by: AI $pana_url" PANA_SESSION="$pana_session" --
check "Co-authored-by: AI $pana_url <$pana_session@test.example>" PANA_SESSION="$pana_session" -- --email
check "pana/session/$pana_session" PANA_SESSION="$pana_session" -- --raw
# The URL form names its own domain, so it does not need pana's config.
check "Co-authored-by: AI $pana_url" PANA_SESSION="$pana_url" PANA_STATE=/nonexistent --
# pana wins over another harness in the environment: a session that runs pi still
# speaks for the pana session that woke it.
check "Co-authored-by: AI $pana_url" PANA_SESSION="$pana_session" "${runtime[@]}" --
# Anything that is not a session URL or a ULID falls through to the usual
# detection, so a mangled variable cannot claim every commit in a repository.
check 'unknown/unknown/unknown' PANA_SESSION=not-a-session -- --raw
check 'pi-test/vendor/model-one' PANA_SESSION=not-a-session "${runtime[@]}" -- --raw

printf 'agent-trailer: %s checks passed\n' "$checks"
