#!/usr/bin/env bash
# The transition to the SQLite store has to fail safe, not only succeed: the archive restores,
# --verify catches every kind of drift, a crash at any seam of a dual-write leaves the Maildir
# correct and is repaired by one migrate, rollback loses nothing, and a long random run of
# every mutating command keeps the mirror exact. AGENT_MAIL_FUZZ_SEED replays a random run;
# AGENT_MAIL_FUZZ_OPS lengthens it.
set -euo pipefail

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
tmp="$(mktemp -d)"
tmp="$(CDPATH= cd -- "$tmp" && pwd -P)"
trap 'rm -rf "$tmp"' EXIT
unset AGENT_SCRATCHPAD AGENT_HANDLE AGENT_MAIL_FROM AGENT_MAIL2_DB AGENT_MAIL2_HUMAN AGENT_SCRATCH_ROOT
mkdir -p "$tmp/no-notify"
printf '#!/bin/sh\nexit 0\n' >"$tmp/no-notify/notify-josh"
chmod +x "$tmp/no-notify/notify-josh"
export AGENT_MAIL_STALE_HOURS=100000 PATH="$tmp/no-notify:$PATH"

alice=alice-agent-11111111
bob=bob-agent-22222222
carol=carol-agent-33333333

realm() {
  dir="$tmp/$1"
  rm -rf "$dir"
  mkdir -p "$dir/pads/$alice" "$dir/pads/$bob" "$dir/pads/$carol" "$dir/state/humans/josh" "$dir/identities"
  export AGENT_MAIL_ROOT="$dir/pads" AGENT_HUMAN_MAIL_ROOT="$dir/state/humans" AGENT_IDENTITIES_DIR="$dir/identities"
  bin="$root/bin"
  db="$dir/state/mail2.sqlite3"
}
cmd() { "$bin/agent-mail" "$@"; }
as() { local who="$1"; shift; AGENT_SCRATCHPAD="$AGENT_MAIL_ROOT/$who" "$@"; }
migrate() { "$bin/agent-mail-migrate" --db "$db" "$@"; }
verified() { migrate --verify >/dev/null 2>&1; }
fail() { echo "agent-mail-transition: $*" >&2; exit 1; }
sql() { python3 - "$db" "$@" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
db.execute(sys.argv[2], sys.argv[3:])
db.commit()
PY
}

# --- the archive restores, and --finish removes it only when the mirror is exact --------
realm archive
m1="$(as $alice cmd send --to "$bob,josh" --subject Before -m 'history' | tail -1)"
ln -s "$dir/state" "$tmp/state-link"
"$bin/agent-mail-migrate" --db "$tmp/state-link/mail2.sqlite3" --set-store both >"$tmp/out"
archive="$(ls "$dir/state/archives/"*.tar.gz)"
grep -Fq "archived and restored the mail to $archive" "$tmp/out" || fail "set-store did not report the archive"
[[ "$(stat -c %a "$archive" 2>/dev/null || stat -f %Lp "$archive")" == 600 ]] || fail "the archive is not private"
# Listed to a file first: grep -q closing the pipe early fails tar under pipefail.
tar -tzf "$archive" >"$tmp/listing"
grep -Fq "agents/$bob/inbox/new/$m1.md" "$tmp/listing" || fail "the archive is missing an inbox"
grep -Fq "humans/josh/inbox/new/$m1.md" "$tmp/listing" || fail "the archive is missing Josh's mailbox"
sql "update deliveries set read_at = 1 where recipient_mailbox_id = ?" "$bob"
set +e; migrate --finish >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 && -f "$archive" ]] || fail "--finish removed the archive while the mirror had drifted"
migrate >/dev/null
migrate --finish | grep -Fq 'removed 1 archive' || fail "--finish did not remove the archive"
[[ ! -e "$archive" && -s "$dir/state/migration-finished" ]] || fail "--finish did not stamp the migration"

# --- --verify names each kind of drift --------------------------------------------------
realm drift
migrate --set-store both >/dev/null
m1="$(as $alice cmd send --to "$bob,$carol" --subject Drift -m 'the whole body' | tail -1)"
verified || fail "the mirror was not exact to begin with"
expect_drift() {  # $1 the expected complaint, then a SQL statement that breaks the mirror
  local expected="$1"; shift
  python3 -c 'import sqlite3, sys; sqlite3.connect(sys.argv[1]).execute("pragma wal_checkpoint(truncate)")' "$db"
  cp "$db" "$tmp/pristine.sqlite3"
  python3 - "$db" "$@" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
for trigger in ("messages_no_update", "message_recipients_no_delete"):
    db.execute(f"drop trigger if exists {trigger}")
db.execute(sys.argv[2], sys.argv[3:])
db.commit()
PY
  set +e; migrate --verify >/dev/null 2>"$tmp/err"; local status=$?; set -e
  [[ "$status" == 1 ]] && grep -Fq "$expected" "$tmp/err" || { cat "$tmp/err" >&2; fail "verify missed: $expected"; }
  cp "$tmp/pristine.sqlite3" "$db"
  rm -f "$db-wal" "$db-shm"
}
expect_drift "$m1 differs from its Maildir copy" "update messages set body = substr(body, 1, 4) where message_id = ?" "$m1"
expect_drift "$m1 is unread for $carol in the Maildir, not delivered in the database" \
  "delete from deliveries where message_id = ? and recipient_mailbox_id = ?" "$m1" "$carol"
expect_drift "$m1 is unread for $bob in the Maildir, read in the database" \
  "update deliveries set read_at = 1 where message_id = ? and recipient_mailbox_id = ?" "$m1" "$bob"
verified || fail "restoring the pristine database did not restore a clean verify"

# --- a crash or fault at each seam of a dual-write --------------------------------------
# A copy of bin/ whose agent-mail-migrate can be replaced, since agent-mail runs its sibling.
faulty() {
  rm -rf "$tmp/bin"
  cp -R "$root/bin" "$tmp/bin"
  bin="$tmp/bin"
}
after_fault() {  # $1 the message delivered during the fault
  [[ -f "$AGENT_MAIL_ROOT/$bob/inbox/new/$1.md" ]] || fail "the Maildir delivery was lost: $2"
  bin="$root/bin"
  migrate >/dev/null
  verified || fail "one migrate did not repair: $2"
  python3 - "$db" <<'PY' || fail "the database is corrupt after: $2"
import sqlite3, sys
assert sqlite3.connect(sys.argv[1]).execute("pragma integrity_check").fetchone()[0] == "ok"
PY
}
realm faults
migrate --set-store both >/dev/null

faulty
printf '#!/bin/sh\nkill -9 $$\n' >"$bin/agent-mail-migrate"
lost="$(as $alice cmd send --to $bob --subject Killed -m 'killed mirror' 2>"$tmp/err" | tail -1)"
grep -Fq "mirroring $lost into the SQLite store failed" "$tmp/err" || fail "a killed mirror was silent"
grep -rFq "$lost" "$dir/state/mirror-failures.d" || fail "a killed mirror was not logged"
after_fault "$lost" "a mirror killed before it started"

for i in 1 2 3 4 5 6 7 8; do
  faulty
  mv "$bin/agent-mail-migrate" "$bin/agent-mail-migrate.real"
  # Killed at a random point, often inside its transaction: either it committed or it did not.
  printf '#!/bin/sh\n"$(dirname "$0")/agent-mail-migrate.real" "$@" & child=$!\nsleep 0.0%s\nkill -9 $child 2>/dev/null\nwait $child\n' \
    "$(( RANDOM % 9 ))" >"$bin/agent-mail-migrate"
  chmod +x "$bin/agent-mail-migrate"
  mid="$(as $alice cmd send --to $bob --subject "Mid $i" -m "mid-transaction $i" 2>/dev/null | tail -1)"
  after_fault "$mid" "a mirror killed mid-flight ($i)"
done

python3 - "$db" "$tmp/release-lock" <<'PY' &
import os, sqlite3, sys, time
db = sqlite3.connect(sys.argv[1], isolation_level=None)
db.execute("begin exclusive")
# Hold until the sender has finished, so a slow host cannot release the lock before the
# mirror reaches it and pass the send off as a mystery. The cap only keeps a hung sender
# from holding the whole test open.
deadline = time.monotonic() + 120
while not os.path.exists(sys.argv[2]) and time.monotonic() < deadline:
    time.sleep(0.05)
db.execute("rollback")
PY
locker=$!
sleep 0.5
locked="$(as $alice cmd send --to $bob --subject Locked -m 'locked database' 2>"$tmp/err" | tail -1)"
: >"$tmp/release-lock"
wait "$locker"
grep -Fq "mirroring $locked into the SQLite store failed" "$tmp/err" || fail "a mirror past the busy timeout was silent"
after_fault "$locked" "a database locked past the busy timeout"

chmod 400 "$db"
readonly_id="$(as $alice cmd send --to $bob --subject Readonly -m 'read-only database' 2>"$tmp/err" | tail -1)"
# SQLite creates its -wal and -shm with the database's mode, so repairing means all three.
chmod 600 "$db"*
grep -Fq "mirroring $readonly_id into the SQLite store failed" "$tmp/err" || fail "a read-only database was silent"
after_fault "$readonly_id" "a read-only database"

# --- rollback loses nothing, with mail arriving between every step -----------------------
realm rollback
for step in both maildir both maildir both; do
  migrate --set-store "$step" >/dev/null
  as $alice cmd send --to $bob --subject "During $step" -m "sent under $step" >/dev/null
  as $bob cmd read --to $bob >/dev/null 2>&1
done
migrate >/dev/null
verified || fail "mail sent across rollbacks did not reconcile"
[[ "$(find "$AGENT_MAIL_ROOT/$bob/inbox" -name '*.md' | wc -l | tr -d ' ')" == 5 ]] || fail "rollback lost Maildir mail"
python3 - "$db" <<'PY' || fail "rollback lost or duplicated mirrored mail"
import sqlite3, sys
assert sqlite3.connect(sys.argv[1]).execute("select count(*) from messages").fetchone()[0] == 5
PY

# --- findings from an independent review, each pinned ------------------------------------
realm review
migrate --set-store both >/dev/null

# A full migrate and a mirror racing for the lock never leave a stale view behind.
for i in 1 2 3 4 5 6; do
  python3 - "$db" <<'PY' &
import sqlite3, sys, time
db = sqlite3.connect(sys.argv[1], isolation_level=None)
db.execute("begin immediate")
time.sleep(1)
db.execute("rollback")
PY
  locker=$!
  sleep 0.2
  migrate >/dev/null 2>&1 &
  full=$!
  as $alice cmd send --to $bob --subject "Race $i" -m "race $i" >/dev/null 2>&1
  wait "$locker" "$full"
  verified || fail "a migrate racing a mirror left drift (round $i)"
done

# A command that began before the switch and delivers after it is still mirrored.
realm late
mkfifo "$tmp/late-body"
as $alice cmd send --to $bob --subject Late --body-file "$tmp/late-body" >"$tmp/late-out" 2>&1 &
sender=$!
sleep 0.5
migrate --set-store both >/dev/null
printf 'arrived after the switch\n' >"$tmp/late-body"
wait "$sender"
verified || fail "a send that straddled --set-store both was not mirrored"
rm -f "$tmp/late-body"

# Both tools read one marker grammar: the whole file less trailing newlines.
for content in $'sqlite\njunk' ' both' $'both\r'; do
  printf '%s' "$content" >"$dir/state/store"
  [[ "$(cmd store | cut -f1)" == maildir ]] || fail "agent-mail read a garbled marker as a store: $content"
  migrate >/dev/null || fail "the migrator refused under a garbled marker it should read as maildir"
done
printf 'both\n\n' >"$dir/state/store"
[[ "$(cmd store | cut -f1)" == both ]] || fail "trailing newlines broke the marker"

# A symlinked human root puts the marker and the database where agent-mail looks.
realm symlinked
mv "$dir/state" "$dir/real-state"
mkdir "$dir/state"
ln -s "$dir/real-state/humans" "$dir/state/humans"
db="$dir/real-state/mail2.sqlite3"
"$bin/agent-mail-migrate" --set-store both >/dev/null
[[ "$(cmd store | cut -f1)" == both ]] || fail "a symlinked human root split the marker"
[[ -f "$dir/real-state/store" && ! -e "$dir/state/store" ]] || fail "the marker landed beside the symlink"

# Switching the store over any database but the one agent-mail mirrors into is refused.
realm otherdb
set +e; "$bin/agent-mail-migrate" --db "$tmp/elsewhere.sqlite3" --set-store both >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 && ! -e "$dir/state/store" ]] && grep -Fq 'cannot be switched over' "$tmp/err" || fail "set-store accepted a database agent-mail does not use"

# A custom AGENT_MAIL2_DB cannot become the runtime store: its mail would never notify Josh.
realm customdb
set +e; AGENT_MAIL2_DB="$tmp/custom.sqlite3" "$bin/agent-mail-migrate" --set-store both >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 && ! -e "$dir/state/store" ]] && grep -Fq 'unset AGENT_MAIL2_DB' "$tmp/err" || fail "set-store accepted a custom runtime database"

# Store transitions are serialized and re-read the store under their lock: a switch to maildir
# that waited behind a flip refuses rather than hiding SQLite-only mail.
realm serialized
migrate --set-store both >/dev/null
python3 - "$dir/state/.store.lock" <<'PY' &
import fcntl, sys, time
with open(sys.argv[1], "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    time.sleep(1.5)
PY
holder=$!
sleep 0.3
migrate --set-store maildir >/dev/null 2>"$tmp/err" &
switch=$!
sleep 0.3
printf 'sqlite\n' >"$dir/state/store"
set +e; wait "$switch"; status=$?; set -e
wait "$holder"
[[ "$status" == 1 && "$(cat "$dir/state/store")" == sqlite ]] && grep -Fq 'strand' "$tmp/err" || fail "a stale switch overwrote a newer store"

# A reply mirrored before its parent brings the parent with it, link and order intact.
realm ancestors
parent="$(as $alice cmd send --to $bob --subject Parent -m parent | tail -1)"
printf 'both\n' >"$dir/state/store"
reply="$(as $bob cmd send --to $alice --in-reply-to "$parent" --subject 'Re: Parent' -m reply | tail -1)"
python3 - "$db" "$parent" "$reply" <<'PY' || fail "the reply's parent was not brought in ahead of it"
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
parent, reply = sys.argv[2:]
rows = dict(db.execute("select message_id, sequence from messages").fetchall())
assert rows[parent] == 1 and rows[reply] == 2, rows
assert db.execute("select reply_to_message_id from messages where message_id = ?", (reply,)).fetchone()[0] == parent
PY

# Hand-made legacy mail: the migrator's parsing, ordering and refusals.
realm legacy
mkdir -p "$AGENT_MAIL_ROOT/$bob/inbox/new" "$AGENT_MAIL_ROOT/$bob/inbox/cur"
legacy() {  # file id from date parent body
  { printf 'From: %s\nTo: %s\nDate: %s\nMessage-ID: %s\nThread-ID: root-z\n' "$3" "$bob" "$4" "$2"
    [[ -z "$5" ]] || printf 'In-Reply-To: %s\n' "$5"
    printf 'Subject: legacy\n\n'; printf "$6"; } >"$AGENT_MAIL_ROOT/$bob/inbox/new/$1.md"
}
# Same second, and the reply's id sorts before its parent's: parents still go first.
legacy root-z root-z "humans/josh" 2026-10-01T10:00:00Z "" 'root\n'
legacy a-reply a-reply Service-A 2026-10-01T10:00:00Z root-z 'crlf\r\nbody\r\n'
migrate >/dev/null || fail "a reply dated with its parent aborted the migration"
python3 - "$db" <<'PY' || fail "legacy parsing changed the mail"
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
row = dict(db.execute("select message_id, sender_mailbox_id from messages").fetchall())
assert row == {"root-z": "josh", "a-reply": "Service-A"}, row
assert db.execute("select reply_to_message_id, body from messages where message_id = 'a-reply'").fetchone() == ("root-z", "crlf\r\nbody\r\n")
PY
verified || fail "verify disagreed with a byte-exact migration"
# --message is a literal id, never a glob.
migrate --message '*' >/dev/null
python3 - "$db" <<'PY' || fail "--message '*' touched mail"
import sqlite3, sys
assert sqlite3.connect(sys.argv[1]).execute("select count(*) from deliveries where discarded_at is not null").fetchone()[0] == 0
PY
# Undecodable bytes are refused by name rather than replaced.
printf 'From: josh\nMessage-ID: bad-bytes\n\n\xff\xfe\n' >"$AGENT_MAIL_ROOT/$bob/inbox/new/bad-bytes.md"
set +e; migrate >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 ]] && grep -Fq 'bad-bytes.md is not UTF-8' "$tmp/err" || fail "undecodable mail was not refused by name"
rm "$AGENT_MAIL_ROOT/$bob/inbox/new/bad-bytes.md"
# A human mailbox and an agent scratchpad with one name are refused, not merged.
mkdir -p "$AGENT_HUMAN_MAIL_ROOT/$bob"
set +e; migrate >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 ]] && grep -Fq "$bob is both an agent scratchpad and a human mailbox" "$tmp/err" || fail "a name collision was not refused"

# --- findings from the second review pass ----------------------------------------------
# The first mail to a fresh inbox, arriving while --set-store waits for the lock, is migrated.
realm fresh
rmdir "$AGENT_MAIL_ROOT/$carol" && mkdir "$AGENT_MAIL_ROOT/$carol"
AGENT_MAIL2_DB="$db" "$bin/agent-mail2" init >/dev/null
python3 - "$db" <<'PY' &
import sqlite3, sys, time
db = sqlite3.connect(sys.argv[1], isolation_level=None)
db.execute("begin immediate")
time.sleep(3)
db.execute("rollback")
PY
locker=$!
sleep 0.3
migrate --set-store both >/dev/null 2>&1 &
switcher=$!
sleep 1.5
first="$(as $alice "$bin/agent-mail" send --to $carol --subject First -m 'first ever' 2>/dev/null | tail -1)"
wait "$locker" "$switcher"
[[ -f "$AGENT_MAIL_ROOT/$carol/inbox/new/$first.md" ]] || fail "the fresh-inbox delivery did not happen"
verified || fail "mail to an inbox created during --set-store was left out"

# A NUL in the marker is garbled to both tools, not a store to one of them.
realm nul
printf 'sqlite\0\n' >"$dir/state/store"
[[ "$(cmd store | cut -f1)" == maildir ]] || fail "agent-mail read a marker with a NUL as a store"
migrate >/dev/null || fail "the migrator refused under a marker it should read as maildir"

# A parent filed under another thread still lands before its reply.
realm crossthread
mkdir -p "$AGENT_MAIL_ROOT/$bob/inbox/new"
printf 'From: %s\nMessage-ID: z-parent\nDate: 2026-10-01T10:00:00Z\nSubject: p\n\nparent\n' "$alice" >"$AGENT_MAIL_ROOT/$bob/inbox/new/z-parent.md"
printf 'From: %s\nMessage-ID: a-child\nIn-Reply-To: z-parent\nDate: 2026-10-01T10:00:00Z\nSubject: c\n\nchild\n' "$alice" >"$AGENT_MAIL_ROOT/$bob/inbox/new/a-child.md"
migrate >/dev/null || fail "a reply whose parent sits in another thread aborted the migration"
verified || fail "the cross-thread parent link was not kept"

# Names that would give one inbox two identities, or two inboxes one, are refused.
realm names
ln -s "$AGENT_MAIL_ROOT/$bob" "$AGENT_MAIL_ROOT/link-agent-44444444"
set +e; "$bin/agent-mail2" resolve link-agent-44444444 >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 ]] && grep -Fq 'is a symlink' "$tmp/err" || fail "agent-mail2 resolved a symlinked pad"
mkdir -p "$AGENT_MAIL_ROOT/link-agent-44444444/inbox/new"
set +e; migrate >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 ]] && grep -Fq 'is a symlink' "$tmp/err" || fail "the migrator read a symlinked pad"
rm "$AGENT_MAIL_ROOT/link-agent-44444444"
mkdir -p "$AGENT_HUMAN_MAIL_ROOT/$bob"
for address in $bob "humans/$bob"; do
  set +e; "$bin/agent-mail2" resolve "$address" >/dev/null 2>"$tmp/err"; status=$?; set -e
  [[ "$status" == 1 ]] && grep -Fq 'both an agent scratchpad and a human mailbox' "$tmp/err" || fail "agent-mail2 resolved a colliding name: $address"
done

# Under both, undecodable mail is refused before delivery rather than failing every repair.
realm utf8
migrate --set-store both >/dev/null
set +e; as $alice cmd send --to $bob --subject Bytes --body $'\xff\xfe' >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 ]] && grep -Fq 'not valid UTF-8' "$tmp/err" || fail "undecodable mail was delivered under both"
[[ -z "$(find "$AGENT_MAIL_ROOT/$bob" -type f -name '*' ! -name '.*' -print -quit 2>/dev/null)" ]] || fail "a refused send left files behind"

# Switching the store from any tree but the one agent-mail delivers into is refused.
realm otherroot
set +e; "$bin/agent-mail-migrate" --agent-root "$tmp/empty-pads" --set-store both >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 && ! -e "$dir/state/store" ]] && grep -Fq 'cannot be switched from' "$tmp/err" || fail "set-store accepted a tree agent-mail does not deliver into"

# Under maildir or both, agent-mail2 refuses to change the runtime database directly.
realm direct
migrate --set-store both >/dev/null
for args in "send --to $bob -m direct" "read --to $bob" "discard --to $bob --id x"; do
  set +e; as $alice "$bin/agent-mail2" $args >/dev/null 2>"$tmp/err"; status=$?; set -e
  [[ "$status" == 5 ]] && grep -Fq 'the store marker says both' "$tmp/err" || fail "agent-mail2 $args wrote around the Maildir"
done
as $alice "$bin/agent-mail2" read --to $bob --peek >/dev/null 2>&1 || true
AGENT_MAIL2_DB="$tmp/elsewhere.sqlite3" as $alice "$bin/agent-mail2" send --to $bob -m 'a private database' >/dev/null \
  || fail "agent-mail2 refused a database that is not the runtime store"

# --- the flip to sqlite ------------------------------------------------------------------
# History flips over intact; a send that read the marker before the flip and delivers after
# it is still in SQLite and drainable; and after the flip the Maildir can only add.
realm flip
before="$(as $alice cmd send --to "$bob,josh" --subject History -m 'before the flip' | tail -1)"
as $bob cmd read --to $bob --id "$before" >/dev/null 2>&1
migrate --set-store both >/dev/null
mkfifo "$tmp/straddle-body"
as $alice cmd send --to $bob --subject Straddle --body-file "$tmp/straddle-body" >"$tmp/straddle-out" 2>"$tmp/straddle-err" &
sender=$!
sleep 0.5
migrate --set-store sqlite >"$tmp/flip-out" || { cat "$tmp/flip-out"; fail "the flip failed"; }
printf 'written across the flip\n' >"$tmp/straddle-body"
wait "$sender"
straddled="$(tail -1 "$tmp/straddle-out")"
[[ "$(cmd store | cut -f1)" == sqlite ]] || fail "the marker did not flip"
cmd receipt "$before" | grep -Fq $'read\t'"$before"$'\tto:'"$bob" || fail "a read from before the flip was lost"
cmd scan --to $bob --json | python3 -c 'import json,sys; ids=[m["message_id"] for m in json.load(sys.stdin)["messages"]]; sys.exit(0 if sys.argv[1] in ids else 1)' "$straddled" \
  || fail "a send that straddled the flip is not drainable from SQLite"
cmd read --to $bob --id "$straddled" --peek 2>/dev/null | grep -Fxq 'written across the flip' || fail "the straddling send lost its body"
set +e; migrate >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 ]] && grep -Fq 'refusing to sync' "$tmp/err" || fail "a full sync ran over the sqlite store"
migrate --import-only >/dev/null || fail "an import-only pass was refused under sqlite"
cmd receipt "$before" | grep -Fq $'read\t'"$before"$'\tto:'"$bob" || fail "an import-only pass changed state"
migrate --verify >/dev/null || fail "verify under sqlite found problems in a sound store"
set +e; migrate --set-store both >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 ]] && grep -Fq 'strand' "$tmp/err" || fail "leaving sqlite was allowed"

# A straddling writer whose import fails is not silent: it is logged for the drift alarm,
# and one import-only pass repairs it, changing nothing else.
realm flip-fail
migrate --set-store both >/dev/null
mkfifo "$tmp/fail-body"
as $alice env AGENT_MAIL2_DB="$tmp" "$bin/agent-mail" send --to $bob --subject Lost --body-file "$tmp/fail-body" \
  >"$tmp/fail-out" 2>"$tmp/fail-err" &
sender=$!
sleep 0.5
migrate --set-store sqlite >/dev/null
printf 'imported later\n' >"$tmp/fail-body"
wait "$sender"
lost="$(tail -1 "$tmp/fail-out")"
grep -Fq "mirroring $lost into the SQLite store failed" "$tmp/fail-err" || fail "a failed straddling import was silent"
grep -rFq "$lost" "$dir/state/mirror-failures.d" || fail "a failed straddling import was not logged"
cmd receipt "$lost" >/dev/null 2>&1 && fail "the failed import somehow reached SQLite"
set +e; migrate --finish >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 ]] && grep -Fq 'not repaired' "$tmp/err" || fail "--finish ran with an unrepaired import"
migrate --import-only >/dev/null
cmd read --to $bob --id "$lost" --peek 2>/dev/null | grep -Fxq 'imported later' || fail "an import-only pass did not repair the straddler"
migrate --finish >/dev/null || fail "--finish refused after the repair"
[[ -z "$(find "$dir/state/mirror-failures.d" -maxdepth 1 -type f ! -name '.*')" && -n "$(ls "$dir/state/mirror-failures.d/repaired")" ]] || fail "--finish did not retire the repaired failure record"

# A read or discard begun under both that changes the Maildir after the flip still reaches
# SQLite. The probe parks agent-mail at the Maildir change itself: a cat and an rm that wait
# on a gate for message files, after the command has chosen the Maildir path.
realm late-ack
migrate --set-store both >/dev/null
to_read="$(as $alice cmd send --to $bob --subject 'Read late' -m 'read me' | tail -1)"
to_drop="$(as $alice cmd send --to $bob --subject 'Drop late' -m 'drop me' | tail -1)"
shims="$tmp/late-shims"
mkdir -p "$shims"
for tool in cat rm; do
  real="$(command -v $tool)"
  printf '#!/bin/sh\ncase "$*" in *inbox/new/*) while [ ! -e "%s/go" ]; do sleep 0.05; done ;; esac\nexec %s "$@"\n' "$shims" "$real" >"$shims/$tool"
  chmod +x "$shims/$tool"
done
as $bob env PATH="$shims:$PATH" "$bin/agent-mail" read --to $bob --id "$to_read" >/dev/null 2>"$tmp/late-read-err" &
reader=$!
as $bob env PATH="$shims:$PATH" "$bin/agent-mail" discard --to $bob --id "$to_drop" 2>"$tmp/late-drop-err" &
dropper=$!
sleep 0.5
migrate --set-store sqlite >/dev/null
touch "$shims/go"
wait "$reader" "$dropper"
[[ "$(cmd receipt "$to_read" | cut -f1)" == read ]] || { cat "$tmp/late-read-err"; fail "a read that straddled the flip lost its acknowledgement"; }
[[ "$(cmd receipt "$to_drop" | cut -f1)" == discarded ]] || { cat "$tmp/late-drop-err"; fail "a discard that straddled the flip was lost"; }
cmd scan --to $bob | grep -Fq "$to_read" && fail "the late-read message is still listed unread"

# A late acknowledgement whose mirror fails is logged with its operation, --finish refuses
# until it is applied, and --replay-failures applies it.
realm late-ack-fail
migrate --set-store both >/dev/null
stuck="$(as $alice cmd send --to $bob --subject Stuck -m stuck | tail -1)"
mkdir -p "$shims-2"
real="$(command -v cat)"
printf '#!/bin/sh\ncase "$*" in *inbox/new/*) while [ ! -e "%s/go" ]; do sleep 0.05; done ;; esac\nexec %s "$@"\n' "$shims-2" "$real" >"$shims-2/cat"
chmod +x "$shims-2/cat"
as $bob env PATH="$shims-2:$PATH" AGENT_MAIL2_DB="$tmp" "$bin/agent-mail" read --to $bob --id "$stuck" >/dev/null 2>"$tmp/stuck-err" &
reader=$!
sleep 0.5
migrate --set-store sqlite >/dev/null
touch "$shims-2/go"
wait "$reader"
grep -Fq "mirroring $stuck into the SQLite store failed" "$tmp/stuck-err" || fail "a failed late acknowledgement was silent"
grep -rFq $'\t'"$stuck"$'\tread\t'"$bob"$'\t' "$dir/state/mirror-failures.d" || fail "the failure record lost the operation"
set +e; migrate --finish >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 ]] && grep -Fq "read by $bob" "$tmp/err" || fail "--finish ran with an unapplied acknowledgement"
migrate --replay-failures >/dev/null || fail "--replay-failures failed"
[[ "$(cmd receipt "$stuck" | cut -f1)" == read ]] || fail "--replay-failures did not apply the acknowledgement"
[[ -z "$(find "$dir/state/mirror-failures.d" -maxdepth 1 -type f ! -name '.*')" ]] || fail "--replay-failures did not retire the record"

# A failure recorded while a repair runs is not swept up with the records it checked.
python3 - "$bin/agent-mail-migrate" "$dir/state" "$db" "$AGENT_MAIL_ROOT" "$AGENT_HUMAN_MAIL_ROOT" "$stuck" "$bob" <<'PY' || fail "a failure recorded during a repair was retired unrepaired"
import importlib.machinery, importlib.util, sys
from pathlib import Path
script, state, db, pads, humans, stuck, bob = sys.argv[1:]
loader = importlib.machinery.SourceFileLoader("migrate", script)
sys.dont_write_bytecode = True
m = importlib.util.module_from_spec(importlib.util.spec_from_loader("migrate", loader))
# dataclass asks sys.modules for the defining module on Python 3.12 and older; without the
# entry it raises AttributeError instead of building the class.
sys.modules["migrate"] = m
loader.exec_module(m)
state = Path(state)
first = state / "mirror-failures.d" / "20261022T000000Z-1-1-first"
first.write_text(f"t\t{stuck}\tread\t{bob}\terror\n")
checked = m.unrepaired
def unrepaired_then_a_writer_records(db, entries):
    result = checked(db, entries)
    late = state / "mirror-failures.d" / "20261022T000001Z-2-2-late"
    if not late.exists():
        late.write_text(f"t\tnever-delivered\tread\t{bob}\terror\n")
    return result
m.unrepaired = unrepaired_then_a_writer_records
try:
    m.replay_failures(state / "store", Path(db), (Path(pads), Path(humans)), "public")
except m.MigrationError:
    pass
assert not first.exists(), "the checked record was not retired"
assert (state / "mirror-failures.d" / "20261022T000001Z-2-2-late").exists(), "the late record was swept up"
PY

# A failure for a message id longer than a filename may be is still recorded.
realm long-id
migrate --set-store both >/dev/null
long_id="$(printf 'L%.0s' $(seq 1 240))"
mkdir -p "$AGENT_MAIL_ROOT/$bob/inbox/new"
printf 'From: %s\nTo: %s\nMessage-ID: %s\nSubject: long\n\nlong\n' "$alice" "$bob" "$long_id" >"$AGENT_MAIL_ROOT/$bob/inbox/new/$long_id.md"
as $bob env AGENT_MAIL2_DB="$tmp" "$bin/agent-mail" read --to $bob --id "$long_id" >/dev/null 2>"$tmp/long-err"
grep -rFq "$long_id" "$dir/state/mirror-failures.d" || { cat "$tmp/long-err"; fail "a long id's failure was not recorded"; }
set +e; migrate --verify >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 ]] && grep -Fq 'recorded mirror failures are unrepaired' "$tmp/err" || fail "verify did not report a recorded failure"
migrate --replay-failures >/dev/null || fail "replay of a long id failed"
migrate --verify >/dev/null || fail "verify still failed after the replay"

# The legacy log is never renamed or truncated, since an old agent-mail may still append to it:
# retiring records the bytes checked, and a line appended later is still pending.
realm legacy-log
migrate --set-store both >/dev/null
old="$(as $alice cmd send --to $bob --subject Old -m old | tail -1)"
printf 't\t%s\terror\n' "$old" >"$dir/state/mirror-failures"
migrate --replay-failures >/dev/null
[[ -s "$dir/state/mirror-failures" && "$(cat "$dir/state/mirror-failures.retired-bytes")" == "$(wc -c <"$dir/state/mirror-failures" | tr -d ' ')" ]] \
  || fail "retiring the legacy log did not record its checked size"
migrate --verify >/dev/null || fail "a retired legacy log still counted as drift"
printf 't\tnever-delivered-legacy\terror\n' >>"$dir/state/mirror-failures"
set +e; migrate --verify >/dev/null 2>"$tmp/err"; status=$?; set -e
[[ "$status" == 1 ]] && grep -Fq 'never-delivered-legacy' "$tmp/err" || fail "a line appended to the legacy log after retiring was ignored"

# A migration that passed its first check just before the flip refuses once it holds the lock.
realm flip-race
migrate --set-store both >/dev/null
python3 - "$db" <<'PY' &
import sqlite3, sys, time
db = sqlite3.connect(sys.argv[1], isolation_level=None)
db.execute("begin immediate")
time.sleep(2)
db.execute("rollback")
PY
locker=$!
sleep 0.3
migrate >/dev/null 2>"$tmp/race-err" &
racer=$!
sleep 0.7
printf 'sqlite\n' >"$dir/state/store"
set +e; wait "$racer"; status=$?; set -e
wait "$locker"
[[ "$status" == 1 ]] && grep -Fq 'became sqlite' "$tmp/race-err" || fail "a migration that began before the flip synced after it"

# --- a long random run of every mutating command keeps the mirror exact ------------------
realm fuzz
migrate --set-store both >/dev/null
seed="${AGENT_MAIL_FUZZ_SEED:-$RANDOM$RANDOM}"
ops="${AGENT_MAIL_FUZZ_OPS:-120}"
python3 - "$bin" "$db" "$seed" "$ops" "$alice" "$bob" "$carol" <<'PY' || fail "random run failed (replay with AGENT_MAIL_FUZZ_SEED=$seed)"
import os, random, subprocess, sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

bin_dir, db, seed, ops, *agents = sys.argv[1:]
rng = random.Random(int(seed))
pads = Path(os.environ["AGENT_MAIL_ROOT"])
humans = Path(os.environ["AGENT_HUMAN_MAIL_ROOT"])
cli = str(Path(bin_dir) / "agent-mail")
everyone = [*agents, "josh"]


def run(who, *args, check=True):
    env = dict(os.environ)
    if who == "josh":
        env.pop("AGENT_SCRATCHPAD", None)
        env["AGENT_MAIL_FROM"] = "josh"
    else:
        env["AGENT_SCRATCHPAD"] = str(pads / who)
    result = subprocess.run([cli, *args], env=env, capture_output=True, text=True)
    if check and result.returncode:
        raise SystemExit(f"{who} {args}: exit {result.returncode}: {result.stderr}")
    if "mirroring" in result.stderr:
        raise SystemExit(f"{who} {args}: mirror failed: {result.stderr}")
    return result


def inbox(who, state):
    base = humans / "josh" / "inbox" if who == "josh" else pads / who / "inbox"
    return sorted((base / state).glob("*.md")) if (base / state).is_dir() else []


def body(rng):
    return rng.choice(["short", "two\nlines", "trailing newline\n", "unicode ✓ café", "x" * rng.randint(1, 3000)])


def op(rng, who):
    kind = rng.choice(["send", "send", "reply", "read", "read-id", "discard", "archive", "deliver"])
    held = inbox(who, "new") + inbox(who, "cur")
    if kind == "send" or not held:
        audience = rng.sample([a for a in everyone if a != who], rng.randint(1, 3))
        run(who, "send", "--to", ",".join(audience), "--subject", f"s{rng.randint(0, 99)}", "--body", body(rng))
    elif kind == "reply":
        # A message whose only other party is the replier has nobody to reply to; that refusal is fine.
        run(who, "send", "--reply-all", str(rng.choice(held)), "--body", body(rng), check=False)
    elif kind == "read":
        run(who, "read", "--to", who, check=False)
    elif kind == "read-id":
        run(who, "read", "--to", who, "--id", rng.choice(held).stem)
    elif kind == "discard":
        run(who, "discard", "--to", who, "--id", rng.choice(held).stem)
    elif kind == "archive" and who == "josh" and inbox("josh", "new"):
        run("josh", "archive", str(rng.choice(inbox("josh", "new"))))
    elif kind == "deliver":
        draft = Path(run("josh", "compose").stdout.strip())
        audience = rng.sample(agents, rng.randint(1, 3))
        draft.write_text(f"From: josh\nTo: {', '.join(audience)}\nSubject: web {rng.randint(0, 99)}\n\n{body(rng)}")
        run("josh", "deliver", str(draft))


def verify(step):
    result = subprocess.run([str(Path(bin_dir) / "agent-mail-migrate"), "--db", db, "--verify"],
                            capture_output=True, text=True)
    if result.returncode:
        raise SystemExit(f"step {step}: mirror drifted:\n{result.stderr}")


for step in range(int(ops)):
    if rng.random() < 0.15:
        # Concurrent writers, one per mailbox, each with its own generator so a seed replays.
        batch = [(random.Random(rng.random()), who) for who in rng.sample(everyone, 4)]
        with ThreadPoolExecutor(4) as pool:
            list(pool.map(lambda job: op(*job), batch))
    else:
        op(rng, rng.choice(everyone))
    verify(step)
print(f"{ops} random steps verified (seed {seed})")
PY

echo 'agent-mail-transition tests passed'
