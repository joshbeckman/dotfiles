#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d)"
export GH_HOST=wrong.example.invalid GH_REPO=other/project GW_REPO=other/project
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/repo" "$tmp/bin"
git -C "$tmp/repo" init -q -b feature
cat >"$tmp/bin/gw" <<'EOF'
#!/bin/sh
[ "$GW_REPO" = github.com/example/project ] || exit 90
[ "$GH_HOST" = github.com ] || exit 91
[ -z "${GH_REPO:-}" ] || exit 92
case "$1" in
  pr-url) printf 'https://github.com/example/project/pull/7\n' ;;
  pr-merged) printf '2026-01-02T03:04:05Z\n' ;;
  pr-checks) printf '| Check | Status | Result |\n| --- | --- | --- |\n' ;;
  *) exit 2 ;;
esac
EOF
chmod +x "$tmp/bin/gw"
# `git pr-view` renders a GitHub PR with `gh` itself; `gw` has no markdown viewer.
cat >"$tmp/bin/gh" <<'EOF2'
#!/bin/sh
case "$1" in
  extension) [ "$2" = list ] && printf 'gh view-md\tjoshbeckman/gh-view-md\t1\n' ;;
  view-md)
    # The trimmed render is what `pr-view` must ask for; the flag is the whole point.
    # OLD_VIEW_MD stands for an extension released before the flag existed.
    if [ "$2" = "--help" ]; then
      printf 'Usage: gh view-md <url> [options]\n'
      [ -n "${OLD_VIEW_MD:-}" ] || printf '        --max-diff LINES  Maximum diff lines to show (default: 800)\n'
      exit 0
    fi
    if [ -n "${OLD_VIEW_MD:-}" ]; then
      [ "$2" = https://github.com/example/project/pull/7 ] || exit 93
    else
      [ "$2" = "--max-diff" ] && [ "$3" = 0 ] || exit 93
    fi
    printf '# Full GitHub PR\n'
    ;;
  *) exit 2 ;;
esac
EOF2
chmod +x "$tmp/bin/gh"

run() {
  (cd "$tmp/repo" && PATH="$tmp/bin:$root/bin:$PATH" git "$@")
}

# Capture to a file before matching. `run ... | grep -q` looks equivalent but is not:
# grep -q exits as soon as it matches, and under `set -o pipefail` the write end then
# dies with SIGPIPE, which the script reports as exit 141. It only shows up when the
# producer has not finished writing yet -- it failed on a macOS runner and never here.
expect_line() {
  local want="$1"
  shift
  local out="$tmp/expect.$$"
  run "$@" >"$out"
  grep -Fq -- "$want" "$out"
}

# Unknown providers cannot fall through to GitHub, even with a mirror.
git -C "$tmp/repo" config prLookup.provider unsupported
git -C "$tmp/repo" remote add github https://github.com/mirror/project.git
for operation in pr-url pr-view pr-merged pr-checks; do
  if run "$operation" 42 >"$tmp/out" 2>"$tmp/err"; then
    echo 'expected unsupported provider to fail' >&2; exit 1
  fi
  grep -Fq 'unsupported provider: unsupported' "$tmp/err"
done
[[ "$(run pr-url https://github.com/example/project/pull/7)" == 'https://github.com/example/project/pull/7' ]]
[[ "$(run pr-view https://github.com/example/project/pull/7)" == '# Full GitHub PR' ]]
[[ "$(OLD_VIEW_MD=1 run pr-view https://github.com/example/project/pull/7)" == '# Full GitHub PR' ]]
# Without the `gh view-md` extension, `pr-view` falls back to `gh pr view`.
casebin="$tmp/gh-no-ext"
mkdir "$casebin"
cat >"$casebin/gh" <<'EOF3'
#!/bin/sh
case "$1" in
  extension) exit 0 ;;
  pr) [ "$2" = view ] && printf '# Plain GitHub PR\n' ;;
  *) exit 2 ;;
esac
EOF3
chmod +x "$casebin/gh"
out="$(cd "$tmp/repo" && PATH="$casebin:$tmp/bin:$root/bin:$PATH" git pr-view https://github.com/example/project/pull/7)"
[[ "$out" == '# Plain GitHub PR' ]] || { printf 'pr-view fell back to: %s\n' "$out" >&2; exit 1; }
[[ "$(run pr-merged https://github.com/example/project/pull/7)" == '2026-01-02T03:04:05Z' ]]
expect_line '| Check | Status | Result |' pr-checks https://github.com/example/project/pull/7 --required

git -C "$tmp/repo" config --unset-all prLookup.provider
git -C "$tmp/repo" remote add origin https://github.com/example/project.git
for url in 'https://unrelated.example.invalid/other/project/pulls/42' 'https://reviews.example.test/pulls/41'; do
  if run pr-view "$url" >"$tmp/out" 2>"$tmp/err"; then
    echo 'expected untrusted selector to fail' >&2; exit 1
  fi
done

printf 'pr-lookup tests passed\n'
