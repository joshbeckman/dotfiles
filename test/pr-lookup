#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/repo" "$tmp/bin"
git -C "$tmp/repo" init -q -b feature
git -C "$tmp/repo" config prLookup.provider gitstream
git -C "$tmp/repo" config prLookup.urlTemplate 'https://reviews.example.test/pulls/{number}'

cat >"$tmp/bin/gw" <<'EOF'
#!/bin/sh
case "$1" in
  pr-url) printf 'https://github.com/example/project/pull/7\n' ;;
  pr-merged) printf '2026-01-02T03:04:05Z\n' ;;
  pr-checks) printf '| Check | Status | Result |\n| --- | --- | --- |\n' ;;
  view-md) printf '# Full GitHub PR\n' ;;
  *) exit 2 ;;
esac
EOF
cat >"$tmp/bin/gs" <<'EOF'
#!/bin/sh
case "$1 $2" in
  'pr list') printf '[{"number":42}]\n' ;;
  'pr view')
    if [ "${4:-}" = --comments ]; then
      printf '# Full Gitstream PR\n'
    else
      printf '{"mergedAt":"2026-02-03T04:05:06Z"}\n'
    fi
    ;;
  'pr checks')
    if [ "${4:-}" = --json ]; then
      printf '{"requiredChecks":[{"name":"Required CI","state":"%s","present":true}]}\n' "${FAKE_CHECK_STATE:-success}"
    else
      printf 'Required CI  success\n'
    fi
    ;;
  *) exit 2 ;;
esac
EOF
chmod +x "$tmp/bin/gw" "$tmp/bin/gs"

run() {
  (cd "$tmp/repo" && PATH="$tmp/bin:$root/bin:$PATH" git "$@")
}

# Capture to a file before matching. `run ... | grep -q` looks equivalent but is not:
# grep -q exits as soon as it matches, and under `set -o pipefail` the write end then
# dies with SIGPIPE, which the script reports as exit 141. It only shows up when the
# producer has not finished writing yet -- it failed on a macOS runner and never here.
expect_line() {
  local want="$1"
  shift
  local out="$tmp/expect.$$"
  run "$@" >"$out"
  grep -Fq -- "$want" "$out"
}

[[ "$(run pr-url)" == 'https://reviews.example.test/pulls/42' ]]
[[ "$(run pr-url 41)" == 'https://reviews.example.test/pulls/41' ]]
[[ "$(run pr-view 41)" == '# Full Gitstream PR' ]]
[[ "$(run pr-merged 41)" == '2026-02-03T04:05:06Z' ]]
expect_line 'Required CI  success' pr-checks 41
expect_line '| Required CI | success | Required |' pr-checks 41 --required
if FAKE_CHECK_STATE=failure run pr-checks 41 --required >"$tmp/out"; then
  printf 'expected a failed required check to return nonzero\n' >&2
  exit 1
fi
grep -Fq '| Required CI | failure | Required |' "$tmp/out"
[[ "$(run pr-url https://github.com/example/project/pull/7)" == 'https://github.com/example/project/pull/7' ]]
[[ "$(run pr-view https://github.com/example/project/pull/7)" == '# Full GitHub PR' ]]
[[ "$(run pr-merged https://github.com/example/project/pull/7)" == '2026-01-02T03:04:05Z' ]]
expect_line '| Check | Status | Result |' pr-checks https://github.com/example/project/pull/7 --required

git -C "$tmp/repo" config --unset-all prLookup.urlTemplate
# An explicit provider is not trust in arbitrary URL hosts or repositories.
for url in 'https://unrelated.example.invalid/other/project/pulls/42' 'https://reviews.example.test/pulls/41'; do
  if run pr-view "$url" >"$tmp/out" 2>"$tmp/err"; then
    echo 'expected untrusted legacy selector to fail without a template' >&2; exit 1
  fi
  grep -Fq 'does not match the configured Gitstream host' "$tmp/err"
done
git -C "$tmp/repo" remote add origin https://github.com/example/project.git
if run pr-view https://unrelated.example.invalid/other/project/pulls/42 >"$tmp/out" 2>"$tmp/err"; then
  echo 'a GitHub mirror does not authenticate a legacy selector' >&2; exit 1
fi
git -C "$tmp/repo" config prLookup.host reviews.example.test
git -C "$tmp/repo" config prLookup.repo example/project
gitstream_url='https://reviews.example.test/repos/example/project/pulls/41'
[[ "$(run pr-url "$gitstream_url")" == "$gitstream_url" ]]
[[ "$(run pr-merged "$gitstream_url")" == '2026-02-03T04:05:06Z' ]]
for url in 'https://unrelated.example.invalid/repos/example/project/pulls/42' 'https://reviews.example.test/repos/other/project/pulls/42'; do
  if run pr-view "$url" >"$tmp/out" 2>"$tmp/err"; then
    echo 'expected mismatched legacy host/repository to fail' >&2; exit 1
  fi
  grep -Fq 'does not match the configured Gitstream host' "$tmp/err"
done

printf 'pr-lookup tests passed\n'
