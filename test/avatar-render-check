#!/usr/bin/env bash
# Each case asserts a failure the check exists to catch. A check whose failure cannot be
# named is a check that cannot fail, which is what every avatar defect turned out to be.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
check="$root/.agents/skills/avatars/scripts/render-check"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/stubs"

cat >"$tmp/avatar.svg" <<'EOF'
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect x="0" y="0" width="64" height="64" fill="#123456"/></svg>
EOF
printf 'not an svg at all\n' >"$tmp/bad.svg"

# A renderer stub writes a real PNG header, because the check now reads the dimensions from
# the file rather than shelling to sips, which is macOS-only. Each flavour lies in the way a
# tool reporting success without doing the thing did.
cat >"$tmp/render-good" <<'EOF'
#!/usr/bin/env python3
import pathlib, struct, sys
args = sys.argv[1:]
size = int(args[args.index('-s') + 1]) if '-s' in args else int(args[args.index('-w') + 1])
out = pathlib.Path(args[args.index('-o') + 1])
if pathlib.Path(sys.argv[0]).name == 'qlmanage':
    out = out / (pathlib.Path(args[-1]).name + '.png')
out.write_bytes(b'\x89PNG\r\n\x1a\n' + struct.pack('>I', 13) + b'IHDR'
                + struct.pack('>IIBBBBB', size, size, 8, 6, 0, 0, 0))
EOF
cat >"$tmp/render-wrong" <<'EOF'
#!/usr/bin/env python3
import pathlib, struct, sys
args = sys.argv[1:]
out = pathlib.Path(args[args.index('-o') + 1])
if pathlib.Path(sys.argv[0]).name == 'qlmanage':
    out = out / (pathlib.Path(args[-1]).name + '.png')
out.write_bytes(b'\x89PNG\r\n\x1a\n' + struct.pack('>I', 13) + b'IHDR'
                + struct.pack('>IIBBBBB', 28, 28, 8, 6, 0, 0, 0))
EOF
cat >"$tmp/render-silent" <<'EOF'
#!/bin/sh
printf '* %s produced one thumbnail\nDone producing thumbnails\n' "$*"
exit 0
EOF
chmod +x "$tmp"/render-*

stub_dir() { # stub_dir qlmanage good -> a PATH with that renderer and no other
  local dir="$tmp/stubs/$1-$2"
  mkdir -p "$dir"
  cp "$tmp/render-$2" "$dir/$1"
  ln -sf "$(command -v python3)" "$dir/python3"
  printf '%s' "$dir"
}

last=""
expect() { # want_exit label command...
  local want="$1" label="$2"; shift 2
  local got=0
  "$@" >"$tmp/out" 2>&1 || got=$?
  last="$(cat "$tmp/out")"
  if [ "$got" != "$want" ]; then
    printf 'FAIL %s: expected exit %s, got %s\n' "$label" "$want" "$got" >&2
    printf '%s\n' "$last" >&2
    exit 1
  fi
  printf 'ok   %s (exit %s)\n' "$label" "$got"
}

run_with() { # stub_dir
  # Only the stub directory is on PATH: appending /usr/bin would put the real qlmanage and
  # sips back, which is how the "no renderer" case first passed while rendering.
  PATH="$1" "$check" "$tmp/avatar.svg"
}

# 1. A file the bridge would reject, which must not be rendered at all.
expect 1 "invalid svg is rejected before rendering" "$check" "$tmp/bad.svg"
case "$last" in *"the bridge would reject this"*) ;; *) printf 'FAIL: no rejection reason\n' >&2; exit 1 ;; esac

# 2. Nothing to check.
expect 2 "missing file" "$check" "$tmp/nothing-here.svg"

# 3. No renderer on this host: still valid, and the report names what that leaves untested.
# qlmanage lives in /usr/bin, so the only way to hide it is a PATH that has python3 and
# nothing else — which is also what a bare host looks like.
mkdir -p "$tmp/stubs/no-qlmanage"
ln -sf "$(command -v python3)" "$tmp/stubs/no-qlmanage/python3"
expect 0 "no qlmanage still validates and names the gap" run_with "$tmp/stubs/no-qlmanage"
case "$last" in *"no qlmanage"*) ;; *) printf 'FAIL: silent about the missing renderer\n' >&2; exit 1 ;; esac

# 4. qlmanage reporting success while writing nothing — the defect that cost the most.
expect 1 "qlmanage that writes nothing" run_with "$(stub_dir qlmanage silent)"

# 5. A file that exists but is not the size that was asked for: the collision defect.
expect 1 "wrong dimensions are caught" run_with "$(stub_dir qlmanage wrong)"
case "$last" in *"expected 512x512"*) ;; *) printf 'FAIL: did not name the expected size\n' >&2; exit 1 ;; esac

# 6. The passing case, which must stay passing, and must still name what it cannot see.
expect 0 "valid avatar renders at both sizes" run_with "$(stub_dir qlmanage good)"
case "$last" in *"cannot tell you whether the mark"*) ;; *) printf 'FAIL: passing run did not name its distance\n' >&2; exit 1 ;; esac

# 7. The render half works off macOS: rsvg-convert is the fallback when qlmanage is absent.
expect 0 "rsvg-convert covers the render half without qlmanage" run_with "$(stub_dir rsvg-convert good)"

printf 'avatar render-check tests passed\n'
