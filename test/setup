#!/usr/bin/env python3
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parents[1]
SOURCE = Path(os.environ.get('SETUP_UNDER_TEST', ROOT / 'setup'))
FAKE_COMMAND = '''#!/usr/bin/env python3
import json, os, pathlib, sys
name = pathlib.Path(sys.argv[0]).name
args = sys.argv[1:]
record = {'command': name, 'args': args, 'cwd': os.getcwd(),
          'no_ask': os.environ.get('HOMEBREW_NO_ASK'),
          'no_sudo': os.environ.get('HOMEBREW_NO_SUDO'),
          'git_prompt': os.environ.get('GIT_TERMINAL_PROMPT'),
          'gh_prompt': os.environ.get('GH_PROMPT_DISABLED')}
if name == 'brew':
    record['stdin'] = sys.stdin.read()
with open(os.environ['COMMAND_LOG'], 'a') as f:
    f.write(json.dumps(record) + '\\n')
if name == 'git' and args[0] == 'clone':
    pathlib.Path(args[-1]).mkdir(parents=True, exist_ok=True)
elif name == 'uname':
    print('Linux fixture')
elif name == 'lsb_release':
    print('Distributor ID: ubuntu')
elif name == 'dpkg':
    print(os.environ.get('FAKE_ARCH', 'amd64'))
if name == os.environ.get('FAIL_COMMAND') and (not os.environ.get('FAIL_ARG') or os.environ['FAIL_ARG'] in args):
    sys.exit(7)
'''


@unittest.skipUnless(shutil.which('zsh'), 'setup requires zsh')
class SetupTest(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='dotfiles-setup-test-')
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name).resolve()
        self.repo = self.root / 'dotfiles with spaces'
        self.home = self.root / 'home with spaces'
        self.bin = self.root / 'bin'
        self.bin.mkdir()
        (self.bin / 'python3').symlink_to(sys.executable)
        self.home.mkdir()
        self.repo.mkdir()
        self.script = self.repo / 'setup'
        shutil.copyfile(SOURCE, self.script)
        (self.repo / 'Brewfile').touch()
        (self.repo / '.config/nvim').mkdir(parents=True)
        for path in ('.agents/AGENTS.md', '.agents/pi/settings.json', '.agents/pi/keybindings.json'):
            target = self.repo / path
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text('{}')
        for path in ('.agents/prompts', '.agents/skills'):
            (self.repo / path).mkdir()
        for name in ('git', 'brew', 'pi', 'gh', 'uname', 'lsb_release', 'dpkg', 'sudo', 'apt-cache'):
            self.executable(self.bin / name)
        for name in ('dfm', 's', 'gh-nvim-username-keywords', 'gh-nvim-labels-keywords',
                     'gh-nvim-repos-keywords', 'gh-nvim-email-keywords', 'agent-nvim-keywords'):
            self.executable(self.repo / 'bin' / name)
        self.log = self.root / 'commands.jsonl'
        self.env = {'HOME': str(self.home), 'ZDOTDIR': str(self.home),
                    'PATH': os.pathsep.join([str(self.bin), '/usr/bin', '/bin']),
                    'COMMAND_LOG': str(self.log)}

    def executable(self, path):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(FAKE_COMMAND)
        path.chmod(0o700)

    def run_setup(self, platform='darwin', **environment):
        return subprocess.run([shutil.which('zsh'), '-f', '-c',
                               'OSTYPE=$1; source "$2"', 'setup-test', platform, str(self.script)],
                              cwd=self.repo, env={**self.env, **environment},
                              input='this must not reach a child prompt\n', capture_output=True,
                              text=True, timeout=20)

    def records(self):
        return [json.loads(line) for line in self.log.read_text().splitlines()]

    def test_brew_is_noninteractive_and_does_not_repeat_upgrade(self):
        result = self.run_setup()
        self.assertEqual(result.returncode, 0, result.stderr)
        commands = self.records()
        brew = [c for c in commands if c['command'] == 'brew']
        self.assertEqual([c['args'] for c in brew], [
            ['update'], ['upgrade', '--no-ask', '--no-quit'], ['cleanup'],
            ['bundle', 'install', '--no-upgrade', '--file', str(self.repo / 'Brewfile')]])
        for call in brew:
            self.assertEqual(call['no_ask'], '1')
            self.assertEqual(call['no_sudo'], '1')
            self.assertEqual(call['stdin'], '')
        self.assertTrue(all(c['git_prompt'] == '0' and c['gh_prompt'] == '1' for c in commands))
        self.assertEqual(commands[-1]['command'], 'pi')
        self.assertIsNone(commands[-1]['no_sudo'])

    def test_refresh_uses_fast_forward_only_without_changing_cwd(self):
        self.assertEqual(self.run_setup().returncode, 0)
        self.log.write_text('')
        result = self.run_setup()
        self.assertEqual(result.returncode, 0, result.stderr)
        git = [c for c in self.records() if c['command'] == 'git']
        self.assertGreater(len(git), 0)
        for call in git:
            self.assertEqual(call['args'][0], '-C')
            self.assertEqual(call['args'][2:], ['pull', '--ff-only'])
            self.assertEqual(call['cwd'], str(self.repo))

    def test_failed_upgrade_stops_setup(self):
        result = self.run_setup(FAIL_COMMAND='brew', FAIL_ARG='upgrade')
        self.assertEqual(result.returncode, 7, result.stderr)
        self.assertEqual(self.records()[-1]['args'][0], 'upgrade')

    def test_failed_plugin_update_does_not_continue_to_package_updates(self):
        self.assertEqual(self.run_setup().returncode, 0)
        self.log.write_text('')
        result = self.run_setup(FAIL_COMMAND='git', FAIL_ARG='pull')
        self.assertEqual(result.returncode, 7, result.stderr)
        self.assertFalse(any(c['command'] == 'brew' for c in self.records()))

    def test_optional_keyword_failures_still_continue(self):
        result = self.run_setup(FAIL_COMMAND='gh-nvim-email-keywords')
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn('email keyword generation failed', result.stdout)
        self.assertEqual(self.records()[-1]['command'], 'pi')

    def test_pi_update_failure_does_not_abort_setup(self):
        # pi refuses to self-update when the machine's install method does not
        # match the shared npmCommand setting. That is an install mismatch, not a
        # dotfiles failure, and it used to abort the run and report failure.
        result = self.run_setup(FAIL_COMMAND='pi')
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn('pi update failed; continuing', result.stdout)
        self.assertIn('updated pi and pi packages', result.stdout)

    def test_linux_sudo_cannot_prompt(self):
        result = self.run_setup(platform='linux', FAIL_COMMAND='sudo')
        self.assertEqual(result.returncode, 7, result.stderr)
        self.assertEqual(self.records()[-1]['command'], 'sudo')
        self.assertEqual(self.records()[-1]['args'][:2], ['-n', 'apt-get'])

    def apt_get_args(self):
        for record in self.records():
            if record['command'] == 'sudo' and record['args'][:2] == ['-n', 'apt-get']:
                return record['args']
        return None

    def test_arm64_installs_packages(self):
        # Debian 13 on arm64 has every package in the list; the amd64-only guard
        # used to skip the install entirely and leave the box without ripgrep.
        result = self.run_setup(platform='linux', FAKE_ARCH='arm64')
        self.assertNotIn('not a checked architecture', result.stdout)
        args = self.apt_get_args()
        self.assertIsNotNone(args, result.stdout + result.stderr)
        self.assertIn('ripgrep', args)
        self.assertIn('fzf', args)
        self.assertIn('bat', args)

    def test_ctags_uses_the_name_apt_knows(self):
        # exuberant-ctags is gone after Debian 12; naming it fails the whole
        # apt-get call, so the available package is probed first.
        result = self.run_setup(platform='linux', FAKE_ARCH='arm64')
        args = self.apt_get_args()
        self.assertIsNotNone(args, result.stdout + result.stderr)
        self.assertIn('universal-ctags', args)
        self.assertNotIn('exuberant-ctags', args)

    def test_missing_machine_local_prerequisites_are_reported(self):
        # These files cannot be shipped: they are per-machine or secret. Their
        # absence is silent elsewhere, which is why a machine missing the push
        # credential accumulated unread mail without anyone being told.
        result = self.run_setup()
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn('machine-local prerequisites missing', result.stdout)
        self.assertIn('agent-realm', result.stdout)
        self.assertIn('mcp.json', result.stdout)
        self.assertIn('Josh Status MCP credential', result.stdout)

    def test_present_machine_local_prerequisites_are_silent(self):
        (self.home / '.config').mkdir()
        (self.home / '.config/agent-realm').write_text('test-realm\n')
        (self.home / '.pi/agent').mkdir(parents=True)
        (self.home / '.pi/agent/mcp.json').write_text('{}')
        (self.home / '.claude.json').write_text(
            json.dumps({'mcpServers': {'josh-beckman-status': {'headers': {'Authorization': 'x'}}}}))
        result = self.run_setup()
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertNotIn('machine-local prerequisites missing', result.stdout)

    def test_push_credential_in_the_environment_suppresses_the_warning(self):
        (self.home / '.config').mkdir()
        (self.home / '.config/agent-realm').write_text('test-realm\n')
        (self.home / '.pi/agent').mkdir(parents=True)
        (self.home / '.pi/agent/mcp.json').write_text('{}')
        result = self.run_setup(PI_JOSH_STATUS_MCP_AUTHORIZATION='x')
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertNotIn('machine-local prerequisites missing', result.stdout)

    def test_bridge_restart_is_skipped_without_the_launch_agent(self):
        # Guarded by the plist's existence, so this never reaches launchctl on a
        # machine that does not supervise the bridge, nor inside this sandbox.
        result = self.run_setup()
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertNotIn('restarting the agent mail bridge', result.stdout)

    def test_unchecked_architecture_stops_before_apt(self):
        result = self.run_setup(platform='linux', FAKE_ARCH='riscv64')
        self.assertIn('not a checked architecture (riscv64)', result.stdout)
        self.assertIsNone(self.apt_get_args())


if __name__ == '__main__':
    unittest.main(verbosity=2)
