#!/usr/bin/env python3
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parents[1]
SOURCE = Path(os.environ.get('SETUP_UNDER_TEST', ROOT / 'setup'))
# Every plugin is pinned, so the fixture records one commit for all of them and the
# fake git reports it as the checkout's HEAD. A test that wants a moved pin runs
# setup with a different FAKE_GIT_HEAD.
PIN = '1' * 40
MOVED = '2' * 40
FAKE_COMMAND = '''#!/usr/bin/env python3
import json, os, pathlib, sys
name = pathlib.Path(sys.argv[0]).name
args = sys.argv[1:]
record = {'command': name, 'args': args, 'cwd': os.getcwd(),
          'no_ask': os.environ.get('HOMEBREW_NO_ASK'),
          'no_sudo': os.environ.get('HOMEBREW_NO_SUDO'),
          'git_prompt': os.environ.get('GIT_TERMINAL_PROMPT'),
          'gh_prompt': os.environ.get('GH_PROMPT_DISABLED')}
if name == 'brew':
    record['stdin'] = sys.stdin.read()
if name == 'dfm':
    # dfm cannot create this leaf directory itself, and chdir's into it without
    # checking, so setup has to have made it first.
    record['launchagents_exists'] = os.path.isdir(os.path.join(os.environ['HOME'], 'Library/LaunchAgents'))
with open(os.environ['COMMAND_LOG'], 'a') as f:
    f.write(json.dumps(record) + '\\n')
if name == 'git' and args[0] == 'clone':
    destination = pathlib.Path(args[-1])
    destination.mkdir(parents=True, exist_ok=True)
    (destination / '.git').mkdir(exist_ok=True)
elif name == 'git' and args[-1] == 'HEAD':
    print(os.environ.get('FAKE_GIT_HEAD', ''))
elif name == 'uname':
    print(os.environ.get('FAKE_UNAME_SM', 'Linux x86_64'))
elif name == 'curl':
    # -o is where the pinned download would land; nothing real is fetched, so the
    # file either stays empty or holds FAKE_CURL_BODY and cannot match a pin.
    if '-o' in args:
        pathlib.Path(args[args.index('-o') + 1]).write_text(os.environ.get('FAKE_CURL_BODY', ''))
elif name == 'lsb_release':
    print('Distributor ID: ubuntu')
elif name == 'dpkg':
    print(os.environ.get('FAKE_ARCH', 'amd64'))
elif name == 'gem':
    if args[:1] == ['list']:
        if os.environ.get('FAKE_GEM_HAS_TRY'):
            print('try-cli (1.10.1)')
    elif args[:1] == ['install'] and os.environ.get('FAKE_GEM_BINDIR') and name != os.environ.get('FAIL_COMMAND'):
        bindir = pathlib.Path(os.environ['FAKE_GEM_BINDIR'])
        bindir.mkdir(parents=True, exist_ok=True)
        target = bindir / 'try'
        target.write_text('#!/bin/sh\\nexit 0\\n')
        target.chmod(0o700)
elif name == 'df':
    # setup checks free space before a brew upgrade; the fake reports either a
    # healthy disk or a nearly full one.
    print('Filesystem 1024-blocks Used Available Capacity Mounted on')
    print('/dev/disk1s5 100000000 1 %s 1%% /' % os.environ.get('FAKE_FREE_KB', '99999999'))
elif name == 'ruby':
    print(os.environ.get('FAKE_GEM_BINDIR', ''))
if name == os.environ.get('FAIL_COMMAND') and (not os.environ.get('FAIL_ARG') or os.environ['FAIL_ARG'] in args):
    sys.exit(7)
'''


@unittest.skipUnless(shutil.which('zsh'), 'setup requires zsh')
class SetupTest(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='dotfiles-setup-test-')
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name).resolve()
        self.repo = self.root / 'dotfiles with spaces'
        self.home = self.root / 'home with spaces'
        self.bin = self.root / 'bin'
        self.bin.mkdir()
        (self.bin / 'python3').symlink_to(sys.executable)
        self.home.mkdir()
        self.repo.mkdir()
        self.script = self.repo / 'setup'
        shutil.copyfile(SOURCE, self.script)
        (self.repo / 'Brewfile').touch()
        (self.repo / '.config/nvim').mkdir(parents=True)
        for unit in ('dotfiles-refresh.service', 'dotfiles-refresh.timer'):
            target = self.repo / '.config/systemd/user' / unit
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text('[Unit]\n')
        # panad is a service rather than a timer, and it is enabled without being
        # started on a machine that has no pana config yet.
        (self.repo / '.config/systemd/user/panad.service').write_text('[Unit]\n')
        for path in ('.agents/AGENTS.md', '.agents/pi/settings.json', '.agents/pi/keybindings.json'):
            target = self.repo / path
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text('{}')
        for path in ('.agents/prompts', '.agents/skills'):
            (self.repo / path).mkdir()
        for name in ('git', 'brew', 'pi', 'gh', 'uname', 'lsb_release', 'dpkg', 'sudo', 'apt-cache',
                     'gem', 'ruby', 'curl', 'systemctl', 'df'):
            self.executable(self.bin / name)
        for name in ('dfm', 's', 'retire-agent-automation', 'gh-nvim-username-keywords', 'gh-nvim-labels-keywords',
                     'gh-nvim-repos-keywords', 'gh-nvim-email-keywords', 'agent-nvim-keywords'):
            self.executable(self.repo / 'bin' / name)
        self.log = self.root / 'commands.jsonl'
        self.gem_bindir = self.root / 'gem-bin'
        (self.root / 'tmp').mkdir()
        self.env = {'HOME': str(self.home), 'ZDOTDIR': str(self.home),
                    'PATH': os.pathsep.join([str(self.bin), '/usr/bin', '/bin']),
                    'TMPDIR': str(self.root / 'tmp'),
                    'FAKE_GIT_HEAD': PIN,
                    'COMMAND_LOG': str(self.log), 'FAKE_GEM_BINDIR': str(self.gem_bindir)}
        self.write_lock(re.findall(r'^\s*git_clone_or_update (\S+)', self.script.read_text(), re.M))
        # The real tools.lock, so the installers are asked for the release and digest
        # they will actually be asked for on this architecture.
        shutil.copyfile(ROOT / 'tools.lock', self.repo / 'tools.lock')

    def write_lock(self, urls):
        """Write the fixture's plugins.lock: one pinned commit per repository."""
        lines = ['# fixture pins'] + ['%s  %s' % (PIN, url) for url in urls]
        (self.repo / 'plugins.lock').write_text('\n'.join(lines) + '\n')

    def executable(self, path):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(FAKE_COMMAND)
        path.chmod(0o700)

    def run_setup(self, platform='darwin', **environment):
        return subprocess.run([shutil.which('zsh'), '-f', '-c',
                               'OSTYPE=$1; source "$2"', 'setup-test', platform, str(self.script)],
                              cwd=self.repo, env={**self.env, **environment},
                              input='this must not reach a child prompt\n', capture_output=True,
                              text=True, timeout=120)

    def records(self):
        return [json.loads(line) for line in self.log.read_text().splitlines()]

    def test_brew_is_noninteractive_and_does_not_repeat_upgrade(self):
        result = self.run_setup()
        self.assertEqual(result.returncode, 0, result.stderr)
        commands = self.records()
        brew = [c for c in commands if c['command'] == 'brew']
        self.assertEqual([c['args'] for c in brew], [
            ['update'], ['cleanup'], ['upgrade', '--no-ask', '--no-quit'], ['cleanup'],
            ['bundle', 'install', '--no-upgrade', '--file', str(self.repo / 'Brewfile')]])
        for call in brew:
            self.assertEqual(call['no_ask'], '1')
            self.assertEqual(call['no_sudo'], '1')
            self.assertEqual(call['stdin'], '')
        self.assertTrue(all(c['git_prompt'] == '0' and c['gh_prompt'] == '1' for c in commands))
        self.assertEqual(commands[-1]['command'], 'pi')
        self.assertIsNone(commands[-1]['no_sudo'])

    def test_plugins_are_checked_out_at_their_pins_and_never_pulled(self):
        # A pull would fast-forward the checkout to upstream HEAD, which is how
        # unreviewed plugin code used to arrive every two hours.
        result = self.run_setup()
        self.assertEqual(result.returncode, 0, result.stderr)
        git = [c for c in self.records() if c['command'] == 'git']
        self.assertGreater(len(git), 0)
        clones = [c for c in git if c['args'][0] == 'clone']
        self.assertTrue(clones, result.stdout)
        for call in clones:
            self.assertIn('--no-checkout', call['args'])
        for call in git:
            if call['args'][0] == 'clone':
                continue
            self.assertEqual(call['args'][0], '-C')
            self.assertIn(call['args'][2], ('fetch', 'checkout', 'rev-parse'))
            self.assertEqual(call['cwd'], str(self.repo))
        checkouts = [c['args'] for c in git if c['args'][2:3] == ['checkout']]
        self.assertTrue(checkouts)
        for args in checkouts:
            self.assertEqual(args[-1], PIN)
            self.assertIn('--detach', args)

    def test_a_pinned_checkout_is_left_alone_on_the_next_run(self):
        self.assertEqual(self.run_setup().returncode, 0)
        self.log.write_text('')
        result = self.run_setup()
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertFalse([c for c in self.records()
                          if c['command'] == 'git' and any(
                              word in c['args'] for word in ('clone', 'checkout', 'fetch'))])

    def test_a_moved_checkout_is_reported_then_pinned_again(self):
        self.assertEqual(self.run_setup().returncode, 0)
        self.log.write_text('')
        result = self.run_setup(FAKE_GIT_HEAD=MOVED)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn('plugin changed: zsh-syntax-highlighting %s -> %s' % (MOVED, PIN),
                      result.stdout)
        checkouts = [c['args'] for c in self.records()
                     if c['command'] == 'git' and c['args'][2:3] == ['checkout']]
        self.assertTrue(checkouts)
        self.assertTrue(all(args[-1] == PIN for args in checkouts), checkouts)

    def test_a_repository_without_a_pin_stops_setup(self):
        (self.repo / 'plugins.lock').write_text('')
        result = self.run_setup()
        self.assertNotEqual(result.returncode, 0, result.stdout)
        self.assertIn('no pinned commit for https://github.com/val-town/plugins', result.stderr)
        self.assertFalse([c for c in self.records()
                          if c['command'] == 'git' and c['args'][0] == 'clone'])
        self.assertFalse(any(c['command'] == 'brew' for c in self.records()))

    def test_the_checksum_guard_accepts_a_match_and_rejects_anything_else(self):
        # Both installers lean on this, and the fixture cannot produce a download
        # that matches a pinned digest, so the guard is checked directly.
        artifact = self.root / 'artifact.tar.gz'
        artifact.write_text('pinned\n')
        digest = hashlib.sha256(artifact.read_bytes()).hexdigest()
        self.assertEqual(self.verify_sha256(artifact, digest).returncode, 0)
        wrong = self.verify_sha256(artifact, '0' * 64)
        self.assertNotEqual(wrong.returncode, 0)
        self.assertIn('checksum mismatch', wrong.stderr)

    def verify_sha256(self, artifact, expected):
        text = (self.repo / 'setup').read_text()
        start = text.index('function verify_sha256()')
        function = text[start:text.index('\n}\n', start) + 3]
        script = self.root / 'verify.zsh'
        script.write_text(function + '\nverify_sha256 "$1" "$2"\n')
        return subprocess.run([shutil.which('zsh'), '-f', str(script), str(artifact), expected],
                              capture_output=True, text=True, timeout=120)

    def test_s_comes_from_a_pinned_checksummed_release(self):
        (self.repo / 'bin/s').unlink()
        result = self.run_setup(platform='linux-gnu')
        # The download cannot match the pinned digest, so setup stops instead of
        # installing the binary that unwraps every secret.
        self.assertNotEqual(result.returncode, 0, result.stdout)
        curls = [' '.join(c['args']) for c in self.records() if c['command'] == 'curl']
        self.assertTrue(any('tobi/s/releases/download/v0.9.5/s-v0.9.5-x86_64-unknown-linux-musl.tar.gz'
                            in line for line in curls), curls)
        self.assertIn('checksum mismatch', result.stderr)
        self.assertFalse((self.repo / 'bin/s').exists())

    def test_s_without_a_pin_is_never_installed(self):
        (self.repo / 'bin/s').unlink()
        (self.repo / 'tools.lock').write_text('')
        result = self.run_setup(platform='linux-gnu')
        self.assertNotEqual(result.returncode, 0, result.stdout)
        self.assertIn('no s pin for x86_64-unknown-linux-musl in tools.lock', result.stderr)
        self.assertFalse([c for c in self.records() if c['command'] == 'curl'])
        self.assertFalse((self.repo / 'bin/s').exists())

    def test_failed_upgrade_stops_setup(self):
        result = self.run_setup(FAIL_COMMAND='brew', FAIL_ARG='upgrade')
        self.assertEqual(result.returncode, 7, result.stderr)
        self.assertEqual(self.records()[-1]['args'][0], 'upgrade')

    def test_low_disk_space_stops_before_any_brew_write(self):
        # A pour that runs out of space reports it once per archive member. The
        # guard turns that into one message naming the command that reclaims.
        result = self.run_setup(FAKE_FREE_KB='1024')
        self.assertNotEqual(result.returncode, 0, result.stdout)
        self.assertIn('free-space', result.stderr)
        self.assertFalse(any(c['command'] == 'brew' for c in self.records()))

    def test_failed_plugin_checkout_does_not_continue_to_package_updates(self):
        # A plugin that cannot be put on its pinned commit stops the run, so a
        # package upgrade never happens on top of a half-installed editor.
        result = self.run_setup(FAIL_COMMAND='git', FAIL_ARG='checkout')
        self.assertEqual(result.returncode, 7, result.stderr)
        self.assertFalse(any(c['command'] == 'brew' for c in self.records()))

    def test_optional_keyword_failures_still_continue(self):
        result = self.run_setup(FAIL_COMMAND='gh-nvim-email-keywords')
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn('email keyword generation failed', result.stdout)
        self.assertEqual(self.records()[-1]['command'], 'pi')

    def test_pi_update_failure_does_not_abort_setup(self):
        # pi refuses to self-update when the machine's install method does not
        # match the shared npmCommand setting. That is an install mismatch, not a
        # dotfiles failure, and it used to abort the run and report failure.
        result = self.run_setup(FAIL_COMMAND='pi')
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn('pi update failed; continuing', result.stdout)
        self.assertIn('updated pi and pi packages', result.stdout)

    def test_linux_sudo_cannot_prompt(self):
        result = self.run_setup(platform='linux', FAIL_COMMAND='sudo')
        self.assertEqual(result.returncode, 7, result.stderr)
        self.assertEqual(self.records()[-1]['command'], 'sudo')
        self.assertEqual(self.records()[-1]['args'][:2], ['-n', 'apt-get'])

    def apt_get_args(self):
        for record in self.records():
            if record['command'] == 'sudo' and record['args'][:2] == ['-n', 'apt-get']:
                return record['args']
        return None

    def test_arm64_installs_packages(self):
        # Debian 13 on arm64 has every package in the list; the amd64-only guard
        # used to skip the install entirely and leave the box without ripgrep.
        result = self.run_setup(platform='linux', FAKE_ARCH='arm64')
        self.assertNotIn('not a checked architecture', result.stdout)
        args = self.apt_get_args()
        self.assertIsNotNone(args, result.stdout + result.stderr)
        self.assertIn('ripgrep', args)
        self.assertIn('fzf', args)
        self.assertIn('bat', args)
        # .gitconfig sets delta as the pager; the Brewfile covers macOS only.
        self.assertIn('git-delta', args)

    def test_ctags_uses_the_name_apt_knows(self):
        # exuberant-ctags is gone after Debian 12; naming it fails the whole
        # apt-get call, so the available package is probed first.
        result = self.run_setup(platform='linux', FAKE_ARCH='arm64')
        args = self.apt_get_args()
        self.assertIsNotNone(args, result.stdout + result.stderr)
        self.assertIn('universal-ctags', args)
        self.assertNotIn('exuberant-ctags', args)

    def test_retirement_runs_before_dfm(self):
        result = self.run_setup()
        self.assertEqual(result.returncode, 0, result.stderr)
        calls = [c['command'] for c in self.records()]
        self.assertLess(calls.index('retire-agent-automation'), calls.index('dfm'))
        self.assertNotIn('machine-local prerequisites missing', result.stdout)
        self.assertNotIn('restarting the agent mail bridge', result.stdout)

    def test_retirement_failure_stops_setup(self):
        result = self.run_setup(FAIL_COMMAND='retire-agent-automation')
        self.assertEqual(result.returncode, 7, result.stderr)
        self.assertFalse(any(c['command'] == 'dfm' for c in self.records()))

    def test_unchecked_architecture_stops_before_apt(self):
        result = self.run_setup(platform='linux', FAKE_ARCH='riscv64')
        self.assertIn('not a checked architecture (riscv64)', result.stdout)
        self.assertIsNone(self.apt_get_args())

    def test_val_town_plugin_is_cloned(self):
        result = self.run_setup(platform='linux', FAKE_ARCH='arm64')
        self.assertEqual(result.returncode, 0, result.stderr)
        clones = [c for c in self.records() if c['command'] == 'git' and c['args'][:1] == ['clone']]
        self.assertTrue(any('val-town/plugins' in ' '.join(c['args']) for c in clones), result.stdout)

    def test_deno_comes_from_a_pinned_checksummed_release(self):
        # Deno's own installer is a curl | sh of a script that resolves "latest"
        # when it runs, so the release zip is fetched at a pinned version instead,
        # and the empty fixture download proves the checksum stops it.
        result = self.run_setup(platform='linux-gnu')
        self.assertEqual(result.returncode, 0, result.stderr)
        curls = [' '.join(c['args']) for c in self.records() if c['command'] == 'curl']
        self.assertTrue(any('denoland/deno/releases/download/v2.9.8/deno-x86_64-unknown-linux-gnu.zip'
                            in line for line in curls), curls)
        self.assertFalse([line for line in curls if 'deno.land/install.sh' in line], curls)
        self.assertIn('checksum mismatch', result.stderr)
        self.assertIn('Deno install failed; continuing', result.stdout)
        self.assertFalse((self.home / '.deno/bin/deno').exists())
        self.assertEqual([c for c in self.records() if c['command'] == 'deno'], [])

    def test_deno_without_a_pin_is_reported_and_skipped(self):
        (self.repo / 'tools.lock').write_text('')
        result = self.run_setup(platform='linux-gnu')
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn('no Deno pin for x86_64-unknown-linux-gnu in tools.lock', result.stdout)
        self.assertFalse([c for c in self.records() if c['command'] == 'curl'])

    def test_try_is_installed_and_linked_into_local_bin(self):
        result = self.run_setup(platform='linux', FAKE_ARCH='arm64')
        self.assertEqual(result.returncode, 0, result.stderr)
        installs = [c for c in self.records() if c['command'] == 'gem' and c['args'][:1] == ['install']]
        self.assertEqual(len(installs), 1)
        self.assertIn('--user-install', installs[0]['args'])
        link = self.home / '.local/bin/try'
        self.assertTrue(link.is_symlink(), result.stdout + result.stderr)
        self.assertEqual(os.readlink(link), str(self.gem_bindir / 'try'))

    def test_try_install_is_skipped_when_already_installed(self):
        self.gem_bindir.mkdir(parents=True)
        (self.gem_bindir / 'try').write_text('#!/bin/sh\nexit 0\n')
        (self.gem_bindir / 'try').chmod(0o700)
        result = self.run_setup(platform='linux', FAKE_ARCH='arm64', FAKE_GEM_HAS_TRY='1')
        self.assertEqual(result.returncode, 0, result.stderr)
        installs = [c for c in self.records() if c['command'] == 'gem' and c['args'][:1] == ['install']]
        self.assertEqual(installs, [])
        self.assertTrue((self.home / '.local/bin/try').is_symlink())

    def test_failed_try_install_does_not_abort_setup(self):
        result = self.run_setup(platform='linux', FAKE_ARCH='arm64',
                                FAIL_COMMAND='gem', FAIL_ARG='install')
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn('try install failed; continuing', result.stdout)

    def test_dfm_runs_after_the_launchagents_directory_exists(self):
        # Without this, dfm's mkdir fails on Linux and its chdir leaves it in $HOME,
        # so the three plists were linked into the home directory as dangling
        # symlinks instead of into the directory they were built for.
        result = self.run_setup(platform='linux-gnu')
        self.assertEqual(result.returncode, 0, result.stderr)
        dfm = [c for c in self.records() if c['command'] == 'dfm']
        self.assertEqual([c['args'] for c in dfm], [['install']])
        self.assertTrue(dfm[0]['launchagents_exists'],
                        'dfm ran before ~/Library/LaunchAgents existed')
        self.assertTrue((self.home / 'Library/LaunchAgents').is_dir())

    def test_linux_links_and_enables_the_refresh_timer(self):
        # The Mac gets this schedule from launchd via dfm; Linux has to get it
        # here, and a linked unit that is never enabled does nothing.
        result = self.run_setup(platform='linux-gnu')
        self.assertEqual(result.returncode, 0, result.stderr)
        for unit in ('dotfiles-refresh.service', 'dotfiles-refresh.timer'):
            link = self.home / '.config/systemd/user' / unit
            self.assertTrue(link.is_symlink(), f'{unit} was not linked')
            self.assertEqual(os.readlink(link), str(self.repo / '.config/systemd/user' / unit))
        systemctl = [c['args'] for c in self.records() if c['command'] == 'systemctl']
        self.assertIn(['--user', 'daemon-reload'], systemctl)
        self.assertIn(['--user', 'enable', '--now', 'dotfiles-refresh.timer'], systemctl)

    def test_linux_links_and_enables_panad_without_starting_it_unconfigured(self):
        # panad restarts on failure, so starting it before pana has a config.json
        # would be a restart loop rather than a working service.
        result = self.run_setup(platform='linux-gnu')
        self.assertEqual(result.returncode, 0, result.stderr)
        link = self.home / '.config/systemd/user/panad.service'
        self.assertTrue(link.is_symlink(), 'panad.service was not linked')
        self.assertEqual(os.readlink(link), str(self.repo / '.config/systemd/user/panad.service'))
        systemctl = [c['args'] for c in self.records() if c['command'] == 'systemctl']
        self.assertIn(['--user', 'enable', 'panad.service'], systemctl)
        self.assertFalse([a for a in systemctl
                          if a[-1] == 'panad.service' and any(w in a for w in ('start', 'restart'))],
                         'panad was started before pana had a config')

    def test_linux_restarts_a_configured_panad(self):
        state = self.home / '.local/state/pana'
        state.mkdir(parents=True)
        (state / 'config.json').write_text('{"domain":"test.example","user":"tester"}')
        result = self.run_setup(platform='linux-gnu')
        self.assertEqual(result.returncode, 0, result.stderr)
        systemctl = [c['args'] for c in self.records() if c['command'] == 'systemctl']
        self.assertIn(['--user', 'restart', 'panad.service'], systemctl)

    def test_mac_does_not_install_the_linux_timer(self):
        result = self.run_setup()
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual([c for c in self.records() if c['command'] == 'systemctl'], [])
        self.assertFalse((self.home / '.config/systemd/user').exists())

    def test_linux_without_a_user_bus_still_succeeds(self):
        # A container or WSL without systemd has no user bus. Saying so is right;
        # failing the whole refresh over a schedule it cannot install is not.
        result = self.run_setup(platform='linux-gnu', FAIL_COMMAND='systemctl')
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn('enable dotfiles-refresh.timer', result.stdout)
        self.assertNotIn('agent-mail-verify.timer by hand', result.stdout)
        link = self.home / '.config/systemd/user/dotfiles-refresh.timer'
        self.assertTrue(link.is_symlink(), result.stdout + result.stderr)


if __name__ == '__main__':
    unittest.main(verbosity=2)
