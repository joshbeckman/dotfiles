#!/usr/bin/env bash
set -euo pipefail

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
command="$root/bin/agent-mail2"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
unset AGENT_SCRATCHPAD AGENT_HANDLE AGENT_MAIL2_HUMAN AGENT_MAIL_FROM AGENT_SCRATCH_ROOT
export AGENT_MAIL2_DB="$tmp/mail.sqlite3"
# Recipients resolve to scratchpads, as in agent-mail, so the fixture pads live in $tmp.
export AGENT_MAIL_ROOT="$tmp" AGENT_HUMAN_MAIL_ROOT="$tmp/humans" AGENT_IDENTITIES_DIR="$tmp/identities"
mkdir -p "$tmp"/{alice-agent-11111111,bob-agent-22222222,ok-agent-55555555,boom-agent-44444444,identities}

# GNU stat answers -f %Lp with a filesystem dump and exits 0, so the BSD form cannot be
# tried first; probe the flavor once.
if stat -c %a . >/dev/null 2>&1; then
  mode() { stat -c %a "$1"; }
else
  mode() { stat -f %Lp "$1"; }
fi

[[ -x "$command" ]]
"$command" init >/dev/null
[[ -f "$AGENT_MAIL2_DB" ]]
[[ "$(mode "$AGENT_MAIL2_DB")" == 600 ]]

receipt_state() {
  "$command" receipt "$1" | awk -F '\t' -v recipient="$2" '$3 == "to:" recipient { print $1 }'
}

root_id="$(AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send \
  --to bob-agent-22222222 --subject 'Coordinate work' --body 'I will own file A.')"
[[ "$($command head "$root_id")" == "$root_id" ]]
# A ULID and a slug of the subject, from the same helper the shell tool uses.
[[ "$root_id" =~ ^[0-9A-HJKMNP-TV-Z]{26}-coordinate-work$ ]]

scan="$($command scan --to bob-agent-22222222)"
grep -Fq "$root_id" <<<"$scan"
grep -Fq 'seq:1' <<<"$scan"

peek="$tmp/peek"
hint="$tmp/hint"
"$command" read --to bob-agent-22222222 --peek >"$peek" 2>"$hint"
grep -Fxq 'Thread-Sequence: 1' "$peek"
grep -Fq -- "--if-head $root_id" "$hint"
[[ "$(receipt_state "$root_id" bob-agent-22222222)" == unread ]]

"$command" read --to bob-agent-22222222 >/dev/null 2>/dev/null
[[ "$(receipt_state "$root_id" bob-agent-22222222)" == read ]]
read_at_before="$(python3 - "$AGENT_MAIL2_DB" "$root_id" <<'PY'
import sqlite3, sys
print(sqlite3.connect(sys.argv[1]).execute("select read_at from deliveries where message_id = ?", (sys.argv[2],)).fetchone()[0])
PY
)"
"$command" read --to bob-agent-22222222 --id "$root_id" >/dev/null 2>/dev/null
read_at_after="$(python3 - "$AGENT_MAIL2_DB" "$root_id" <<'PY'
import sqlite3, sys
print(sqlite3.connect(sys.argv[1]).execute("select read_at from deliveries where message_id = ?", (sys.argv[2],)).fetchone()[0])
PY
)"
[[ "$read_at_before" == "$read_at_after" ]]
[[ "$($command head "$root_id")" == "$root_id" ]]
read_scan="$($command scan --to bob-agent-22222222 --state read --from alice-agent-11111111 --contains 'own file A')"
grep -Fq "$root_id" <<<"$read_scan"
grep -Fq 'state:read' <<<"$read_scan"
if "$command" scan --to bob-agent-22222222 --state unread | grep -Fq "$root_id"; then
  echo 'read message remained in unread scan' >&2
  exit 1
fi

reply1="$(AGENT_SCRATCHPAD="$tmp/bob-agent-22222222" "$command" send \
  --reply-all "$root_id" --if-head "$root_id" --body 'I saw the claim and will take file B.')"
[[ "$($command head "$root_id")" == "$reply1" ]]
[[ "$($command receipt "$reply1" | wc -l | tr -d ' ')" == 1 ]]
[[ "$(receipt_state "$reply1" alice-agent-11111111)" == unread ]]

printf 'stale but preserved\n' >"$tmp/stale-body"
set +e
AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send \
  --reply-all "$root_id" --if-head "$root_id" --body-file "$tmp/stale-body" \
  >"$tmp/stale-out" 2>"$tmp/stale-error"
status=$?
set -e
[[ "$status" == 3 ]]
grep -Fq 'stale-thread' "$tmp/stale-error"
grep -Fq "current head $reply1" "$tmp/stale-error"
grep -Fxq 'stale but preserved' "$tmp/stale-body"
[[ "$($command head "$root_id")" == "$reply1" ]]
[[ "$($command thread "$root_id" | grep -c '^Message-ID:')" == 2 ]]

reply2="$(AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send \
  --reply-all "$reply1" --if-head "$reply1" --body-file "$tmp/stale-body")"
[[ "$($command head "$root_id")" == "$reply2" ]]

thread="$tmp/thread"
"$command" thread "$root_id" >"$thread"
[[ "$(grep -c '^Message-ID:' "$thread")" == 3 ]]
grep -Fxq 'Thread-Sequence: 1' "$thread"
grep -Fxq 'Thread-Sequence: 2' "$thread"
grep -Fxq 'Thread-Sequence: 3' "$thread"
grep -Fxq "In-Reply-To: $reply1" "$thread"
grep -Fxq 'stale but preserved' "$thread"
[[ "$($command scan --to bob-agent-22222222 --state all --thread "$root_id" | grep -c "thread:$root_id")" == 2 ]]

# Contending writers observing one head produce exactly one append and stale rejections.
race_root="$(AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send --to josh --body 'race root')"
pids=()
for i in $(seq 1 8); do
  (
    while [[ ! -e "$tmp/race-gate" ]]; do sleep 0.01; done
    set +e
    writer="$(printf 'writer-agent-%08x' "$i")"
    AGENT_SCRATCHPAD="$tmp/$writer" "$command" send --thread "$race_root" \
      --to josh --if-head "$race_root" --body "writer $i" >"$tmp/race-$i-out" 2>"$tmp/race-$i-err"
    echo $? >"$tmp/race-$i-status"
  ) &
  pids+=("$!")
done
touch "$tmp/race-gate"
for pid in "${pids[@]}"; do wait "$pid"; done
[[ "$(grep -l '^0$' "$tmp"/race-*-status | wc -l | tr -d ' ')" == 1 ]]
[[ "$(grep -l '^3$' "$tmp"/race-*-status | wc -l | tr -d ' ')" == 7 ]]
race_thread="$($command thread "$race_root")"
[[ "$(grep -c '^Message-ID:' <<<"$race_thread")" == 2 ]]
grep -Fxq 'Thread-Sequence: 1' <<<"$race_thread"
grep -Fxq 'Thread-Sequence: 2' <<<"$race_thread"

# Any failure during fanout rolls back the thread, message, mailboxes, and deliveries.
python3 - "$AGENT_MAIL2_DB" <<'PY'
import sqlite3, sys
con = sqlite3.connect(sys.argv[1])
con.execute("""create trigger reject_boom before insert on deliveries
when new.recipient_mailbox_id = 'boom-agent-44444444'
begin select raise(abort, 'forced delivery failure'); end""")
con.commit()
PY
before_counts="$(python3 - "$AGENT_MAIL2_DB" <<'PY'
import sqlite3, sys
con = sqlite3.connect(sys.argv[1])
print(*(con.execute(f"select count(*) from {table}").fetchone()[0] for table in ('threads','messages','mailboxes','deliveries')))
PY
)"
set +e
AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send \
  --to ok-agent-55555555,boom-agent-44444444 --body fail >"$tmp/rollback-out" 2>"$tmp/rollback-err"
rollback_status=$?
set -e
[[ "$rollback_status" == 1 ]]
grep -Fq 'forced delivery failure' "$tmp/rollback-err"
after_counts="$(python3 - "$AGENT_MAIL2_DB" <<'PY'
import sqlite3, sys
con = sqlite3.connect(sys.argv[1])
con.execute("drop trigger reject_boom")
con.commit()
print(*(con.execute(f"select count(*) from {table}").fetchone()[0] for table in ('threads','messages','mailboxes','deliveries')))
PY
)"
[[ "$before_counts" == "$after_counts" ]]

multi="$(AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send \
  --to bob-agent-22222222,josh --subject 'Two recipients' --body 'Same ledger event.')"
[[ "$(receipt_state "$multi" bob-agent-22222222)" == unread ]]
[[ "$(receipt_state "$multi" josh)" == unread ]]
multi_reply="$(AGENT_SCRATCHPAD="$tmp/bob-agent-22222222" "$command" send \
  --reply-all "$multi" --if-head "$multi" --body 'reply to both')"
[[ "$(receipt_state "$multi_reply" alice-agent-11111111)" == unread ]]
[[ "$(receipt_state "$multi_reply" josh)" == unread ]]
[[ "$($command receipt "$multi_reply" | wc -l | tr -d ' ')" == 2 ]]
"$command" read --to josh --id "$multi" >/dev/null 2>/dev/null
[[ "$(receipt_state "$multi" josh)" == read ]]
[[ "$(receipt_state "$multi" bob-agent-22222222)" == unread ]]
"$command" discard --to bob-agent-22222222 --id "$multi"
[[ "$(receipt_state "$multi" bob-agent-22222222)" == discarded ]]
[[ "$(receipt_state "$multi" josh)" == read ]]
if "$command" scan --to bob-agent-22222222 | grep -Fq "$multi"; then
  echo 'discarded delivery remained in unread scan' >&2
  exit 1
fi
if "$command" read --to bob-agent-22222222 --id "$multi" >/dev/null 2>&1; then
  echo 'discarded delivery remained readable' >&2
  exit 1
fi

python3 - "$AGENT_MAIL2_DB" "$reply2" <<'PY'
import sqlite3, sys, time
con = sqlite3.connect(sys.argv[1])
assert con.execute("select body from messages where message_id = ?", (sys.argv[2],)).fetchone()[0] == "stale but preserved\n"
assert con.execute("select typeof(sent_at) from messages limit 1").fetchone()[0] == "integer"
sent = con.execute("select sent_at from messages order by sent_at limit 1").fetchone()[0]
assert 1_000_000_000_000_000 < sent <= int(time.time() * 1_000_000) + 5_000_000
assert con.execute("select count(*) from sqlite_master where type='table' and name in ('mailboxes','threads','messages','message_recipients','deliveries')").fetchone()[0] == 5
assert con.execute("select count(*) from sqlite_master where type='index' and name='messages_thread_sequence'").fetchone()[0] == 1
# The mutable state points at the immutable audience, so a delivery cannot exist without one.
assert "FOREIGN KEY" in con.execute("select sql from sqlite_master where name='deliveries'").fetchone()[0].upper()
assert con.execute("select count(*) from sqlite_master where type='trigger' and name in ('messages_no_update','messages_no_delete')").fetchone()[0] == 2
try:
    con.execute("update messages set body = 'tampered'")
except sqlite3.IntegrityError as error:
    assert "append-only" in str(error)
else:
    raise AssertionError("message ledger accepted an update")
# The audience is as immutable as the message: the recipient list is part of it.
try:
    con.execute("update message_recipients set recipient_mailbox_id = 'mallory-agent-99999999'")
except sqlite3.IntegrityError as error:
    assert "append-only" in str(error)
else:
    raise AssertionError("recipient list accepted an update")
assert con.execute("pragma journal_mode").fetchone()[0] == "wal"
assert con.execute("pragma user_version").fetchone()[0] == 4
PY

grep -Eq '^Date: [0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$' "$thread"

expect_failure() {
  local expected="$1"; shift
  set +e
  "$@" >"$tmp/failure-out" 2>"$tmp/failure-err"
  local actual=$?
  set -e
  [[ "$actual" == "$expected" ]]
}

expect_failure 1 "$command" send --to bob-agent-22222222 --body nope
grep -Fq 'cannot determine sender' "$tmp/failure-err"
human_message="$(AGENT_MAIL2_HUMAN=josh "$command" send --to bob-agent-22222222 --body 'human message')"
"$command" thread "$human_message" | grep -Fxq 'From: josh'
expect_failure 1 env AGENT_SCRATCHPAD="$tmp/josh" "$command" send --to bob-agent-22222222 --body nope
grep -Fq 'invalid derived agent identity: josh' "$tmp/failure-err"
# A service with no scratchpad, such as pr-monitor, sends under its own name, as in agent-mail.
service="$("$command" send --from pr-monitor --to bob-agent-22222222 -m 'CI is green')"
"$command" thread "$service" | grep -Fxq 'From: pr-monitor'
# Without --if-head an existing-thread send appends at the head instead of failing.
unguarded="$(AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send --thread "$root_id" --to josh --body 'late note')"
[[ "$($command head "$root_id")" == "$unguarded" ]]
expect_failure 3 env AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send --thread "$root_id" --to josh --if-head none --body nope
grep -Fq 'stale-thread' "$tmp/failure-err"
expect_failure 1 env AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send --to josh --if-head bogus --body nope
grep -Fq 'new thread has no head' "$tmp/failure-err"
expect_failure 1 env AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send --to josh --subject $'bad\nsubject' --body nope
grep -Fq 'control characters' "$tmp/failure-err"
expect_failure 1 env AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send --to 'bad/address' --body nope
grep -Fq 'invalid mailbox address' "$tmp/failure-err"
expect_failure 1 env AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send --reply-all "$root_id" --to josh --if-head "$reply2" --body nope
grep -Fq 'mutually exclusive' "$tmp/failure-err"
expect_failure 1 env AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send --to josh --body x --body-file "$tmp/stale-body"
grep -Fq 'mutually exclusive' "$tmp/failure-err"

# An override inside an existing directory must not chmod that directory.
mkdir "$tmp/override-parent"
chmod 755 "$tmp/override-parent"
AGENT_MAIL2_DB="$tmp/override-parent/mail.sqlite3" "$command" init >/dev/null
[[ "$(mode "$tmp/override-parent")" == 755 ]]

# Refuse a final database path that is a symlink.
touch "$tmp/target.sqlite3"
ln -s "$tmp/target.sqlite3" "$tmp/link.sqlite3"
expect_failure 1 env AGENT_MAIL2_DB="$tmp/link.sqlite3" "$command" init
grep -Fq 'must not be a symlink' "$tmp/failure-err"

# Visibility: public by default, so a non-member can find and read it.
pub_thread="$(AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send --to bob-agent-22222222 --subject 'public topic' --body 'open')"
priv_thread="$(AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send --private --to bob-agent-22222222 --subject 'private topic' --body 'closed')"
carol="$tmp/carol-agent-33333333"
search="$(AGENT_SCRATCHPAD="$carol" "$command" search topic)"
grep -Fq "$pub_thread" <<<"$search"
! grep -Fq "$priv_thread" <<<"$search"
AGENT_SCRATCHPAD="$carol" "$command" thread "$pub_thread" >/dev/null
expect_failure 1 env AGENT_SCRATCHPAD="$carol" "$command" thread "$priv_thread"
grep -Fq 'is private' "$tmp/failure-err"
expect_failure 1 env AGENT_SCRATCHPAD="$carol" "$command" publish "$priv_thread"
grep -Fq 'not a member' "$tmp/failure-err"
[[ "$(AGENT_SCRATCHPAD="$tmp/bob-agent-22222222" "$command" publish "$priv_thread")" == "$priv_thread"$'\tpublic' ]]
AGENT_SCRATCHPAD="$carol" "$command" thread "$priv_thread" >/dev/null
expect_failure 1 env AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send --private \
  --thread "$pub_thread" --to bob-agent-22222222 --if-head "$pub_thread" --body nope
grep -Fq 'visibility is fixed at creation' "$tmp/failure-err"

# Databases from before the v3 schema were never created, so they are refused, not upgraded.
old_db="$tmp/old.sqlite3"
python3 -c 'import sqlite3, sys; db = sqlite3.connect(sys.argv[1]); db.execute("PRAGMA user_version = 2"); db.commit()' "$old_db"
expect_failure 1 env AGENT_MAIL2_DB="$old_db" "$command" init
grep -Fq 'unsupported schema version 2' "$tmp/failure-err"

# Addresses resolve the way agent-mail resolves them, so every spelling reaches one mailbox.
# The registry claim names a session; the pad is <name>-<first 8 of the session>.
v1="$root/bin/agent-mail"
printf '01a1aaaa-0000-7000-8000-000000000001\n' >"$tmp/identities/dana-miller-of-testrealm"
mkdir -p "$tmp/dana-miller-of-testrealm-01a1aaaa" "$tmp/erin-agent-01a1bbbb" "$tmp/humans/josh"
for address in @+dana-miller-of-testrealm dana-miller-of-testrealm dana-miller \
  dana-miller-of-testrealm-01a1aaaa @+erin-agent-of-testrealm erin-agent erin-agent-01a1bbbb \
  bob-agent-22222222 @+bob-agent josh @josh humans/josh josh@example.com; do
  expected="$(basename "$(dirname "$("$v1" addr "$address")")")"
  actual="$("$command" resolve "$address" | cut -f2)"
  [[ "$actual" == "$expected" ]] || { echo "resolve $address: $actual, agent-mail says $expected" >&2; exit 1; }
done

dana="$tmp/dana-miller-of-testrealm-01a1aaaa"
by_handle="$(AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send --to @+dana-miller-of-testrealm \
  --subject 'Handle form' --body 'sent to the documented handle')"
AGENT_SCRATCHPAD="$dana" "$command" scan | grep -Fq "$by_handle"
[[ "$(receipt_state "$by_handle" dana-miller-of-testrealm-01a1aaaa)" == unread ]]
# A bare AGENT_HANDLE finds its own pad too, so it reads the same inbox.
AGENT_HANDLE=dana-miller-of-testrealm "$command" scan | grep -Fq "$by_handle"

# A recipient with no scratchpad is refused, and nothing is written.
counts() {
  python3 - "$AGENT_MAIL2_DB" <<'PY'
import sqlite3, sys
con = sqlite3.connect(sys.argv[1])
print(*(con.execute(f"select count(*) from {table}").fetchone()[0] for table in ('threads','messages','mailboxes','deliveries')))
PY
}
before="$(counts)"
expect_failure 1 env AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send \
  --to bob-agent-22222222,@+dana-miler-of-testrealm --body typo
grep -Fq 'has no scratchpad' "$tmp/failure-err"
[[ "$(counts)" == "$before" ]]
expect_failure 1 "$command" resolve @+nobody-of-testrealm
grep -Fq $'agent\tnobody-of-testrealm\tno-scratchpad' "$tmp/failure-out"

# Shortened ids and v1 file paths resolve, as they do in agent-mail.
ulid="${by_handle:0:26}"
[[ "$(AGENT_SCRATCHPAD="$dana" "$command" read --peek --id "$ulid" 2>/dev/null | sed -n 's/^Message-ID: //p')" == "$by_handle" ]]
"$command" receipt "${by_handle: -11}" | grep -Fq "to:dana-miller-of-testrealm-01a1aaaa"
followup="$(AGENT_SCRATCHPAD="$dana" "$command" send --reply-all "/old/inbox/cur/$by_handle.md" \
  --if-head "$by_handle" --body 'path form')"
[[ "$($command head "$by_handle")" == "$followup" ]]
# A path is exact: its stem never falls back to prefix or suffix matching.
expect_failure 1 env AGENT_SCRATCHPAD="$dana" "$command" send --reply-all "/old/inbox/cur/$ulid.md" --body x
grep -Fq "unknown message: $ulid" "$tmp/failure-err"

# A reply without --if-head lands after mail the sender had not seen, and says so.
AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send --reply-all "$by_handle" \
  --body 'replying to the first message' >"$tmp/late-out" 2>"$tmp/late-err"
grep -Fq "1 message arrived in this thread after $by_handle" "$tmp/late-err"
[[ "$($command head "$by_handle")" == "$(cat "$tmp/late-out")" ]]

# The recipient's idle time is reported, as agent-mail does.
AGENT_MAIL_STALE_HOURS=0 AGENT_SCRATCHPAD="$tmp/alice-agent-11111111" "$command" send \
  --to dana-miller-of-testrealm-01a1aaaa -m 'are you there' 2>"$tmp/idle-err" >/dev/null || true
grep -Fq "last active 0h ago" "$tmp/idle-err"

# Receipts carry real read times, and every listing has a JSON form.
AGENT_SCRATCHPAD="$dana" "$command" read --id "$by_handle" >/dev/null 2>&1
"$command" receipt "$by_handle" | grep -Eq $'^read\t.*\tread:[0-9T:.-]+Z$'
python3 - "$command" "$by_handle" "$dana" <<'PY'
import json, os, subprocess, sys
command, message, dana = sys.argv[1:]
run = lambda *args, **env: json.loads(subprocess.run([command, *args], check=True, capture_output=True, text=True,
                                                     env=dict(os.environ, **env)).stdout)
receipt = run("receipt", message, "--json")
assert receipt[0]["state"] == "read" and receipt[0]["read_at"].endswith("Z"), receipt
thread = run("thread", message, "--json")
assert [m["sequence"] for m in thread] == list(range(1, len(thread) + 1)), thread
assert thread[0]["body"] == "sent to the documented handle" and thread[0]["to"] == ["dana-miller-of-testrealm-01a1aaaa"]
scan = run("scan", "--state", "all", "--json", AGENT_SCRATCHPAD=dana)
assert scan["version"] == 1 and scan["next"] is None, scan
assert any(m["message_id"] == message and m["state"] == "read" for m in scan["messages"]), scan
assert run("search", "documented handle", "--json")[0]["visibility"] == "public"
read = run("read", "--peek", "--id", message, "--json", AGENT_SCRATCHPAD=dana)
assert read["head"] == thread[-1]["message_id"] and read["body"] == thread[0]["body"]
PY

echo 'agent-mail2 tests passed'
