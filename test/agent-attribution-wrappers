#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/bin"

cat >"$tmp/bin/agent-trailer" <<'SH'
#!/bin/sh
if [ "${1:-}" = --raw ]; then
  echo pi/test/model
else
  echo 'Co-authored-by: AI Test Agent @+test-agent'
fi
SH

cat >"$tmp/bin/capture-body" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"$CALLS"
trap 'printf "%s\n" "${FAKE_STDOUT:-}"; printf "%s" "${FAKE_STDERR:-}" >&2; exit "${FAKE_STATUS:-0}"' EXIT
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  if [[ "${args[0]:-} ${args[1]:-}" == "pr review" && "${args[i]}" == --comment ]]; then continue; fi
  case "${args[i]}" in
    --body-file|-F)
      cat "${args[i + 1]}" >"$CAPTURE"
      exit 0
      ;;
    --body-file=*)
      cat "${args[i]#--body-file=}" >"$CAPTURE"
      exit 0
      ;;
    --body|-b|--comment|-c)
      printf '%s\n' "${args[i + 1]}" >"$CAPTURE"
      exit 0
      ;;
    --body=*|--comment=*)
      printf '%s\n' "${args[i]#*=}" >"$CAPTURE"
      exit 0
      ;;
  esac
done
: >"$CAPTURE"
SH
ln -s capture-body "$tmp/bin/gh"
chmod +x "$tmp/bin/agent-trailer" "$tmp/bin/capture-body"

export PATH="$tmp/bin:$PATH"
export CAPTURE="$tmp/captured"
export CALLS="$tmp/calls"
cat >"$tmp/bin/agent-pr-monitor" <<'SH'
#!/bin/sh
echo called >>"$MONITOR_CALLS"
exit 99
SH
chmod +x "$tmp/bin/agent-pr-monitor"
export MONITOR_CALLS="$tmp/monitor-calls"
trailer='Co-authored-by: AI Test Agent @+test-agent'

assert_capture() {
  local expected="$tmp/expected"
  printf '%s' "$1" >"$expected"
  diff -u "$expected" "$CAPTURE"
}

"$root/bin/gw" issue comment 1 --body $'First line.\n\nSecond line.'
assert_capture "$trailer

> First line.
>
> Second line.
"

"$root/bin/gw" issue create --title Test --body 'Maintained artifact.'
assert_capture "Maintained artifact.

$trailer
"

mixed="Josh's introduction.

> Agent finding.

$trailer

Josh's conclusion."
"$root/bin/gw" issue comment 1 --body "$mixed"
assert_capture "$mixed
"

"$root/bin/gw" issue close 1 --comment 'Closing after verification.'
assert_capture "$trailer

> Closing after verification.
"

historical='Co-authored-by: AI Previous Agent (pi/test/model) @+previous-agent'
"$root/bin/gw" pr edit 1 --body "Existing description.

$historical"
assert_capture "Existing description.

$historical

$trailer
"

# Exercise the real wrapper parsers, not a stub of the wrapper boundary.
printf 'From file.\n' >"$tmp/body with spaces"
for wrapper in gw; do
  for option in '-bShort body.' '-b=Short body.'; do
    "$root/bin/$wrapper" pr comment 1 "$option"
    assert_capture "$trailer

> Short body.
"
  done
  for option in "-F$tmp/body with spaces" "-F=$tmp/body with spaces"; do
    "$root/bin/$wrapper" pr comment 1 "$option"
    assert_capture "$trailer

> From file.
"
  done
  printf 'Already attributed.\n\n%s\n' "$trailer" | "$root/bin/$wrapper" pr review 1 --comment -F-
  assert_capture "Already attributed.

$trailer
"
done
for option in '-cClosing note.' '-c=Closing note.'; do
  "$root/bin/gw" pr close 1 "$option"
  assert_capture "$trailer

> Closing note.
"
done

# A prose value is data even when it begins with another short option.
for wrapper in gw; do
  for body in '-bhello' '-Fbody-file' '--body=literal'; do
    "$root/bin/$wrapper" pr comment 1 --body "$body"
    assert_capture "$trailer

> $body
"
  done
  printf 'Leading filename.\n' >"$tmp/-Fbody-file"
  (cd "$tmp" && "$root/bin/$wrapper" pr comment 1 --body-file '-Fbody-file')
  assert_capture "$trailer

> Leading filename.
"
  rc=0
  "$root/bin/$wrapper" pr comment 1 --body >"$tmp/missing-body.out" 2>"$tmp/missing-body.err" || rc=$?
  [[ $rc -eq 2 ]]
  grep -Fq 'requires a value' "$tmp/missing-body.err"
done
for body in '-chello' '-c=literal'; do
  "$root/bin/gw" pr close 1 --comment "$body"
  assert_capture "$trailer

> $body
"
done

# Metadata values are not flags, even after the body option.
for wrapper in gw; do
  for title in '-bTitle' '--body=Title' '-h'; do
    "$root/bin/$wrapper" pr edit 1 --body hello --title "$title"
    assert_capture "hello

$trailer
"
    tail -n 1 "$CALLS" >"$tmp/metadata-call"
    grep -Fq -- "--title $title" "$tmp/metadata-call"
  done
  "$root/bin/$wrapper" pr edit 1 --body hello --add-label '-FLabel'
  assert_capture "hello

$trailer
"
  tail -n 1 "$CALLS" >"$tmp/metadata-call"
  grep -Fq -- '--add-label -FLabel' "$tmp/metadata-call"
  "$root/bin/$wrapper" pr comment 1 --body '--help'
  assert_capture "$trailer

> --help
"
done

# Review short switches are booleans, unlike their create-command aliases.
for option in -a -r; do
  "$root/bin/gw" pr review 1 "$option" --body 'Review note.'
  assert_capture "$trailer

> Review note.
"
done

# GW-01: a pana session's bash tool has none of the harness variables the stub
# above fakes, so the wrapper tests use the real generator. That is also how gw
# detects a caller: attribution is the generator's job, not the wrapper's.
rm -f "$tmp/bin/agent-trailer"
ln -s "$root/bin/agent-trailer" "$tmp/bin/agent-trailer"
mkdir -p "$tmp/home/.local/state/pana"
printf '{"domain":"test.example","user":"tester"}\n' >"$tmp/home/.local/state/pana/config.json"
pana_session=01JB8ZQ4V0K3W9X2Y7Z5A6B8C9
pana_thread="pana://test.example/threads/01JB8ZQ4V0K3W9X2Y7Z5A6B8CA"
pana_trailer="Co-authored-by: AI $pana_thread"

# Run the way a pana session's bash tool runs: clean of both the old harness
# variables and the agent name, which panad never passes to a session.
run_pana() {
  env -u AGENT_NAME -u AGENT_HANDLE -u AGENT_REALM -u PI_MODEL -u PI_PROVIDER \
    -u PI_CODING_AGENT -u PI_PACKAGE_DIR -u PI_SESSION_ID -u PI_SESSION_FILE \
    -u CLAUDECODE -u CLAUDE_CODE_ENTRYPOINT -u CURSOR_AGENT -u CODEX_HOME \
    -u CODEX_SANDBOX -u AIDER_MODEL -u PANA_STATE \
    HOME="$tmp/home" PANA_SESSION="$pana_session" PANA_THREAD="$pana_thread" "$@"
}

run_pana "$root/bin/gw" issue comment 1 --body $'Pana first.\n\nPana second.'
assert_capture "$pana_trailer

> Pana first.
>
> Pana second.
"

run_pana "$root/bin/gw" issue create --title Test --body 'Pana artifact.'
assert_capture "Pana artifact.

$pana_trailer
"

run_pana "$root/bin/gw" pr edit 1 --body 'Updated under pana.'
assert_capture "Updated under pana.

$pana_trailer
"

# Creating under an agent must preserve attribution and the CLI's
# output/status without invoking the retired monitor or doing follow-up reads.
export FAKE_STDOUT='https://github.com/example/repo/pull/123'
export FAKE_STDERR='CLI diagnostic'
: >"$CALLS"
command=("$root/bin/gw" pr create)
run_pana "${command[@]}" --body 'New PR.' >"$tmp/out" 2>"$tmp/err"
assert_capture "New PR.

$pana_trailer
"
grep -Fxq "$FAKE_STDOUT" "$tmp/out"
grep -Fq "$FAKE_STDERR" "$tmp/err"
[[ $(wc -l <"$CALLS") -eq 1 ]]
[[ ! -e "$MONITOR_CALLS" ]]

# A successful write without a URL must not trigger a fallback lookup.
FAKE_STDOUT='' run_pana "${command[@]}" --body 'New PR.' >"$tmp/out" 2>"$tmp/err"
[[ $(wc -l <"$CALLS") -eq 2 ]]
! grep -q 'monitor' "$tmp/err"

rc=0
FAKE_STATUS=7 run_pana "${command[@]}" --body 'New PR.' >"$tmp/out" 2>"$tmp/err" || rc=$?
[[ $rc -eq 7 ]]
[[ $(wc -l <"$CALLS") -eq 3 ]]
[[ ! -e "$MONITOR_CALLS" ]]

# Detection still recognizes Pana without a thread, but the write must not reach gh.
before="$(wc -l <"$CALLS")"
rc=0
pana_thread='' run_pana "$root/bin/gw" pr edit 1 --body 'Must not publish.' >"$tmp/out" 2>"$tmp/err" || rc=$?
[[ $rc -ne 0 ]]
[[ $(wc -l <"$CALLS") -eq $before ]]
grep -Fxq 'agent-trailer: PANA_THREAD must be the originating thread URL for PANA_SESSION' "$tmp/err"

echo 'agent attribution wrapper tests passed'
