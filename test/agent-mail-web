    def test_contact_search_matches_headers_and_aliases_across_folders(self):
        fixtures = [
            ('sent', 'outbound', 'josh', '@+birch-weaver, +alder-turner-12345678'),
            ('archive', 'archived', '@+ALDER-TURNER', '@josh'),
            ('drafts', 'draft', 'josh', '@+alder-turner'),
            ('inbox', 'human', '@alder-turner', '@josh'),
            ('inbox', 'prefix', '@+alder-turner-extra', '@josh'),
            ('inbox', 'mention', '@+birch-weaver', '@josh'),
        ]
        for folder, name, sender, recipients in fixtures:
            (self.box.directory(folder) / (name + '.md')).write_text(
                f'From: {sender}\nTo: {recipients}\nSubject: Mentions @+alder-turner\nMessage-ID: {name}\n\nBody mentions @+alder-turner.\n')
        original = self.box.path(self.key).read_bytes()
        expected = {self.key, 'sent:outbound.md', 'archive:archived.md', 'drafts:draft.md'}
        for address in ('@+alder-turner', '+alder-turner', 'alder-turner', '@+ALDER-TURNER-12345678'):
            code, body = self.request('/api/messages?folder=all&q=' + quote('with:' + address))
            self.assertEqual(code, 200)
            self.assertEqual({m['key'] for m in json.loads(body)['messages']}, expected)
        def keys(query, folder='all'):
            return {m['key'] for m in self.box.listing(folder, query)['messages']}
        self.assertEqual(keys('with:@+alder-turner needle'), {self.key})
        self.assertEqual(keys('with:@+alder-turner', 'sent'), {'sent:outbound.md'})
