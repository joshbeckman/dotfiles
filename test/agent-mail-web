        self.assertEqual(headers.get('Vary'), 'Accept-Encoding')
        self.assertEqual(headers.get('Cache-Control'), 'no-cache')
        self.assertEqual(__import__('gzip').decompress(body), asset)
        self.assertLess(len(body), len(asset) // 2)
        # A client that does not ask for gzip still gets the bytes, uncompressed.
        status, headers, plain = self.request_with_headers('/app.js')
        self.assertEqual((status, headers.get('Content-Encoding'), plain), (200, None, asset))
        # Revalidating costs a round trip and no body rather than the whole asset again.
        etag = headers.get('ETag')
