    def add_tailnet(self, name='machine.example.ts.net'):
        self.server.authorities = [self.server.authority, name]
        self.server.origins = {f'{scheme}://{host}'
                               for host in self.server.authorities for scheme in ('http', 'https')}
        return name

    def test_a_tailnet_host_is_accepted_and_a_foreign_one_is_not(self):
        # Tailscale Serve proxies this machine's HTTPS name to the loopback port, so the
        # Host header arriving here is that name. Allowing it is what lets the phone reach
        # the bridge without the bridge binding anywhere but 127.0.0.1, and an unknown name
        # must still be refused: the tailnet is not a licence to answer anyone.
        tailnet = 'machine.example.ts.net'
        self.assertEqual(self.request('/', Host=tailnet)[0], 403)
        self.add_tailnet(tailnet)
        self.assertEqual(self.request('/', Host=tailnet)[0], 200)
        self.assertEqual(self.request('/', Host='elsewhere.example.ts.net')[0], 403)
        # The origin check follows the same list, since a browser on the tailnet sends the
        # tailnet origin rather than the loopback one.
        self.assertEqual(self.request('/api/messages?folder=inbox&q=', Origin='https://' + tailnet)[0], 200)
        self.assertEqual(self.request('/api/messages?folder=inbox&q=', Origin='https://elsewhere.example.ts.net')[0], 403)

    def test_the_reader_policy_names_the_host_the_request_arrived_on(self):
        # The reader frame's policy has to name its own origin, because WebKit does not match
        # 'self' from a sandboxed opaque origin. Behind a proxy the bridge cannot see the
        # scheme the browser used, so both are named for whichever host arrived.
        tailnet = self.add_tailnet()
        req = urllib.request.Request(self.url + '/reader.html', headers={'Host': tailnet})
        with urllib.request.urlopen(req, timeout=5) as response:
            policy = response.headers['Content-Security-Policy']
        self.assertIn(f'script-src http://{tailnet} https://{tailnet}', policy)
        self.assertNotIn('127.0.0.1', policy)

    def test_tailnet_authorities_reads_the_local_name(self):
        # Detected rather than configured: the tailnet DNS name can change, and a stale name
        # in the LaunchAgent would be a 403 nobody sees. An unusable tailscale means no
        # extra authority, which is the loopback-only default.
        script = self.root / 'bin' / 'tailscale'
        script.write_text('#!/bin/sh\necho \'{"Self": {"DNSName": "machine.example.ts.net."}}\'\n')
        script.chmod(0o755)
        # The trailing dot is how the API spells a fully qualified name; a Host header has
        # none, so the helper strips it rather than producing a name nothing matches.
        self.assertEqual(web.tailnet_authorities(), ['machine.example.ts.net'])
        script.write_text('#!/bin/sh\necho \'{"Self": {}}\'\n')
        self.assertEqual(web.tailnet_authorities(), [])
        script.write_text('#!/bin/sh\nexit 1\n')
        self.assertEqual(web.tailnet_authorities(), [])
        script.write_text('#!/bin/sh\necho not-json\n')
        self.assertEqual(web.tailnet_authorities(), [])

    def test_thread_skips_unchanged_unrelated_cache_but_observes_external_edits(self):
        other = self.box.directory('archive') / 'unrelated.md'
        other.write_text('From: fixture\nMessage-ID: unrelated\nThread-ID: elsewhere\n\nOther body.\n')
        self.box.messages()
        selected = self.box.message(self.key)
        with patch.object(self.box, 'message', wraps=self.box.message) as read:
            self.assertEqual(len(self.box.thread(self.key)), 1)
            self.assertNotIn(('archive:unrelated.md',), [call.args for call in read.call_args_list])
        self.assertIn('archive:unrelated.md', self.box.cache)
        other.write_text('From: fixture\nMessage-ID: unrelated\nThread-ID: ' + selected['thread'] + '\n\nEdited into this thread.\n')
        self.assertEqual({m['id'] for m in self.box.thread(self.key)}, {selected['id'], 'unrelated'})
        reply = self.box.directory('inbox') / 'new-reply.md'
        reply.write_text('From: fixture\nMessage-ID: new-reply\nThread-ID: ' + selected['thread'] + '\n\nNew body.\n')
        self.assertEqual({m['id'] for m in self.box.thread(self.key)}, {selected['id'], 'unrelated', 'new-reply'})
        reply.unlink()
        self.assertEqual({m['id'] for m in self.box.thread(self.key)}, {selected['id'], 'unrelated'})
        self.assertNotIn('inbox:new-reply.md', self.box.cache)

