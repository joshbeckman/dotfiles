            {'type': 'delta', 'at_ms': 1070, 'turn': 1, 'kind': 'reasoning_redacted', 'data': 'opaque-blob'},
            {'type': 'delta', 'at_ms': 1080, 'turn': 1, 'kind': 'reasoning_opaque', 'data': 'opaque-blob'},
            {'type': 'delta', 'at_ms': 1090, 'turn': 1, 'kind': 'text_signature', 'data': 'opaque-blob'},
            {'type': 'delta', 'at_ms': 1100, 'turn': 1, 'kind': 'content', 'data': 'after.', 'index': 3},
            {'type': 'model_request', 'at_ms': 1200, 'turn': 2,
             'model': {'provider': 'fireworks', 'model': 'deepseek-v4p1-flash', 'api': 'chat'}},
            {'type': 'model_changed', 'at_ms': 1300, 'change': {'id': 'c1', 'selection': 'auto'}},
