    def test_agent_run_poll_sends_only_what_is_new(self):
        thread, root = self.agent_run(records=self.agent_run_records())
        first = json.loads(self.request('/api/transcript?thread=' + thread)[1])
        cut = str(first['end'])
        data = json.loads(self.request('/api/transcript?thread=' + thread + '&version=x&after=' + cut)[1])
        # The log ends with a completed record rather than a streaming group, so nothing is new.
        self.assertEqual(data['entries'], [])
        with (root / 'sessions' / (thread + '.jsonl')).open('ab') as log:
            for piece in ('Hel', 'lo', ' world'):
                log.write(json.dumps({'type': 'delta', 'at_ms': 9000, 'turn': 9, 'kind': 'content',
                                      'data': piece}).encode() + b'\n')
        data = json.loads(self.request('/api/transcript?thread=' + thread + '&version=x&after=' + cut)[1])
        self.assertEqual(len(data['entries']), 1)
        self.assertEqual(data['entries'][0]['entry']['message']['content'][0]['text'], 'Hello world')
        # The group is still streaming, so the next poll carries it again even though its start
        # is behind the offset the client has read to. Without that it would freeze mid-sentence.
        again = json.loads(self.request('/api/transcript?thread=' + thread + '&version=x&after=' + str(data['end']))[1])
        self.assertEqual(len(again['entries']), 1)
        self.assertEqual(again['entries'][0]['entry']['message']['content'][0]['text'], 'Hello world')
        # And a completed record behind the offset is not resent.
        with (root / 'sessions' / (thread + '.jsonl')).open('ab') as log:
            log.write(json.dumps({'type': 'settled', 'at_ms': 9100, 'outcome': 'complete'}).encode() + b'\n')
        third = json.loads(self.request('/api/transcript?thread=' + thread + '&version=x&after=' + str(again['end']))[1])
        self.assertEqual([item['entry']['type'] for item in third['entries']], ['settled'])

