        # Whole-entry equality, so a field the projection does not map, such as origin_job on
        # a user record, cannot leak into the rendered message.
        self.assertEqual(entries[1], {'type': 'message', 'timestamp': 2000, 'message': {
            'role': 'user', 'content': [{'type': 'text', 'text': 'From: @josh\n\nBuild the thing.'}]}})
        self.assertEqual(entries[2]['type'], 'assistant_start')
        self.assertEqual(entries[3]['message']['content'], [{'type': 'thinking', 'thinking': 'Considering.'}])
        self.assertEqual(entries[4]['message']['content'], [{'type': 'text', 'text': 'I will.\n'}])
        self.assertEqual(entries[6]['message']['content'][0]['type'], 'toolCall')
        self.assertEqual(entries[6]['message']['content'][0]['arguments'], {'cmd': 'ls'})
        self.assertEqual(entries[7]['message']['role'], 'toolResult')
        self.assertEqual(entries[8]['message']['stopReason'], 'tool_use')
        self.assertFalse(entries[8]['message']['isError'])
        self.assertEqual(entries[9], {'type': 'compaction', 'summary': 'Compacted after turn one.', 'timestamp': 3700})
        # Records that are not prose keep their own shape rather than becoming invented messages.
        self.assertEqual([item['type'] for item in entries[10:]], ['retry', 'reply_sending', 'reply_sent', 'settled'])

    def test_agent_run_keeps_argument_fragments_out_of_tool_calls(self):
        thread, _ = self.agent_run(records=self.agent_run_records())
        status, body = self.request('/api/transcript?thread=' + thread)
        data = json.loads(body)
        calls = [item['entry'] for item in data['entries']
                 if item['entry'].get('type') == 'message'
                 and any(part.get('type') == 'toolCall' for part in item['entry']['message'].get('content', []))]
        self.assertEqual(len(calls), 1)
        self.assertEqual(calls[0]['message']['content'][0]['id'], 'call-1')
        # Argument pieces become one labelled entry rather than a call or a card per piece. The
        # role is one the viewer leaves collapsed, so a long argument stream does not fill the page.
        arguments = [item['entry'] for item in data['entries']
                     if item['entry'].get('type') == 'message'
                     and item['entry']['message'].get('role') == 'tool_arguments']
        self.assertEqual(len(arguments), 1)
        self.assertEqual(arguments[0]['message']['content'][0]['text'], '{"cmd":')

    def test_agent_run_coalesces_a_streamed_turn_into_readable_entries(self):
        records = [{'type': 'init', 'at_ms': 0, 'cwd': '/fixture', 'model': 'm', 'system': 's'}]
        records += [{'type': 'delta', 'at_ms': 1000 + i, 'turn': 1, 'kind': 'content', 'data': piece}
                    for i, piece in enumerate(['Sto', 'pp', 'ing', ' the', ' run'])]
        records += [{'type': 'delta', 'at_ms': 2000, 'turn': 1, 'kind': 'reasoning_content', 'data': 'thin'},
                    {'type': 'delta', 'at_ms': 2100, 'turn': 1, 'kind': 'reasoning_content', 'data': 'king'},
                    {'type': 'delta', 'at_ms': 3000, 'turn': 2, 'kind': 'content', 'data': 'second turn'}]
        thread, _ = self.agent_run(records=records)
        data = json.loads(self.request('/api/transcript?thread=' + thread)[1])
        entries = [item['entry'] for item in data['entries']]
        # The init record, one content group, one thinking group, then a new turn's group.
        self.assertEqual(len(entries), 4)
        self.assertEqual(entries[1]['message']['content'], [{'type': 'text', 'text': 'Stopping the run'}])
        self.assertEqual(entries[1]['timestamp'], 1000)
        self.assertEqual(entries[2]['message']['content'], [{'type': 'thinking', 'thinking': 'thinking'}])
        self.assertEqual(entries[3]['message']['content'], [{'type': 'text', 'text': 'second turn'}])
        # Keyed by the first piece, so a poll during the stream re-sends it under a stable key.
        self.assertEqual(int(data['entries'][1]['key']), len(json.dumps(records[0]).encode()) + 1)
        self.assertEqual([int(item['key']) for item in data['entries']],
                         sorted(int(item['key']) for item in data['entries']))

    def test_agent_run_bounds_a_group_and_keeps_the_tail_open(self):
        records = [{'type': 'delta', 'at_ms': 1000 + i, 'turn': 1, 'kind': 'content', 'data': 'x' * 100}
                   for i in range(10)]
        thread, _ = self.agent_run(records=records)
        with patch.object(web, 'AGENT_RUN_GROUP', 250):
            data = json.loads(self.request('/api/transcript?thread=' + thread)[1])
        texts = [item['entry']['message']['content'][0]['text'] for item in data['entries']]
        # Three pieces fill a group and the fourth starts the next, so a group can exceed the
        # budget by one piece. That is bounded, and simpler than splitting a streamed piece.
        self.assertEqual(texts, ['x' * 300, 'x' * 300, 'x' * 300, 'x' * 100])
        self.assertFalse(data['truncated'])

    def test_agent_run_handles_a_real_sized_fragment_stream(self):
        # The live demo streamed one turn as 319 pieces of two characters. One entry per piece
        # drew that turn as 319 cards, which is what this guards against.
        records = [{'type': 'delta', 'at_ms': 1000 + i, 'turn': 6, 'kind': 'content', 'data': 'ab'}
                   for i in range(319)]
        thread, _ = self.agent_run(records=records)
        data = json.loads(self.request('/api/transcript?thread=' + thread)[1])
        self.assertEqual(len(data['entries']), 1)
        self.assertEqual(len(data['entries'][0]['entry']['message']['content'][0]['text']), 638)

    def test_agent_run_labels_truncation_and_a_torn_tail(self):
        thread, root = self.agent_run(records=self.agent_run_records())
        path = root / 'sessions' / (thread + '.jsonl')
        with patch.object(web, 'AGENT_RUN_WINDOW', 200):
            data = json.loads(self.request('/api/transcript?thread=' + thread)[1])
        self.assertTrue(data['truncated'])
        label = data['entries'][-1]['entry']
        self.assertEqual(label['type'], 'transcript_oversize')
        self.assertTrue(label['continued'])
        self.assertGreater(label['bytes'], 0)
        path.write_bytes(path.read_bytes() + b'{"type":"delta","turn":2,"kind":"content","data":"torn')
        data = json.loads(self.request('/api/transcript?thread=' + thread)[1])
        self.assertTrue(data['partial'])
        self.assertEqual(data['entries'][-1]['entry']['type'], 'settled')
        self.assertLess(data['end'], path.stat().st_size)

    def test_agent_run_refuses_bindings_that_disagree_or_escape(self):
        thread, root = self.agent_run(records=self.agent_run_records())
        record = root / 'threads' / (thread + '.json')
        for bad, message in (({'thread_id': 'someone-else-thread'}, 'different thread'),
                             ({'log': '/etc/passwd'}, 'invalid log path'),
                             ({'log': '../../etc/passwd'}, 'invalid log path'),
                             ({'version': 2}, 'Unsupported')):
            with self.subTest(message=message):
                record.write_text(json.dumps(dict({'version': 1, 'format': 'agent-run-v1',
                                                   'thread_id': thread, 'log': 'sessions/' + thread + '.jsonl'}, **bad)))
                status, body = self.request('/api/transcript?thread=' + thread)
                self.assertEqual(status, 422)
                self.assertIn(message, json.loads(body)['error'])
        # A log reached through a link is not the log the binding names.
        record.write_text(json.dumps({'version': 1, 'format': 'agent-run-v1', 'thread_id': thread,
                                      'log': 'sessions/' + thread + '.jsonl'}))
        target = root / 'sessions' / (thread + '.jsonl')
        outside = self.root / 'outside.jsonl'
        outside.write_bytes(target.read_bytes())
        target.unlink()
        target.symlink_to(outside)
        self.assertEqual(self.request('/api/transcript?thread=' + thread)[0], 404)

    def test_agent_run_leaves_ordinary_threads_alone(self):
        thread, root = self.agent_run(records=self.agent_run_records())
        self.assertEqual(self.request('/api/transcript?thread=unmanaged-thread')[0], 404)
        status, body = self.request('/api/transcript?thread=' + thread + '&probe=1')
        self.assertEqual((status, json.loads(body)), (200, {'thread': thread, 'available': True}))
        self.assertEqual(json.loads(self.request('/api/transcript?thread=unmanaged-thread&probe=1')[1]),
                         {'thread': 'unmanaged-thread', 'available': False})
        # An absent binding is the ordinary case for Pi mail, so it is not an error.
        self.assertEqual(self.request('/api/transcript?handle=' + quote('@+alder-turner'))[0], 200)

    def test_agent_run_poll_is_free_when_nothing_changed(self):
        thread, root = self.agent_run(records=self.agent_run_records())
        first = json.loads(self.request('/api/transcript?thread=' + thread)[1])
        status, body = self.request('/api/transcript?thread=' + thread + '&version=' + quote(first['version']))
        self.assertEqual((status, json.loads(body)), (200, {'unchanged': True, 'version': first['version']}))
        with (root / 'sessions' / (thread + '.jsonl')).open('ab') as log:
            log.write(json.dumps({'type': 'delta', 'at_ms': 5000, 'turn': 1, 'kind': 'content', 'data': 'more'}).encode() + b'\n')
        grown = json.loads(self.request('/api/transcript?thread=' + thread + '&version=' + quote(first['version']))[1])
        self.assertNotIn('unchanged', grown)
        self.assertEqual(len(grown['entries']), len(first['entries']) + 1)
        self.assertEqual(grown['entries'][-1]['entry']['message']['content'][0]['text'], 'more')

    def test_agent_run_skips_unparsable_records(self):
        thread, _ = self.agent_run(log_bytes=b'not json\n' + json.dumps({'type': 'nonsense'}).encode() + b'\n' +
                                  json.dumps({'type': 'delta', 'turn': 1, 'kind': 'content', 'data': 'kept'}).encode() + b'\n')
        data = json.loads(self.request('/api/transcript?thread=' + thread)[1])
        self.assertEqual(data['skipped'], 2)
        self.assertEqual([item['entry']['message']['content'][0]['text'] for item in data['entries']], ['kept'])


class SqliteWebTest(WebTest):
    """The same mailbox once the store marker says sqlite: no Maildir is read or written,
    and the app sees the same keys, folders and fields."""

    def setUp(self):
        super().setUp()
        (self.root / 'store').write_text('sqlite\n')
        self.id = web.cli('send', '--from', 'alder-turner', '--to', '@josh', '--to', '@+birch-weaver',
                          '--subject', 'A stored thread', '--body', '**Hello**\n\nA stored needle.\n')
        self.key = 'inbox:' + self.id + '.md'
        self.maildir_before = sorted(str(p) for p in (self.root / 'humans').rglob('*.md'))

    def tearDown(self):
        drafts = (self.root / 'humans/josh/drafts').resolve()
        delivered = [p for p in (self.root / 'humans').rglob('*.md') if not p.resolve().is_relative_to(drafts)]
        self.assertEqual(sorted(str(p) for p in delivered), [p for p in self.maildir_before if 'drafts' not in p])
        super().tearDown()

    def test_open_search_archive_and_thread(self):
        status, body = self.request('/api/thread?key=' + quote(self.key))
        self.assertEqual((status, [m['id'] for m in json.loads(body)]), (200, [self.id]))
        listing = self.box.listing('all', 'stored needle')
        self.assertEqual([m['key'] for m in listing['messages']], [self.key])
        self.assertEqual(listing['counts']['inbox'], 1)
        self.assertEqual(self.request('/api/archive', {'key': self.key})[0], 200)
        self.assertEqual(self.box.listing('inbox', 'stored')['messages'], [])
        archived = self.box.listing('archive', 'stored')['messages']
        self.assertEqual([m['key'] for m in archived], ['archive:' + self.id + '.md'])
        self.assertEqual(self.request('/api/archive', {'key': self.key})[0], 404)

    def test_compose_save_send_and_reply_all(self):
        draft = self.box.draft('reply-all', self.key)
        self.assertIn('birch-weaver', draft['to'])
        self.assertIn('alder-turner', draft['to'])
        self.assertNotIn('josh', draft['to'])
        draft = self.box.save(dict(draft, body='My stored reply.'))
        status, body = self.request('/api/send', {'key': draft['key'], 'revision': draft['revision']})
        self.assertEqual(status, 200, body)
        sent_key = json.loads(body)['key']
        sent = self.box.message(sent_key)
        self.assertEqual((sent['folder'], sent['thread'], sent['parent'], sent['body']),
                         ('sent', self.id, self.id, 'My stored reply.'))
        self.assertEqual([m['id'] for m in self.box.thread(self.key)], [self.id, sent['id']])
        # A double click or lost response must not deliver a second message.
        self.assertEqual(self.request('/api/send', {'key': draft['key'], 'revision': draft['revision']})[0], 404)
        self.assertEqual(len(self.box.listing('sent', '')['messages']), 1)
        reply = self.box.draft('reply', sent_key)
        self.assertNotIn('josh', reply['to'])
        compose = self.box.save(dict(self.box.draft('compose'), to='@+birch-weaver', subject='Fresh', body='New.'))
        status, body = self.request('/api/send', {'key': compose['key'], 'revision': compose['revision']})
        self.assertEqual(status, 200, body)
        self.assertEqual(self.box.message(json.loads(body)['key'])['to'], 'birch-weaver-87654321')

    def test_an_undeliverable_draft_is_kept(self):
        draft = self.box.save(dict(self.box.draft('compose'), to='missing-agent', body='No partial delivery'))
        self.assertEqual(self.request('/api/send', {'key': draft['key'], 'revision': draft['revision']})[0], 400)
        self.assertTrue(self.box.path(draft['key']).exists())
        self.assertEqual(self.box.listing('sent', '')['messages'], [])

    def test_grouped_listing_counts_a_stored_conversation_once(self):
        reply = web.cli('send', '--from', 'birch-weaver', '--to', '@josh', '--in-reply-to', self.id,
                        '--subject', 'Re: A stored thread', '--body', 'Second.')
        rows = json.loads(self.request('/api/messages?folder=inbox&q=&group=1')[1])['messages']
        self.assertEqual([(r['key'], r['count']) for r in rows], [('inbox:' + reply + '.md', 2)])

    def test_a_send_retried_after_a_lost_outcome_delivers_once(self):
        draft = self.box.save(dict(self.box.draft('compose'), to='@+birch-weaver', subject='Once', body='Only once.'))
        path = self.box.path(draft['key'])
        with patch.object(web.Path, 'unlink', side_effect=OSError('killed before the draft was removed')):
            with self.assertRaises(OSError):
                self.box.send_draft(path)
        self.assertTrue(path.exists())
        retried = self.box.send_draft(path)
        sent = [m for m in self.box.listing('sent', 'Only once')['messages']]
        self.assertEqual([m['key'] for m in sent], ['sent:' + retried + '.md'])

    def test_a_draft_keeps_its_reply_to_and_thread(self):
        draft = self.box.draft('compose')
        path = self.box.path(draft['key'])
        path.write_text('From: josh\nTo: @+birch-weaver\nReply-To: @+alder-turner\nThread-ID: ' + self.id +
                        '\nSubject: Routed\n\nRoute replies elsewhere.')
        sent = self.box.message('sent:' + self.box.send_draft(path) + '.md')
        self.assertEqual((sent['reply_to'], sent['thread']), ('alder-turner-12345678', self.id))

    def test_the_store_narrows_listings_threads_and_messages_itself(self):
        reply = web.cli('send', '--from', 'birch-weaver', '--to', '@josh', '--in-reply-to', self.id,
                        '--subject', 'Re: A stored thread', '--body', 'Ünïcode   reply\n\n  with   SPACES.')
        other = web.cli('send', '--from', 'birch-weaver', '--to', '@josh', '--subject', 'Unrelated', '--body', 'Elsewhere.')
        self.assertEqual(self.request('/api/archive', {'key': 'inbox:' + other + '.md'})[0], 200)
        # Words match case-folded across sender, recipients, subject and body, in the store.
        keys = lambda folder, q: [m['key'] for m in self.box.listing(folder, q)['messages']]
        self.assertEqual(keys('all', 'ÜNÏCODE spaces'), ['inbox:' + reply + '.md'])
        self.assertEqual(keys('all', 'birch-weaver elsewhere'), ['archive:' + other + '.md'])
        self.assertEqual(keys('inbox', 'elsewhere'), [])
        self.assertEqual(keys('all', 'stored needle'), [self.key])
        self.assertEqual(keys('all', 'with:@+birch-weaver unrelated'), ['archive:' + other + '.md'])
        listing = self.box.listing('inbox', '')
        self.assertEqual([m['key'] for m in listing['messages']], ['inbox:' + reply + '.md', self.key])
        self.assertEqual(listing['counts'], {'inbox': 2, 'archive': 1, 'sent': 0, 'drafts': 0})
        self.assertEqual(listing['messages'][0]['excerpt'], 'Ünïcode reply with SPACES.')
        self.assertNotIn('body', listing['messages'][0])
        # A thread and a message are fetched by id, and a key naming the wrong folder is not found.
        self.assertEqual([m['id'] for m in self.box.thread(self.key)], [self.id, reply])
        self.assertEqual(self.box.message(self.key)['body'], '**Hello**\n\nA stored needle.\n')
        self.assertEqual(self.request('/api/thread?key=' + quote('archive:' + self.id + '.md'))[0], 404)

    def test_a_waiting_window_hears_stored_mail(self):
        # agent-mail2 rings beside its database rather than through the Maildir.
        self.assert_a_wait_hears_new_mail()

    def test_the_bridge_follows_a_flip_without_restarting(self):
        (self.root / 'store').write_text('both\n')
        self.assertNotIn(self.key, [m['key'] for m in self.box.listing('all', '')['messages']])
        (self.root / 'store').write_text('sqlite\n')
        self.assertIn(self.key, [m['key'] for m in self.box.listing('all', '')['messages']])


