        ]
        thread, _ = self.agent_run(records=records)
        data = json.loads(self.request('/api/transcript?thread=' + thread)[1])
        self.assertEqual(data['skipped'], 0)
        entries = [item['entry'] for item in data['entries']]
        # No entry mentions a signature, and the prose on both sides is one group.
        self.assertNotIn('opaque-blob', json.dumps(entries))
        self.assertEqual(entries[0]['message']['content'], [{'type': 'text', 'text': 'Before after.'}])
        self.assertEqual(len(entries), 4)
        # A model request reads as the provider and model that answered the turn, carrying api and
        # thinking on that same entry rather than a second one under the same key.
        self.assertEqual(entries[1], {'type': 'model_change', 'timestamp': 1200, 'provider': 'fireworks',
