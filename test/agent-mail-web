    def assert_a_wait_hears_new_mail(self):
        import time
        status, body = self.request('/api/wait?since=&timeout=0')
        self.assertEqual(status, 200)
        stamp = json.loads(body)['doorbell']
        # Nothing rang: the wait runs out its timeout and reports no change.
        started = time.monotonic()
        quiet = json.loads(self.request('/api/wait?since=' + quote(stamp) + '&timeout=0.3')[1])
        self.assertEqual(quiet, {'doorbell': stamp, 'changed': False})
        self.assertGreaterEqual(time.monotonic() - started, 0.25)
        # A long wait answers as soon as a delivery rings, and other requests are served meanwhile.
        heard = {}
        waiter = threading.Thread(target=lambda: heard.update(
            zip(('status', 'body'), self.request('/api/wait?since=' + quote(stamp) + '&timeout=20'))))
        waiter.start()
        time.sleep(0.3)
        started = time.monotonic()
        self.assertEqual(self.request('/api/config')[0], 200)
        self.assertLess(time.monotonic() - started, 2)
        self.assertTrue(waiter.is_alive())
        started = time.monotonic()
        web.cli('send', '--from', 'alder-turner', '--to', '@josh', '--subject', 'Ring', '--body', 'Ding.')
        waiter.join(10)
        self.assertFalse(waiter.is_alive())
        self.assertLess(time.monotonic() - started, 5)
        rang = json.loads(heard['body'])
        self.assertEqual((heard['status'], rang['changed']), (200, True))
        self.assertNotEqual(rang['doorbell'], stamp)
        # It needs the token like any other read, and a bad timeout is a bad request.
        self.assertEqual(self.request('/api/wait?since=&timeout=0', **{'X-Agent-Mail-Token': 'wrong'})[0], 403)
        self.assertEqual(self.request('/api/wait?since=&timeout=soon')[0], 400)

    def test_a_client_that_hangs_up_is_not_an_error(self):
        import socket, struct, time
        with patch('sys.stderr', new_callable=io.StringIO) as stderr:
            for pause in (0, 0.05, 0.05):
                # The uncompressed diagram bundle is larger than the socket buffers, so the bridge
                # is still writing when the reset arrives; with no pause it is still reading.
                s = socket.create_connection(('127.0.0.1', self.server.server_port))
                s.sendall(f'GET /mermaid-vendor.js HTTP/1.0\r\nHost: {self.server.authority}\r\n\r\n'.encode())
                time.sleep(pause)
                s.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack('ii', 1, 0))
                s.close()
            # The bridge answers one request at a time, so this one proves it moved on.
            self.assertEqual(self.request('/api/config')[0], 200)
        self.assertNotIn('Traceback', stderr.getvalue())

