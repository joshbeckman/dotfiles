#!/usr/bin/env bash
# The subject becomes a directory name, so the slug rule is the interesting part: a
# bad slug makes a path that is hard to find later, and a collision makes a spawn fail.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/scripts" "$tmp/tries"

# A copy of the script with a stub launcher beside it: the real one resolves its
# sibling by path, so the delegation is what gets observed here.
cp "$root/bin/spawn-pi-workspace" "$tmp/scripts/"
cat >"$tmp/scripts/spawn-pi-worktree" <<'EOF'
#!/bin/sh
# One line, so a flag and its value can be asserted together.
printf 'launcher'
printf ' %s' "$@"
printf '\n'
EOF
chmod +x "$tmp/scripts/spawn-pi-workspace" "$tmp/scripts/spawn-pi-worktree"

today="$(date +%Y-%m-%d)"
run() { "$tmp/scripts/spawn-pi-workspace" --tmux-session agents --root "$tmp/tries" "$@" 2>&1; }

expect_fail() {
  local label="$1"; shift
  if out="$(run "$@" 2>&1)"; then
    printf 'FAIL %s: expected a failure, got:\n%s\n' "$label" "$out" >&2
    exit 1
  fi
  printf 'ok   %s\n' "$label"
}

# 1. A subject becomes a dated slugged directory, and the launcher is told about it.
out="$(run --subject 'Investigate orchard migrations')"
expected="$tmp/tries/$today-investigate-orchard-migrations"
grep -Fxq "$expected" <<<"$out" || { printf 'FAIL: workspace not printed\n%s\n' "$out" >&2; exit 1; }
[ -d "$expected" ] || { printf 'FAIL: workspace not created\n' >&2; exit 1; }
grep -Fq -- "--title investigate-orchard-migrations" <<<"$out" || { printf 'FAIL: title not slugged\n%s\n' "$out" >&2; exit 1; }
grep -Fq -- "--cwd $expected" <<<"$out" || { printf 'FAIL: launcher not pointed at the workspace\n%s\n' "$out" >&2; exit 1; }
printf 'ok   subject becomes a dated slug and the launcher is pointed at it\n'

# 2. Punctuation and case are reduced, not passed through.
out="$(run --subject 'RE: Water bill increase | 1721 N Sheffield')"
expected="$tmp/tries/$today-re-water-bill-increase-1721-n-sheffield"
grep -Fxq "$expected" <<<"$out" || { printf 'FAIL: punctuation survived\n%s\n' "$out" >&2; exit 1; }
printf 'ok   punctuation and case are reduced\n'

# 3. A subject with nothing usable falls back rather than making a bare date.
out="$(run --subject '!!!')"
grep -Fxq "$tmp/tries/$today-spawn" <<<"$out" || { printf 'FAIL: no fallback slug\n%s\n' "$out" >&2; exit 1; }
printf 'ok   an unusable subject falls back\n'

# 4. A second spawn for the same subject gets a suffix instead of failing.
out="$(run --subject 'Investigate orchard migrations')"
grep -Fxq "$tmp/tries/$today-investigate-orchard-migrations-2" <<<"$out" || { printf 'FAIL: collision not suffixed\n%s\n' "$out" >&2; exit 1; }
printf 'ok   a same-day collision is suffixed rather than refused\n'

# 5. Failing directions: a spawn without a subject or a session must not run.
expect_fail "a missing subject is refused" --subject ''
expect_fail "a missing tmux session is refused" --subject 'x' --tmux-session ''

printf 'spawn-pi-workspace tests passed\n'
