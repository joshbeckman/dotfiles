#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/bin"

cat >"$tmp/bin/uname" <<'EOF'
#!/bin/sh
printf 'Darwin\n'
EOF
cat >"$tmp/bin/pgrep" <<'EOF'
#!/bin/sh
exit 1
EOF
cat >"$tmp/bin/osascript" <<'EOF'
#!/bin/sh
printf 'false\n'
EOF
cat >"$tmp/bin/pmset" <<'EOF'
#!/bin/sh
printf 'Internal failure: no power state\n'
EOF
cat >"$tmp/bin/ioreg" <<'EOF'
#!/bin/sh
printf '%s\n' '"IOPowerManagement" = {"DevicePowerState"=4,"CurrentPowerState"=4,"MaxPowerState"=4}'
i=0
while [ "$i" -lt 10000 ]; do
  printf 'padding %s\n' "$i"
  i=$((i + 1))
done
EOF
cat >"$tmp/bin/terminal-notifier" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >"$LOCAL_LOG"
EOF
cat >"$tmp/bin/node" <<'EOF'
#!/bin/sh
# Record the lengths, not just that it was called: the status MCP caps the title
# at 50 and the body at 150, so the interesting assertion is how much arrived.
printf 'push called title=%s len=%s\n' "${#NOTIFY_JOSH_TITLE}" "${#NOTIFY_JOSH_MESSAGE}" >"$PUSH_LOG"
exit 1
EOF
cat >"$tmp/bin/tmux" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >>"$TMUX_LOG"
EOF
chmod +x "$tmp/bin"/*

export PATH="$tmp/bin:/usr/bin:/bin"
export LOCAL_LOG="$tmp/local"
export PUSH_LOG="$tmp/push"
export TMUX_LOG="$tmp/tmux"
export TMUX=fake

"$root/bin/notify-josh" --pane-title 'must not replace the pane title' --execute 'echo clicked' 'Mail delivered' 'Read your inbox.' >"$tmp/stdout"
[[ -s "$LOCAL_LOG" ]]
[[ ! -e "$PUSH_LOG" ]]
[[ ! -e "$TMUX_LOG" ]]
[[ "$(od -An -tu1 "$tmp/stdout" | tr -d '[:space:]')" == 7 ]]
grep -Fq -- '-title Mail delivered' "$LOCAL_LOG"
grep -Fq -- '-execute echo clicked' "$LOCAL_LOG"

rm -f "$LOCAL_LOG" "$PUSH_LOG"
"$root/bin/notify-josh" --away-only 'Mail delivered' 'A web app shows this.'
[[ ! -e "$LOCAL_LOG" && ! -e "$PUSH_LOG" ]]
short_message='Away from the desk.'
NOTIFY_JOSH_FORCE_PUSH=1 "$root/bin/notify-josh" --away-only 'Mail delivered' "$short_message" || true
[[ ! -e "$LOCAL_LOG" && -s "$PUSH_LOG" ]]
grep -Fq "len=${#short_message}" "$PUSH_LOG"

# Over the MCP's limit the message is shortened rather than rejected: the call sites
# mostly discard the exit status, so a rejection would arrive as silence.
rm -f "$PUSH_LOG"
long_message="$(printf 'x%.0s' $(seq 1 400))"
NOTIFY_JOSH_FORCE_PUSH=1 "$root/bin/notify-josh" 'Title' "$long_message" || true
grep -Fq 'len=150' "$PUSH_LOG"

# The title is capped at 50 too; a long one used to be rejected and drop the push.
rm -f "$PUSH_LOG"
long_title="$(printf 'y%.0s' $(seq 1 80))"
NOTIFY_JOSH_FORCE_PUSH=1 "$root/bin/notify-josh" "$long_title" 'Body' || true
grep -Fq 'title=50' "$PUSH_LOG"

printf 'notify-josh tests passed\n'
