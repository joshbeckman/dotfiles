// --- benchmark recommendation -----------------------------------------------

const BENCH_MODELS = [
  model("claude-opus-5-5", 4, 20),
  model("claude-haiku-4-5", 0.25, 1),
  model("accounts/fireworks/models/glm-5p3", 0.4, 1.2), // pi path-prefixes it and spells the dot as "p"
  model("gpt-6-sol", 2, 8),
