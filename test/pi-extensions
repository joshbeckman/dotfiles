async function recommend(params, options = {}) {
  const pi = fakePi();
  modelSwitch(pi.api);
  const result = await pi.tools.switch_model.execute("call-1", params, undefined, undefined,
    contextFor(options.current ?? model("claude-opus-5-5", 4, 20), options.available ?? BENCH_MODELS, new Set(BENCH_MODELS.map((m) => m.id))));
  return { pi, result, text: result.content.map((part) => part.text).join("\n") };
}

{
  const { text } = await recommend({ class: "coding", topPercent: 50 });
  const lines = text.split("\n");
  const ranked = lines.filter((line) => line.startsWith("| ") && !line.includes("---") && !line.startsWith("| Model"));
  check("the recommendation names the class and the cutoff", text.includes("coding candidates") && text.includes("top 50%"), lines[0]);
  const prices = ranked.map((line) => Number(line.split("|")[4].trim().replace("$", "").split("/")[0]));
  check("rows are cheapest first", prices.every((value, index) => index === 0 || value >= prices[index - 1]), ranked.join(" | "));
  const cutoff = Number(text.match(/score >= (\d+)/)?.[1]);
  const scores = ranked.map((line) => Number(line.split("|")[2].trim()));
  check("every listed row clears the stated cutoff", scores.every((score) => score >= cutoff), `${scores} vs ${cutoff}`);
  check("the most capable qualifying model is listed", ranked.some((l) => l.includes("claude-opus-5-5")), ranked.join(" | "));
  check("a model below the tier is left out", !ranked.some((l) => l.includes("haiku")), ranked.join(" | "));
  check("a model measured on one of the class's inputs is still ranked", ranked.some((l) => l.includes("half-covered")), ranked.join(" | "));
  check("and its partial coverage is visible", /half-covered\D+\d+ \| 1\/2/.test(text), ranked.find((l) => l.includes("half-covered")));
  check("a model below the cutoff is not reported as unmapped", !text.includes("no benchmark data: ") || !text.includes("glm-5p3"), text);
  check("models the catalog lacks are reported", text.includes("nemotron-3-ultra-nvfp4") && text.includes("no benchmark data"), text.split("\n").pop());
  check("the snapshot date and price basis are stated", text.includes("Snapshot:") && text.includes("pi's list price"), text);
