#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
command="$root/bin/agent-mail"
real_nvim="$(command -v nvim || true)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/bin"

cat >"$tmp/bin/notify-josh" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >>"$NOTIFY_LOG"
EOF
cat >"$tmp/bin/nvim" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >"$EDITOR_LOG"
printf '%s\n' "$PWD" >"$EDITOR_CWD_LOG"
EOF
chmod +x "$tmp/bin/notify-josh" "$tmp/bin/nvim"
export AGENT_MAIL_ROOT="$tmp/mail"
export AGENT_HUMAN_MAIL_ROOT="$tmp/humans"
export NOTIFY_LOG="$tmp/notifications"
export EDITOR_LOG="$tmp/editor"
export EDITOR_CWD_LOG="$tmp/editor-cwd"
export AGENT_MAIL_EDITOR=nvim
export PATH="$tmp/bin:$PATH"

mkdir -p "$tmp/shared/default-agent"
default_id="$(env -u AGENT_MAIL_ROOT AGENT_SCRATCH_ROOT="$tmp/shared" "$command" send --to default-agent --from test-agent --subject 'Persistent root' --body 'Shared state.')"
[[ -f "$tmp/shared/default-agent/inbox/new/$default_id.md" ]]

msgid="$("$command" send --to @josh --from test-agent --subject 'Needs attention' --body 'Please review this.')"
[[ "$msgid" =~ ^[0-9]{8}T[0-9]{6}Z--from-test-agent--to-josh--needs-attention--[0-9]+-[0-9]+$ ]]
mail_root="$(CDPATH= cd -- "$tmp/mail" && pwd -P)"
human_root="$(CDPATH= cd -- "$tmp/humans" && pwd -P)"
inbox="$human_root/josh/inbox"
[[ -f "$inbox/new/$msgid.md" ]]
grep -Fxq "Message-ID: $msgid" "$inbox/new/$msgid.md"
grep -Fxq "Thread-ID: $msgid" "$inbox/new/$msgid.md"
[[ -d "$inbox/.escalated-$msgid" ]]
grep -Fq 'Agent mail: Needs attention' "$NOTIFY_LOG"
grep -Fq 'From test-agent. Read with: agent-mail read --to @josh' "$NOTIFY_LOG"
grep -Fq -- '--execute /usr/bin/open -na Ghostty.app --args -e /bin/zsh -lic' "$NOTIFY_LOG"
grep -Fq 'agent-mail\ inbox\ @josh' "$NOTIFY_LOG"
[[ "$("$command" addr @josh)" == "$inbox" ]]
[[ "$("$command" addr josh)" == "$inbox" ]]
"$command" scan --to @josh | grep -Fq "$msgid"
"$command" sweep --hours 0 >/dev/null
[[ "$(wc -l <"$NOTIFY_LOG" | tr -d ' ')" == 1 ]]

"$command" read --to @josh | grep -Fq 'Please review this.'
message="$inbox/cur/$msgid.md"
[[ -f "$message" ]]
[[ ! -e "$inbox/.escalated-$msgid" ]]
"$command" receipt "$msgid" | grep -Fq $'read\t'

mkdir -p "$mail_root/test-agent-session"

before_invalid="$(find "$inbox/new" -type f | wc -l | tr -d ' ')"
if "$command" send --to @josh --to missing-agent --subject 'Must not partially deliver' --body 'no' >/dev/null 2>&1; then
    echo 'multi-recipient send unexpectedly accepted a missing recipient' >&2
    exit 1
fi
[[ "$(find "$inbox/new" -type f | wc -l | tr -d ' ')" == "$before_invalid" ]]

multi_id="$(printf 'Shared body.\n' | "$command" send --to '@josh, @+test-agent' --to @josh --from test-agent --subject 'Shared update')"
multi_agent="$mail_root/test-agent-session/inbox/new/$multi_id.md"
multi_human="$inbox/new/$multi_id.md"
[[ -f "$multi_agent" && -f "$multi_human" ]]
[[ "$multi_id" == *'--from-test-agent--to-josh+test-agent--shared-update--'* ]]
grep -Fxq 'To: josh, test-agent' "$multi_agent"
grep -Fq 'Shared body.' "$multi_agent"
cmp -s "$multi_agent" "$multi_human"
[[ "$("$command" receipt "$multi_id" | wc -l | tr -d ' ')" == 2 ]]

draft="$("$command" reply "$message")"
[[ "$draft" == "$human_root/josh/drafts/"*.md ]]
grep -Fxq 'From: josh' "$draft"
grep -Fxq 'To: test-agent' "$draft"
grep -Fxq "In-Reply-To: $msgid" "$draft"
grep -Fxq "Thread-ID: $msgid" "$draft"
grep -Fxq 'Subject: Re: Needs attention' "$draft"
[[ "$(basename "$draft" .md)" =~ ^[0-9]{8}T[0-9]{6}Z--from-josh--to-test-agent--re-needs-attention--[0-9]+-[0-9]+$ ]]
printf 'Reply body.\n' >>"$draft"

delivered="$("$command" deliver "$draft")"
[[ "$delivered" == "$mail_root/test-agent-session/inbox/new/"*.md ]]
grep -Fq 'Reply body.' "$delivered"
archived="$("$command" archive "$delivered")"
[[ "$archived" == "$mail_root/test-agent-session/inbox/cur/"*.md ]]
[[ -f "$archived" ]]
grep -Fxq "Thread-ID: $msgid" "$archived"

reply_id="$("$command" send --to @josh --from test-agent --in-reply-to "$(basename "$archived" .md)" --subject 'Re: Needs attention' --body 'Following up.')"
grep -Fxq "Thread-ID: $msgid" "$inbox/new/$reply_id.md"
grep -Fxq "In-Reply-To: $(basename "$archived" .md)" "$inbox/new/$reply_id.md"

mkdir "$inbox/.escalated-orphan"
"$command" inbox @josh
[[ ! -e "$inbox/.escalated-orphan" ]]
[[ "$(cat "$EDITOR_LOG")" == "." ]]
[[ "$(cat "$EDITOR_CWD_LOG")" == "$inbox" ]]

"$command" inbox @+test-agent
[[ "$(cat "$EDITOR_LOG")" == "." ]]
[[ "$(cat "$EDITOR_CWD_LOG")" == "$mail_root/test-agent-session/inbox" ]]
if "$command" send --to '../../outside' --body 'no' >/dev/null 2>&1; then
    echo 'path-like recipient unexpectedly accepted' >&2
    exit 1
fi

mkdir -p "$tmp/physical/josh/inbox/new"
physical_root="$(CDPATH= cd -- "$tmp/physical" && pwd -P)"
ln -s "$tmp/physical" "$tmp/alias"
printf 'Subject: alias test\n\nbody\n' >"$physical_root/josh/inbox/new/alias.md"
alias_archived="$(AGENT_HUMAN_MAIL_ROOT="$tmp/alias" "$command" archive "$physical_root/josh/inbox/new/alias.md")"
[[ "$alias_archived" == "$physical_root/josh/inbox/cur/alias.md" ]]
[[ -f "$alias_archived" ]]

if [[ -n "$real_nvim" ]]; then
    env -u AGENT_MAIL_ROOT AGENT_SCRATCH_ROOT="$tmp/shared" AGENT_HUMAN_MAIL_ROOT="$tmp/humans" "$real_nvim" --headless -u NONE \
        --cmd "set runtimepath+=$root/.config/nvim" --cmd 'filetype plugin on' "$tmp/shared/default-agent/inbox/new/$default_id.md" \
        "+if exists(':AgentMailArchive') != 2 | cquit 1 | endif" +quit

    check_nvim_command() {
        local file="$1" name="$2" expected="$3" mail_root="${4:-$tmp/mail}"
        AGENT_MAIL_ROOT="$mail_root" AGENT_HUMAN_MAIL_ROOT="$tmp/humans" "$real_nvim" --headless -u NONE \
            --cmd "set runtimepath+=$root/.config/nvim" --cmd 'filetype plugin on' "$file" \
            "+if exists(':$name') != $expected | cquit 1 | endif" +quit
    }
    check_nvim_mapping() {
        local file="$1" lhs="$2" command="$3"
        AGENT_MAIL_ROOT="$tmp/mail" AGENT_HUMAN_MAIL_ROOT="$tmp/humans" "$real_nvim" --headless -u NONE \
            --cmd 'let mapleader=" "' --cmd "set runtimepath+=$root/.config/nvim" --cmd 'filetype plugin on' "$file" \
            "+let m=maparg('$lhs','n',0,1) | if get(m,'buffer',0) != 1 || get(m,'rhs','') !~# '$command' | cquit 1 | endif" +quit
    }
    check_nvim_command "$message" AgentMailReply 2
    check_nvim_command "$message" AgentMailArchive 0
    check_nvim_command "$archived" AgentMailReply 2
    check_nvim_command "$archived" AgentMailArchive 0

    draft="$("$command" reply "$archived")"
    check_nvim_command "$draft" AgentMailSend 2
    check_nvim_command "$draft" AgentMailReply 0
    check_nvim_mapping "$inbox/new/$reply_id.md" ' e' AgentMailArchive
    check_nvim_mapping "$inbox/new/$reply_id.md" ' r' AgentMailReply
    check_nvim_mapping "$archived" ' r' AgentMailReply
    check_nvim_mapping "$draft" ' d' AgentMailSend

    ln -s "$tmp/mail" "$tmp/mail-link"
    check_nvim_command "$archived" AgentMailReply 2 "$tmp/mail-link"

    AGENT_MAIL_ROOT="$tmp/mail" AGENT_HUMAN_MAIL_ROOT="$tmp/humans" "$real_nvim" --headless -u NONE \
        --cmd "set runtimepath+=$root/.config/nvim" --cmd 'filetype plugin on' "$archived" \
        '+AgentMailReply' "+if exists(':AgentMailSend') != 2 | cquit 1 | endif" '+qa!'

    nvim_message="$inbox/new/nvim-archive.md"
    nvim_archive_script="$tmp/nvim-archive.vim"
    printf 'From: test-agent\nTo: josh\nSubject: archive in Neovim\n\nbody\n' >"$nvim_message"
    cat >"$nvim_archive_script" <<EOF
let g:netrw_liststyle=3
execute 'Explore ' . fnameescape('$inbox')
call search('new/')
execute "normal \\<CR>"
if search('nvim-archive.md') == 0 | cquit 1 | endif
execute 'edit ' . fnameescape('$nvim_message')
AgentMailArchive
if &filetype !=# 'netrw' | cquit 1 | endif
if search('nvim-archive.md') != 0 | cquit 1 | endif
qa!
EOF
    AGENT_MAIL_ROOT="$tmp/mail" AGENT_HUMAN_MAIL_ROOT="$tmp/humans" "$real_nvim" --headless -u NONE \
        --cmd "set runtimepath+=$root/.config/nvim" --cmd 'filetype plugin on' --cmd 'runtime plugin/netrwPlugin.vim' \
        -S "$nvim_archive_script"
    [[ -f "$inbox/cur/nvim-archive.md" ]]
fi

printf 'agent-mail tests passed\n'
