#!/usr/bin/env bash
# The alarm watches mirror-failures.d/ beside the store marker, which is the parent of the human mail
# root. AGENT_MAIL_ROOT names the scratchpads root, so anything there is a decoy.
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
state="$tmp/state"
mkdir -p "$state/humans" "$state/mirror-failures.d/repaired" "$tmp/bin" "$tmp/scratchpads"
sent="$tmp/sent"
cat > "$tmp/bin/agent-mail" <<'FAKE'
#!/bin/sh
if [ "${1:-}" = "store" ]; then printf '%s\tmarker:/x\tdb:/y\n' "${AGENT_MAIL_TEST_MODE:-sqlite}"; exit 0; fi
[ "${1:-}" = "send" ] || exit 0
printf 'SEND\n' >> "$AGENT_MAIL_TEST_SENT"
while [ $# -gt 0 ]; do
  case "$1" in
    --subject) printf 'SUBJECT %s\n' "$2" >> "$AGENT_MAIL_TEST_SENT"; shift ;;
    --body-file) cat "$2" >> "$AGENT_MAIL_TEST_SENT" ;;
  esac
  shift
done
FAKE
cat > "$tmp/bin/agent-mail-migrate" <<'FAKE'
#!/bin/sh
exit "${AGENT_MAIL_TEST_VERIFY_EXIT:-0}"
FAKE
chmod +x "$tmp/bin/agent-mail" "$tmp/bin/agent-mail-migrate"
run() {
  AGENT_HUMAN_MAIL_ROOT="$state/humans" AGENT_MAIL_ROOT="$tmp/scratchpads" \
    AGENT_MAIL_TEST_SENT="$sent" PATH="$tmp/bin:$PATH" "$ROOT/bin/agent-mail-verify"
}
reset_state() {
  rm -rf "$state/mirror-failures.d" "$state/mirror-failures" "$state/mirror-failures.retired-bytes" "$state/migration-finished"
  mkdir -p "$state/mirror-failures.d/repaired"
  : > "$sent"
}
fail=0
check() { if [ "$1" = "$2" ]; then echo "  ok: $3"; else echo "  FAIL: $3 (wanted $2, got $1)"; fail=1; fi; }
subject() { grep '^SUBJECT ' "$sent" | head -1 | cut -d' ' -f2- || true; }
body() { grep -v '^SEND\|^SUBJECT' "$sent" || true; }
want() { case "$2" in *"$3"*) echo "  ok: $1" ;; *) echo "  FAIL: $1 (got $2)"; fail=1 ;; esac; }
want_not() { case "$2" in *"$3"*) echo "  FAIL: $1"; fail=1 ;; *) echo "  ok: $1" ;; esac; }
count() { grep -c '^SEND' "$sent" || true; }

reset_state; run
check "$(count)" "0" "a clean mirror stays silent"

# The live box has no mirror-failures.d until the new writer lands, so the alarm has to survive its
# absence rather than aborting on a missing directory.
: > "$sent"; rm -rf "$state/mirror-failures.d"; run
check "$(count)" "0" "a missing failure directory is not an error"

reset_state; printf 'when\tid\tsend\tjosh\terror\n' > "$state/mirror-failures.d/one"; run
check "$(count)" "1" "a failure file raises the alarm"
want "the subject names missing mail" "$(subject)" "mail missing from SQLite"
want "the body names the repair" "$(body)" "--replay-failures"

reset_state; printf 'partial\n' > "$state/mirror-failures.d/.one.tmp"; run
check "$(count)" "0" "a file still being written is ignored"

# A legacy mirror-failures is not renamed when retired, so its checked length lives in
# mirror-failures.retired-bytes and only the tail past it is pending. Reading the file directly would
# fire forever on retired lines, so the alarm leaves the legacy file to --verify and stays silent
# when verify is clean.
reset_state; printf 'when\tid\tread\tjosh\terror\n' > "$state/mirror-failures"; printf '120\n' > "$state/mirror-failures.retired-bytes"; run
check "$(count)" "0" "a retired legacy log does not raise on its own"

reset_state; printf 'when\tid\tsend\tjosh\terror\n' > "$state/mirror-failures.d/one"; AGENT_MAIL_TEST_MODE=both run
want "under both it still says mirror drifted" "$(subject)" "mirror drifted"

reset_state; printf 'when\tid\tsend\tjosh\terror\n' > "$state/mirror-failures.d/repaired/one"; run
check "$(count)" "1" "repaired records remind"
want "the reminder subject says what it is" "$(subject)" "waiting to be finished"
if grep -q 'reminder to run --finish' "$sent"; then echo "  ok: the reminder says what it is"; else echo "  FAIL: reminder wording missing"; fail=1; fi

reset_state; : > "$state/migration-finished"; printf 'when\tid\tsend\tjosh\terror\n' > "$state/mirror-failures.d/repaired/one"; run
check "$(count)" "0" "a finished migration stops reminding"

reset_state; printf 'decoy\n' > "$tmp/scratchpads/mirror-failures"; mkdir -p "$tmp/scratchpads/mirror-failures.d"; printf 'decoy\n' > "$tmp/scratchpads/mirror-failures.d/one"; run
check "$(count)" "0" "a failure log in the scratchpads root is ignored"

reset_state; AGENT_MAIL_TEST_VERIFY_EXIT=1 run || true
check "$(count)" "1" "a failed verify raises the alarm"

reset_state; AGENT_MAIL_TEST_VERIFY_EXIT=1 run || true
want "the failed-verify subject says so" "$(subject)" "SQLite does not verify"
want "the body names the pre-flip record" "$(body)" "pre-flip record"
want_not "the body does not point at the archives" "$(body)" "archives/"

# --verify reports unrepaired records too, so with one pending record both this scan and verify fail.
# That is one fault, and a subject claiming two would be untrue.
reset_state; printf 'when\tid\tsend\tjosh\terror\n' > "$state/mirror-failures.d/one"
AGENT_MAIL_TEST_VERIFY_EXIT=1 run || true
want "one pending record does not claim two faults" "$(subject)" "mail missing from SQLite"
want_not "and the subject does not say verify failed" "$(subject)" "did not verify"
# Verify fails for the pending record, so the body must not send the reader after corruption or a
# Maildir restore. Verify's own message stays, which is where a second fault would show.
want_not "the body does not blame corruption" "$(body)" "integrity check failed"
want_not "the body does not offer a Maildir restore" "$(body)" "pre-flip record"

# 3 and 4 mean verified with completeness unchecked: a standing condition, logged rather than mailed.
for code in 3 4; do
  reset_state; AGENT_MAIL_TEST_VERIFY_EXIT=$code run 2>/dev/null || true
  check "$(count)" "0" "verify exit $code does not raise the alarm"
done

[ "$fail" = 0 ] && echo "agent-mail-verify tests passed" || { echo "agent-mail-verify tests failed"; exit 1; }
