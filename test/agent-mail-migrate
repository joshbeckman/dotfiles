#!/usr/bin/env bash
# The migrator reads the Maildir, so its tests build one by hand and check that the
# database it produces matches what the directories say.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

export PATH="$root/bin:$PATH"
export AGENT_SCRATCH_ROOT="$tmp/scratchpads"
export AGENT_MAIL2_DB="$tmp/mail2.sqlite3"
# An empty registry, so the real one on this machine can never change what a test sees.
export AGENT_IDENTITIES_DIR="$tmp/identities/by-name"
mkdir -p "$AGENT_IDENTITIES_DIR"

agent1="alder-agent-11111111"
agent2="birch-agent-22222222"
mkdir -p "$AGENT_SCRATCH_ROOT/$agent1/inbox/new" "$AGENT_SCRATCH_ROOT/$agent1/inbox/cur"
mkdir -p "$AGENT_SCRATCH_ROOT/$agent2/inbox/new" "$AGENT_SCRATCH_ROOT/$agent2/inbox/cur"
mkdir -p "$tmp/humans/josh/inbox/new" "$tmp/humans/josh/sent"

write_message() {
  local path="$1" from="$2" to="$3" date="$4" id="$5" thread="$6" reply_to="$7" subject="$8" body="$9"
  {
    printf 'From: %s\n' "$from"
    printf 'To: %s\n' "$to"
    printf 'Date: %s\n' "$date"
    printf 'Message-ID: %s\n' "$id"
    printf 'Thread-ID: %s\n' "$thread"
    [ -z "$reply_to" ] || printf 'In-Reply-To: %s\n' "$reply_to"
    printf 'Subject: %s\n\n' "$subject"
    printf '%s\n' "$body"
  } > "$path"
}

a="20261001T100000Z--from-$agent1--to-$agent2--first--1-1"
b="20261001T110000Z--from-$agent2--to-$agent1--second--2-2"
c="20261001T120000Z--from-$agent1--to-$agent1,--to-$agent2--both--3-3"
d="20261002T090000Z--from-josh--to-$agent1--human--4-4"

# A opens a thread; B replies to it; C goes to both. C lands in two inboxes, which must
# become one message with two recipients rather than two messages.
write_message "$AGENT_SCRATCH_ROOT/$agent2/inbox/new/$a.md" "$agent1" "$agent2" "2026-10-01T10:00:00Z" "$a" "$a" "" "First" "one"
write_message "$AGENT_SCRATCH_ROOT/$agent1/inbox/cur/$b.md" "$agent2" "$agent1" "2026-10-01T11:00:00Z" "$b" "$a" "$a" "Second" "two"
write_message "$AGENT_SCRATCH_ROOT/$agent1/inbox/new/$c.md" "$agent1" "$agent2" "2026-10-01T12:00:00Z" "$c" "$a" "" "Both" "three"
write_message "$AGENT_SCRATCH_ROOT/$agent2/inbox/new/$c.md" "$agent1" "$agent2" "2026-10-01T12:00:00Z" "$c" "$a" "" "Both" "three"
# A human's sent copy is redundant where an inbox copy exists, since the From header
# names the sender; it is read as a fallback, which is what this message exercises.
write_message "$tmp/humans/josh/sent/$d.md" "josh" "$agent1" "2026-10-02T09:00:00Z" "$d" "$d" "" "Human" "four"
write_message "$AGENT_SCRATCH_ROOT/$agent1/inbox/new/$d.md" "josh" "$agent1" "2026-10-02T09:00:00Z" "$d" "$d" "" "Human" "four"

AGENT_MAIL2_DB="$AGENT_MAIL2_DB" agent-mail-migrate --agent-root "$AGENT_SCRATCH_ROOT" \
  --human-root "$tmp/humans" >/dev/null

python3 - "$AGENT_MAIL2_DB" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
db.row_factory = sqlite3.Row
one = lambda sql, *p: db.execute(sql, p).fetchone()[0]

assert one("select count(*) from messages") == 4, "expected four distinct messages"
assert one("select count(*) from threads") == 2, "expected two threads"
# A to agent2, B to agent1, C to both, D to agent1.
assert one("select count(*) from message_recipients") == 5
assert one("select count(*) from deliveries") == 5
# C reached two inboxes but is one message addressed to two mailboxes.
assert one("select count(*) from message_recipients where message_id = ?", "20261001T120000Z--from-alder-agent-11111111--to-alder-agent-11111111,--to-birch-agent-22222222--both--3-3") == 2
# The thread is ordered by the Date header, and the reply points at the opening message.
thread = db.execute("select thread_id from messages where sequence = 1 and sender_mailbox_id = 'alder-agent-11111111' limit 1").fetchone()[0]
rows = db.execute("select sequence, sender_mailbox_id from messages where thread_id = ? order by sequence", (thread,)).fetchall()
assert [r["sequence"] for r in rows] == [1, 2, 3], [r["sequence"] for r in rows]
assert [r["sender_mailbox_id"] for r in rows] == ["alder-agent-11111111", "birch-agent-22222222", "alder-agent-11111111"]
# Read state comes from the folder: cur/ is read, new/ is unread.
assert one("select read_at from deliveries where message_id = ? and recipient_mailbox_id = ?", "20261001T110000Z--from-birch-agent-22222222--to-alder-agent-11111111--second--2-2", "alder-agent-11111111") is not None
assert one("select read_at from deliveries where message_id = ? and recipient_mailbox_id = ?", "20261001T100000Z--from-alder-agent-11111111--to-birch-agent-22222222--first--1-1", "birch-agent-22222222") is None
# The human is a human mailbox, not an agent.
assert db.execute("select kind from mailboxes where mailbox_id = 'josh'").fetchone()[0] == "human"
PY

# Re-running changes nothing: the migrator is idempotent.
AGENT_MAIL2_DB="$AGENT_MAIL2_DB" agent-mail-migrate --agent-root "$AGENT_SCRATCH_ROOT" \
  --human-root "$tmp/humans" >/dev/null
python3 - "$AGENT_MAIL2_DB" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
assert db.execute("select count(*) from messages").fetchone()[0] == 4
assert db.execute("select count(*) from deliveries").fetchone()[0] == 5
PY

# --verify reconciles the Maildir against the database.
AGENT_MAIL2_DB="$AGENT_MAIL2_DB" agent-mail-migrate --verify --agent-root "$AGENT_SCRATCH_ROOT" \
  --human-root "$tmp/humans" | grep -qx verified

migrate() {
  agent-mail-migrate --agent-root "$AGENT_SCRATCH_ROOT" --human-root "$tmp/humans" "$@"
}

# Reading in v1 moves a file to cur/; a re-run carries that into the database.
mv "$AGENT_SCRATCH_ROOT/$agent2/inbox/new/$a.md" "$AGENT_SCRATCH_ROOT/$agent2/inbox/cur/$a.md"
# v1's discard deletes the file. A re-run after that, with a new reply in the same thread,
# must not reuse the sequence the shorter Maildir group would suggest.
rm "$AGENT_SCRATCH_ROOT/$agent2/inbox/new/$c.md"
e="20261003T090000Z--from-$agent1--to-$agent2--fifth--5-5"
write_message "$AGENT_SCRATCH_ROOT/$agent2/inbox/new/$e.md" "$agent1" "$agent2" "2026-10-03T09:00:00Z" "$e" "$a" "$c" "Fifth" "five"
migrate >/dev/null
python3 - "$AGENT_MAIL2_DB" "$a" "$c" "$e" "$agent1" "$agent2" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
a, c, e, agent1, agent2 = sys.argv[2:]
state = lambda m, r: db.execute("select read_at, discarded_at from deliveries where message_id = ? and recipient_mailbox_id = ?", (m, r)).fetchone()
assert state(a, agent2)[0] is not None, "a read in v1 stayed unread in the database"
assert state(c, agent2)[1] is not None, "a discard in v1 was not carried over"
assert state(c, agent1) == (None, None), "the other recipient's copy must be untouched"
assert db.execute("select sequence from messages where message_id = ?", (e,)).fetchone()[0] == 4
assert db.execute("select reply_to_message_id from messages where message_id = ?", (e,)).fetchone()[0] == c
PY
migrate --verify | grep -qx verified

# A mailbox whose inbox has gone is not read as having discarded everything.
mv "$AGENT_SCRATCH_ROOT/$agent1" "$tmp/pruned"
migrate >/dev/null
python3 - "$AGENT_MAIL2_DB" "$agent1" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
assert db.execute("select count(*) from deliveries where recipient_mailbox_id = ? and discarded_at is not null", (sys.argv[2],)).fetchone()[0] == 0
PY
mv "$tmp/pruned" "$AGENT_SCRATCH_ROOT/$agent1"

# --verify compares state and content, not just presence.
python3 - "$AGENT_MAIL2_DB" "$a" "$agent2" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
db.execute("update deliveries set read_at = null where message_id = ? and recipient_mailbox_id = ?", sys.argv[2:])
db.commit()
PY
set +e
migrate --verify >"$tmp/verify-out" 2>"$tmp/verify-err"
status=$?
set -e
[[ "$status" == 1 ]]
grep -Fq "$a is read for $agent2 in the Maildir, unread in the database" "$tmp/verify-err"
migrate >/dev/null
migrate --verify | grep -qx verified

# Sent mail whose every recipient copy is gone keeps its audience, without a delivery.
f="20261004T090000Z--from-josh--to-gone--orphan--6-6"
write_message "$tmp/humans/josh/sent/$f.md" "josh" "gone-agent-99999999, $agent2" "2026-10-04T09:00:00Z" "$f" "$f" "" "Orphan" "nobody kept it"
migrate >/dev/null
python3 - "$AGENT_MAIL2_DB" "$f" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
assert sorted(r[0] for r in db.execute("select recipient_mailbox_id from message_recipients where message_id = ?", (sys.argv[2],))) == ["birch-agent-22222222", "gone-agent-99999999"]
assert db.execute("select count(*) from deliveries where message_id = ?", (sys.argv[2],)).fetchone()[0] == 0
PY
migrate --verify | grep -qx verified
# One copy gone and one surviving: the gone recipient stays in the audience, and a To entry that
# is only the handle of a surviving copy's mailbox is not added twice.
g="20261005T090000Z--from-josh--to-partial--7-7"
write_message "$tmp/humans/josh/sent/$g.md" "josh" "pruned-agent-77777777, birch-agent" "2026-10-05T09:00:00Z" "$g" "$g" "" "Partial" "half kept"
write_message "$AGENT_SCRATCH_ROOT/$agent2/inbox/new/$g.md" "josh" "pruned-agent-77777777, birch-agent" "2026-10-05T09:00:00Z" "$g" "$g" "" "Partial" "half kept"
migrate >/dev/null
python3 - "$AGENT_MAIL2_DB" "$g" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
assert sorted(r[0] for r in db.execute("select recipient_mailbox_id from message_recipients where message_id = ?", (sys.argv[2],))) == ["birch-agent-22222222", "pruned-agent-77777777"]
assert [r[0] for r in db.execute("select recipient_mailbox_id from deliveries where message_id = ?", (sys.argv[2],))] == ["birch-agent-22222222"]
PY
migrate --verify | grep -qx verified

# A From header written before a session was renamed to the realm-suffixed convention names a
# handle no pad has. bin/agent-mail resolves that name through the identity registry and
# reaches the canonical pad, so the store must record the same mailbox: otherwise one seat
# owns its deliveries under one id and its sent mail under another, and no query joins them.
# Both claims exist before the first run: canonicalization is read from the registry at
# migration time, and rows are append-only, so a registry that changes later makes --verify
# disagree with rows already written. The repair is a fresh database, not an incremental run.
printf '11111111-1111-1111-1111-111111111111\n' > "$AGENT_IDENTITIES_DIR/alder-agent-of-testland"
printf '22222222-2222-2222-2222-222222222222\n' > "$AGENT_IDENTITIES_DIR/birch-agent-of-testland"
renamed_db="$tmp/renamed.sqlite3"
h="20261006T090000Z--from-$agent1--to-josh--renamed--8-8"
write_message "$AGENT_SCRATCH_ROOT/$agent1/inbox/new/$h.md" "$agent1" "josh" "2026-10-06T09:00:00Z" "$h" "$h" "" "Renamed" "after the rename"
AGENT_MAIL2_DB="$renamed_db" migrate >/dev/null
python3 - "$renamed_db" "$agent1" "$h" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
agent1, message = sys.argv[2], sys.argv[3]
sender = db.execute("select sender_mailbox_id from messages where message_id = ?", (message,)).fetchone()[0]
assert sender == "alder-agent-of-testland-11111111", sender
assert db.execute("select count(*) from messages where sender_mailbox_id = ?", (agent1,)).fetchone()[0] == 0, "the stale name kept sent mail"
PY
# A name that already carries the realm is not rewritten again.
i="20261007T090000Z--from-birch-agent-of-testland-22222222--to-josh--canonical--9-9"
write_message "$AGENT_SCRATCH_ROOT/$agent2/inbox/new/$i.md" "birch-agent-of-testland-22222222" "josh" "2026-10-07T09:00:00Z" "$i" "$i" "" "Canonical" "already suffixed"
AGENT_MAIL2_DB="$renamed_db" migrate >/dev/null
python3 - "$renamed_db" "$i" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
assert db.execute("select sender_mailbox_id from messages where message_id = ?", (sys.argv[2],)).fetchone()[0] == "birch-agent-of-testland-22222222"
PY
AGENT_MAIL2_DB="$renamed_db" migrate --verify | grep -qx verified
rm "$AGENT_IDENTITIES_DIR/alder-agent-of-testland" "$AGENT_IDENTITIES_DIR/birch-agent-of-testland"

# A name that is not a session address is never rewritten, even with a claim of the same base.
printf '33333333-3333-3333-3333-333333333333\n' > "$AGENT_IDENTITIES_DIR/pr-monitor-of-testland"
j="20261008T090000Z--from-pr-monitor--to-josh--bare--10-10"
write_message "$tmp/humans/josh/sent/$j.md" "pr-monitor" "josh" "2026-10-08T09:00:00Z" "$j" "$j" "" "Bare" "no session suffix"
AGENT_MAIL2_DB="$renamed_db" migrate >/dev/null
python3 - "$renamed_db" "$j" <<'PY'
import sqlite3, sys
db = sqlite3.connect(sys.argv[1])
assert db.execute("select sender_mailbox_id from messages where message_id = ?", (sys.argv[2],)).fetchone()[0] == "pr-monitor"
PY
rm "$AGENT_IDENTITIES_DIR/pr-monitor-of-testland"

echo "agent-mail-migrate tests passed"
