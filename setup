#!/bin/zsh
set -euo pipefail

# A refresh must fail rather than wait for a terminal or open a merge editor.
exec </dev/null
export GIT_TERMINAL_PROMPT=0 GH_PROMPT_DISABLED=1

DOTFILES_DIR="${0:A:h}"

# utility functions

# The pinned commit for a plugin repository, from plugins.lock. An empty answer is
# an error at the call site: activating a plugin checkout that has no recorded
# commit is exactly the unpinned install this file exists to prevent.
function plugin_pin() {
        [ -f "$DOTFILES_DIR/plugins.lock" ] || return 0
        awk -v url="$1" '$1 !~ /^#/ && $2 == url { print $1; exit }' "$DOTFILES_DIR/plugins.lock"
}

# A shallow clone carries only the default branch, so a pin on any other commit has
# to be fetched by id; if the host will not serve that, fall back to a full fetch of
# the branches and tags, which reaches any published commit.
function fetch_pinned_commit() {
        local dest="$1" pin="$2"
        if ! git -C "$dest" fetch --quiet --depth 1 origin "$pin" 2>/dev/null; then
                git -C "$dest" fetch --quiet --tags origin '+refs/heads/*:refs/remotes/origin/*'
        fi
}

# A plugin is installed at the commit plugins.lock records, never at whatever a
# branch points to. Upstream plugin code runs in every shell, editor, and tmux here,
# so it is activated by a reviewed pin change rather than by the two-hour refresh.
function git_clone_or_update() {
        local url="$1" dest="$2" name pin current
        name=$(basename "$dest")
        pin=$(plugin_pin "$url")
        if [ -z "$pin" ]; then
                echo "  ======  no pinned commit for $url in plugins.lock; refusing to install it unpinned" >&2
                return 1
        fi
        if [ ! -d "$dest/.git" ]; then
                echo "  ======  cloning $name at $pin"
                # --no-checkout because a plain clone writes the default branch's
                # working tree first, which is upstream code nobody reviewed.
                git clone --quiet --depth 1 --no-checkout "$url" "$dest"
                if ! git -C "$dest" checkout --quiet --detach "$pin" 2>/dev/null; then
                        fetch_pinned_commit "$dest" "$pin"
                        git -C "$dest" checkout --quiet --detach "$pin"
                fi
                return 0
        fi
        current=$(git -C "$dest" rev-parse HEAD 2>/dev/null || true)
        if [ "$current" = "$pin" ]; then
                echo "  ======  $name is at its pinned commit"
                return 0
        fi
        # Said before the checkout happens, and in a shape bin/dotfiles-refresh
        # recognises, so a moved plugin commit is reported rather than replaced quietly.
        echo "  ======  plugin changed: $name ${current:-unknown} -> $pin"
        fetch_pinned_commit "$dest" "$pin"
        git -C "$dest" checkout --quiet --detach "$pin"
}

# The pinned release for one tool and release target, as "version sha256", from
# tools.lock. Both installers below refuse to run without an answer rather than
# falling back to whatever upstream calls latest.
function tool_pin() {
        [ -f "$DOTFILES_DIR/tools.lock" ] || return 0
        awk -v tool="$1" -v target="$2" '$1 !~ /^#/ && $1 == tool && $3 == target { print $2 " " $4; exit }' "$DOTFILES_DIR/tools.lock"
}

# macOS ships shasum, most Linuxes sha256sum. The expected digest comes from
# tools.lock rather than from beside the artifact: a substituted download can then
# only be accepted by a commit that also moves the pin.
function verify_sha256() {
        local file="$1" expected="$2" actual
        if command -v sha256sum > /dev/null 2>&1; then
                actual=$(sha256sum "$file" | awk '{ print $1 }')
        elif command -v shasum > /dev/null 2>&1; then
                actual=$(shasum -a 256 "$file" | awk '{ print $1 }')
        else
                echo "no sha256sum or shasum to verify $file" >&2
                return 1
        fi
        if [ -z "$expected" ] || [ "$actual" != "$expected" ]; then
                echo "checksum mismatch for $file: expected ${expected:-none}, got ${actual:-nothing}" >&2
                return 1
        fi
}

function symlink_agent_config() {
        local source_path="$1"
        local target_path="$2"

        mkdir -p "$(dirname "$target_path")"

        if [ -L "$target_path" ] || [ -f "$target_path" ]; then
                rm -f "$target_path"
        elif [ -d "$target_path" ]; then
                local backup_path="${target_path}.backup.$(date +%s)"
                echo "  ======  moving existing $target_path to $backup_path"
                mv "$target_path" "$backup_path"
        fi

        ln -s "$source_path" "$target_path"
}

# dfm's recurse into Library/LaunchAgents uses a plain mkdir and then chdir's into the
# result, without checking either. macOS always has ~/Library, so this is only a Linux
# problem, and there it fails silently: the mkdir cannot create the leaf because the
# parent is missing, the chdir leaves dfm sitting in $HOME, and the plists land as
# dangling symlinks in the home directory instead of the one they were built for. The
# link text is right for Library/LaunchAgents, which is how you can tell it was placed
# wrong rather than computed wrong. Making the directory first keeps dfm doing its own
# work, and survives a dfm version bump in a way patching the vendored copy would not.
mkdir -p "$HOME/Library/LaunchAgents"

# Retire old supervisors before dfm can relink obsolete resources.
"$DOTFILES_DIR/bin/retire-agent-automation"

# symlink up dotfiles
echo '  ======  installing dotfiles via dfm'
"$DOTFILES_DIR/bin/dfm" install
echo '  ======  installed dotfiles via dfm'

# shared coding-agent configuration
if [ ! -e "$HOME/.agents" ] && [ -d "$DOTFILES_DIR/.agents" ]; then
        ln -s "$DOTFILES_DIR/.agents" "$HOME/.agents"
fi

if [ -d "$HOME/.agents" ]; then
        echo '  ======  installing shared coding-agent config'
        mkdir -p "$HOME/.pi/agent"
        symlink_agent_config "$HOME/.agents/AGENTS.md" "$HOME/.pi/agent/AGENTS.md"
        symlink_agent_config "$HOME/.agents/prompts" "$HOME/.pi/agent/prompts"
        symlink_agent_config "$HOME/.agents/skills" "$HOME/.pi/agent/skills"
        symlink_agent_config "$HOME/.agents/pi/settings.json" "$HOME/.pi/agent/settings.json"
        symlink_agent_config "$HOME/.agents/pi/keybindings.json" "$HOME/.pi/agent/keybindings.json"
        echo '  ======  installed shared coding-agent config'
fi

# Val Town plugin — the platform skills for building on Val Town, loaded by Pi from
# the skills path in .agents/pi/settings.json. Cloned rather than vendored because
# the skills are upstream code, and pinned in plugins.lock like every other plugin.
echo '  ======  installing the Val Town plugin skills'
git_clone_or_update https://github.com/val-town/plugins "$HOME/.local/share/val-town-plugins"
echo '  ======  installed the Val Town plugin skills'

# zsh-specific things
echo '  ======  installing zsh plugins'
mkdir -p ~/.config/zsh
# install zsh plugins
git_clone_or_update https://github.com/zsh-users/zsh-syntax-highlighting.git ~/.config/zsh/zsh-syntax-highlighting
echo '  ======  installed zsh plugins'

# install tmux helpers
echo '  ======  installing tmux plugins'
mkdir -p ~/.config/tmux
git_clone_or_update https://github.com/laktak/extrakto ~/.config/tmux/extrakto
git_clone_or_update https://github.com/tmux-plugins/tmux-resurrect ~/.config/tmux/tmux-resurrect
git_clone_or_update https://github.com/tmux-plugins/tmux-continuum ~/.config/tmux/tmux-continuum
echo '  ======  installed tmux plugins'

# neovim-specific things
echo '  ======  installing neovim plugins'
mkdir -p ~/.local/share/nvim/site/pack/git-plugins/start
# install neovim plugins
git_clone_or_update https://github.com/dense-analysis/ale.git ~/.local/share/nvim/site/pack/git-plugins/start/ale
git_clone_or_update https://github.com/tpope/vim-fugitive.git ~/.local/share/nvim/site/pack/git-plugins/start/vim-fugitive
git_clone_or_update https://github.com/tpope/vim-rhubarb.git ~/.local/share/nvim/site/pack/git-plugins/start/vim-rhubarb
git_clone_or_update https://github.com/tpope/vim-surround.git ~/.local/share/nvim/site/pack/git-plugins/start/vim-surround
git_clone_or_update https://github.com/tpope/vim-repeat.git ~/.local/share/nvim/site/pack/git-plugins/start/vim-repeat
git_clone_or_update https://github.com/airblade/vim-gitgutter.git ~/.local/share/nvim/site/pack/git-plugins/start/vim-gitgutter
git_clone_or_update https://github.com/ruanyl/vim-gh-line.git ~/.local/share/nvim/site/pack/git-plugins/start/vim-gh-line
git_clone_or_update https://github.com/kana/vim-textobj-user.git ~/.local/share/nvim/site/pack/git-plugins/start/vim-textobj-user
git_clone_or_update https://github.com/tek/vim-textobj-ruby.git ~/.local/share/nvim/site/pack/git-plugins/start/vim-textobj-ruby
git_clone_or_update https://github.com/jiangmiao/auto-pairs.git ~/.local/share/nvim/site/pack/git-plugins/start/auto-pairs
git_clone_or_update https://github.com/maxmx03/solarized.nvim.git ~/.local/share/nvim/site/pack/git-plugins/start/solarized.nvim
git_clone_or_update https://github.com/junegunn/fzf.vim.git ~/.local/share/nvim/site/pack/git-plugins/start/fzf.vim
# git_clone_or_update https://github.com/thiagoalessio/rainbow_levels.vim.git ~/.local/share/nvim/site/pack/git-plugins/start/rainbow_levels.vim
# git_clone_or_update https://github.com/folke/zen-mode.nvim.git ~/.local/share/nvim/site/pack/git-plugins/start/zen-mode.nvim
echo '  ======  installed neovim plugins'

# nvim completion keywords are generated rather than versioned: the file is a
# roster of collaborators plus machine-local agent handles, which is both
# public-repo-unfriendly and stale on any other machine. init.vim references
# the file unconditionally, so it must at least exist.
echo '  ======  generating nvim completion keywords'
touch "$DOTFILES_DIR/.config/nvim/keywords.txt"
if command -v gh &> /dev/null; then
        "$DOTFILES_DIR/bin/gh-nvim-username-keywords" || echo 'gh username keyword generation failed (auth?); continuing'
        "$DOTFILES_DIR/bin/gh-nvim-labels-keywords" || echo 'gh label keyword generation failed (auth?); continuing'
        "$DOTFILES_DIR/bin/gh-nvim-repos-keywords" || echo 'gh repo keyword generation failed (auth?); continuing'
        "$DOTFILES_DIR/bin/gh-nvim-email-keywords" || echo 'gh email keyword generation failed (auth?); continuing'
fi
"$DOTFILES_DIR/bin/agent-nvim-keywords" || true
echo '  ======  generated nvim completion keywords'

__setup_ubuntu(){
        # Checked architectures only: arm64 was verified on Debian 13 (trixie),
        # where every package below exists for it. An unlisted architecture stops
        # here rather than failing partway through an apt install. The nix block
        # below still runs either way, since it does not go through apt.
        arch="$(dpkg --print-architecture)"
        case "$arch" in
                amd64 | arm64)
                        echo "Ubuntu detected ($arch)"
                        # exuberant-ctags was dropped after Debian 12 in favour of
                        # universal-ctags, and naming a package apt does not know
                        # fails the whole apt-get call rather than just that one.
                        if apt-cache show universal-ctags > /dev/null 2>&1; then
                                ctags_package=universal-ctags
                        else
                                ctags_package=exuberant-ctags
                        fi
                        # git-delta backs the `delta` pager in .gitconfig; the
                        # Brewfile covers it on macOS. unzip unpacks the pinned Deno
                        # release, which is a zip and cannot be read by tar.
                        sudo -n apt-get install -y ripgrep fzf "$ctags_package" xsel bat git-delta unzip
                        ;;
                *)
                        echo "Ubuntu detected, but not a checked architecture ($arch)"
                        __setup_unsupported
                        ;;
        esac
        # try — ephemeral workspace manager (github.com/tobi/try). The Brewfile
        # covers macOS; Linux has no Homebrew, so install the gem into the user's
        # gem home, which needs no sudo, and link only `try` into ~/.local/bin,
        # which is already on PATH. Putting the whole user-gem bin directory on
        # PATH would shadow system commands from every retained Ruby ABI.
        if command -v gem >/dev/null 2>&1; then
                gem list try-cli 2>/dev/null | grep -q '^try-cli ' || {
                        echo '  ======  installing try (try-cli)'
                        gem install --user-install --no-document try-cli || echo 'try install failed; continuing'
                }
                try_bin="$(ruby -e 'require "rubygems"; print Gem.bindir(Gem.user_dir)' 2>/dev/null)/try"
                if [ -x "$try_bin" ]; then
                        mkdir -p "$HOME/.local/bin"
                        ln -sf "$try_bin" "$HOME/.local/bin/try"
                fi
        fi
        if command -v nix-env &> /dev/null
        then
                echo "Nix detected"
                nix-env -iA nixpkgs.bash nixpkgs.git nixpkgs.ripgrep nixpkgs.fzf nixpkgs.ctags nixpkgs.bat
        fi
}

__setup_linux(){
        echo "Detected Linux!"
        echo "Checking distro..."
        if (uname -a | grep -qi "Microsoft"); then
    OS="ubuntuwsl"
  elif ! command -v lsb_release &> /dev/null; then
    echo "lsb_release could not be found. Falling back to /etc/os-release"
    OS="$(grep -Po '(?<=^ID=).*$' /etc/os-release | tr '[:upper:]' '[:lower:]')" 2>/dev/null
  else
    OS=$(lsb_release -i | awk '{ print $3 }' | tr '[:upper:]' '[:lower:]')
  fi
        case "$OS" in
                "ubuntu" | "ubuntuwsl" | "debian" | "linuxmint" | "parrot" | "kali" | "elementary" | "pop")
                        __setup_ubuntu;;
                *)
                        __setup_unsupported;;
        esac

        # The refresh schedule and panad. On macOS these are launchd jobs that dfm
        # links from Library/LaunchAgents; here they are user units, linked the same
        # way so that editing the unit in the repo is what the machine runs. Linking
        # is not enough on its own, so enable them, and say so rather than failing
        # when there is no user bus to enable them on: a container, or WSL without
        # systemd, still has every other part of setup to do.
        echo '  ======  installing the dotfiles refresh schedule'
        for unit in dotfiles-refresh.service dotfiles-refresh.timer panad.service; do
                unit_source="$DOTFILES_DIR/.config/systemd/user/$unit"
                [ -f "$unit_source" ] || continue
                symlink_agent_config "$unit_source" "$HOME/.config/systemd/user/$unit"
        done
        if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
                systemctl --user daemon-reload
                for timer in dotfiles-refresh.timer; do
                        systemctl --user enable --now "$timer" || echo "could not enable $timer; continuing"
                done
                # panad is a long-running service rather than a timer, and it needs a
                # config.json before it can start. Enabling is what survives the next
                # login; starting it here is only safe on a machine pana is set up for,
                # because Restart=on-failure would turn a missing config into a loop.
                if [ -f "$HOME/.config/systemd/user/panad.service" ]; then
                        systemctl --user enable panad.service || echo 'could not enable panad.service; continuing'
                        if [ -f "${XDG_STATE_HOME:-$HOME/.local/state}/pana/config.json" ]; then
                                systemctl --user restart panad.service || echo 'could not start panad.service; continuing'
                        fi
                fi
        else
                echo '  ======  no user systemd bus here; enable dotfiles-refresh.timer by hand, and panad.service too'
        fi
        echo '  ======  installed the dotfiles refresh schedule'
}

__setup_mac(){
        echo "Detected Mac!"

        # No application bundle is installed here. ~/Applications is also where Safari
        # puts a Dock web app, and setup used to move the foreign bundle aside and copy
        # its own launcher over it, which broke the installed app's Dock entry on every
        # refresh. Do not reintroduce a bundle at that path.

        if command -v brew &> /dev/null
        then
                # Privileged installers need a separate manual run; never quit running apps.
                local -x HOMEBREW_NO_ASK=1 HOMEBREW_NO_SUDO=1

                # A large bottle needs room for the new version while the old one is
                # still installed; llvm alone is several gigabytes. Without this check
                # the pour fails with dozens of "No space left on device" lines naming
                # individual archive members, which reads like a broken formula rather
                # than a full disk. Fail once, with the command that fixes it.
                local free_kb
                free_kb=$(df -Pk "$HOME" | awk 'NR==2 {print $4}')
                if [ "${free_kb:-0}" -lt 5242880 ]; then
                        echo "  ======  only $((free_kb / 1024)) MB free on $HOME; need 5 GB. Run $DOTFILES_DIR/bin/free-space." >&2
                        return 1
                fi

                echo "Refreshing your brew"
                brew update
                # Clean before upgrading as well as after: the pour needs the space.
                brew cleanup
                brew upgrade --no-ask --no-quit
                brew cleanup
                echo "Installing basics with brew bundle"
                brew bundle install --no-upgrade --file "$DOTFILES_DIR/Brewfile"
        else
                echo "Could not find brew"
        fi

}

__setup_unsupported(){
        echo "  ======  Unknown or unsupported OS or architecture"
}

case "$OSTYPE" in
  linux*)         __setup_linux ;;
  darwin*)        __setup_mac ;;
  *)              __setup_unsupported ;;
esac

# s — encrypted env store (github.com/tobi/s); prebuilt binary, no toolchain.
# Fetched here rather than Brewfile because it is not in homebrew. The release and
# the per-architecture digest come from tools.lock and the download is checked before
# anything is unpacked: this is the binary that unwraps every secret, so it is the
# last one that should be installed from a floating "latest".
if [ ! -x "$DOTFILES_DIR/bin/s" ]; then
        echo '  ======  installing s (encrypted env store)'
        case "$(uname -sm)" in
                "Darwin arm64") s_target="aarch64-apple-darwin" ;;
                "Darwin x86_64") s_target="x86_64-apple-darwin" ;;
                "Linux x86_64") s_target="x86_64-unknown-linux-musl" ;;
                "Linux aarch64") s_target="aarch64-unknown-linux-musl" ;;
                *) s_target="" ;;
        esac
        s_pin=""
        if [ -n "$s_target" ]; then
                s_pin=$(tool_pin s "$s_target")
        fi
        if [ -z "$s_target" ]; then
                echo "could not determine an s release for $(uname -sm); install manually from github.com/tobi/s"
        elif [ -z "$s_pin" ]; then
                echo "no s pin for $s_target in tools.lock; refusing to install an unverified binary" >&2
                exit 1
        else
                s_version=${s_pin%% *}
                s_sha256=${s_pin##* }
                s_tmp=$(mktemp -d)
                curl -fsSL -o "$s_tmp/s.tar.gz" "https://github.com/tobi/s/releases/download/$s_version/s-$s_version-$s_target.tar.gz"
                verify_sha256 "$s_tmp/s.tar.gz" "$s_sha256"
                tar -xzf "$s_tmp/s.tar.gz" -C "$DOTFILES_DIR/bin" s
                chmod +x "$DOTFILES_DIR/bin/s"
                rm -rf "$s_tmp"
        fi
fi

# deno + vt — the Val Town CLI. vt runs on Deno; both install into ~/.deno/bin,
# which .zshrc puts on PATH. User-local, so no sudo and no Brewfile entry. Deno's
# own installer is a `curl | sh` of a script that resolves "latest" when it runs,
# so the release zip named in tools.lock is fetched and checked instead.
if [ ! -x "$HOME/.deno/bin/deno" ]; then
        echo '  ======  installing Deno'
        case "$(uname -sm)" in
                "Darwin arm64") deno_target="aarch64-apple-darwin" ;;
                "Darwin x86_64") deno_target="x86_64-apple-darwin" ;;
                "Linux x86_64") deno_target="x86_64-unknown-linux-gnu" ;;
                "Linux aarch64") deno_target="aarch64-unknown-linux-gnu" ;;
                *) deno_target="" ;;
        esac
        deno_pin=""
        if [ -n "$deno_target" ]; then
                deno_pin=$(tool_pin deno "$deno_target")
        fi
        if [ -z "$deno_target" ]; then
                echo "could not determine a Deno release for $(uname -sm); install manually from deno.land"
        elif [ -z "$deno_pin" ]; then
                echo "no Deno pin for $deno_target in tools.lock; install manually from deno.land"
        else
                deno_version=${deno_pin%% *}
                deno_sha256=${deno_pin##* }
                deno_tmp=$(mktemp -d)
                if curl -fsSL -o "$deno_tmp/deno.zip" "https://github.com/denoland/deno/releases/download/$deno_version/deno-$deno_target.zip" \
                        && verify_sha256 "$deno_tmp/deno.zip" "$deno_sha256" \
                        && mkdir -p "$HOME/.deno/bin" \
                        && unzip -oq "$deno_tmp/deno.zip" -d "$HOME/.deno/bin"; then
                        chmod +x "$HOME/.deno/bin/deno"
                else
                        echo 'Deno install failed; continuing'
                fi
                rm -rf "$deno_tmp"
        fi
fi
if [ -x "$HOME/.deno/bin/deno" ] && [ ! -x "$HOME/.deno/bin/vt" ]; then
        echo '  ======  installing vt (Val Town CLI)'
        "$HOME/.deno/bin/deno" install -grAf jsr:@valtown/vt || echo 'vt install failed; continuing'
fi

# pi — update after config is linked and package managers have had a chance to install it
if command -v pi &> /dev/null; then
        echo '  ======  updating pi and pi packages'
        # Non-fatal: pi refuses to self-update when this machine's install method
        # does not match the npmCommand in .agents/pi/settings.json, which is
        # shared across machines. That is an install mismatch rather than a
        # dotfiles failure, and letting it abort the run made a working setup
        # report failure on every scheduled refresh.
        pi update || echo 'pi update failed; continuing (check npmCommand in .agents/pi/settings.json)'
        echo '  ======  updated pi and pi packages'
fi

